---
import { ArrowRight } from 'lucide-react';
import SectionHeading from './SectionHeading.astro';
import type { SectionContent } from '../../../shared/schemas/cms';
import type { PublicPortfolioItem } from '../../../server/modules/cms';

interface Props {
  content: SectionContent<'work_grid'>;
  items: PublicPortfolioItem[];
}
const { content: c, items } = Astro.props;
---

{
  items.length > 0 ? (
    <section class="bg-surface py-16 md:py-24 lg:py-28" aria-labelledby="work-title">
      <div class="container-content">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <SectionHeading id="work-title" title={c.title} intro={c.intro} />
          <a href="/work" class="mb-10 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 md:mb-14">
            All work <ArrowRight size={16} aria-hidden="true" />
          </a>
        </div>
        <ul class="grid gap-4 md:grid-cols-3">
          {items.slice(0, 3).map((p) => (
            <li>
              <a href={`/work/${p.slug}`} class="flex h-full flex-col rounded-md border border-line p-6 hover:border-brand-500">
                <span class="text-xs font-semibold tracking-wider text-ink-600 uppercase">{p.category}</span>
                <span class="mt-3 font-display text-lg font-bold tracking-display text-ink-950">{p.name}</span>
                <span class="mt-2 text-[15px] leading-6 text-ink-600">{p.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ) : null
}
