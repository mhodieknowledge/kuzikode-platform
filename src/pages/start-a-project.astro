---
/**
 * The Start-a-project wizard is retired (BRIEF B.0c). Old links and shared URLs land on the contact form with any package,
 * division or service preselection carried over. Permanent redirect; only slug-shaped values are forwarded.
 */
const SLUG = /^[a-z0-9_-]{1,80}$/;
const target = new URLSearchParams();
for (const key of ['category', 'service', 'package'] as const) {
  const value = Astro.url.searchParams.get(key);
  if (value && SLUG.test(value)) target.set(key, value);
}
const query = target.toString();
return Astro.redirect(query ? `/contact?${query}` : '/contact', 301);
