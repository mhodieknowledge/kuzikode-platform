---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import StatusPill from '../../../components/portal/StatusPill.astro';
import { ProjectMessageForm } from '../../../components/portal/ProjectMessageForm';
import { loadPortalPage } from '../../../server/lib/portal-page';
import { getPortalProject } from '../../../server/modules/projects';
import { AppError } from '../../../server/lib/errors';
import { MILESTONE_STATUS_LABEL, PROJECT_STATUS_LABEL } from '../../../shared/projects';
import { formatLongDate } from '../../../shared/service-display';
import { harareDateTime } from '../../../shared/devices';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request, { area: 'projects' });
if (page instanceof Response) return page;
let data;
try {
  data = await getPortalProject(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND') return new Response(null, { status: 404 });
  throw err;
}
const p = data.project;
const size = (b: number) =>
  b >= 1_048_576 ? `${(b / 1_048_576).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`;
const MILESTONE_TONE = { pending: 'neutral', in_progress: 'info', completed: 'success', cancelled: 'neutral' } as const;
const section = 'rounded-lg border border-line bg-surface p-5 md:p-6';
---

<PortalLayout title={p.name} page={page} active="projects">
  <p class="text-sm">
    <a href="/portal/projects" class="font-semibold text-brand-600 underline underline-offset-2">
      Projects
    </a>
  </p>
  <div class="mt-2 flex flex-wrap items-baseline justify-between gap-3">
    <h1 class="text-2xl font-bold tracking-display md:text-3xl">{p.name}</h1>
    <p class="text-sm text-ink-600">
      <span class="font-mono">{p.reference}</span> · {PROJECT_STATUS_LABEL[p.status]}
    </p>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]">
    <div class="flex min-w-0 flex-col gap-6">
      <section class={section} aria-labelledby="progress-title">
        <h2 id="progress-title" class="font-sans text-lg font-semibold">
          Progress
        </h2>
        <div class="mt-3 flex items-center gap-3">
          <div
            class="h-3 flex-1 overflow-hidden rounded-full bg-ink-950/10"
            role="progressbar"
            aria-label={`${p.name} progress`}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={p.progressPct}
          >
            <div class="h-full rounded-full bg-brand-600" style={`width:${p.progressPct}%`} />
          </div>
          <span class="w-12 text-right font-mono tabular-nums text-ink-950">{p.progressPct}%</span>
        </div>
        <p class="mt-2 text-sm text-ink-600">
          {p.startDate ? `Started ${formatLongDate(p.startDate)}` : ''}
          {p.startDate && (p.targetDate || p.completedAt) ? ' · ' : ''}
          {p.completedAt
            ? `Completed ${formatLongDate(p.completedAt)}`
            : p.targetDate
              ? `Target ${formatLongDate(p.targetDate)}`
              : ''}
        </p>
        {data.milestones.length ? (
          <ol class="mt-4 divide-y divide-line border-t border-line" aria-label="Milestones">
            {data.milestones.map((m) => (
              <li class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1 py-3">
                <div class="min-w-0">
                  <p class="font-medium text-ink-950">{m.title}</p>
                  {m.description ? <p class="text-sm text-ink-600">{m.description}</p> : null}
                  {m.dueDate ? <p class="text-sm text-ink-600">Due {formatLongDate(m.dueDate)}</p> : null}
                </div>
                <StatusPill label={MILESTONE_STATUS_LABEL[m.status]} tone={MILESTONE_TONE[m.status]} />
              </li>
            ))}
          </ol>
        ) : null}
      </section>

      <section class={section} aria-labelledby="updates-title">
        <h2 id="updates-title" class="font-sans text-lg font-semibold">
          Updates
        </h2>
        {data.updates.length === 0 ? (
          <p class="mt-2 text-sm text-ink-600">No updates yet.</p>
        ) : (
          <ol class="mt-3 flex flex-col gap-4" data-testid="project-updates">
            {data.updates.map((u) => (
              <li class="border-l-2 border-brand-600 pl-4">
                <p class="text-[13px] text-ink-600">
                  {u.author} · <time datetime={u.createdAt}>{harareDateTime(u.createdAt)}</time>
                </p>
                <p class="mt-1 whitespace-pre-line text-ink-950">{u.body}</p>
              </li>
            ))}
          </ol>
        )}
      </section>

      <section class={section} aria-labelledby="messages-title">
        <h2 id="messages-title" class="font-sans text-lg font-semibold">
          Messages
        </h2>
        <p class="mt-1 text-sm text-ink-600">Write to the team working on this project.</p>
        {data.messages.length ? (
          <ol class="mt-4 flex flex-col gap-3" data-testid="project-messages">
            {data.messages.map((m) => (
              <li
                class:list={[
                  'max-w-[85%] rounded-lg px-4 py-3',
                  m.mine ? 'self-end bg-brand-600/10' : m.fromTeam ? 'self-start bg-canvas' : 'self-end bg-canvas',
                ]}
              >
                <p class="text-[13px] text-ink-600">
                  {m.mine ? 'You' : m.fromTeam ? `${m.author} · Kuzikode` : m.author} ·{' '}
                  <time datetime={m.createdAt}>{harareDateTime(m.createdAt)}</time>
                </p>
                <p class="mt-1 whitespace-pre-line text-ink-950">{m.body}</p>
              </li>
            ))}
          </ol>
        ) : null}
        <div class="mt-4">
          <ProjectMessageForm client:visible projectId={p.id} />
        </div>
      </section>
    </div>

    <aside class="flex min-w-0 flex-col gap-6">
      <section class={section} aria-labelledby="files-title">
        <h2 id="files-title" class="font-sans text-lg font-semibold">
          Deliverables
        </h2>
        {data.deliverables.length === 0 ? (
          <p class="mt-2 text-sm text-ink-600">Files the team shares with you appear here.</p>
        ) : (
          <ul class="mt-3 divide-y divide-line" aria-label="Deliverables">
            {data.deliverables.map((f) => (
              <li class="py-3">
                <a
                  href={`/api/v1/portal/files/${f.fileId}`}
                  download
                  class="font-semibold text-brand-600 underline underline-offset-2 [overflow-wrap:anywhere]"
                >
                  {f.label}
                </a>
                <p class="text-[13px] text-ink-600 [overflow-wrap:anywhere]">
                  {f.name} · {size(f.size)} · {formatLongDate(f.createdAt)}
                </p>
              </li>
            ))}
          </ul>
        )}
      </section>
    </aside>
  </div>
</PortalLayout>
