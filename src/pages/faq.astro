---
import PublicLayout from '../layouts/PublicLayout.astro';
import { breadcrumbLd, FAQ_CATEGORIES, faqLd, getPage, listAllFaqs, sectionOf } from '../server/modules/cms';

const { ctx } = Astro.locals;
const [page, faqs] = await Promise.all([getPage(ctx, 'faq'), listAllFaqs(ctx)]);
const intro = sectionOf(page, 'intro', 'rich_text');
const groups = FAQ_CATEGORIES.map((c) => ({ ...c, items: faqs.filter((f) => f.category === c.key) })).filter(
  (g) => g.items.length > 0,
);
const ld = [breadcrumbLd(ctx, [{ name: 'FAQ', path: '/faq' }]), ...(faqs.length ? [faqLd(faqs)] : [])];
---

<PublicLayout
  structuredData={ld}
  title={page?.seoTitle ?? 'FAQ · Kuzikode Technologies'}
  description={page?.seoDescription ?? undefined}
>
  <section class="bg-canvas py-14 md:py-20" aria-labelledby="faq-title">
    <div class="container-content max-w-3xl">
      <h1 id="faq-title" class="text-4xl font-bold tracking-display md:text-5xl">
        {intro?.content.title ?? 'Frequently asked questions'}
      </h1>
      {intro ? <div class="prose-kz mt-4 text-lg" set:html={intro.content.html} /> : null}
      <div class="mt-8 hidden" data-faq-filter-wrap>
        <label for="faq-filter" class="text-sm font-medium text-ink-950">
          Filter questions
        </label>
        <input
          id="faq-filter"
          type="search"
          autocomplete="off"
          maxlength="100"
          class="mt-1.5 h-11 w-full rounded-sm border border-line bg-surface px-3 text-[15px] text-ink-950 hover:border-ink-400 focus-visible:border-brand-500 focus-visible:outline-2 focus-visible:outline-brand-500"
          data-faq-filter
        />
        <p class="mt-2 text-[13px] text-ink-600" role="status" aria-live="polite" data-faq-count></p>
      </div>
      <nav aria-label="FAQ categories" class="mt-6">
        <ul class="flex flex-wrap gap-2">
          {groups.map((g) => (
            <li>
              <a
                href={`#${g.key}`}
                class="inline-flex h-9 items-center rounded-full border border-line bg-surface px-4 text-sm font-semibold text-ink-800 hover:border-ink-400"
              >
                {g.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
  <div class="bg-surface py-14 md:py-20">
    <div class="container-content flex max-w-3xl flex-col gap-14">
      {groups.map((g) => (
        <section id={g.key} class="scroll-mt-24" aria-labelledby={`faq-${g.key}`} data-faq-group>
          <h2 id={`faq-${g.key}`} class="text-2xl font-bold tracking-display">
            {g.label}
          </h2>
          <div class="mt-6 divide-y divide-line border-y border-line">
            {g.items.map((f) => (
              <details id={f.id} class="group scroll-mt-24 py-5" data-faq-item>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink-950">
                  {f.question}
                  <span
                    aria-hidden="true"
                    class="text-xl leading-none text-ink-600 transition-transform group-open:rotate-45"
                  >
                    +
                  </span>
                </summary>
                <p class="mt-3 text-[15px] leading-7 text-ink-600">{f.answer}</p>
              </details>
            ))}
          </div>
        </section>
      ))}
      <p class="text-[15px] text-ink-600">
        Still have a question?{' '}
        <a href="/contact" class="font-semibold text-brand-600 underline underline-offset-2">
          Contact us
        </a>
        .
      </p>
    </div>
  </div>
</PublicLayout>

<script>
  // Progressive enhancement: the filter appears only when JavaScript runs; every answer is in the HTML regardless.
  const wrap = document.querySelector<HTMLElement>('[data-faq-filter-wrap]');
  const input = document.querySelector<HTMLInputElement>('[data-faq-filter]');
  const count = document.querySelector<HTMLElement>('[data-faq-count]');
  const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-faq-group]')];
  if (wrap && input && count) {
    wrap.classList.remove('hidden');
    input.addEventListener('input', () => {
      const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const item of items) {
        const text = item.textContent?.toLowerCase() ?? '';
        const match = terms.every((t) => text.includes(t));
        item.hidden = !match;
        if (match) shown++;
        item.open = terms.length > 0 && match;
      }
      for (const g of groups) g.hidden = !g.querySelector('[data-faq-item]:not([hidden])');
      count.textContent = terms.length ? `${shown} matching question${shown === 1 ? '' : 's'}` : '';
    });
    const openFromHash = () => {
      const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      if (!(target instanceof HTMLDetailsElement)) return;
      if (target.hidden) {
        input.value = '';
        input.dispatchEvent(new Event('input'));
      }
      target.open = true;
      target.scrollIntoView();
    };
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  }
</script>
