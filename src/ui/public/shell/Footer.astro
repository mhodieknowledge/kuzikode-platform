---
/**
 * Public footer (R9.5, REFINEMENTS §6): on night, calm and stacked on phones. A short closing band (one primary action, one
 * quiet link), the brand with its three contact lines (email, telephone, WhatsApp & calls; all from Settings, blank ones are
 * not rendered), two compact link lists, the newsletter and the legal line. No oversized wordmark, no link columns on phones.
 */
import Logo from '../../brand/Logo.astro';
import Icon from '../../icons/Icon.astro';
import Newsletter from '../forms/Newsletter';
import type { SiteNavigation } from '../../../server/modules/cms';
import { divisionShortName } from '../../../shared/directory';

interface Props {
  nav: SiteNavigation;
  /** Pages that end with their own call to action (contact, consultation) hide the footer's routes. */
  cta?: boolean;
  /** The page's own closing words (e.g. the home page's CMS `cta` section) shown above the routes instead of "Where next". */
  lead?: { title: string; body?: string | undefined } | undefined;
}
const { nav, cta = true, lead } = Astro.props;
const { footer } = nav;
const year = new Date().getFullYear();
const c = footer.contact;
const digits = (v: string) => v.replace(/[^\d+]/g, '');
const quiet =
  Astro.url.pathname === '/consultation'
    ? { href: '/pricing', label: 'See all prices' }
    : { href: '/consultation', label: 'Book a consultation' };
---

<footer class="kz-footer on-night" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  {
    cta ? (
      <div class="container-wide kz-footer__next">
        <div>
          <h2 class="kz-footer__lead">{lead?.title ?? 'Tell us what you need'}</h2>
          <p class="kz-footer__lead-body">
            {lead?.body ?? 'We reply with questions or a written quotation, usually within one business day.'}
          </p>
        </div>
        <div class="kz-footer__actions">
          {Astro.url.pathname !== '/contact' ? (
            <a href="/contact" class="kz-btn kz-btn--primary kz-btn--lg"><span>Get a quote</span></a>
          ) : null}
          <a href={quiet.href} class="kz-btn kz-btn--secondary kz-btn--lg"><span>{quiet.label}</span></a>
        </div>
      </div>
    ) : null
  }

  <div class="container-wide kz-footer__grid">
    <div class="kz-footer__brand">
      <Logo height={26} />
      {footer.blurb ? <p class="kz-footer__blurb">{footer.blurb}</p> : null}
      {
        c.address || c.location ? (
          <p class="kz-footer__place">
            <Icon name="location" size={20} />
            <span>{c.address ?? c.location}</span>
          </p>
        ) : null
      }
    </div>

    <ul class="kz-footer__contact" aria-label="Contact" role="list">
      {
        c.email ? (
          <li>
            <Icon name="email" size={20} />
            <span class="kz-footer__label">Email</span>
            <a href={`mailto:${c.email}`} class="kz-footer__value">{c.email}</a>
          </li>
        ) : null
      }
      {
        c.phone ? (
          <li>
            <Icon name="phone" size={20} />
            <span class="kz-footer__label">Tel</span>
            <a href={`tel:${digits(c.phone)}`} class="kz-footer__value">{c.phone}</a>
          </li>
        ) : null
      }
      {
        c.whatsapp && c.whatsappNumber ? (
          <li>
            <Icon name="whatsapp" size={20} />
            <span class="kz-footer__label">WhatsApp &amp; calls</span>
            <span class="kz-footer__value kz-footer__value--pair">
              <a href={c.whatsapp} rel="noopener noreferrer" target="_blank">
                {c.whatsappNumber}<span class="sr-only"> on WhatsApp (opens in a new tab)</span>
              </a>
              <a href={`tel:${digits(c.whatsappNumber)}`} class="kz-footer__call">
                Call<span class="sr-only"> {c.whatsappNumber}</span>
              </a>
            </span>
          </li>
        ) : null
      }
    </ul>

    <nav aria-labelledby="footer-services" class="kz-footer__col">
      <h3 id="footer-services" class="kz-footer__h">Services</h3>
      <ul role="list">
        {
          footer.services.map((l) => (
            <li>
              <a href={l.href} class="kz-footer__link">
                {divisionShortName(l.href.replace(/^\/services\//, ''), l.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-labelledby="footer-company" class="kz-footer__col">
      <h3 id="footer-company" class="kz-footer__h">Company</h3>
      <ul role="list">
        {
          footer.company.map((l) => (
            <li>
              <a href={l.href} class="kz-footer__link">
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/portal/login" class="kz-footer__link">Client workspace</a>
        </li>
      </ul>
    </nav>

    <section aria-labelledby="newsletter-heading" class="kz-footer__news">
      <h3 id="newsletter-heading" class="kz-footer__h">Newsletter</h3>
      <Newsletter client:idle source="footer" />
      {
        footer.social.length > 0 ? (
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Social media" role="list">
            {footer.social.map((s) => (
              <li>
                <a href={s.href} rel="noopener noreferrer" target="_blank" class="kz-btn kz-btn--secondary kz-btn--sm">
                  <span>{s.label}</span>
                  <Icon name="arrow-up-right" size={16} />
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
    </section>
  </div>

  <div class="container-wide">
    <div class="kz-footer__legal">
      <p>© {year} {footer.companyName}{footer.registration ? ` · ${footer.registration}` : ''}</p>
      <ul role="list" aria-label="Legal">
        {
          footer.legal.map((l) => (
            <li>
              <a href={l.href} class="kz-footer__link">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
