---
import AuthLayout from '../../layouts/AuthLayout.astro';
import { SetPasswordForm } from '../../components/auth/AuthForms';

const token = (Astro.url.searchParams.get('token') ?? '').slice(0, 200);
Astro.response.headers.set('referrer-policy', 'no-referrer');
---

<AuthLayout
  title="Set up your account"
  heading="Set up your account"
  intro="Choose a password to finish setting up your Kuzikode client portal account."
  area="Client portal"
>
  {token ? (
    <SetPasswordForm client:load audience="portal" token={token} mode="invite" />
  ) : (
    <p class="text-ink-600">
      This link is incomplete. Open the link from your email again, or ask Kuzikode to resend it.
    </p>
  )}
</AuthLayout>
