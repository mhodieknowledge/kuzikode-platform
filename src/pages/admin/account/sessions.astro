---
/** Signed-in devices (R6.2 group 3): sessions as a dense table → list rows, this device marked, sign out per device and everywhere. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import { SignOutDevice, SignOutEverywhere } from '../../../ui/admin/account/AccountActions';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listSessions } from '../../../server/modules/auth/service';
import { deviceLabel, harareDateTime } from '../../../shared/devices';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request);
if (page instanceof Response) return page;
const sessions = await listSessions(ctx, page.auth);
---

<AdminLayout title="Signed-in devices" page={page}>
  <PageHead
    title="Signed-in devices"
    meta="Sessions end after 12 hours, or after 2 hours without activity. Sign out any you don't recognise."
    crumbs={[{ label: 'Security', href: '/admin/account/security' }, { label: 'Devices' }]}
  >
    <Fragment slot="actions">
      <SignOutEverywhere client:visible />
    </Fragment>
  </PageHead>
  <DataTable
    caption="Active sessions"
    count={sessions.length}
    columns={[
      { label: 'Device' },
      { label: 'IP address' },
      { label: 'Signed in' },
      { label: 'Last active' },
      { label: 'Actions' },
    ]}
  >
    {sessions.map((s) => {
      const label = deviceLabel(s.userAgent);
      return (
        <tr>
          <Cell m="main">
            <span class="kz-dt__strong">{label}</span>
            {s.current ? (
              <StatusPill tone="lit" class="kz-pill--xs">
                This device
              </StatusPill>
            ) : null}
            <span class="kz-dt__ph">
              <span class="kz-dt__sub">{s.ip ?? '—'}</span>
            </span>
          </Cell>
          <Cell tone="mute">
            <span class="kz-amono">{s.ip ?? '—'}</span>
          </Cell>
          <Cell tone="mute" class="kz-dt__nw">
            {harareDateTime(s.createdAt)}
          </Cell>
          <Cell m="meta" tone="mute" class="kz-dt__nw">
            <span class="kz-dt__ph">Active </span>
            {harareDateTime(s.lastSeenAt)}
          </Cell>
          <Cell m="acts" class="kz-dt__acts">
            {s.current ? null : <SignOutDevice client:visible sessionId={s.id} device={label} />}
          </Cell>
        </tr>
      );
    })}
  </DataTable>
</AdminLayout>
