---
import PublicLayout from '../../layouts/PublicLayout.astro';
import ApplicationForm from '../../components/forms/ApplicationForm';
import { getSettings, settingBool } from '../../server/modules/cms';

const { ctx } = Astro.locals;
if (!settingBool(await getSettings(ctx), 'careers.general_applications')) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}
---

<PublicLayout
  title="Send us your CV · Careers · Kuzikode Technologies"
  description="Send Kuzikode Technologies a general application."
>
  <section class="bg-canvas py-12 md:py-16" aria-labelledby="general-title">
    <div class="container-content max-w-3xl">
      <h1 id="general-title" class="text-4xl font-bold tracking-display md:text-5xl">
        Send us your CV
      </h1>
      <p class="mt-4 text-lg text-ink-600">
        Tell us about yourself. We will keep your details on file and contact you if a suitable role opens.
      </p>
      <div class="mt-8 rounded-lg border border-line bg-surface p-6 md:p-8">
        <ApplicationForm
          client:load
          slug={null}
          position="General application"
          questions={[]}
          siteKey={ctx.config.turnstileSiteKey}
        />
      </div>
    </div>
  </section>
</PublicLayout>
