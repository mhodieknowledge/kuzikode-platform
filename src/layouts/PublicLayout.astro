---
import BaseHead from '../components/BaseHead.astro';
import AnnouncementBar from '../components/public/AnnouncementBar.astro';
import SiteFooter from '../components/public/SiteFooter.astro';
import SiteHeader from '../components/public/SiteHeader.astro';
import JsonLd from '../components/JsonLd.astro';
import WhatsAppButton from '../components/public/WhatsAppButton.astro';
import {
  currentAnnouncement,
  getSettings,
  organizationLd,
  settingText,
  siteNavigation,
  websiteLd,
} from '../server/modules/cms';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  headerTone?: 'light' | 'dark';
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Page-specific schema.org objects; Organization is always included, WebSite on the home page. */
  structuredData?: Record<string, unknown>[];
  /** Prefilled WhatsApp message for this page, e.g. "Hi Kuzikode, I'm interested in the Business Website plan." */
  whatsappMessage?: string;
}
const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  headerTone = 'light',
  ogImage,
  ogType,
  structuredData = [],
  whatsappMessage,
} = Astro.props;
const { ctx } = Astro.locals;
const [nav, announcement, org, settings] = await Promise.all([
  siteNavigation(ctx),
  currentAnnouncement(ctx),
  organizationLd(ctx),
  getSettings(ctx),
]);
const whatsappNumber = settingText(settings, 'contact.whatsapp_number');
const whatsappText =
  whatsappMessage ??
  settingText(settings, 'contact.whatsapp_message') ??
  'Hi Kuzikode, I would like to talk about a project.';
const ld = [org, ...(Astro.url.pathname === '/' ? [websiteLd(ctx)] : []), ...structuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonicalPath={noindex ? undefined : canonicalPath}
      noindex={noindex}
      ogImage={ogImage}
      ogType={ogType}
    />
    {noindex ? null : <JsonLd data={ld} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-surface">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {Astro.locals.ctx.preview ? (
      <p role="status" class="sticky top-0 z-50 bg-warning-700 px-4 py-2 text-center text-sm font-semibold text-white">
        Preview of unpublished changes. Visitors still see the published version.
      </p>
    ) : null}
    <AnnouncementBar announcement={announcement} />
    <SiteHeader nav={nav} tone={headerTone} />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter nav={nav} />
    <WhatsAppButton number={whatsappNumber} message={whatsappText} />
  </body>
</html>
