---
/**
 * Icon for Astro templates (server-rendered SVG, no client JS).
 * Decorative by default (`aria-hidden`); pass `label` when the icon is the only content of a control or carries meaning.
 */
import { ICONS, ICON_SIZES, type IconName, type IconSize } from './registry';

interface Props {
  name: IconName;
  size?: IconSize;
  label?: string | undefined;
  class?: string | undefined;
}
const { name, size = 20, label, class: className } = Astro.props;
const Glyph = ICONS[name];
---

<Glyph
  width={size}
  height={size}
  strokeWidth={ICON_SIZES[size]}
  absoluteStrokeWidth={false}
  className={['kz-icon shrink-0', className].filter(Boolean).join(' ')}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  focusable="false"
/>
