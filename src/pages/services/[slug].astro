---
/**
 * Division page (R4.2, clean slate; recomposed after the B.0d board review): header with the division drawing → packages first,
 * as a comparison table on the night band (IMG_5071; "Recommended" from the CMS flag) → what we offer (numbered ledger) → a
 * full-bleed photo band carrying the overview (B.4a) → why it matters + typical deliverables → questions; the footer's routes
 * close the page under "Tell us what you need". Data and URLs unchanged (catalogue, packagesForCategory, quotationHref).
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import DivisionHeader from '../../ui/public/services/DivisionHeader.astro';
import ServiceLedger from '../../ui/public/services/ServiceLedger.astro';
import PackageCompare from '../../ui/public/services/PackageCompare.astro';
import PhotoBand from '../../ui/public/shared/PhotoBand.astro';
import Accordion from '../../ui/primitives/Accordion.astro';
import AccordionItem from '../../ui/primitives/AccordionItem.astro';
import Icon from '../../ui/icons/Icon.astro';
import manifest from '../../../design/images/manifest.json';
import {
  breadcrumbLd,
  getServiceCatalogue,
  getSettings,
  packagesForCategory,
  serviceLd,
  settingBool,
} from '../../server/modules/cms';
import { canRequestQuote, quotationHref } from '../../shared/service-display';
import { RETIRED_DIVISIONS, divisionFromPrice, divisionShortName } from '../../shared/directory';

const { ctx } = Astro.locals;
const catalogue = await getServiceCatalogue(ctx);
const index = catalogue.findIndex((c) => c.slug === (Astro.params.slug ?? ''));
const cat = catalogue[index];
if (!cat) {
  // Divisions retired in R9.1 (REFINEMENTS §1): permanent redirect to the closest remaining page.
  const moved = RETIRED_DIVISIONS[Astro.params.slug ?? ''];
  if (moved) return Astro.redirect(moved, 301);
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const settings = await getSettings(ctx);
const showPrices = settingBool(settings, 'pricing.show_prices');
const { packages } = await packagesForCategory(ctx, cat.slug);
const quotable = canRequestQuote(cat.status);
const n = index + 1;
const hue = `kz-div-${((n - 1) % 6) + 1}`;
const from = showPrices ? divisionFromPrice(packages, cat.slug) : null;
// R9.1 renamed two divisions; their photographs keep the original keys until the owner sends new ones.
const IMAGE_ALIAS: Record<string, string> = {
  websites: 'web-development',
  'cross-platform-apps': 'mobile-desktop-apps',
};
const imageKey = `svc-${IMAGE_ALIAS[cat.slug] ?? cat.slug}`;
const bandImage = imageKey in manifest.images ? imageKey : 'about-workspace';
const ld = [
  serviceLd(ctx, cat),
  breadcrumbLd(ctx, [
    { name: 'Services', path: '/services' },
    { name: cat.name, path: `/services/${cat.slug}` },
  ]),
];
---

<PublicLayout
  structuredData={ld}
  ogImage={`/brand/og/services-${cat.slug}.png`}
  title={`${cat.seoTitle ?? cat.name} · Kuzikode Technologies`}
  description={cat.seoDescription ?? cat.summary}
  whatsappMessage={`Hi Kuzikode, I'm interested in ${cat.name}.`}
  headerTone="bone"
  footerLead={quotable ? { title: 'Tell us what you need' } : undefined}
>
  <DivisionHeader
    slug={cat.slug}
    name={cat.name}
    summary={cat.summary}
    n={n}
    total={catalogue.length}
    comingSoon={cat.status === 'coming_soon'}
    quoteHref={quotable ? quotationHref(cat.slug) : null}
    from={from}
  />

  {packages.length > 0 ? (
    <section class={`kz-band on-night ${hue}`} aria-labelledby="packages-title">
      <div class="container-wide">
        <header class="kz-sec__head">
          <div>
            <h2 id="packages-title" class="kz-h2">
              Packages and prices
            </h2>
            <p class="kz-lede">Published prices. The written quotation confirms the final amount before work starts.</p>
          </div>
          <a class="kz-link" href="/pricing">
            Compare all pricing
            <Icon name="arrow-right" size={16} />
          </a>
        </header>
        <PackageCompare packages={packages} caption={`${cat.name} packages compared`} id="compare" />
      </div>
    </section>
  ) : null}

  {cat.services.length > 0 ? <ServiceLedger cat={cat} n={n} showPrices={showPrices} packages={packages} /> : null}

  {cat.description ? (
    <PhotoBand image={bandImage} label="Overview">
      <h2 class="kz-pband__title">How we approach {divisionShortName(cat.slug, cat.name).toLowerCase()}</h2>
      <div class="prose-kz kz-pband__prose" set:html={cat.description} />
    </PhotoBand>
  ) : null}

  {cat.benefits.length > 0 || cat.deliverables.length > 0 ? (
    <section class={`kz-sec kz-gains ${hue}`} aria-label="Benefits and deliverables">
      <div class="container-wide kz-gains__grid">
        {cat.benefits.length > 0 ? (
          <div>
            <h2 class="kz-h2">Why it matters</h2>
            <dl class="kz-gains__list" data-reveal-group>
              {cat.benefits.map((b, i) => (
                <div class="kz-gains__row">
                  <dt>
                    <span class="kz-gains__n">{String(i + 1).padStart(2, '0')}</span>
                    {b.title}
                  </dt>
                  <dd>{b.body}</dd>
                </div>
              ))}
            </dl>
          </div>
        ) : null}
        {cat.deliverables.length > 0 ? (
          <div class="kz-gains__deliver">
            <h2 class="kz-h2">Typical deliverables</h2>
            <ul class="kz-gains__checks" role="list">
              {cat.deliverables.map((d) => (
                <li>
                  <Icon name="check" size={16} />
                  {d}
                </li>
              ))}
            </ul>
          </div>
        ) : null}
      </div>
    </section>
  ) : null}

  {cat.faq.length > 0 ? (
    <section class="kz-sec kz-sec--inset kz-faq" aria-labelledby="faq-title">
      <div class="container-wide kz-faq__grid">
        <h2 id="faq-title" class="kz-h2">
          Questions
        </h2>
        <Accordion>
          {cat.faq.map((f, i) => (
            <AccordionItem title={f.q} open={i === 0}>
              <p>{f.a}</p>
            </AccordionItem>
          ))}
        </Accordion>
      </div>
    </section>
  ) : null}
</PublicLayout>
