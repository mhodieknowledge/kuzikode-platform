---
/**
 * Pricing (R9.2, REFINEMENTS §2): short hero (with the rate card as an index) → one block per division, in catalogue order: a package
 * carousel and, when the packages share features, a comparison table with every package as a column; a division with a single priced
 * offer gets one compact offer card → one FAQ + VAT note → one "Get a quote" band. No tabs or segmented controls. Every figure comes
 * from `getPricingCatalogue` (BRIEF B.6; the price-accuracy e2e test checks it against D1).
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import PricingHero, { type RateRow } from '../ui/public/pricing/PricingHero.astro';
import PlanDeck from '../ui/public/pricing/PlanDeck.astro';
import OfferCard from '../ui/public/pricing/OfferCard.astro';
import PackageCompare from '../ui/public/services/PackageCompare.astro';
import QuoteBand from '../ui/public/shared/QuoteBand.astro';
import Accordion from '../ui/primitives/Accordion.astro';
import AccordionItem from '../ui/primitives/AccordionItem.astro';
import Icon from '../ui/icons/Icon.astro';
import {
  breadcrumbLd,
  faqLd,
  getPage,
  getPricingCatalogue,
  getServiceCatalogue,
  listFaqs,
  sectionOf,
  type PublicPackage,
} from '../server/modules/cms';
import { isComparable, packagePrice } from '../shared/service-display';
import { divisionShortName } from '../shared/directory';

const { ctx } = Astro.locals;
const [page, catalogue, services, faqs] = await Promise.all([
  getPage(ctx, 'pricing'),
  getPricingCatalogue(ctx),
  getServiceCatalogue(ctx),
  listFaqs(ctx, 'pricing'),
]);
const intro = sectionOf(page, 'intro', 'rich_text');
const cta = sectionOf(page, 'cta', 'cta');

/** Lowest published price in a division (same currency as the first priced package), shown with its own unit. */
const lowest = (pkgs: PublicPackage[]): RateRow['from'] => {
  if (!catalogue.showPrices) return null;
  const priced = pkgs.filter((p) => p.priceType !== 'custom_quote' && p.priceMinor !== null && p.currency);
  const currency = priced[0]?.currency;
  const min = priced
    .filter((p) => p.currency === currency)
    .reduce<PublicPackage | null>((a, p) => (a === null || (p.priceMinor ?? 0) < (a.priceMinor ?? 0) ? p : a), null);
  if (!min) return null;
  const d = packagePrice(min);
  return { amount: d.amount, suffix: d.suffix };
};

// One block per division, in catalogue order. Packages whose division is not in the catalogue still show (never drop a price).
const known = new Set(services.map((c) => c.slug));
const blocks = [
  ...services.map((c, i) => ({
    key: c.slug,
    name: c.name,
    short: divisionShortName(c.slug, c.name),
    n: i + 1,
    deliverables: c.deliverables,
    packages: catalogue.packages.filter((p) => p.categorySlug === c.slug),
  })),
  ...[...new Set(catalogue.packages.filter((p) => !known.has(p.categorySlug)).map((p) => p.categorySlug))].map(
    (slug) => ({
      key: slug,
      name: slug,
      short: slug,
      n: 0,
      deliverables: [] as string[],
      packages: catalogue.packages.filter((p) => p.categorySlug === slug),
    }),
  ),
].filter((b) => b.packages.length > 0);
const rows: RateRow[] = blocks.map((b) => ({
  key: b.key,
  label: b.short,
  count: b.packages.length,
  from: lowest(b.packages),
}));
const ld = [breadcrumbLd(ctx, [{ name: 'Pricing', path: '/pricing' }]), ...(faqs.length ? [faqLd(faqs)] : [])];
---

<PublicLayout
  structuredData={ld}
  title={page?.seoTitle ?? 'Pricing · Kuzikode Intelligent Technologies'}
  description={page?.seoDescription ?? undefined}
  whatsappMessage="Hi Kuzikode, I have a question about your packages and pricing."
  headerTone="bone"
  footerCta={false}
>
  <PricingHero
    title={intro?.content.title ?? 'Pricing'}
    introHtml={intro?.content.html ?? null}
    rows={rows}
    showPrices={catalogue.showPrices}
  />

  {blocks.length === 0 ? (
    <section class="kz-sec">
      <div class="container-wide">
        <p class="kz-lede">
          Our packages are being updated.{' '}
          <a class="kz-link" href="/contact">
            Contact us
          </a>{' '}
          for a quotation.
        </p>
      </div>
    </section>
  ) : (
    blocks.map((b, i) => (
      <section
        id={b.key}
        class:list={['kz-sec kz-pdiv', b.n > 0 && `kz-div-${((b.n - 1) % 6) + 1}`, i % 2 === 1 && 'kz-sec--inset']}
        aria-labelledby={`div-${b.key}`}
      >
        <div class="container-wide">
          <header class="kz-pdiv__head">
            <span class="kz-pdiv__n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h2 id={`div-${b.key}`} class="kz-h2">
              {b.name}
            </h2>
            {b.n > 0 ? (
              <a class="kz-link kz-pdiv__more" href={`/services/${b.key}`}>
                About this service
                <span class="sr-only">: {b.name}</span>
                <Icon name="arrow-right" size={16} />
              </a>
            ) : null}
          </header>
          {b.packages.length === 1 ? (
            <OfferCard pkg={b.packages[0]!} deliverables={b.deliverables} compact id={`plans-${b.key}`} />
          ) : (
            <PlanDeck packages={b.packages} label={b.short} id={`plans-${b.key}`} />
          )}
          {isComparable(b.packages) ? (
            <div class="kz-pdiv__compare">
              <h3 class="kz-pdiv__sub">Compare all packages side by side</h3>
              <PackageCompare packages={b.packages} caption={`${b.short}: package comparison`} id={`cmp-${b.key}`} />
            </div>
          ) : null}
        </div>
      </section>
    ))
  )}

  <section
    class="kz-sec kz-faq kz-pfaq"
    aria-labelledby={faqs.length > 0 ? 'faq-title' : undefined}
    aria-label={faqs.length > 0 ? undefined : 'Pricing note'}
  >
    <div class="container-wide kz-faq__grid">
      <div>
        {faqs.length > 0 ? (
          <h2 id="faq-title" class="kz-h2">
            Pricing questions
          </h2>
        ) : null}
        <p class="kz-pnote" data-vat-note>
          {catalogue.vatNote}
        </p>
      </div>
      {faqs.length > 0 ? (
        <Accordion>
          {faqs.map((f, i) => (
            <AccordionItem title={f.question} open={i === 0}>
              <p>{f.answer}</p>
            </AccordionItem>
          ))}
        </Accordion>
      ) : null}
    </div>
  </section>

  <QuoteBand
    title={cta?.content.title ?? 'Not sure which package fits?'}
    body={cta?.content.body ?? undefined}
    href="/contact"
  />
</PublicLayout>
