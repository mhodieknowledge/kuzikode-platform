---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import { ExpenseForm } from '../../../ui/admin/expenses/ExpenseForm';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { businessDate } from '../../../server/lib/dates';
import { formOptions } from '../../../server/modules/expenses';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'expenses.manage' });
if (page instanceof Response) return page;
const opts = await formOptions(ctx);
const projectId = Astro.url.searchParams.get('projectId');
const initial = {
  categoryId: '',
  expenseDate: businessDate(ctx.now()),
  vendor: null,
  description: '',
  amountMinor: null,
  currency: opts.currencies[0]?.code ?? 'USD',
  paymentMethod: null,
  reference: null,
  projectId: opts.projects.some((p) => p.id === projectId) ? projectId : null,
  clientId: null,
  notes: null,
};
---

<AdminLayout title="Record expense" page={page}>
  <PageHead title="Record expense" crumbs={[{ label: 'Expenses', href: '/admin/expenses' }, { label: 'New' }]} />
  <ExpenseForm client:load initial={initial} hasReceipt={false} {...opts} />
</AdminLayout>
