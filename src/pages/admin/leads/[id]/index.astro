---
/**
 * One lead (R6.2): the activity composer, open follow-ups and the activity log (mono timestamps) beside the details,
 * conversion and enquiry panes. Page actions: edit, new quotation (once converted) and convert to client.
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import Pane from '../../../../ui/admin/Pane.astro';
import DetailList from '../../../../ui/admin/DetailList.astro';
import Button from '../../../../ui/primitives/Button.astro';
import StatusPill from '../../../../ui/primitives/StatusPill.astro';
import { ActivityForm, CompleteFollowUp, ConvertLead } from '../../../../ui/admin/leads/LeadActivity';
import { LEAD_SOURCE_LABEL, LEAD_STATUS_TONE } from '../../../../ui/admin/leads/labels';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { businessDate } from '../../../../server/lib/dates';
import { AppError } from '../../../../server/lib/errors';
import { getLead, LEAD_STATUS_LABEL } from '../../../../server/modules/leads';
import { formatMoney } from '../../../../shared/money';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'leads.view' });
if (page instanceof Response) return page;
let data;
try {
  data = await getLead(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const { lead: l, services, activities, enquiries, client } = data;
const perms = page.auth.permissions;
const canManage = perms.has('leads.manage');
const canConvert = canManage && perms.has('clients.create') && !l.client_id && l.status !== 'lost';
const today = businessDate(ctx.now());
const TYPE_LABEL = {
  note: 'Note',
  call: 'Call',
  email: 'Email',
  meeting: 'Meeting',
  status_change: 'Stage change',
  follow_up: 'Follow-up',
} as const;
const fmt = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Africa/Harare' }).format(
    new Date(iso),
  );
const shortDate = (d: string) =>
  new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(`${d}T00:00:00Z`));
const openFollowUps = activities
  .filter((a) => a.type === 'follow_up' && !a.completed_at)
  .sort((a, b) => (a.due_on ?? '').localeCompare(b.due_on ?? ''));
---

<AdminLayout title={l.title} page={page}>
  <PageHead
    title={l.title}
    crumbs={[{ label: 'Leads', href: '/admin/leads' }, { label: l.title }]}
    meta={`${LEAD_STATUS_LABEL[l.status]} · ${LEAD_SOURCE_LABEL[l.source]} · ${l.assigned_name ?? 'Unassigned'}`}
  >
    <Fragment slot="actions">
      {canManage ? (
        <Button href={`/admin/leads/${l.id}/edit`} variant="secondary" lead="edit">
          Edit
        </Button>
      ) : null}
      {client && perms.has('quotations.create') ? (
        <Button href={`/admin/quotations/new?clientId=${client.id}&leadId=${l.id}`} variant="secondary" lead="add">
          New quotation
        </Button>
      ) : null}
      {canConvert ? <ConvertLead client:load leadId={l.id} name={l.organisation ?? l.contact_name ?? l.title} /> : null}
    </Fragment>
  </PageHead>
  <div class="kz-agrid kz-agrid--detail">
    <div class="kz-astack">
      {canManage ? (
        <Pane title="Log activity" id="act-form">
          <ActivityForm client:load leadId={l.id} />
        </Pane>
      ) : null}
      {openFollowUps.length ? (
        <Pane title="Open follow-ups" id="fu-title" flush meta={String(openFollowUps.length)}>
          <ul class="kz-alist" role="list">
            {openFollowUps.map((a) => (
              <li>
                <div class="kz-alist__main">
                  <p class="kz-aprose">{a.body}</p>
                  <p class:list={['kz-afu__due', a.due_on && a.due_on <= today && 'is-late']}>
                    {a.due_on ? `${a.due_on < today ? 'Overdue since' : 'Due'} ${shortDate(a.due_on)}` : ''}
                  </p>
                </div>
                {canManage ? <CompleteFollowUp client:visible leadId={l.id} activityId={a.id} /> : null}
              </li>
            ))}
          </ul>
        </Pane>
      ) : null}
      <Pane title="Activity" id="log-title" flush meta={activities.length ? String(activities.length) : undefined}>
        {activities.length === 0 ? (
          <p class="kz-anone">
            <span class="kz-anone__code">0 entries</span>Nothing logged yet.
          </p>
        ) : (
          <ol class="kz-afeed">
            {activities.map((a) => (
              <li data-kind={a.type}>
                <p class="kz-afeed__k">
                  {TYPE_LABEL[a.type]}
                  {a.type === 'follow_up' && a.due_on ? ` for ${shortDate(a.due_on)}` : ''}
                  {a.type === 'follow_up' && a.completed_at ? ' · done' : ''}
                </p>
                {a.body ? <p class="kz-afeed__b">{a.body}</p> : null}
                <p class="kz-afeed__t">
                  {a.user_name ?? 'System'} · {fmt(a.created_at)}
                </p>
              </li>
            ))}
          </ol>
        )}
      </Pane>
    </div>
    <aside class="kz-astack" aria-label="Lead details">
      {client ? (
        <div class="kz-anotice kz-anotice--ok">
          <p>
            <strong>Converted</strong> to <a href={`/admin/clients/${client.id}`}>{client.display_name}</a>{' '}
            <span class="kz-amono">{client.client_number}</span>
          </p>
        </div>
      ) : null}
      <Pane title="Details" id="ld-title">
        <StatusPill slot="actions" tone={LEAD_STATUS_TONE[l.status]}>
          {LEAD_STATUS_LABEL[l.status]}
        </StatusPill>
        <DetailList
          items={[
            { label: 'Contact', value: l.contact_name },
            { label: 'Organisation', value: l.organisation },
            { label: 'Email', value: l.email, href: l.email ? `mailto:${l.email}` : undefined },
            { label: 'Phone', value: l.phone, href: l.phone ? `tel:${l.phone.replace(/[^\d+]/g, '')}` : undefined },
            {
              label: 'Estimated value',
              value:
                l.estimated_value_minor != null && l.currency ? formatMoney(l.estimated_value_minor, l.currency) : null,
              mono: true,
            },
            { label: 'Next follow-up', value: l.next_follow_up_on ? shortDate(l.next_follow_up_on) : null },
            ...(services.length ? [{ label: 'Services', value: services.map((s) => s.name).join(', ') }] : []),
            ...(l.status === 'lost' && l.lost_reason ? [{ label: 'Lost because', value: l.lost_reason }] : []),
            { label: 'Created', value: fmt(l.created_at) },
          ]}
        />
        {l.notes ? (
          <div class="kz-asub">
            <h3 class="kz-asub__t">Notes</h3>
            <p class="kz-aprose">{l.notes}</p>
          </div>
        ) : null}
      </Pane>
      {enquiries.length ? (
        <Pane title="Enquiries" id="enq-title" flush>
          <ul class="kz-alist" role="list">
            {enquiries.map((e) => (
              <li>
                <div class="kz-alist__main">
                  {perms.has('enquiries.view') ? (
                    <a href={`/admin/enquiries/${e.id}`} class="kz-alist__t kz-amono">
                      {e.reference}
                    </a>
                  ) : (
                    <span class="kz-alist__t kz-amono">{e.reference}</span>
                  )}
                  <span class="kz-alist__m">{fmt(e.created_at)}</span>
                </div>
              </li>
            ))}
          </ul>
        </Pane>
      ) : null}
    </aside>
  </div>
</AdminLayout>
