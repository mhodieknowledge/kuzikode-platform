---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BarChart from '../../../ui/admin/BarChart.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import PeriodForm from '../../../ui/admin/PeriodForm.astro';
import DetailList from '../../../ui/admin/DetailList.astro';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { addMonths } from '../../../server/lib/dates';
import { reports, resolveRange } from '../../../server/modules/reports';
import { formatMoney } from '../../../shared/money';
import { AGEING_BUCKETS, AGEING_LABEL, reportRangeQuery, type ReportKey } from '../../../shared/schemas/reports';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'reports.view' });
if (page instanceof Response) return page;
const params = Astro.url.searchParams;
const range = resolveRange(
  ctx,
  reportRangeQuery.parse({ from: params.get('from') ?? undefined, to: params.get('to') ?? undefined }),
);
const d = await reports(ctx, range);
const canExport = page.auth.permissions.has('reports.export');
const csv = (report: ReportKey) =>
  `/api/v1/admin/reports/export.csv?report=${report}&from=${range.from}&to=${range.to}`;

// Months in the range for the charts (YYYY-MM).
const months: string[] = [];
for (let m = `${range.from.slice(0, 7)}-01`; m.slice(0, 7) <= range.to.slice(0, 7); m = addMonths(m, 1))
  months.push(m.slice(0, 7));
const currencies = [...new Set(d.byMonth.map((x) => x.currency))];
const compact = (currency: string) => (minor: number) =>
  `${currency} ${new Intl.NumberFormat('en-GB', { notation: 'compact', maximumFractionDigits: 1 }).format(minor / 100)}`;
const conversion = [
  { label: 'Sent', value: String(d.conversion.sent), mono: true },
  { label: 'Accepted', value: String(d.conversion.accepted), mono: true },
  {
    label: 'Conversion rate',
    value: d.conversion.rateBp === null ? '–' : `${(d.conversion.rateBp / 100).toFixed(1)}%`,
    mono: true,
  },
  { label: 'Rejected', value: String(d.conversion.rejected), mono: true },
  { label: 'Expired', value: String(d.conversion.expired), mono: true },
  { label: 'Still open', value: String(d.conversion.open), mono: true },
];
---

<AdminLayout title="Reports" page={page}>
  <PageHead
    title="Reports"
    meta={`${range.from} to ${range.to} (Africa/Harare). Every amount stays in its own currency; nothing is converted or added across currencies.`}
  />
  <div class="kz-atools">
    <PeriodForm label="Report period" from={range.from} to={range.to} />
  </div>

  <div class="kz-astack">
    <Pane title="Revenue received by month" id="rev-h">
      {canExport ? (
        <a slot="actions" class="kz-apane__link" href={csv('revenue_month')}>
          Export CSV
        </a>
      ) : null}
      <p class="kz-rnote">
        Payments received, minus refunds in the month they were made. Reversed payments are excluded.
      </p>
      {currencies.length === 0 ? <p class="kz-afeed__t">No payments in this period.</p> : null}
      <div class="kz-agrid kz-agrid--2">
        {currencies.map((cur) => (
          <BarChart
            id={`rev-${cur}`}
            title={`Net revenue (${cur})`}
            months={months}
            series={[
              {
                label: cur,
                values: months.map((m) => d.byMonth.find((x) => x.month === m && x.currency === cur)?.netMinor ?? 0),
              },
            ]}
            format={(v) => formatMoney(v, cur)}
            tick={compact(cur)}
          />
        ))}
      </div>
    </Pane>

    <Pane title="Indicative profit" id="profit-h" flush>
      {canExport ? (
        <a slot="actions" class="kz-apane__link" href={csv('profit')}>
          Export CSV
        </a>
      ) : null}
      <p class="kz-rnote kz-apad">
        Indicative only: revenue received minus recorded expenses. These are not accounting figures.
      </p>
      <div class="kz-rscroll" tabindex="0" role="region" aria-label="Scrollable table">
        <table class="kz-rt">
          <thead>
            <tr>
              <th scope="col">Currency</th>
              <th scope="col" class="is-num">
                Revenue received
              </th>
              <th scope="col" class="is-num">
                Expenses
              </th>
              <th scope="col" class="is-num">
                Indicative profit
              </th>
            </tr>
          </thead>
          <tbody>
            {d.profit.length === 0 ? (
              <tr>
                <td colspan="4" class="is-none">
                  Nothing in this period.
                </td>
              </tr>
            ) : null}
            {d.profit.map((p) => (
              <tr>
                <th scope="row">{p.currency}</th>
                <td class="is-num">{formatMoney(p.revenueMinor, p.currency)}</td>
                <td class="is-num">{formatMoney(p.expensesMinor, p.currency)}</td>
                <td class="is-num is-strong">{formatMoney(p.profitMinor, p.currency)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Pane>

    <div class="kz-agrid kz-agrid--2">
      <Pane title="Revenue by client" id="client-h" flush>
        {canExport ? (
          <a slot="actions" class="kz-apane__link" href={csv('revenue_client')}>
            Export CSV
          </a>
        ) : null}
        <div class="kz-rscroll is-tall" tabindex="0" role="region" aria-label="Scrollable table">
          <table class="kz-rt">
            <thead>
              <tr>
                <th scope="col">Client</th>
                <th scope="col" class="is-num">
                  Net received
                </th>
              </tr>
            </thead>
            <tbody>
              {d.byClient.length === 0 ? (
                <tr>
                  <td colspan="2" class="is-none">
                    No payments in this period.
                  </td>
                </tr>
              ) : null}
              {d.byClient.map((c) => (
                <tr>
                  <td>
                    <a href={`/admin/clients/${c.client_id}`}>{c.client}</a>
                  </td>
                  <td class="is-num">{formatMoney(c.net, c.currency)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Pane>
      <Pane title="Invoiced by service" id="svc-h" flush>
        {canExport ? (
          <a slot="actions" class="kz-apane__link" href={csv('revenue_service')}>
            Export CSV
          </a>
        ) : null}
        <p class="kz-rnote kz-apad">
          Line totals on invoices issued in this period (void and draft invoices excluded).
        </p>
        <div class="kz-rscroll is-tall" tabindex="0" role="region" aria-label="Scrollable table">
          <table class="kz-rt">
            <thead>
              <tr>
                <th scope="col">Service</th>
                <th scope="col" class="is-num">
                  Invoiced
                </th>
              </tr>
            </thead>
            <tbody>
              {d.byService.length === 0 ? (
                <tr>
                  <td colspan="2" class="is-none">
                    No invoices issued in this period.
                  </td>
                </tr>
              ) : null}
              {d.byService.map((s) => (
                <tr>
                  <td>{s.service}</td>
                  <td class="is-num">{formatMoney(s.amount, s.currency)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Pane>
    </div>

    <Pane title="Outstanding and ageing" id="age-h" flush>
      {canExport ? (
        <a slot="actions" class="kz-apane__link" href={csv('ageing')}>
          Export CSV
        </a>
      ) : null}
      <p class="kz-rnote kz-apad">Open invoice balances today ({d.ageing.asOf}), by days past the due date.</p>
      <div class="kz-rscroll" tabindex="0" role="region" aria-label="Scrollable table">
        <table class="kz-rt">
          <thead>
            <tr>
              <th scope="col">Currency</th>
              {AGEING_BUCKETS.map((b) => (
                <th scope="col" class="is-num">
                  {AGEING_LABEL[b]}
                </th>
              ))}
              <th scope="col" class="is-num">
                Total
              </th>
            </tr>
          </thead>
          <tbody>
            {d.ageing.summary.length === 0 ? (
              <tr>
                <td colspan="7" class="is-none">
                  Nothing outstanding.
                </td>
              </tr>
            ) : null}
            {d.ageing.summary.map((s) => (
              <tr>
                <th scope="row">{s.currency}</th>
                {AGEING_BUCKETS.map((b) => (
                  <td class="is-num">
                    {formatMoney(s[b].amountMinor, s.currency)}
                    <span class="kz-rt__sub">{s[b].count} inv.</span>
                  </td>
                ))}
                <td class="is-num is-strong">{formatMoney(s.totalMinor, s.currency)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Pane>

    <div class="kz-agrid kz-agrid--2">
      <Pane title="Quotation conversion" id="conv-h">
        {canExport ? (
          <a slot="actions" class="kz-apane__link" href={csv('conversion')}>
            Export CSV
          </a>
        ) : null}
        <DetailList items={conversion} rows />
        {d.conversion.acceptedValue.length ? (
          <p class="kz-rnote">
            Accepted value: {d.conversion.acceptedValue.map((v) => formatMoney(v.amountMinor, v.currency)).join(' · ')}
          </p>
        ) : null}
        <p class="kz-rnote">Quotations first sent in this period; the rate is accepted ÷ sent.</p>
      </Pane>
      <Pane title="Expenses by category" id="exp-h" flush>
        {canExport ? (
          <a slot="actions" class="kz-apane__link" href={csv('expenses')}>
            Export CSV
          </a>
        ) : null}
        <p class="kz-rnote kz-apad">Expense records. This is not a statutory accounting system.</p>
        <div class="kz-rscroll is-tall" tabindex="0" role="region" aria-label="Scrollable table">
          <table class="kz-rt">
            <thead>
              <tr>
                <th scope="col">Category</th>
                <th scope="col" class="is-num">
                  Amount
                </th>
              </tr>
            </thead>
            <tbody>
              {d.expenses.length === 0 ? (
                <tr>
                  <td colspan="2" class="is-none">
                    No expenses in this period.
                  </td>
                </tr>
              ) : null}
              {d.expenses.map((e) => (
                <tr>
                  <td>{e.category}</td>
                  <td class="is-num">{formatMoney(e.amount, e.currency)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Pane>
    </div>
  </div>
</AdminLayout>
