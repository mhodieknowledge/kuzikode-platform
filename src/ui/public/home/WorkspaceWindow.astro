---
/**
 * The home hero object (BRIEF B.0e, DESIGN_DIRECTION §3): the client workspace as a layered composition at four elevations:
 * (1) the night window with the workspace dock, (2) the project with its milestone strip and approved quotation, (3) the weekly
 * update note lifted off the window, (4) the invoice with local payment methods over its edge. Every element depicts a real
 * workspace feature; the project and amounts are fictional and the composition is one labelled illustration.
 */
const steps = [
  { label: 'Plan', state: 'done' },
  { label: 'Design', state: 'done' },
  { label: 'Build', state: 'now' },
  { label: 'Launch', state: 'next' },
] as const;
const dock = [
  { label: 'Overview', n: '' },
  { label: 'Projects', n: '1' },
  { label: 'Quotations', n: '' },
  { label: 'Invoices', n: '1' },
  { label: 'Support', n: '' },
];
const methods = ['EcoCash', 'OneMoney', 'InnBucks', 'Card'];
---

<div
  class="kz-scene"
  role="img"
  aria-label="Illustration of the Kuzikode client workspace: a website project on its build milestone with an approved quotation, this week's update from the team and an invoice that can be paid with EcoCash, OneMoney, InnBucks or card."
>
  <div class="kz-win" aria-hidden="true">
    <div class="kz-win__top">
      <b>Client workspace</b><span class="kz-win__status">Project on track</span>
    </div>
    <div class="kz-win__dock">
      {
        dock.map((d) => (
          <span class:list={[d.label === 'Projects' && 'is-on']}>
            {d.label}
            {d.n ? <i>{d.n}</i> : null}
          </span>
        ))
      }
      <span class="kz-win__dockfoot">No open support requests</span>
    </div>
    <div class="kz-win__main">
      <div class="kz-win__head">
        <span class="kz-win__title">Company website</span><span>Milestone 3 of 4</span>
      </div>
      <ol class="kz-strip">
        {steps.map((s) => <li class={`is-${s.state}`}>{s.label}</li>)}
      </ol>
      <div class="kz-win__row">
        <div class="kz-wcard">
          <small>Quotation approved</small><span class="kz-wcard__amt">$750</span><small>Business Website</small>
        </div>
        <div class="kz-wcard kz-wcard--files">
          <small>Deliverables</small><span>Sitemap.pdf</span><span>Page designs v2</span>
        </div>
      </div>
      <ul class="kz-win__log">
        <li><span>Fri</span>Invoice for milestone 2 issued</li>
        <li><span>Wed</span>Page designs approved</li>
      </ul>
    </div>
  </div>
  <div class="kz-note" aria-hidden="true">
    <small>Weekly update, Monday</small>
    <b>Pages and the content editor are live on staging.</b>
    <span>Review link sent. Launch training booked.</span>
  </div>
  <div class="kz-paycard" aria-hidden="true">
    <small>Invoice, due in 5 days</small>
    <span class="kz-paycard__amt">$250.00</span>
    <div class="kz-paycard__methods">{methods.map((m) => <span>{m}</span>)}</div>
  </div>
</div>
