---
/** Careers (R6.2): job postings with status, closing date and applicant counts, plus general applications. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Button from '../../../ui/primitives/Button.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { employmentTypeLabel, listPostingsAdmin } from '../../../server/modules/careers';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'careers.view' });
if (page instanceof Response) return page;
const { postings, general } = await listPostingsAdmin(ctx);
const canManage = page.auth.permissions.has('careers.manage');
const STATUS: Record<string, { label: string; tone: 'neutral' | 'ok' | 'warn' }> = {
  draft: { label: 'Draft', tone: 'neutral' },
  open: { label: 'Open', tone: 'ok' },
  closed: { label: 'Closed', tone: 'warn' },
  archived: { label: 'Archived', tone: 'neutral' },
};
const scheduled = (p: (typeof postings)[number]) =>
  p.status === 'open' && p.opensAt && p.opensAt > ctx.now().toISOString();
const count = (n: number, fresh: number) => `${n}${fresh ? ` (${fresh} new)` : ''}`;
---

<AdminLayout title="Careers" page={page}>
  <PageHead title="Careers" meta="Job postings and applicants. Applicant data is deleted after the retention period.">
    <Fragment slot="actions">
      <Button href="/admin/careers/applicants?status=active&view=board" variant="secondary">
        All applicants
      </Button>
      {canManage ? (
        <Button href="/admin/careers/templates" variant="secondary">
          Email templates
        </Button>
      ) : null}
      {canManage ? (
        <Button href="/admin/careers/new" lead="add">
          New posting
        </Button>
      ) : null}
    </Fragment>
  </PageHead>
  <DataTable
    caption="Job postings"
    count={postings.length + 1}
    columns={[{ label: 'Posting' }, { label: 'Status' }, { label: 'Closes' }, { label: 'Applicants', num: true }]}
  >
    {postings.map((p) => (
      <tr>
        <Cell
          m="main"
          href={`/admin/careers/${p.id}`}
          title={p.title}
          sub={`${p.department} · ${employmentTypeLabel(p.employmentType)} · ${p.location}`}
          subText
        />
        <Cell m="status">
          <StatusPill tone={scheduled(p) ? 'warn' : (STATUS[p.status]?.tone ?? 'neutral')}>
            {scheduled(p) ? 'Scheduled' : (STATUS[p.status]?.label ?? p.status)}
          </StatusPill>
        </Cell>
        <Cell tone="mute">{p.closesAt ? formatLongDate(p.closesAt.slice(0, 10)) : '—'}</Cell>
        <Cell m="amount" num>
          <a class="kz-wsr__tap" href={`/admin/careers/applicants?posting=${p.id}&view=board`}>
            {count(p.applicants, p.fresh)}
            <span class="sr-only"> applicants for {p.title}</span>
          </a>
        </Cell>
      </tr>
    ))}
    <tr>
      <Cell m="main" title={'General applications ("Send us your CV")'} subText />
      <Cell m="status" tone="mute">
        —
      </Cell>
      <Cell tone="mute">—</Cell>
      <Cell m="amount" num>
        <a class="kz-wsr__tap" href="/admin/careers/applicants?posting=general">
          {count(general.applicants, general.fresh)}
          <span class="sr-only"> general applicants</span>
        </a>
      </Cell>
    </tr>
  </DataTable>
</AdminLayout>
