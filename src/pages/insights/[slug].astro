---
/**
 * Article (R4.7, rebuilt from scratch). Spec (RESPONSIVE_DESIGN_SPEC "Insights"): a text-first head (breadcrumb, title, excerpt,
 * byline) in a 68ch measure; the cover drawn in the category hue (or the post's photo) across the reading width; the body at
 * 68ch with an "On this page" index from the article's own h2s: a sticky side index on desktop, a disclosure above the body on
 * phones. Tags and share close the article (the side column's foot on desktop). Related articles as ledger rows with drawings
 * (a swipe track on phones when there are two or more).
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import Icon from '../../ui/icons/Icon.astro';
import CoverArt from '../../ui/illustrations/CoverArt.astro';
import { categoryHue, coverMotif, withHeadingIds } from '../../ui/public/insights/lib';
import { articleLd, breadcrumbLd, getPost, listPostCategories, relatedPosts } from '../../server/modules/cms';
import { formatLongDate } from '../../shared/service-display';

const { ctx } = Astro.locals;
const post = await getPost(ctx, Astro.params.slug ?? '');
if (!post) return new Response(null, { status: 404, statusText: 'Not found' });
const [related, categories] = await Promise.all([relatedPosts(ctx, post), listPostCategories(ctx)]);
const slugs = categories.map((c) => c.slug);
const { html, toc } = withHeadingIds(post.body);
const url = new URL(`/insights/${post.slug}`, ctx.config.siteUrl).toString();
const share = [
  ['LinkedIn', `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`],
  ['X', `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(post.title)}`],
  ['Facebook', `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`],
  ['WhatsApp', `https://wa.me/?text=${encodeURIComponent(`${post.title} ${url}`)}`],
] as const;
const ld = [
  articleLd(ctx, post),
  breadcrumbLd(ctx, [
    { name: 'Insights', path: '/insights' },
    { name: post.title, path: `/insights/${post.slug}` },
  ]),
];
---

<PublicLayout
  structuredData={ld}
  title={post.seoTitle ?? `${post.title} · Kuzikode Insights`}
  description={post.seoDescription ?? post.excerpt}
  ogType="article"
  headerTone="bone"
  footerLead={{
    title: 'Want help with this?',
    body: 'Tell us what you are working on and we will reply within one business day.',
  }}
>
  <link slot="head" rel="alternate" type="application/rss+xml" title="Kuzikode Insights" href="/insights/rss.xml" />
  <article class:list={['kz-art', categoryHue(post.category?.slug, slugs)]} aria-labelledby="post-title">
    <header class="kz-art__head container-wide">
      <div class="kz-art__headtext">
        <nav aria-label="Breadcrumb" class="kz-crumbs" data-enter>
          <ol role="list">
            <li>
              <a href="/insights">Insights</a>
            </li>
            {post.category ? (
              <li>
                <a href={`/insights/category/${post.category.slug}`}>
                  <span class="kz-icat__sq" aria-hidden="true" />
                  {post.category.name}
                </a>
              </li>
            ) : null}
          </ol>
        </nav>
        <h1 id="post-title" class="kz-art__title" data-enter>
          {post.title}
        </h1>
        <p class="kz-art__ex" data-enter="2">
          {post.excerpt}
        </p>
        <p class="kz-art__by" data-enter="2">
          By <b>{post.author}</b>
          <span aria-hidden="true">·</span>
          <time datetime={post.publishedAt}>{formatLongDate(post.publishedAt)}</time>
          <span aria-hidden="true">·</span>
          {post.readingMinutes} min read
        </p>
      </div>
      <figure class="kz-art__cover" data-enter="3">
        {post.cover ? (
          <img
            src={post.cover.src}
            alt={post.cover.alt}
            width={post.cover.width ?? 1600}
            height={post.cover.height ?? 900}
            loading="eager"
            decoding="async"
          />
        ) : (
          <CoverArt motif={coverMotif(post.category?.slug)} />
        )}
      </figure>
    </header>

    <div class="container-wide">
      <div class:list={['kz-art__grid', toc.length < 2 && 'no-toc']}>
        {toc.length >= 2 ? (
          <nav class="kz-art__toc" aria-label="On this page">
            <details data-art-toc>
              <summary>
                <Icon name="list-checks" size={16} />
                On this page
                <Icon name="chevron-down" size={16} class="kz-art__toc-chev" />
              </summary>
              <ol role="list">
                {toc.map((t, i) => (
                  <li>
                    <a href={`#${t.id}`}>
                      <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                      {t.text}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        ) : null}

        <div class="kz-art__body kz-read" set:html={html} />

        <footer class="kz-art__side">
          {post.tags.length > 0 ? (
            <div>
              <p class="kz-art__side-h">Tags</p>
              <ul class="kz-art__tags" role="list" aria-label="Tags">
                {post.tags.map((t) => (
                  <li>
                    <a href={`/insights/tag/${t.slug}`}>{t.name}</a>
                  </li>
                ))}
              </ul>
            </div>
          ) : null}
          <div>
            <p class="kz-art__side-h">Share this article</p>
            <ul class="kz-art__share" role="list">
              {share.map(([name, href]) => (
                <li>
                  <a href={href} target="_blank" rel="noopener noreferrer">
                    {name}
                    <Icon name="arrow-up-right" size={16} />
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </footer>
      </div>
    </div>
  </article>

  {related.length > 0 ? (
    <section class="kz-sec kz-sec--inset kz-irel" aria-labelledby="related-title">
      <div class="container-wide">
        <div class="kz-irel__head">
          <h2 id="related-title" class="kz-h2">
            Related articles
          </h2>
          <a class="kz-link" href="/insights">
            All insights
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
        <ul
          class:list={['kz-irel__list', related.length >= 2 && 'kz-track']}
          role="list"
          data-kz-track={related.length >= 2 ? '' : undefined}
        >
          {related.map((p) => (
            <li class={categoryHue(p.category?.slug, slugs)}>
              <article class="kz-irel__item" aria-labelledby={`r-${p.slug}`}>
                <span class="kz-irel__media" aria-hidden="true">
                  {p.cover ? (
                    <img src={p.cover.src} alt="" width="480" height="300" loading="lazy" decoding="async" />
                  ) : (
                    <CoverArt motif={coverMotif(p.category?.slug)} />
                  )}
                </span>
                {p.category ? (
                  <p class="kz-icat">
                    <span class="kz-icat__sq" aria-hidden="true" />
                    {p.category.name}
                  </p>
                ) : null}
                <h3 id={`r-${p.slug}`} class="kz-irel__title">
                  <a href={`/insights/${p.slug}`}>{p.title}</a>
                </h3>
                <p class="kz-imeta">
                  <time datetime={p.publishedAt}>{formatLongDate(p.publishedAt)}</time>
                  <span aria-hidden="true">·</span>
                  {p.readingMinutes} min read
                </p>
              </article>
            </li>
          ))}
        </ul>
        {related.length >= 2 ? (
          <div class="kz-track__dots kz-irel__dots" data-kz-track-dots aria-hidden="true">
            {related.map((_, i) => (
              <i class:list={[i === 0 && 'is-on']} />
            ))}
          </div>
        ) : null}
      </div>
    </section>
  ) : null}
</PublicLayout>

<script>
  // Desktop shows the "On this page" index open beside the article; phones keep it as a closed disclosure. Without JS it is a
  // disclosure everywhere.
  const toc = document.querySelector<HTMLDetailsElement>('[data-art-toc]');
  if (toc) {
    const mq = window.matchMedia('(min-width: 1024px)');
    const sync = () => {
      toc.open = mq.matches;
    };
    sync();
    mq.addEventListener('change', sync);
    // Mark the section being read.
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const heads = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((h): h is HTMLElement => h !== null);
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          for (const a of links) a.classList.toggle('is-on', a.hash === `#${e.target.id}`);
        }
      },
      { rootMargin: '-96px 0px -60% 0px' },
    );
    for (const h of heads) io.observe(h);
  }
</script>
