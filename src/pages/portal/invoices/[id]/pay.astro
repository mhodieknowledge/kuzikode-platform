---
/**
 * Portal checkout for one invoice (docs/06 §3b): the same Checkout as /pay/[invoiceToken], within portal scope. R5.3: the workspace
 * back link above it; the checkout itself is the rebuilt R4.8 one.
 */
import PortalLayout from '../../../../layouts/PortalLayout.astro';
import CheckoutSummary from '../../../../ui/public/checkout/CheckoutSummary.astro';
import { Checkout } from '../../../../ui/public/checkout/Checkout';
import Icon from '../../../../ui/icons/Icon.astro';
import { loadPortalPage } from '../../../../server/lib/portal-page';
import { portalInvoiceId } from '../../../../server/modules/invoices';
import { checkoutView } from '../../../../server/modules/payments';
import { AppError } from '../../../../server/lib/errors';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request, { area: 'finance' });
if (page instanceof Response) return page;
let invoiceId: string;
try {
  invoiceId = await portalInvoiceId(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND') return new Response(null, { status: 404 });
  throw err;
}
const view = await checkoutView(ctx, invoiceId, { userId: ctx.actor.userId });
const id = encodeURIComponent(invoiceId);
---

<PortalLayout title={`Pay ${view.invoice.number}`} page={page} active="invoices">
  <nav class="kz-fdoc__crumb" aria-label="Breadcrumb">
    <a class="kz-wshead__back" href={`/portal/invoices/${id}`}>
      <Icon name="arrow-left" size={16} />
      Invoice {view.invoice.number}
    </a>
  </nav>
  <div class="kz-co kz-co--portal">
    <CheckoutSummary view={view} />
    <div class="kz-co__pay">
      <Checkout
        client:load
        mode="portal"
        currency={view.invoice.currency}
        minorDigits={view.invoice.minorDigits}
        amountDueMinor={view.invoice.amountDueMinor}
        invoiceNumber={view.invoice.number}
        methods={view.methods}
        bankTransfer={view.bankTransfer}
        phone={view.phone}
        cards={view.cards}
        testMode={view.testMode}
        endpoints={{
          pay: `/api/v1/portal/invoices/${id}/pay`,
          bankNotice: `/api/v1/portal/invoices/${id}/bank-transfer-notice`,
        }}
        backHref={`/portal/invoices/${id}`}
      />
    </div>
  </div>
</PortalLayout>
