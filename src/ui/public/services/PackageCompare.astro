---
/**
 * Package comparison table (R9.2, REFINEMENTS §2): every package of the division is a column, side by side (no selector). Rows are the
 * packages' comparison features (union of labels, in CMS order): included ✓, not included –, or the package's own text. The feature
 * column is sticky (pinned while the table scrolls sideways on phones); the scroll region is keyboard-focusable and labelled. The head
 * repeats name, "Most popular" badge and price; the foot carries "Get a quote" per package (contact form, package preselected).
 * Data only from the pricing catalogue (`packagePrice`, features); nothing is computed or rounded here.
 */
import Icon from '../../icons/Icon.astro';
import type { PublicPackage } from '../../../server/modules/cms';
import { packagePrice, packageQuoteHref } from '../../../shared/service-display';

interface Props {
  packages: PublicPackage[];
  caption: string;
  id: string;
}
const { packages, caption, id } = Astro.props;
const labels: string[] = [];
for (const p of packages) for (const f of p.features) if (!labels.includes(f.label)) labels.push(f.label);
const cell = (p: PublicPackage, label: string) => p.features.find((f) => f.label === label) ?? null;
---

<div class="kz-cmp" id={id} style={`--cols:${packages.length}`}>
  <div class="kz-cmp__scroll" role="region" aria-label={`${caption} (scrolls sideways on small screens)`} tabindex="0">
    <table class="kz-cmp__table" id={`${id}-table`}>
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr>
          <th scope="col" class="kz-cmp__corner"><span class="sr-only">Feature</span></th>
          {
            packages.map((p) => {
              const price = packagePrice(p);
              return (
                <th scope="col" class:list={['kz-cmp__head', p.mostPopular && 'is-rec']} data-package={p.slug}>
                  {p.mostPopular ? <span class="kz-cmp__rec">Most popular</span> : null}
                  <span class="kz-cmp__name">{p.name}</span>
                  <span class="kz-cmp__price" data-price>
                    {price.prefix ? <small>{price.prefix} </small> : null}
                    <b class:list={[!price.hasPrice && 'is-quote']}>{price.amount}</b>
                    {price.suffix ? <small> {price.suffix}</small> : null}
                  </span>
                  {price.annual ? <span class="kz-cmp__note">{price.annual}</span> : null}
                  {p.minQuantity > 1 ? <span class="kz-cmp__note">Minimum {p.minQuantity}</span> : null}
                </th>
              );
            })
          }
        </tr>
      </thead>
      <tbody>
        {
          labels.map((label) => (
            <tr>
              <th scope="row">{label}</th>
              {packages.map((p) => {
                const f = cell(p, label);
                return (
                  <td class:list={[p.mostPopular && 'is-rec']}>
                    {!f || f.value === 'not_included' ? (
                      <span class="kz-cmp__no">
                        <Icon name="remove" size={16} />
                        <span class="sr-only">Not included</span>
                      </span>
                    ) : f.value === 'included' ? (
                      <span class="kz-cmp__yes">
                        <Icon name="check" size={16} />
                        <span class="sr-only">Included</span>
                      </span>
                    ) : (
                      <span class="kz-cmp__text">{f.text}</span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
      <tfoot>
        <tr>
          <th scope="row" class="kz-cmp__corner"><span class="sr-only">Get a quote</span></th>
          {
            packages.map((p) => (
              <td class:list={[p.mostPopular && 'is-rec']}>
                {p.status === 'coming_soon' ? (
                  <span class="kz-cmp__soon">Coming soon</span>
                ) : (
                  <a
                    class:list={['kz-btn kz-btn--block', p.mostPopular ? 'kz-btn--primary' : 'kz-btn--secondary']}
                    href={packageQuoteHref(p)}
                  >
                    <span>Get a quote</span>
                    <span class="sr-only">: {p.name}</span>
                  </a>
                )}
              </td>
            ))
          }
        </tr>
      </tfoot>
    </table>
  </div>
</div>
