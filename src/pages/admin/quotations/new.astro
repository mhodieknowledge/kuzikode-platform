---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import Button from '../../../ui/primitives/Button.astro';
import { QuotationEditor } from '../../../ui/admin/quotations/QuotationEditor';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { getSettings, settingText } from '../../../server/modules/cms';
import { editorProps } from '../../../server/modules/quotations';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'quotations.create' });
if (page instanceof Response) return page;
const [props, settings] = await Promise.all([editorProps(ctx), getSettings(ctx)]);
const params = Astro.url.searchParams;
const clientId = params.get('clientId') ?? '';
const client = props.clients.find((c) => c.id === clientId);
const leadId = /^led_[A-Za-z0-9_]+$/.test(params.get('leadId') ?? '') ? params.get('leadId') : null;
const initial = {
  clientId: client?.id ?? '',
  contactId: null,
  leadId,
  enquiryId: null,
  title: '',
  introHtml: '',
  currency: client?.currency ?? props.currencies[0]?.code ?? 'USD',
  validUntil: null,
  paymentTerms: null,
  notes: null,
  terms: settingText(settings, 'quotation.default_terms_text') ?? null,
  discountType: 'none' as const,
  discountValue: 0,
  lines: [],
};
---

<AdminLayout title="New quotation" page={page}>
  <PageHead title="New quotation" crumbs={[{ label: 'Quotations', href: '/admin/quotations' }, { label: 'New' }]} />
  {props.clients.length === 0 ? (
    <Pane title="Add a client first" class="kz-anarrow">
      <p class="kz-adlg__desc">Quotations are made for a client record.</p>
      <Button slot="actions" href="/admin/clients/new" size="sm" lead="add">
        New client
      </Button>
    </Pane>
  ) : (
    <QuotationEditor client:load initial={initial} {...props} />
  )}
</AdminLayout>
