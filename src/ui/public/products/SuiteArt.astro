---
/**
 * Business Suite drawing (R4.7, BRIEF B.4a/B.7): replaces the old 3D device render (navy and royal blue, banned by B.0b) with a
 * Route drawing of a workspace fragment, kept modest. An app window with a module rail; two modules drawn solid (a sales slip
 * and a stock-level card), the rest of the window still a dashed outline with a pencil: the product is being built. The pencil
 * tip is the single lit detail (`.i-move`). No figures, names or screens that claim features exist. Accent: umber (business software).
 * Decorative (aria-hidden); the panel's text says what the product is.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={['kz-ill kz-ill--scene kz-sart', className].filter(Boolean).join(' ')}
  viewBox="0 0 360 240"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
  data-ill="business-suite"
>
  <rect class="i-ground" x="0" y="0" width="360" height="240" rx="10"></rect>
  <path class="i-road" d="M20 222H340"></path>

  {/* Window frame and title bar */}
  <rect class="i-paper" x="28" y="26" width="304" height="182" rx="9"></rect>
  <path class="i-ink" d="M28 48H332"></path>
  <rect class="i-soft" x="40" y="33" width="44" height="8" rx="3"></rect>

  {/* Module rail: two modules exist, three are still outlines */}
  <path class="i-line" d="M76 48V208"></path>
  <rect class="i-acc" x="44" y="62" width="18" height="18" rx="4"></rect>
  <rect class="i-tint" x="44" y="90" width="18" height="18" rx="4"></rect>
  <rect class="i-line" x="44" y="118" width="18" height="18" rx="4" stroke-dasharray="4 4"></rect>
  <rect class="i-line" x="44" y="146" width="18" height="18" rx="4" stroke-dasharray="4 4"></rect>
  <rect class="i-line" x="44" y="174" width="18" height="18" rx="4" stroke-dasharray="4 4"></rect>

  {/* Sales slip */}
  <path class="i-paper" d="M92 62H170V150L163 145L156 150L149 145L142 150L135 145L128 150L121 145L114 150L107 145L100 150L92 145Z"
  ></path>
  <rect class="i-soft" x="102" y="72" width="40" height="6" rx="3"></rect>
  <path class="i-line-s" d="M102 90H160M102 102H160M102 114H160"></path>
  <rect class="i-tint-f" x="102" y="94" width="30" height="5" rx="2"></rect>
  <rect class="i-soft" x="102" y="106" width="22" height="5" rx="2"></rect>
  <path class="i-ink" d="M102 128H160"></path>
  <rect class="i-solid" x="136" y="133" width="24" height="6" rx="2"></rect>

  {/* Stock-level card */}
  <rect class="i-paper" x="182" y="62" width="136" height="62" rx="6"></rect>
  <rect class="i-soft" x="192" y="72" width="38" height="6" rx="3"></rect>
  <rect class="i-tint" x="192" y="88" width="104" height="8" rx="3"></rect>
  <rect class="i-acc" x="192" y="88" width="66" height="8" rx="3"></rect>
  <rect class="i-tint" x="192" y="104" width="104" height="8" rx="3"></rect>
  <rect class="i-acc" x="192" y="104" width="30" height="8" rx="3"></rect>

  {/* The rest is still being drawn */}
  <rect class="i-line" x="182" y="134" width="136" height="60" rx="6" stroke-dasharray="6 6"></rect>
  <path class="i-line-s" d="M194 152H262M194 166H244" stroke-dasharray="4 6"></path>
  <path class="i-line" d="M92 162H170M92 176H150" stroke-dasharray="4 6"></path>
  <g class="i-move">
    <path class="i-paper" d="M286 182L304 150L314 156L296 188L284 192Z"></path>
    <path class="i-ink" d="M300 157L310 163"></path>
    <circle class="i-lit" cx="285" cy="190" r="3.5"></circle>
  </g>
</svg>
