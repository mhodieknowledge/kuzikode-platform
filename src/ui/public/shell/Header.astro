---
/**
 * Public header (docs/redesign/RESPONSIVE_DESIGN_SPEC.md §1).
 * R3.1 (Route structure, Zimbabwe earth palette). ≥ 1280 px: wordmark · main nav with a sliding indicator · Services = the
 * division index mega-panel (numerals in division hues, real "from" prices, a lit frame) · About = a compact panel · search ·
 * Client workspace · Get a quote. Below: wordmark · "Get a quote" (steps back while the hero's own is on screen) · menu button
 * opening a full-height sheet. No wizard links (BRIEF B.0c). Behaviour: header.ts.
 */
import Logo from '../../brand/Logo.astro';
import Icon from '../../icons/Icon.astro';
import { divisionIcon } from '../../icons/registry';
import type { SiteNavigation } from '../../../server/modules/cms';
import { divisionShortName, type FromPrice } from '../../../shared/directory';

export interface DirectoryDivision {
  slug: string;
  name: string;
  summary: string | null;
  icon: string | null;
  href: string;
  services: { name: string }[];
  from: FromPrice | null;
}

interface Props {
  nav: SiteNavigation;
  divisions: DirectoryDivision[];
  tone?: 'night' | 'bone';
}
const { nav, divisions, tone = 'bone' } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const servicesActive = path.startsWith('/services') || path.startsWith('/industries');
const aboutActive = ['/about', '/products', '/faq', '/how-we-work', ...(nav.careersInNav ? [] : ['/careers'])].some((p) =>
  path.startsWith(p),
);
const top = [
  { label: 'Pricing', href: '/pricing' },
  { label: 'Our Work', href: '/work' },
  { label: 'Insights', href: '/insights' },
  ...(nav.careersInNav ? [{ label: 'Careers', href: '/careers' }] : []),
  { label: 'Contact', href: '/contact' },
];
const floor = (i: number) => String(i + 1).padStart(2, '0');
const contact = nav.footer.contact;
const mobileLinks = [
  { label: 'Pricing', href: '/pricing' },
  { label: 'Our Work', href: '/work' },
  { label: 'About Kuzikode', href: '/about' },
  ...nav.servicesExtra.map((l) => ({ label: l.label, href: l.href })),
  { label: 'Insights', href: '/insights' },
  { label: 'Products', href: '/products' },
  { label: 'Careers', href: '/careers' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Contact', href: '/contact' },
].filter((l, i, all) => all.findIndex((x) => x.href === l.href) === i);
---

<header
  class:list={['kz-header', tone === 'night' ? 'kz-header--night on-night' : 'kz-header--bone']}
  data-site-header
  data-tone={tone}
>
  <div class="container-wide flex h-[var(--header-h)] items-center gap-4">
    <Logo height={26} class="kz-header__logo mr-auto xl:mr-6" />

    <nav aria-label="Main" class="kz-nav hidden xl:block" data-nav>
      <ul class="flex items-center">
        <li data-menu>
          <button
            type="button"
            class="kz-nav__item"
            aria-expanded="false"
            aria-controls="menu-about"
            aria-current={aboutActive ? 'true' : undefined}
            data-menu-button
          >
            About <Icon name="chevron-down" size={16} class="kz-nav__chev" />
          </button>
        </li>
        <li data-menu>
          <button
            type="button"
            class="kz-nav__item"
            aria-expanded="false"
            aria-controls="menu-services"
            aria-current={servicesActive ? 'true' : undefined}
            data-menu-button
          >
            Services <Icon name="chevron-down" size={16} class="kz-nav__chev" />
          </button>
        </li>
        {
          top.map((l) => (
            <li>
              <a href={l.href} class="kz-nav__item" aria-current={isActive(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="kz-nav__bar" aria-hidden="true"></span>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/search" class="kz-btn kz-btn--quiet kz-btn--icon kz-header__icon hidden xl:inline-flex" aria-label="Search">
        <Icon name="search" />
      </a>
      <a href="/portal/login" class="kz-btn kz-btn--quiet kz-btn--sm hidden xl:inline-flex">Client workspace</a>
      <a href="/contact" class="kz-btn kz-btn--primary kz-btn--sm kz-header__cta"><span>Get a quote</span></a>
      <button
        type="button"
        class="kz-btn kz-btn--secondary kz-btn--icon kz-header__menu xl:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-menu"
        data-kz-sheet-open="site-menu"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <!-- Services: the directory board (desktop) -->
  <div id="menu-services" class="kz-mega on-night" hidden data-menu-panel>
    <div class="container-wide grid grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-10 py-8">
      <div>
        <ul class="kz-dir" role="list">
          {
            divisions.map((d, i) => (
              <li class={`kz-div-${(i % 6) + 1}`}>
                <a href={d.href} class="kz-dir__row" data-lit-target={`lit-${d.slug}`}>
                  <span class="kz-dir__floor">{floor(i)}</span>
                  <span class="kz-dir__name">{divisionShortName(d.slug, d.name)}</span>
                  {d.from ? (
                    <span class="kz-dir__from">
                      from <b class="tnum text-on-night">{d.from.amount}</b>
                      {d.from.suffix !== 'one-off' ? <span> {d.from.suffix}</span> : null}
                    </span>
                  ) : null}
                  <Icon name="arrow-right" size={16} class="kz-dir__arrow" />
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-2" role="list">
          {
            nav.servicesExtra.map((l) => (
              <li>
                <a href={l.href} class="kz-link">
                  {l.label} <Icon name="arrow-right" size={16} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="kz-lit" aria-hidden="true">
        {
          divisions.map((d, i) => (
            <div id={`lit-${d.slug}`} class="kz-lit__frame" data-lit hidden={i !== 0}>
              <div class={`kz-lit__head kz-div-${(i % 6) + 1}`}>
                <Icon name={divisionIcon(d.slug, d.icon)} size={24} />
                <p class="text-h3 font-bold text-on-night">{d.name}</p>
              </div>
              {d.summary ? <p class="mt-2 text-small text-on-night-2">{d.summary}</p> : null}
              <ul class="kz-lit__list">
                {d.services.slice(0, 6).map((s) => (
                  <li>{s.name}</li>
                ))}
              </ul>
              {d.from ? (
                <p class="mt-6 text-small text-on-night-3">
                  Packages from <b class="tnum text-on-night">{d.from.amount}</b> {d.from.suffix}
                </p>
              ) : null}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- About (desktop) -->
  <div id="menu-about" class="kz-pop" hidden data-menu-panel>
    <ul role="list">
      {
        nav.about.map((l) => (
          <li>
            <a href={l.href} class="kz-pop__link" aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
              <Icon name="arrow-right" size={16} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<!-- Phones and tablets: the directory as a full-height sheet -->
<dialog id="site-menu" class="kz-sheet kz-sheet--top kz-menu" aria-label="Menu">
  <div class="kz-sheet__panel on-night">
    <div class="container-wide flex h-[var(--header-h)] flex-none items-center justify-between gap-4">
      <Logo height={26} />
      <button type="button" class="kz-btn kz-btn--secondary kz-btn--icon" data-kz-sheet-close aria-label="Close menu">
        <Icon name="close" />
      </button>
    </div>
    <div class="kz-sheet__body container-wide">
      <form action="/search" method="get" role="search" class="relative">
        <label for="mobile-search" class="sr-only">Search the site</label>
        <Icon name="search" class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-on-night-3" />
        <input
          id="mobile-search"
          name="q"
          type="search"
          maxlength="100"
          placeholder="Search services, packages, articles"
          enterkeyhint="search"
          class="kz-menu__search"
        />
      </form>

      <h2 class="kz-menu__h" id="menu-dir-label">What we build</h2>
      <ul class="kz-dir mt-2" role="list" aria-labelledby="menu-dir-label" data-reveal-group>
        {
          divisions.map((d, i) => (
            <li class={`kz-div-${(i % 6) + 1}`}>
              <a href={d.href} class="kz-dir__row">
                <span class="kz-dir__floor">{floor(i)}</span>
                <span class="kz-dir__name">{divisionShortName(d.slug, d.name)}</span>
                {d.from ? (
                  <span class="kz-dir__from">
                    from <b class="tnum text-on-night">{d.from.amount}</b>
                  </span>
                ) : null}
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 sm:gap-x-8" role="list">
        {
          mobileLinks.map((l) => (
            <li>
              <a href={l.href} class="kz-menu__link" aria-current={isActive(l.href) ? 'page' : undefined}>
                {l.label}
                <Icon name="chevron-right" size={20} />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 grid gap-3 sm:grid-cols-2">
        <a href="/contact" class="kz-btn kz-btn--primary kz-btn--lg kz-btn--block"><span>Get a quote</span></a>
        <a href="/portal/login" class="kz-btn kz-btn--secondary kz-btn--lg kz-btn--block">
          <Icon name="account" />
          <span>Client workspace</span>
        </a>
      </div>

      {
        contact.whatsapp || contact.phone || contact.email ? (
          <ul class="mt-8 grid gap-2 pb-4" role="list" aria-label="Contact">
            {contact.whatsapp ? (
              <li>
                <a href={contact.whatsapp} class="kz-channel" target="_blank" rel="noopener noreferrer">
                  <Icon name="whatsapp" /> WhatsApp<span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ) : null}
            {contact.phone ? (
              <li>
                <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="kz-channel">
                  <Icon name="phone" /> {contact.phone}
                </a>
              </li>
            ) : null}
            {contact.email ? (
              <li>
                <a href={`mailto:${contact.email}`} class="kz-channel">
                  <Icon name="email" /> {contact.email}
                </a>
              </li>
            ) : null}
          </ul>
        ) : null
      }
    </div>
  </div>
</dialog>

<script>
  import { initHeader } from './header';
  initHeader();
</script>
