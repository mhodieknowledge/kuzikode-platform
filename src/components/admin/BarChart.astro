---
/**
 * Server-rendered bar chart (no client JS). One bar per month, grouped when there are two series. Geometry uses
 * percentages so labels keep their pixel size at any width. Every month has a full-height hover target with a tooltip,
 * and a table view carries the same numbers (identity is never colour alone: legend for ≥ 2 series).
 */
interface Series {
  label: string;
  values: number[];
  /** CSS colour token, e.g. var(--brand-600). */
  color: string;
}
interface Props {
  id: string;
  title: string;
  months: string[]; // YYYY-MM
  series: Series[];
  format: (v: number) => string;
  /** Short axis tick text (defaults to `format`). */
  tick?: (v: number) => string;
  height?: number;
}
const { id, title, months, series, format, tick = format, height = 200 } = Astro.props;

const monthLabel = (m: string, withYear = false) =>
  new Intl.DateTimeFormat('en-GB', {
    month: 'short',
    ...(withYear ? { year: 'numeric' } : {}),
    timeZone: 'UTC',
  }).format(new Date(`${m}-01T00:00:00Z`));

const max = Math.max(0, ...series.flatMap((s) => s.values));
/** A "nice" axis maximum: 1, 2, 2.5 or 5 × 10^n at or above the data maximum. */
function niceMax(v: number): number {
  if (v <= 0) return 1;
  const p = 10 ** Math.floor(Math.log10(v));
  for (const f of [1, 2, 2.5, 5, 10]) if (f * p >= v) return f * p;
  return 10 * p;
}
const top = niceMax(max);
const ticks = [0, 0.25, 0.5, 0.75, 1].map((f) => f * top);
const PAD_TOP = 18;
const PAD_BOTTOM = 22;
const plotH = height - PAD_TOP - PAD_BOTTOM;
const y = (v: number) => PAD_TOP + plotH - (v / top) * plotH;
const slot = 100 / months.length;
const groupW = slot * 0.62;
const gap = series.length > 1 ? 0.35 : 0; // ≈ 2px surface gap between paired bars
const barW = (groupW - gap * (series.length - 1)) / series.length;
const allZero = max === 0;
---

<figure class="m-0" aria-labelledby={`${id}-title`}>
  <figcaption id={`${id}-title`} class="text-sm font-semibold text-ink-950">
    {title}
  </figcaption>
  {series.length > 1 ? (
    <ul class="mt-2 flex flex-wrap gap-4 text-[13px] text-ink-600" aria-label="Legend">
      {series.map((s) => (
        <li class="inline-flex items-center gap-1.5">
          <span class="inline-block h-2.5 w-2.5 rounded-[2px]" style={`background:${s.color}`} aria-hidden="true" />
          {s.label}
        </li>
      ))}
    </ul>
  ) : null}
  {allZero ? (
    <p class="mt-3 rounded-md border border-dashed border-line px-4 py-6 text-center text-sm text-ink-600">
      Nothing recorded in the last 12 months yet.
    </p>
  ) : (
    <svg
      class="bar-chart mt-3 block w-full overflow-visible"
      height={height}
      role="img"
      aria-label={`${title}. Values are listed in the table below.`}
    >
      {ticks.map((t) => (
        <g>
          <line x1="0" x2="100%" y1={y(t)} y2={y(t)} stroke="var(--line)" stroke-width="1" />
          <text x="0" y={y(t) - 4} class="fill-ink-600 text-[11px] tnum">
            {tick(t)}
          </text>
        </g>
      ))}
      {months.map((m, i) => {
        const x0 = i * slot + (slot - groupW) / 2;
        return (
          <g class="slot">
            {series.map((s, k) => {
              const v = s.values[i] ?? 0;
              const h = Math.max(0, (Math.max(v, 0) / top) * plotH);
              const x = `${x0 + k * (barW + gap)}%`;
              return h > 0 ? (
                <g>
                  <rect x={x} y={y(v)} width={`${barW}%`} height={h} rx="3" fill={s.color} />
                  <rect x={x} y={y(0) - Math.min(3, h)} width={`${barW}%`} height={Math.min(3, h)} fill={s.color} />
                </g>
              ) : null;
            })}
            <text
              x={`${i * slot + slot / 2}%`}
              y={height - 6}
              text-anchor="middle"
              class:list={['fill-ink-600 text-[11px]', i % 2 === 1 && i !== months.length - 1 ? 'minor' : '']}
            >
              {monthLabel(m)}
            </text>
            <rect x={`${i * slot}%`} y={PAD_TOP} width={`${slot}%`} height={plotH} fill="transparent" class="hit">
              <title>
                  {`${monthLabel(m, true)}: ${series.map((s) => `${series.length > 1 ? `${s.label} ` : ''}${format(s.values[i] ?? 0)}`).join(' · ')}`}
                </title>
            </rect>
          </g>
        );
      })}
    </svg>
  )}
  <details class="mt-2 text-[13px] text-ink-600">
    <summary class="cursor-pointer select-none font-medium text-ink-800">Show as table</summary>
    <div class="mt-2 overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr>
            <th scope="col" class="py-1 pr-3 font-semibold">
              Month
            </th>
            {series.map((s) => (
              <th scope="col" class="py-1 pr-3 text-right font-semibold">
                {s.label}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {months.map((m, i) => (
            <tr class="border-t border-line">
              <th scope="row" class="py-1 pr-3 font-normal">
                {monthLabel(m, true)}
              </th>
              {series.map((s) => (
                <td class="tnum py-1 pr-3 text-right">{format(s.values[i] ?? 0)}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .bar-chart .slot:hover rect:not(.hit) {
    opacity: 0.82;
  }
  .bar-chart .hit {
    cursor: default;
  }
  @media (max-width: 639px) {
    .bar-chart .minor {
      display: none;
    }
  }
</style>
