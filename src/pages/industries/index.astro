---
import { ArrowRight } from 'lucide-react';
import PublicLayout from '../../layouts/PublicLayout.astro';
import Icon from '../../components/public/Icon.astro';
import { breadcrumbLd, getPage, listIndustries, sectionOf } from '../../server/modules/cms';

const { ctx } = Astro.locals;
const [page, industries] = await Promise.all([getPage(ctx, 'industries'), listIndustries(ctx)]);
const intro = sectionOf(page, 'intro', 'rich_text');
---

<PublicLayout
  structuredData={[breadcrumbLd(ctx, [{ name: 'Industries', path: '/industries' }])]}
  title={page?.seoTitle ?? 'Industries · Kuzikode Technologies'}
  description={page?.seoDescription ?? undefined}
>
  <section class="bg-canvas py-14 md:py-20" aria-labelledby="industries-title">
    <div class="container-content">
      <p class="text-[13px] font-semibold tracking-wide text-brand-600 uppercase">Industries</p>
      <h1 id="industries-title" class="mt-3 max-w-3xl text-4xl font-bold tracking-display md:text-5xl">
        {intro?.content.title ?? 'Industries'}
      </h1>
      {intro ? <div class="prose-kz mt-4 max-w-2xl text-lg" set:html={intro.content.html} /> : null}
    </div>
  </section>
  <section class="bg-surface py-14 md:py-20" aria-label="Industries we serve">
    <div class="container-content">
      {industries.length === 0 ? (
        <p class="text-ink-600">No industries to show yet.</p>
      ) : (
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {industries.map((i) => (
            <li>
              <a
                href={`/industries/${i.slug}`}
                class="group flex h-full flex-col rounded-lg border border-line p-6 transition-colors hover:border-ink-400"
              >
                <span class="flex h-11 w-11 items-center justify-center rounded-sm bg-brand-50 text-brand-600">
                  <Icon name={i.icon} size={22} />
                </span>
                <h2 class="mt-5 font-sans text-lg font-semibold text-ink-950">{i.name}</h2>
                <p class="mt-2 flex-1 text-[15px] leading-6 text-ink-600">{i.summary}</p>
                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600">
                  Explore solutions<span class="sr-only"> for {i.name}</span>
                  <ArrowRight
                    size={16}
                    aria-hidden="true"
                    className="transition-transform group-hover:translate-x-0.5"
                  />
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</PublicLayout>
