---
import { ArrowRight, Briefcase, MapPin } from 'lucide-react';
import PublicLayout from '../../layouts/PublicLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { breadcrumbLd, getSettings, settingBool, settingText } from '../../server/modules/cms';
import { employmentTypeLabel, listOpenPostings, workplaceLabel } from '../../server/modules/careers';
import { EMPLOYMENT_TYPES, WORKPLACES } from '../../shared/schemas/careers';

const { ctx } = Astro.locals;
const q = Astro.url.searchParams;
const filter = {
  department: q.get('department')?.slice(0, 80) || undefined,
  type: q.get('type')?.slice(0, 20) || undefined,
  workplace: q.get('workplace')?.slice(0, 20) || undefined,
};
const [settings, result] = await Promise.all([getSettings(ctx), listOpenPostings(ctx, filter)]);
const intro = settingText(settings, 'careers.intro');
const general = settingBool(settings, 'careers.general_applications');
const filtered = Boolean(filter.department || filter.type || filter.workplace);
const selectClass =
  'h-10 rounded-sm border border-line bg-surface px-3 text-sm text-ink-950 hover:border-ink-400 focus-visible:border-brand-500 focus-visible:outline-2 focus-visible:outline-brand-500';
---

<PublicLayout
  structuredData={[breadcrumbLd(ctx, [{ name: 'Careers', path: '/careers' }])]}
  title="Careers · Kuzikode Technologies"
  description="Open roles at Kuzikode Technologies and how to apply."
>
  <section class="bg-canvas py-14 md:py-20" aria-labelledby="careers-title">
    <div class="container-content grid items-center gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
      <div class="max-w-2xl">
        <p class="text-[13px] font-semibold tracking-wide text-brand-600 uppercase">Careers</p>
        <h1 id="careers-title" class="mt-3 text-4xl font-bold tracking-display md:text-5xl">
          Work with us
        </h1>
        {intro ? <p class="mt-4 text-lg leading-8 text-ink-600">{intro}</p> : null}
      </div>
      <div class="overflow-hidden rounded-lg">
        <ResponsiveImage
          id="careers-mentoring"
          priority
          sizes="(min-width: 1024px) 560px, 100vw"
          class="aspect-[3/2] h-auto w-full object-cover"
        />
      </div>
    </div>
  </section>
  <section class="bg-surface py-14 md:py-20" aria-labelledby="roles-title">
    <div class="container-content max-w-4xl">
      <h2 id="roles-title" class="text-3xl font-bold tracking-display">
        Open roles
      </h2>
      {result.all.length > 1 ? (
        <form method="get" action="/careers" class="mt-6 flex flex-wrap items-end gap-3" aria-label="Filter roles">
          <label class="flex flex-col gap-1 text-sm font-medium text-ink-950">
            Department
            <select name="department" class={selectClass}>
              <option value="">All</option>
              {result.departments.map((d) => (
                <option value={d} selected={filter.department === d}>
                  {d}
                </option>
              ))}
            </select>
          </label>
          <label class="flex flex-col gap-1 text-sm font-medium text-ink-950">
            Type
            <select name="type" class={selectClass}>
              <option value="">All</option>
              {Object.entries(EMPLOYMENT_TYPES).map(([k, v]) => (
                <option value={k} selected={filter.type === k}>
                  {v}
                </option>
              ))}
            </select>
          </label>
          <label class="flex flex-col gap-1 text-sm font-medium text-ink-950">
            Workplace
            <select name="workplace" class={selectClass}>
              <option value="">All</option>
              {Object.entries(WORKPLACES).map(([k, v]) => (
                <option value={k} selected={filter.workplace === k}>
                  {v}
                </option>
              ))}
            </select>
          </label>
          <button
            type="submit"
            class="inline-flex h-10 items-center rounded-sm border border-line px-4 text-sm font-semibold text-ink-950 hover:border-ink-400"
          >
            Apply filters
          </button>
          {filtered ? (
            <a
              href="/careers"
              class="h-10 content-center text-sm font-semibold text-brand-600 underline underline-offset-2"
            >
              Clear
            </a>
          ) : null}
        </form>
      ) : null}
      {result.all.length === 0 ? (
        <div class="mt-8 rounded-lg border border-line p-8" data-careers-empty>
          <p class="text-lg font-semibold text-ink-950">We're not hiring right now.</p>
          <p class="mt-2 text-ink-600">
            New roles are listed here when they open.
            {general ? (
              <>
                {' '}
                You can still{' '}
                <a href="/careers/apply" class="font-semibold text-brand-600 underline underline-offset-2">
                  send us your CV
                </a>
                .
              </>
            ) : null}
          </p>
        </div>
      ) : result.postings.length === 0 ? (
        <p class="mt-8 text-ink-600" role="status">
          No roles match these filters.{' '}
          <a href="/careers" class="font-semibold text-brand-600 underline underline-offset-2">
            See all roles
          </a>
          .
        </p>
      ) : (
        <ul class="mt-8 flex flex-col gap-4">
          {result.postings.map((p) => (
            <li>
              <a
                href={`/careers/${p.slug}`}
                class="group flex flex-col gap-3 rounded-lg border border-line p-6 hover:border-ink-400 md:flex-row md:items-center md:justify-between"
              >
                <div>
                  <p class="text-[13px] font-medium text-ink-600">{p.department}</p>
                  <h3 class="mt-1 font-sans text-lg font-semibold text-ink-950 group-hover:underline">{p.title}</h3>
                  <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[14px] text-ink-600">
                    <span class="inline-flex items-center gap-1.5">
                      <MapPin size={15} aria-hidden="true" />
                      {p.location} · {workplaceLabel(p.workplace)}
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                      <Briefcase size={15} aria-hidden="true" />
                      {employmentTypeLabel(p.employmentType)}
                    </span>
                  </p>
                </div>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600">
                  View role <ArrowRight size={16} aria-hidden="true" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
      {general && result.all.length > 0 ? (
        <p class="mt-10 text-[15px] text-ink-600">
          Don't see the right role?{' '}
          <a href="/careers/apply" class="font-semibold text-brand-600 underline underline-offset-2">
            Send us your CV
          </a>
          .
        </p>
      ) : null}
    </div>
  </section>
</PublicLayout>
