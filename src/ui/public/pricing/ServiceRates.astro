---
/**
 * Price ledger (R4.3) for categories whose packages are separate products rather than tiers of one product. IMG_5055 / IMG_5066:
 * ruled rows, the whole row is the link (bare arrow, no framed buttons).
 * - grouped (default, "Other services" on the night band): rows grouped under their division, each heading ruled in the division hue.
 * - flat ("Email & domains"): one ledger on paper; each row also carries its terms (annual price, minimum quantity) and a run-on
 *   list of what is included, so nothing the plates would show is lost.
 * Every figure comes from `packagePrice` / the package fields; nothing is computed here.
 */
import Icon from '../../icons/Icon.astro';
import type { PublicPackage } from '../../../server/modules/cms';
import { packagePrice, packageQuoteHref } from '../../../shared/service-display';

interface Props {
  packages: PublicPackage[];
  /** Divisions in catalogue order (position decides the hue). Omit for a flat ledger. */
  divisions?: { slug: string; name: string; n: number }[];
}
const { packages, divisions } = Astro.props;
type Group = { slug: string; name: string | null; n: number; items: PublicPackage[] };
let groups: Group[];
if (divisions) {
  groups = divisions
    .map((d) => ({ ...d, items: packages.filter((p) => p.categorySlug === d.slug) }))
    .filter((g) => g.items.length > 0);
  // Packages whose division is not in the catalogue still show (never drop a published price).
  const known = new Set(divisions.map((d) => d.slug));
  const orphans = packages.filter((p) => !known.has(p.categorySlug));
  if (orphans.length > 0) groups.push({ slug: 'other', name: 'Other', n: 0, items: orphans });
} else groups = [{ slug: 'all', name: null, n: 0, items: packages }];
const plural = (unit: string) => (/(x|s|ch|sh)$/.test(unit) ? `${unit}es` : `${unit}s`);
---

<div class:list={['kz-rates', divisions ? 'kz-rates--grouped' : 'kz-rates--flat']}>
  {
    groups.map((g) => (
      <section
        class:list={['kz-rates__group', g.n > 0 && `kz-div-${((g.n - 1) % 6) + 1}`]}
        aria-labelledby={g.name ? `rates-${g.slug}` : undefined}
        aria-label={g.name ? undefined : 'Packages'}
      >
        {g.name ? (
          <h3 class="kz-rates__div" id={`rates-${g.slug}`}>
            {g.name}
          </h3>
        ) : null}
        <ul class="kz-rates__list" role="list">
          {g.items.map((p) => {
            const price = packagePrice(p);
            const unit = p.priceUnit?.replace(/^per\s+/i, '') ?? 'unit';
            const terms = [
              price.annual,
              p.minQuantity > 1 ? `Minimum ${p.minQuantity} ${plural(unit)}` : null,
              p.deliveryTime ? `Delivery ${p.deliveryTime}` : null,
            ].filter(Boolean);
            const inner = (
              <Fragment>
                <span class="kz-rates__what">
                  <span class="kz-rates__name">{p.name}</span>
                  {p.tagline ? <span class="kz-rates__tag">{p.tagline}</span> : null}
                  {p.features.length > 0 ? (
                    <span class="kz-rates__feats">
                      {p.features.map((f, i) => (
                        <span class:list={[f.value === 'not_included' && 'is-no']}>
                          {f.value === 'not_included' ? <span class="sr-only">Not included: </span> : null}
                          {f.label}
                          {f.value === 'text' ? <b>: {f.text}</b> : null}
                          {i < p.features.length - 1 ? <span class="kz-rates__sep" aria-hidden="true">·</span> : null}
                        </span>
                      ))}
                    </span>
                  ) : null}
                </span>
                <span class="kz-rates__price" data-price>
                  {price.prefix ? <small>{price.prefix} </small> : null}
                  <b class:list={[!price.hasPrice && 'is-quote']}>{price.amount}</b>
                  {price.suffix && price.suffix !== 'one-off' ? <small> {price.suffix}</small> : null}
                  {terms.map((t) => (
                    <span class="kz-rates__term">{t}</span>
                  ))}
                </span>
              </Fragment>
            );
            return (
              <li data-package={p.slug}>
                {p.status === 'coming_soon' ? (
                  <div class="kz-rates__row">
                    {inner}
                    <span class="kz-rates__soon">Coming soon</span>
                  </div>
                ) : (
                  <a class="kz-rates__row" href={packageQuoteHref(p)}>
                    {inner}
                    <span class="kz-rates__go">
                      <span class="sr-only">Request {p.name}</span>
                      <Icon name="arrow-right" size={16} />
                    </span>
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</div>
