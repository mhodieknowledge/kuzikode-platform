---
import type { SectionContent } from '../../../shared/schemas/cms';

interface Props {
  content: SectionContent<'statement'>;
  anchor: string;
}
const { content: c, anchor } = Astro.props;
---

<div class="rounded-lg border border-line bg-surface p-8 md:p-10" aria-labelledby={`${anchor}-title`} role="group">
  <h2 id={`${anchor}-title`} class="text-sm font-semibold tracking-wider text-brand-600 uppercase">{c.title}</h2>
  <p class="mt-4 font-display text-2xl leading-snug font-semibold tracking-display text-ink-950 md:text-[28px]">{c.body}</p>
</div>
