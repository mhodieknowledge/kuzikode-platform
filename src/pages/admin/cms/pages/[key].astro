---
/** One website page (R6.2): publish actions in the head, section drafts as panes, page details and search beside them. */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import { PageMetaForm } from '../../../../ui/admin/cms/PageMetaForm';
import { PublishBar } from '../../../../ui/admin/cms/PublishBar';
import { SectionEditor } from '../../../../ui/admin/cms/SectionEditor';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { AppError } from '../../../../server/lib/errors';
import { getPageAdmin, listMedia } from '../../../../server/modules/cms/admin';
import { pagePath, SECTION_FIELDS, SECTION_TYPE_LABEL } from '../../../../shared/cms-fields';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'cms.manage' });
if (page instanceof Response) return page;
let data;
try {
  data = await getPageAdmin(ctx, Astro.params.key ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const { page: p, sections } = data;
const media = (await listMedia(ctx)).map((m) => ({ id: m.id, file_id: m.file_id, alt_text: m.alt_text }));
const path = pagePath(p.key);
const changed = sections.filter((s) => s.changed).length;
---

<AdminLayout title={`Edit ${p.title}`} page={page}>
  <PageHead title={p.title} crumbs={[{ label: 'Website', href: '/admin/cms' }, { label: p.title }]}>
    <Fragment slot="meta">
      <span class="kz-amono">{path}</span> · {changed} sections with unpublished changes
    </Fragment>
    <PublishBar slot="actions" client:load pageKey={p.key} previewHref={`${path}?preview=1`} liveHref={path} />
  </PageHead>
  <div class="kz-agrid kz-agrid--detail">
    <div class="kz-astack">
      {sections.length === 0 ? <p class="kz-anone">This page has no editable sections.</p> : null}
      {sections.map((s, i) => (
        <SectionEditor
          client:load
          pageKey={p.key}
          sectionKey={s.key}
          typeLabel={SECTION_TYPE_LABEL[s.type] ?? s.type}
          fields={SECTION_FIELDS[s.type] ?? []}
          draft={s.draft}
          visible={s.visible}
          changed={s.changed}
          index={i}
          count={sections.length}
        />
      ))}
    </div>
    <aside>
      <PageMetaForm
        client:load
        pageKey={p.key}
        initial={{
          title: p.title,
          seoTitle: p.seo_title,
          seoDescription: p.seo_description,
          ogImageId: p.og_image_id,
        }}
        media={media}
      />
    </aside>
  </div>
</AdminLayout>
