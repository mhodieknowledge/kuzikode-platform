---
/**
 * Consultation booking (R4.6, rebuilt from scratch). Night band: the offer and what the call covers (numbered) on the left; on
 * the right a paper sheet with either the booking calendar link (when `booking.cal_url` is an https link) or the request form with
 * up to three preferred times. Phones: heading, offer, the three points as a compact numbered list, then the sheet.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import ConsultationForm from '../ui/public/forms/ConsultationForm';
import { breadcrumbLd, getSettings, settingText } from '../server/modules/cms';

const { ctx } = Astro.locals;
const settings = await getSettings(ctx);
const raw = settingText(settings, 'booking.cal_url');
// Only an https link is used; anything else falls back to the request form.
const calUrl = raw && /^https:\/\/[^\s"'<>]+$/.test(raw) ? raw : null;
const after = [
  'We confirm one of your times by email, usually within one business day.',
  'We talk by video or phone for up to 30 minutes.',
  'If you want to go ahead, we follow up with a written quotation.',
];
const points = [
  'A clear picture of what your project involves',
  'Which package or approach fits, and why',
  'What a quotation will cover',
];
---

<PublicLayout
  structuredData={[breadcrumbLd(ctx, [{ name: 'Consultation', path: '/consultation' }])]}
  title="Book a free consultation · Kuzikode Intelligent Technologies"
  description="Book a free 30-minute consultation with Kuzikode Intelligent Technologies to talk through your website, app or system."
  whatsappMessage="Hi Kuzikode, I'd like to book a free consultation."
  headerTone="night"
  footerCta={false}
>
  <section class="kz-consult on-night" aria-labelledby="consult-title">
    <div class="container-wide kz-consult__grid">
      <div class="kz-consult__copy">
        <h1 id="consult-title" class="kz-consult__title" data-enter>
          Book a free <span class="kz-nowrap">30-minute</span> consultation
        </h1>
        <p class="kz-consult__lede" data-enter="2">
          Talk through what you need with us by video or phone. We will ask about your goals, suggest options and
          explain the next steps. There is no charge and no obligation.
        </p>
        <h2 class="kz-consult__h" data-enter="2">
          You leave the call with
        </h2>
        <ol class="kz-consult__points" role="list" data-enter="3">
          {points.map((p, i) => (
            <li>
              <span class="kz-consult__n">{String(i + 1).padStart(2, '0')}</span>
              {p}
            </li>
          ))}
        </ol>
      </div>
      <div class="kz-consult__sheet on-bone" data-enter="3">
        {calUrl ? (
          <div data-booking-link>
            <h2 class="kz-contact__sheet-h">Choose a time</h2>
            <p class="kz-consult__cal">Pick a slot in our online calendar. You will get a confirmation by email.</p>
            <a
              class="kz-btn kz-btn--primary kz-btn--lg kz-btn--block"
              href={calUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Open the booking calendar</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        ) : (
          <>
            <h2 class="kz-contact__sheet-h">Request a time</h2>
            <ConsultationForm client:load siteKey={ctx.config.turnstileSiteKey} />
          </>
        )}
      </div>
      <div class="kz-consult__after">
        <h2 class="kz-consult__h">After you send</h2>
        <ol class="kz-next kz-next--night" role="list">
          {after.map((t, i) => (
            <li>
              <span class="kz-next__mark" aria-hidden="true">
                S{i + 1}
              </span>
              <span>{t}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</PublicLayout>
