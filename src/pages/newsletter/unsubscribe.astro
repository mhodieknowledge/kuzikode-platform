---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { unsubscribe, verifyUnsubscribe } from '../../server/modules/newsletter';
import { isSameOriginPost } from '../../server/lib/same-origin';

const { ctx } = Astro.locals;
let id = (Astro.url.searchParams.get('id') ?? '').slice(0, 60);
let sig = (Astro.url.searchParams.get('sig') ?? '').slice(0, 100);
let done = false;
if (Astro.request.method === 'POST') {
  if (!isSameOriginPost(Astro.request, ctx.config.siteUrl)) return new Response('Forbidden', { status: 403 });
  const form = await Astro.request.formData();
  id = String(form.get('id') ?? '').slice(0, 60);
  sig = String(form.get('sig') ?? '').slice(0, 100);
  done = await unsubscribe(ctx, id, sig);
}
const valid = done || (await verifyUnsubscribe(ctx, id, sig));
Astro.response.headers.set('cache-control', 'private, no-store');
---

<PublicLayout title="Unsubscribe · Kuzikode Technologies" noindex>
  <section class="bg-canvas py-16 md:py-24">
    <div class="container-content max-w-xl">
      {done ? (
        <div role="status">
          <h1 class="text-3xl font-bold tracking-display">You have been unsubscribed</h1>
          <p class="mt-3 text-ink-600">
            You will not receive any more newsletters from us. You can sign up again at any time.
          </p>
        </div>
      ) : !valid ? (
        <div role="alert">
          <h1 class="text-3xl font-bold tracking-display">This unsubscribe link is not valid</h1>
          <p class="mt-3 text-ink-600">
            Use the link from one of our emails, or{' '}
            <a href="/contact" class="font-semibold text-brand-600 underline underline-offset-2">
              contact us
            </a>{' '}
            and we will remove you.
          </p>
        </div>
      ) : (
        <form method="post">
          <h1 class="text-3xl font-bold tracking-display">Unsubscribe from our newsletter?</h1>
          <p class="mt-3 text-ink-600">Press the button and we will stop sending you newsletters.</p>
          <input type="hidden" name="id" value={id} />
          <input type="hidden" name="sig" value={sig} />
          <button
            type="submit"
            class="mt-6 inline-flex h-12 items-center rounded-sm bg-brand-600 px-6 text-[15px] font-semibold text-white hover:bg-brand-500"
          >
            Unsubscribe
          </button>
        </form>
      )}
    </div>
  </section>
</PublicLayout>
