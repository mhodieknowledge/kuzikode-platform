---
/** Industries (R6.2): sector pages that describe the problems we solve. Never list clients here. */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import ContentTabs from '../../../../ui/admin/website/ContentTabs.astro';
import DataTable from '../../../../ui/admin/DataTable.astro';
import Cell from '../../../../ui/admin/Cell.astro';
import Button from '../../../../ui/primitives/Button.astro';
import StatusPill from '../../../../ui/primitives/StatusPill.astro';
import EmptyState from '../../../../ui/primitives/EmptyState.astro';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { listIndustriesAdmin } from '../../../../server/modules/cms/content-admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'content.manage' });
if (page instanceof Response) return page;
const industries = await listIndustriesAdmin(ctx);
---

<AdminLayout title="Industries" page={page}>
  <PageHead
    title="Content"
    meta="Industry pages describe the problems we solve for each sector. Never list clients here."
  >
    <Button slot="actions" href="/admin/content/industries/new" lead="add">
      New industry
    </Button>
  </PageHead>
  <div class="kz-atools">
    <ContentTabs current="industries" permissions={page.auth.permissions} />
  </div>
  <DataTable
    caption="Industries"
    count={industries.length}
    columns={[{ label: 'Industry' }, { label: 'Linked services', num: true }, { label: 'Status' }]}
  >
    <EmptyState slot="empty" code="0 industries" title="No industries yet." />
    {industries.map((i) => (
      <tr>
        <Cell m="main" href={`/admin/content/industries/${i.id}`} title={i.name} sub={`/industries/${i.slug}`} />
        <Cell m="meta" num tone="mute">
          {i.services} linked services
        </Cell>
        <Cell m="status">
          <StatusPill tone={i.status === 'published' ? 'ok' : 'neutral'}>
            {i.status === 'published' ? 'Published' : 'Draft'}
          </StatusPill>
        </Cell>
      </tr>
    ))}
  </DataTable>
</AdminLayout>
