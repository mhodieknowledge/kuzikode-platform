---
/** New support request (R5.4): one window (8 columns from 1024 px) holding the form; "Support" goes back. */
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PageHead from '../../../ui/workspace/PageHead.astro';
import Window from '../../../ui/workspace/Window.astro';
import { NewRequest } from '../../../ui/workspace/support/NewRequest';
import { loadPortalPage } from '../../../server/lib/portal-page';
import { portalSupportOptions } from '../../../server/modules/support/portal';
import { SUPPORT_CATEGORIES } from '../../../shared/support';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request, { area: 'support' });
if (page instanceof Response) return page;
const options = await portalSupportOptions(ctx);
---

<PortalLayout title="New support request" page={page} active="support">
  <PageHead
    title="New support request"
    sub="Tell us what you need. Our team replies on the request, where you can follow up."
    back={{ href: '/portal/support', label: 'Support' }}
  />
  <div class="kz-wgrid">
    <Window title="Request" icon="support" id="new" span={8}>
      <NewRequest
        client:load
        clients={options.clients}
        projects={options.projects}
        categories={SUPPORT_CATEGORIES.map((c) => ({ value: c.value, label: c.label }))}
      />
    </Window>
  </div>
</PortalLayout>
