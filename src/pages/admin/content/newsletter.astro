---
/** Newsletter (R6.2): subscriber counts, filters, the list and the audited CSV export. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import ContentTabs from '../../../ui/admin/website/ContentTabs.astro';
import KpiStrip from '../../../ui/admin/KpiStrip.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Button from '../../../ui/primitives/Button.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import { FilterBar, type FilterField } from '../../../ui/admin/FilterBar';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listSubscribers } from '../../../server/modules/cms/content-admin';
import { newsletterFilterSchema } from '../../../shared/schemas/content-admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'newsletter.view' });
if (page instanceof Response) return page;
const q = Astro.url.searchParams;
const filter = newsletterFilterSchema.parse({
  status: q.get('status') ?? undefined,
  q: q.get('q') ?? undefined,
  page: q.get('page') ?? undefined,
});
const data = await listSubscribers(ctx, filter);
const canExport = page.auth.permissions.has('newsletter.export');
const qs = (over: Record<string, string | number | undefined>) => {
  const p = new URLSearchParams();
  const merged = { status: filter.status, q: filter.q, ...over };
  for (const [k, v] of Object.entries(merged)) if (v !== undefined && v !== '') p.set(k, String(v));
  const s = p.toString();
  return s ? `?${s}` : '';
};
const labels = { pending: 'Awaiting confirmation', confirmed: 'Confirmed', unsubscribed: 'Unsubscribed' } as const;
const tones = { pending: 'warn', confirmed: 'ok', unsubscribed: 'neutral' } as const;
const exportStatus = filter.status ?? 'confirmed';
const statuses = ['confirmed', 'pending', 'unsubscribed'] as const;
const fields: FilterField[] = [
  {
    kind: 'search',
    name: 'q',
    label: 'Email contains',
    value: filter.q ?? '',
    maxLength: 120,
    placeholder: 'Email address',
  },
  {
    kind: 'select',
    name: 'status',
    label: 'Status',
    value: filter.status ?? '',
    options: [{ value: '', label: 'All' }, ...statuses.map((s) => ({ value: s, label: labels[s] }))],
  },
];
---

<AdminLayout title="Newsletter" page={page}>
  <PageHead
    title="Content"
    meta="Only confirmed subscribers agreed to receive email. Exports are recorded in the audit log."
  >
    {canExport ? (
      <Button
        slot="actions"
        variant="secondary"
        href={`/api/v1/admin/content/newsletter/export.csv${qs({ status: exportStatus })}`}
        download
        lead="download"
      >
        Export {labels[exportStatus].toLowerCase()} (CSV)
      </Button>
    ) : null}
  </PageHead>
  <div class="kz-atools">
    <ContentTabs current="newsletter" permissions={page.auth.permissions} />
  </div>
  <KpiStrip items={statuses.map((s) => ({ label: labels[s], values: [String(data.counts[s] ?? 0)] }))} />
  <div class="kz-atools">
    <FilterBar client:load label="Filter subscribers" fields={fields} clearHref="/admin/content/newsletter" />
  </div>
  <DataTable
    caption="Subscribers"
    count={data.items.length}
    columns={[{ label: 'Email' }, { label: 'Status' }, { label: 'Source' }, { label: 'Signed up (UTC)' }]}
  >
    <EmptyState slot="empty" code="no matches" title="No subscribers match." />
    {data.items.map((s) => (
      <tr>
        <Cell m="main" title={s.email} sub={s.source ?? ''} subText />
        <Cell m="status">
          <StatusPill tone={tones[s.status as keyof typeof tones] ?? 'neutral'}>
            {labels[s.status as keyof typeof labels] ?? s.status}
          </StatusPill>
        </Cell>
        <Cell tone="mute">{s.source ?? ''}</Cell>
        <Cell m="meta" tone="mute">
          <span class="kz-amono">{s.created_at.slice(0, 16).replace('T', ' ')}</span>
        </Cell>
      </tr>
    ))}
  </DataTable>
  {filter.page > 1 || data.hasMore ? (
    <nav aria-label="Pages" class="kz-apager">
      {filter.page > 1 ? (
        <Button
          variant="secondary"
          size="sm"
          href={qs({ page: filter.page - 1 }) || '?'}
          rel="prev"
          lead="chevron-left"
        >
          Previous
        </Button>
      ) : (
        <span class="kz-apager__gap" />
      )}
      <span class="kz-apager__pos">page {filter.page}</span>
      {data.hasMore ? (
        <Button variant="secondary" size="sm" href={qs({ page: filter.page + 1 })} rel="next" icon="chevron-right">
          Next
        </Button>
      ) : (
        <span class="kz-apager__gap" />
      )}
    </nav>
  ) : null}
</AdminLayout>
