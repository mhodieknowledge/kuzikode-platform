---
import { ArrowRight } from 'lucide-react';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getPage, listPortfolio } from '../../server/modules/cms';
import type { Section } from '../../shared/schemas/cms';

const { ctx } = Astro.locals;
const [page, items] = await Promise.all([getPage(ctx, 'work'), listPortfolio(ctx)]);
const intro = page?.sections.find((s) => s.key === 'intro' && s.type === 'rich_text') as
  Section<'rich_text'> | undefined;
const empty = page?.sections.find((s) => s.key === 'empty' && s.type === 'cta') as Section<'cta'> | undefined;
const categories = [...new Set(items.map((i) => i.category))].sort();
const active = Astro.url.searchParams.get('category');
const filtered = active && categories.includes(active) ? items.filter((i) => i.category === active) : items;
const label = (c: string) => c.replace(/[-_]/g, ' ').replace(/^\w/, (m) => m.toUpperCase());
---

<PublicLayout
  title={page?.seoTitle ?? 'Our Work · Kuzikode Technologies'}
  description={page?.seoDescription ?? undefined}
  canonicalPath="/work"
>
  <section class="bg-canvas py-14 md:py-20" aria-labelledby="work-title">
    <div class="container-content">
      <h1 id="work-title" class="text-4xl font-bold tracking-display md:text-5xl">
        {intro?.content.title ?? 'Our work'}
      </h1>
      {intro ? <div class="prose-kz mt-4 text-lg" set:html={intro.content.html} /> : null}
    </div>
  </section>

  <section class="bg-surface py-14 md:py-20" aria-label="Case studies">
    <div class="container-content">
      {items.length === 0 ? (
        <div class="mx-auto max-w-xl rounded-lg border border-line bg-canvas px-6 py-14 text-center">
          <h2 class="text-2xl font-bold tracking-display">
            {empty?.content.title ?? 'Case studies are being prepared.'}
          </h2>
          <p class="mt-3 text-ink-600">{empty?.content.body ?? 'Talk to us about what we can build for you.'}</p>
          <a
            href={empty?.content.primaryCta.href ?? '/contact'}
            class="mt-6 inline-flex h-12 items-center rounded-sm bg-brand-600 px-6 text-[15px] font-semibold text-white hover:bg-brand-500"
          >
            {empty?.content.primaryCta.label ?? 'Contact us'}
          </a>
        </div>
      ) : (
        <>
          {categories.length > 1 ? (
            <nav aria-label="Filter by category" class="mb-8">
              <ul class="flex flex-wrap gap-2">
                <li>
                  <a
                    href="/work"
                    aria-current={!active ? 'page' : undefined}
                    class:list={[
                      'inline-flex h-9 items-center rounded-full border px-4 text-sm',
                      !active
                        ? 'border-brand-600 bg-brand-50 font-semibold text-brand-600'
                        : 'border-line text-ink-800 hover:border-ink-400',
                    ]}
                  >
                    All
                  </a>
                </li>
                {categories.map((c) => (
                  <li>
                    <a
                      href={`/work?category=${encodeURIComponent(c)}`}
                      aria-current={active === c ? 'page' : undefined}
                      class:list={[
                        'inline-flex h-9 items-center rounded-full border px-4 text-sm',
                        active === c
                          ? 'border-brand-600 bg-brand-50 font-semibold text-brand-600'
                          : 'border-line text-ink-800 hover:border-ink-400',
                      ]}
                    >
                      {label(c)}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ) : null}
          <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {filtered.map((p) => (
              <li>
                <a
                  href={`/work/${p.slug}`}
                  class="group flex h-full flex-col overflow-hidden rounded-md border border-line hover:border-brand-500"
                >
                  {p.cover ? (
                    <img
                      src={p.cover.src}
                      alt={p.cover.alt}
                      width={p.cover.width ?? 1200}
                      height={p.cover.height ?? 750}
                      loading="lazy"
                      class="aspect-[16/10] w-full object-cover"
                    />
                  ) : null}
                  <span class="flex flex-1 flex-col p-6">
                    <span class="text-xs font-semibold tracking-wider text-ink-600 uppercase">{label(p.category)}</span>
                    <span class="mt-2 font-display text-lg font-bold tracking-display text-ink-950">{p.name}</span>
                    <span class="mt-2 flex-1 text-[15px] leading-6 text-ink-600">{p.summary}</span>
                    <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600">
                      Read the case study <ArrowRight size={16} aria-hidden="true" />
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>
</PublicLayout>
