---
/**
 * Package comparison (R4.2; the pricing page reuses it in R4.3). IMG_5071: one table, packages as columns, the recommended one
 * (CMS "most popular" flag, no usage claim) lifted on paper with an emerald top rule and "Recommended" set in its header.
 * Rows: price, delivery, revisions, support, then every feature label any package carries (included ✓, not included –, or the
 * package's own text). Phones and tablets: one package column at a time, chosen with a package selector above the table
 * (`[data-kz-compare]`, buttons with aria-pressed); the full table is still in the DOM for assistive technology.
 * Data only from the pricing catalogue (`packagePrice`, features); nothing is computed or rounded here.
 */
import Icon from '../../icons/Icon.astro';
import type { PublicPackage } from '../../../server/modules/cms';
import { packagePrice, packageQuoteHref } from '../../../shared/service-display';

interface Props {
  packages: PublicPackage[];
  caption: string;
  id: string;
}
const { packages, caption, id } = Astro.props;
const start = Math.max(
  0,
  packages.findIndex((p) => p.mostPopular),
);
const labels: string[] = [];
for (const p of packages) for (const f of p.features) if (!labels.includes(f.label)) labels.push(f.label);
const cell = (p: PublicPackage, label: string) => p.features.find((f) => f.label === label) ?? null;
const facts: [string, (p: PublicPackage) => string | null][] = [
  ['Delivery', (p) => p.deliveryTime],
  ['Revision rounds', (p) => p.revisionRounds],
  ['Support after launch', (p) => p.supportPeriod],
];
// The CMS feature lists already carry delivery / revisions / support rows; the package fields fill in only when they don't.
const shownFacts = labels.length > 0 ? [] : facts.filter(([, get]) => packages.some((p) => get(p)));
const href = (p: PublicPackage) => packageQuoteHref(p);
const col = (i: number) => ({ 'data-col': String(i) });
---

<div class="kz-cmp" data-kz-compare data-show={start} id={id}>
  <div class="kz-cmp__pick" role="group" aria-label="Show package">
    {
      packages.map((p, i) => (
        <button
          type="button"
          class:list={['kz-cmp__opt', p.mostPopular && 'is-rec']}
          aria-pressed={i === start ? 'true' : 'false'}
          aria-controls={`${id}-table`}
          data-col={i}
        >
          {p.name}
        </button>
      ))
    }
  </div>
  <div class="kz-cmp__scroll">
    <table class="kz-cmp__table" id={`${id}-table`} style={`--cols:${packages.length}`}>
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr>
          <td class="kz-cmp__corner"></td>
          {
            packages.map((p, i) => {
              const price = packagePrice(p);
              return (
                <th scope="col" class:list={['kz-cmp__head', p.mostPopular && 'is-rec']} data-package={p.slug} {...col(i)}>
                  {p.mostPopular ? <span class="kz-cmp__rec">Recommended</span> : null}
                  <span class="kz-cmp__name">{p.name}</span>
                  {p.tagline ? <span class="kz-cmp__tag">{p.tagline}</span> : null}
                  <span class="kz-cmp__price" data-price>
                    {price.prefix ? <small>{price.prefix} </small> : null}
                    <b class:list={[!price.hasPrice && 'is-quote']}>{price.amount}</b>
                    {price.suffix ? <small> {price.suffix}</small> : null}
                  </span>
                  {price.annual ? <span class="kz-cmp__note">{price.annual}</span> : null}
                  {p.minQuantity > 1 ? <span class="kz-cmp__note">Minimum {p.minQuantity}</span> : null}
                </th>
              );
            })
          }
        </tr>
      </thead>
      <tbody>
        {
          shownFacts.map(([label, get]) => (
            <tr class="is-fact">
              <th scope="row">{label}</th>
              {packages.map((p, i) => (
                <td class:list={[p.mostPopular && 'is-rec']} {...col(i)}>
                  {get(p) ?? '–'}
                </td>
              ))}
            </tr>
          ))
        }
        {
          labels.map((label) => (
            <tr>
              <th scope="row">{label}</th>
              {packages.map((p, i) => {
                const f = cell(p, label);
                return (
                  <td class:list={[p.mostPopular && 'is-rec']} {...col(i)}>
                    {!f || f.value === 'not_included' ? (
                      <span class="kz-cmp__no">
                        <Icon name="remove" size={16} />
                        <span class="sr-only">Not included</span>
                      </span>
                    ) : f.value === 'included' ? (
                      <span class="kz-cmp__yes">
                        <Icon name="check" size={16} />
                        <span class="sr-only">Included</span>
                      </span>
                    ) : (
                      <span class="kz-cmp__text">{f.text}</span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
      <tfoot>
        <tr>
          <td class="kz-cmp__corner"></td>
          {
            packages.map((p, i) => (
              <td class:list={[p.mostPopular && 'is-rec']} {...col(i)}>
                {p.status === 'coming_soon' ? (
                  <span class="kz-cmp__soon">Coming soon</span>
                ) : (
                  <a
                    class:list={['kz-btn kz-btn--block', p.mostPopular ? 'kz-btn--primary' : 'kz-btn--secondary']}
                    href={href(p)}
                  >
                    <span>{packagePrice(p).hasPrice ? 'Request this package' : 'Ask for a quote'}</span>
                    <span class="sr-only">: {p.name}</span>
                  </a>
                )}
              </td>
            ))
          }
        </tr>
      </tfoot>
    </table>
  </div>
  <div class="kz-cmp__acts">
    {
      packages.map((p, i) =>
        p.status === 'coming_soon' ? (
          <p class="kz-cmp__soon" {...col(i)}>
            {p.name}: coming soon
          </p>
        ) : (
          <a
            class:list={['kz-btn kz-btn--block', p.mostPopular ? 'kz-btn--primary' : 'kz-btn--secondary']}
            href={href(p)}
            {...col(i)}
          >
            <span>{packagePrice(p).hasPrice ? `Request ${p.name}` : `Ask about ${p.name}`}</span>
          </a>
        ),
      )
    }
  </div>
</div>

<script>
  /* Package selector (phones and tablets): shows one column; the table stays complete for assistive technology. */
  for (const box of document.querySelectorAll<HTMLElement>('[data-kz-compare]')) {
    if (box.dataset.kzReady) continue;
    box.dataset.kzReady = '1';
    const opts = Array.from(box.querySelectorAll<HTMLButtonElement>('.kz-cmp__opt'));
    for (const o of opts)
      o.addEventListener('click', () => {
        box.dataset.show = o.dataset.col ?? '0';
        for (const x of opts) x.setAttribute('aria-pressed', String(x === o));
      });
  }
</script>
