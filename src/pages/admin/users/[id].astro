---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { StaffActions } from '../../../components/admin/UsersAdmin';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { AppError } from '../../../server/lib/errors';
import { getStaff, listRoles } from '../../../server/modules/users';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'users.view' });
if (page instanceof Response) return page;
let user;
try {
  user = await getStaff(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const roles = await listRoles(ctx);
const isSuper = page.auth.roles.includes('super_admin');
const targetIsSuper = user.roles.includes('super_admin');
const canManage = page.auth.permissions.has('users.manage') && (isSuper || !targetIsSuper);
const assignable = roles
  .filter((r) => r.key !== 'super_admin' || isSuper)
  .map((r) => ({ key: r.key, name: r.name, description: r.description }));
const fmt = (iso: string | null) =>
  iso
    ? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Africa/Harare' }).format(
        new Date(iso),
      )
    : 'Never';
const ACTIONS: Record<string, string> = {
  'user.invited': 'Invited',
  'user.invitation_resent': 'Invitation resent',
  'user.roles_changed': 'Roles changed',
  'user.renamed': 'Renamed',
  'user.disabled': 'Account disabled',
  'user.enabled': 'Account enabled',
  'user.mfa_reset': 'Two-factor reset by an administrator',
};
const roleName = new Map(roles.map((r) => [r.key, r.name]));
---

<AdminLayout title={user.name} page={page}>
  <nav aria-label="Breadcrumb" class="text-[13px] text-ink-600">
    <a href="/admin/users" class="hover:text-ink-950 hover:underline">
      Users
    </a>{' '}
    / <span class="text-ink-950">{user.name}</span>
  </nav>
  <h1 class="mt-2 text-2xl font-bold tracking-display">{user.name}</h1>
  <p class="text-sm text-ink-600">{user.email}</p>
  <div class="mt-6 grid gap-6 xl:grid-cols-[1fr_360px]">
    <div>
      {canManage ? (
        <StaffActions
          client:load
          userId={user.id}
          name={user.name}
          status={user.status}
          roles={user.roles}
          allRoles={assignable}
          mfaEnabled={user.mfaEnabled}
          isSelf={user.id === page.auth.user.id}
        />
      ) : (
        <section class="rounded-lg border border-line bg-surface p-6">
          <h2 class="font-sans text-base font-semibold">Roles</h2>
          <p class="mt-2 text-sm text-ink-800">
            {user.roles.map((r) => roleName.get(r) ?? r).join(', ') || 'No roles'}
          </p>
          {targetIsSuper && !isSuper ? (
            <p class="mt-2 text-sm text-ink-600">Only a Super Administrator can change this account.</p>
          ) : null}
        </section>
      )}
    </div>
    <aside class="flex flex-col gap-6">
      <section class="rounded-lg border border-line bg-surface p-6" aria-labelledby="facts-title">
        <h2 id="facts-title" class="font-sans text-base font-semibold">
          Account
        </h2>
        <dl class="mt-3 grid gap-2 text-sm">
          <div class="flex justify-between gap-4">
            <dt class="text-ink-600">Status</dt>
            <dd class="font-medium capitalize">{user.status}</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-ink-600">Two-factor</dt>
            <dd class="font-medium">{user.mfaEnabled ? 'On' : 'Off'}</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-ink-600">Last sign-in</dt>
            <dd class="font-medium">{fmt(user.lastLoginAt)}</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-ink-600">Active sessions</dt>
            <dd class="font-medium">{user.activeSessions}</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-ink-600">Created</dt>
            <dd class="font-medium">{fmt(user.createdAt)}</dd>
          </div>
        </dl>
      </section>
      <section class="rounded-lg border border-line bg-surface p-6" aria-labelledby="history-title">
        <h2 id="history-title" class="font-sans text-base font-semibold">
          History
        </h2>
        {user.history.length === 0 ? (
          <p class="mt-3 text-sm text-ink-600">No changes recorded yet.</p>
        ) : (
          <ol class="mt-3 flex flex-col gap-3 text-sm">
            {user.history.map((h) => (
              <li>
                <p class="font-medium text-ink-950">{ACTIONS[h.action] ?? h.action}</p>
                <p class="text-[12px] text-ink-600">
                  {fmt(h.created_at)}
                  {h.actor_name ? ` · by ${h.actor_name}` : ''}
                </p>
              </li>
            ))}
          </ol>
        )}
      </section>
    </aside>
  </div>
</AdminLayout>
