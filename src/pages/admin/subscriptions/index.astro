---
/** Subscriptions (R6.2): MRR strip, filters (sheet on phones), dense table → list rows (description, client, amount, status). */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Pager from '../../../ui/admin/Pager.astro';
import KpiStrip, { type Kpi } from '../../../ui/admin/KpiStrip.astro';
import Button from '../../../ui/primitives/Button.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import { FilterBar } from '../../../ui/admin/FilterBar';
import { SUBSCRIPTION_STATUS } from '../../../ui/admin/finance/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listSubscriptions } from '../../../server/modules/subscriptions';
import { subscriptionListQuery } from '../../../shared/schemas/subscriptions';
import { formatMoney, formatQuantity, mulDivHalfEven } from '../../../shared/money';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'subscriptions.view' });
if (page instanceof Response) return page;
const parsed = subscriptionListQuery.safeParse(Object.fromEntries(Astro.url.searchParams));
const filter = parsed.success ? parsed.data : subscriptionListQuery.parse({});
const result = await listSubscriptions(ctx, filter);
const canManage = page.auth.permissions.has('subscriptions.manage');
const pageHref = (n: number) => {
  const q = new URLSearchParams(Astro.url.searchParams);
  q.set('page', String(n));
  return `/admin/subscriptions?${q.toString()}`;
};
const amount = (s: (typeof result.items)[number]) =>
  formatMoney(mulDivHalfEven(s.unit_price_minor, s.quantity_milli, 1000), s.currency);
const filtered = !!(filter.q || filter.status || filter.dueBy);
const tiles: Kpi[] = result.mrr.length
  ? [
      { label: 'MRR', values: result.mrr.map((m) => `${formatMoney(m.mrrMinor, m.currency)} / mo`) },
      {
        label: 'ARR',
        values: result.mrr.map((m) => formatMoney(m.arrMinor, m.currency)),
        note: `${result.mrr.reduce((n, m) => n + m.count, 0)} subscriptions`,
      },
    ]
  : [];
---

<AdminLayout title="Subscriptions" page={page}>
  <PageHead
    title="Subscriptions"
    meta="Recurring billing. Invoices for each period are created automatically before the billing date."
  >
    {canManage ? (
      <Button slot="actions" href="/admin/subscriptions/new" lead="add">
        New subscription
      </Button>
    ) : null}
  </PageHead>
  {tiles.length ? <KpiStrip items={tiles} testId="mrr" /> : null}
  <div class="kz-atools kz-agap">
    <FilterBar
      client:load
      label="Filter subscriptions"
      clearHref="/admin/subscriptions"
      fields={[
        { kind: 'search', name: 'q', label: 'Search', value: filter.q ?? '', placeholder: 'Client or description' },
        {
          kind: 'select',
          name: 'status',
          label: 'Status',
          value: filter.status ?? 'open',
          options: [
            { value: 'open', label: 'Open (active, at risk, paused)' },
            ...Object.entries(SUBSCRIPTION_STATUS).map(([value, s]) => ({ value, label: s.label })),
            { value: 'all', label: 'All' },
          ],
        },
        { kind: 'date', name: 'dueBy', label: 'Next billing by', value: filter.dueBy ?? '' },
      ]}
    />
  </div>
  <DataTable
    caption="Subscriptions"
    count={result.items.length}
    columns={[
      { label: 'Description' },
      { label: 'Client' },
      { label: 'Amount', num: true },
      { label: 'Next billing' },
      { label: 'Status' },
    ]}
  >
    <EmptyState
      slot="empty"
      code={filtered ? 'no matches' : '0 subscriptions'}
      title={filtered ? 'No subscriptions match these filters.' : 'No subscriptions yet.'}
    >
      Recurring plans for clients appear here.
    </EmptyState>
    {result.items.map((s) => (
      <tr>
        <Cell
          m="main"
          href={`/admin/subscriptions/${s.id}`}
          title={s.description}
          sub={s.quantity_milli !== 1000 ? `× ${formatQuantity(s.quantity_milli)}` : undefined}
        />
        <Cell m="meta" tone="mute">
          <span>{s.client_name}</span>
          {['active', 'at_risk'].includes(s.status) ? (
            <span class="kz-dt__ph"> · next {formatLongDate(s.next_billing_date)}</span>
          ) : null}
        </Cell>
        <Cell m="amount" num>
          {amount(s)} <span class="kz-dt__per">/ {s.interval === 'month' ? 'mo' : 'yr'}</span>
        </Cell>
        <Cell tone="mute">{['active', 'at_risk'].includes(s.status) ? formatLongDate(s.next_billing_date) : '—'}</Cell>
        <Cell m="status">
          <StatusPill tone={SUBSCRIPTION_STATUS[s.status]?.tone ?? 'neutral'}>
            {SUBSCRIPTION_STATUS[s.status]?.label ?? s.status}
          </StatusPill>
        </Cell>
      </tr>
    ))}
  </DataTable>
  <Pager page={result.page} pages={result.pages} href={pageHref} />
</AdminLayout>
