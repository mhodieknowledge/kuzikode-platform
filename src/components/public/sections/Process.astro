---
import { ArrowRight } from 'lucide-react';
import SectionHeading from './SectionHeading.astro';
import type { SectionContent } from '../../../shared/schemas/cms';

interface Props {
  content: SectionContent<'process'>;
}
const { content: c } = Astro.props;
---

<section class="bg-ink-950 py-16 text-white md:py-24 lg:py-28" aria-labelledby="process-title">
  <div class="container-content">
    <SectionHeading id="process-title" title={c.title} tone="dark" />
    <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
      {
        c.steps.map((s, i) => (
          <li class="relative border-t border-dark-line pt-6">
            <span class="tnum font-mono text-sm text-dark-brand">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-sans text-lg font-semibold text-white">{s.title}</h3>
            <p class="mt-2 text-[15px] leading-6 text-white/65">{s.body}</p>
          </li>
        ))
      }
    </ol>
    {
      c.link ? (
        <a href={c.link.href} class="mt-12 inline-flex items-center gap-1.5 text-sm font-semibold text-white hover:underline">
          {c.link.label} <ArrowRight size={16} aria-hidden="true" />
        </a>
      ) : null
    }
  </div>
</section>
