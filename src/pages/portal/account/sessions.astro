---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { SessionActions } from '../../../components/admin/AccountActions';
import { loadPortalPage } from '../../../server/lib/portal-page';
import { listSessions } from '../../../server/modules/auth/service';
import { deviceLabel, harareDateTime } from '../../../shared/devices';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request);
if (page instanceof Response) return page;
const sessions = await listSessions(ctx, page.auth);
---

<PortalLayout title="Signed-in devices" page={page} active="account">
  <p class="text-sm">
    <a href="/portal/account" class="font-semibold text-brand-600 underline underline-offset-2">
      Your account
    </a>
  </p>
  <h1 class="mt-2 text-2xl font-bold tracking-display md:text-3xl">Signed-in devices</h1>
  <p class="mt-1 text-sm text-ink-600">
    You stay signed in for up to 30 days, or 24 hours without activity. Sign out any device you don't recognise.
  </p>
  <ul class="mt-6 grid max-w-3xl gap-3" aria-label="Signed-in devices">
    {sessions.map((s) => (
      <li class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-line p-4">
        <div class="min-w-0 text-sm">
          <p class="font-semibold text-ink-950">
            {deviceLabel(s.userAgent)}
            {s.current ? (
              <span class="ml-2 rounded-full bg-success-50 px-2 py-0.5 text-[12px] font-semibold text-success-700">
                This device
              </span>
            ) : null}
          </p>
          <p class="mt-0.5 text-ink-600">
            Signed in {harareDateTime(s.createdAt)} · last active {harareDateTime(s.lastSeenAt)}
            {s.ip ? ` · IP ${s.ip}` : ''}
          </p>
        </div>
        {s.current ? null : <SessionActions client:visible sessionId={s.id} audience="portal" />}
      </li>
    ))}
  </ul>
  <div class="mt-6">
    <SessionActions client:visible audience="portal" />
  </div>
</PortalLayout>
