---
import AuthLayout from '../../layouts/AuthLayout.astro';
import { VerifyEmailForm } from '../../ui/auth/AuthForms';

const token = (Astro.url.searchParams.get('token') ?? '').slice(0, 200);
Astro.response.headers.set('referrer-policy', 'no-referrer');
---

<AuthLayout title="Confirm your email" heading="Confirm your email address" area="portal" step={1}>
  {token ? (
    <VerifyEmailForm client:load audience="portal" token={token} />
  ) : (
    <p class="kz-auth__note">This link is incomplete. Open the link from your email again.</p>
  )}
</AuthLayout>
