---
import { ChevronDown, Menu, X } from 'lucide-react';
import Logo from '../Logo.astro';
import type { SiteNavigation } from '../../server/modules/cms';

interface Props {
  nav: SiteNavigation;
  /** Dark header for pages that open with a dark hero (home). */
  tone?: 'light' | 'dark';
}
const { nav, tone = 'light' } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
const dark = tone === 'dark';
const linkBase = dark ? 'text-white/80 hover:text-white' : 'text-ink-600 hover:text-ink-950';
const linkActive = dark ? 'text-white' : 'text-ink-950';
const top = [
  { label: 'Pricing', href: '/pricing' },
  { label: 'Our Work', href: '/work' },
  { label: 'Insights', href: '/insights' },
  ...(nav.careersInNav ? [{ label: 'Careers', href: '/careers' }] : []),
  { label: 'Contact', href: '/contact' },
];
const servicesActive = path.startsWith('/services') || path.startsWith('/industries');
const aboutActive = ['/about', '/products', '/faq', '/how-we-work', ...(nav.careersInNav ? [] : ['/careers'])].some((p) => path.startsWith(p));
---

<header class:list={['sticky top-0 z-40 border-b', dark ? 'border-dark-line bg-ink-950' : 'border-line bg-surface/95 backdrop-blur']} data-site-header>
  <div class="container-content flex h-16 items-center justify-between gap-4 xl:h-[72px]">
    <Logo variant={dark ? 'light' : 'dark'} height={26} />

    <nav aria-label="Main" class="hidden xl:block">
      <ul class="flex items-center gap-0.5 text-[15px] whitespace-nowrap">
        <li>
          <a href="/" aria-current={isActive('/') ? 'page' : undefined} class:list={['rounded-sm px-3 py-2 font-medium', isActive('/') ? linkActive : linkBase]}>Home</a>
        </li>
        <li class="relative" data-menu>
          <button
            type="button"
            aria-expanded="false"
            aria-controls="menu-about"
            class:list={['inline-flex items-center gap-1 rounded-sm px-3 py-2 font-medium', aboutActive ? linkActive : linkBase]}
            data-menu-button>About<ChevronDown size={16} aria-hidden="true" /></button
          >
          <div id="menu-about" hidden class="absolute top-full left-0 mt-2 w-56 rounded-md border border-line bg-surface p-2 shadow-2" data-menu-panel>
            <ul>
              {
                nav.about.map((l) => (
                  <li>
                    <a href={l.href} class="block rounded-sm px-3 py-2 text-sm text-ink-800 hover:bg-canvas">
                      {l.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        <li class="relative" data-menu>
          <button
            type="button"
            aria-expanded="false"
            aria-controls="menu-services"
            class:list={['inline-flex items-center gap-1 rounded-sm px-3 py-2 font-medium', servicesActive ? linkActive : linkBase]}
            data-menu-button>Services<ChevronDown size={16} aria-hidden="true" /></button
          >
          <div
            id="menu-services"
            hidden
            class="absolute top-full left-1/2 mt-2 w-[min(760px,90vw)] -translate-x-1/2 rounded-md border border-line bg-surface p-4 shadow-2"
            data-menu-panel
          >
            <div class="grid grid-cols-[2fr_1fr] gap-4">
              <ul class="grid grid-cols-2 gap-1">
                {
                  nav.services.map((l) => (
                    <li>
                      <a href={l.href} class="block rounded-sm p-3 hover:bg-canvas">
                        <span class="block text-sm font-semibold text-ink-950">{l.label}</span>
                        <span class="mt-0.5 block text-[13px] leading-snug text-ink-600">{l.description}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
              <ul class="flex flex-col gap-1 border-l border-line pl-4">
                <li>
                  <a href="/services" class="block rounded-sm p-3 hover:bg-canvas">
                    <span class="block text-sm font-semibold text-ink-950">All services</span>
                    <span class="mt-0.5 block text-[13px] text-ink-600">Everything we do, in one place.</span>
                  </a>
                </li>
                {
                  nav.servicesExtra.map((l) => (
                    <li>
                      <a href={l.href} class="block rounded-sm p-3 hover:bg-canvas">
                        <span class="block text-sm font-semibold text-ink-950">{l.label}</span>
                        <span class="mt-0.5 block text-[13px] leading-snug text-ink-600">{l.description}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </li>
        {
          top.map((l) => (
            <li>
              <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined} class:list={['rounded-sm px-3 py-2 font-medium', isActive(l.href) ? linkActive : linkBase]}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-2 whitespace-nowrap xl:flex">
      <a
        href="/portal/login"
        class:list={[
          'inline-flex h-10 items-center rounded-sm border px-4 text-sm font-semibold',
          dark ? 'border-white/25 text-white hover:border-white/60' : 'border-line text-ink-950 hover:border-ink-400',
        ]}>Client Portal</a
      >
      <a href="/start-a-project" class="inline-flex h-10 items-center rounded-sm bg-brand-600 px-4 text-sm font-semibold text-white hover:bg-brand-500">Start a project</a>
    </div>

    <button
      type="button"
      class:list={['inline-flex h-11 w-11 items-center justify-center rounded-sm border xl:hidden', dark ? 'border-white/25 text-white' : 'border-line text-ink-950']}
      aria-label="Open menu"
      aria-controls="mobile-nav"
      data-mobile-open
    >
      <Menu size={20} aria-hidden="true" />
    </button>
  </div>

  <dialog id="mobile-nav" aria-label="Menu" class="m-0 ml-auto h-dvh max-h-none w-[min(380px,100%)] max-w-none bg-surface p-0 backdrop:bg-ink-950/50" data-mobile-nav>
    <div class="flex h-16 items-center justify-between border-b border-line px-4">
      <Logo height={24} />
      <button type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-sm text-ink-950" aria-label="Close menu" data-mobile-close>
        <X size={20} aria-hidden="true" />
      </button>
    </div>
    <nav aria-label="Mobile" class="overflow-y-auto px-4 py-4">
      <ul class="flex flex-col">
        <li><a href="/" class="flex min-h-11 items-center text-base font-semibold text-ink-950">Home</a></li>
        <li class="mt-3 text-xs font-semibold tracking-wider text-ink-600 uppercase">Services</li>
        <li><a href="/services" class="flex min-h-11 items-center text-[15px] text-ink-800">All services</a></li>
        {
          nav.services.map((l) => (
            <li>
              <a href={l.href} class="flex min-h-11 items-center text-[15px] text-ink-800">
                {l.label}
              </a>
            </li>
          ))
        }
        <li><a href="/industries" class="flex min-h-11 items-center text-[15px] text-ink-800">Industries</a></li>
        <li class="mt-3 text-xs font-semibold tracking-wider text-ink-600 uppercase">Company</li>
        {
          nav.about.map((l) => (
            <li>
              <a href={l.href} class="flex min-h-11 items-center text-[15px] text-ink-800">
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="mt-3 border-t border-line pt-3"></li>
        {
          top.map((l) => (
            <li>
              <a href={l.href} class="flex min-h-11 items-center text-base font-semibold text-ink-950">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-col gap-3">
        <a href="/start-a-project" class="inline-flex h-12 items-center justify-center rounded-sm bg-brand-600 text-[15px] font-semibold text-white">Start a project</a>
        <a href="/portal/login" class="inline-flex h-12 items-center justify-center rounded-sm border border-line text-[15px] font-semibold text-ink-950">Client Portal</a>
      </div>
    </nav>
  </dialog>
</header>

<script>
  for (const menu of document.querySelectorAll<HTMLElement>('[data-menu]')) {
    const button = menu.querySelector<HTMLButtonElement>('[data-menu-button]')!;
    const panel = menu.querySelector<HTMLElement>('[data-menu-panel]')!;
    const close = () => {
      button.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    };
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll<HTMLButtonElement>('[data-menu-button][aria-expanded="true"]').forEach((b) => b !== button && b.click());
      button.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        close();
        button.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node)) close();
    });
    menu.addEventListener('focusout', (e) => {
      if (e.relatedTarget && !menu.contains(e.relatedTarget as Node)) close();
    });
  }
  const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-nav]');
  document.querySelector('[data-mobile-open]')?.addEventListener('click', () => dialog?.showModal());
  document.querySelector('[data-mobile-close]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
