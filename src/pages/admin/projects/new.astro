---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ProjectForm } from '../../../components/admin/ProjectsAdmin';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { formOptions } from '../../../server/modules/projects';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'projects.manage' });
if (page instanceof Response) return page;
const opts = await formOptions(ctx);
const clientId = Astro.url.searchParams.get('clientId') ?? '';
const initial = {
  clientId: opts.clients.some((c) => c.id === clientId) ? clientId : '',
  name: '',
  description: null,
  status: 'planning',
  startDate: null,
  targetDate: null,
  budgetMinor: null,
  currency: null,
  leadId: null,
  memberIds: [],
};
---

<AdminLayout title="New project" page={page}>
  <nav aria-label="Breadcrumb" class="text-[13px] text-ink-600">
    <a href="/admin/projects" class="hover:text-ink-950 hover:underline">
      Projects
    </a>{' '}
    / <span class="text-ink-950">New</span>
  </nav>
  <h1 class="mt-2 mb-6 text-2xl font-bold tracking-display">New project</h1>
  {opts.clients.length === 0 ? (
    <div class="max-w-xl rounded-lg border border-line bg-surface p-6">
      <p class="font-semibold">Add a client first</p>
      <p class="mt-1 text-sm text-ink-600">Projects are run for a client record.</p>
      <a href="/admin/clients/new" class="mt-4 inline-flex text-sm font-semibold text-brand-600 hover:underline">
        New client
      </a>
    </div>
  ) : (
    <div class="max-w-3xl">
      <ProjectForm client:load initial={initial} {...opts} />
    </div>
  )}
</AdminLayout>
