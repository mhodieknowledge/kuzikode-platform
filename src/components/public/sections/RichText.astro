---
import type { SectionContent } from '../../../shared/schemas/cms';

interface Props {
  content: SectionContent<'rich_text'>;
  anchor: string;
  tone?: 'surface' | 'canvas';
  /** Render the title as the page h1 (first block of a page). */
  asPageTitle?: boolean;
}
const { content: c, anchor, tone = 'surface', asPageTitle = false } = Astro.props;
const Heading = asPageTitle ? 'h1' : 'h2';
---

<section class:list={['py-14 md:py-20', tone === 'canvas' ? 'bg-canvas' : 'bg-surface']} aria-labelledby={c.title ? `${anchor}-title` : undefined}>
  <div class="container-content grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_2fr]">
    {
      c.title ? (
        <Heading id={`${anchor}-title`} class:list={['font-bold tracking-display text-ink-950', asPageTitle ? 'text-4xl md:text-5xl' : 'text-3xl']}>
          {c.title}
        </Heading>
      ) : (
        <div />
      )
    }
    <div class="prose-kz" set:html={c.html} />
  </div>
</section>
