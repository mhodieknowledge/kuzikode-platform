---
/**
 * Audit log (R6.2 group 3): filters (sheet on phones), a dense table → list rows with mono timestamps and an expandable
 * before / after per entry, Newer / Older paging, CSV export of the current filter.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Button from '../../../ui/primitives/Button.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import { FilterBar } from '../../../ui/admin/FilterBar';
import { harareStamp } from '../../../ui/admin/projects/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { auditFilters, listAudit } from '../../../server/modules/audit';
import { auditQuery } from '../../../shared/schemas/reports';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'audit.view' });
if (page instanceof Response) return page;
const p = Astro.url.searchParams;
const filter = auditQuery.parse(Object.fromEntries([...p.entries()].filter(([, v]) => v !== '')));
const [data, options] = await Promise.all([listAudit(ctx, filter), auditFilters(ctx)]);
const qs = (over: Record<string, string | number | undefined>) => {
  const out = new URLSearchParams();
  const { page: _p, ...rest } = filter;
  for (const [k, v] of Object.entries({ ...rest, ...over })) if (v !== undefined && v !== '') out.set(k, String(v));
  const s = out.toString();
  return s ? `?${s}` : '';
};
const exportQs = qs({});
const filtered = !!(filter.actor || filter.entityType || filter.action || filter.from || filter.to || filter.entityId);
---

<AdminLayout title="Audit log" page={page}>
  <PageHead
    title="Audit log"
    meta={
      data.financeOnly
        ? 'You see changes to financial records only.'
        : 'Who changed what, newest first. Times are Harare time.'
    }
  >
    <Fragment slot="actions">
      <Button href={`/api/v1/admin/audit/export.csv${exportQs}`} variant="secondary" lead="download" download>
        Export CSV
      </Button>
    </Fragment>
  </PageHead>
  <div class="kz-atools">
    <FilterBar
      client:load
      label="Filter the audit log"
      hidden={filter.entityId ? { entityId: filter.entityId } : {}}
      clearHref="/admin/audit"
      fields={[
        { kind: 'search', name: 'action', label: 'Action', value: filter.action ?? '', placeholder: 'e.g. invoice.' },
        {
          kind: 'select',
          name: 'actor',
          label: 'Person',
          value: filter.actor ?? '',
          options: [{ value: '', label: 'Anyone' }, ...options.actors.map((a) => ({ value: a.id, label: a.name }))],
        },
        {
          kind: 'select',
          name: 'entityType',
          label: 'Record type',
          value: filter.entityType ?? '',
          options: [
            { value: '', label: 'Any' },
            ...options.entityTypes.map((t) => ({ value: t, label: t.replace(/_/g, ' ') })),
          ],
        },
        { kind: 'date', name: 'from', label: 'From', value: filter.from ?? '' },
        { kind: 'date', name: 'to', label: 'To', value: filter.to ?? '' },
      ]}
    />
  </div>
  {filter.entityId ? (
    <p class="kz-anotice kz-anotice--info">
      <span>
        Showing record <span class="kz-amono">{filter.entityId}</span>.
      </span>
      <a href={`/admin/audit${qs({ entityId: undefined })}`}>Show all</a>
    </p>
  ) : null}
  <DataTable
    caption="Audit log entries"
    count={data.items.length}
    columns={[
      { label: 'When (Harare)' },
      { label: 'Who' },
      { label: 'Action' },
      { label: 'Record' },
      { label: 'Details' },
    ]}
  >
    <EmptyState slot="empty" code={filtered ? 'no matches' : '0 entries'} title="No entries match." />
    {data.items.map((a) => (
      <tr>
        <Cell class="kz-dt__nw" tone="mute">
          <span class="kz-amono">{harareStamp(a.created_at)}</span>
        </Cell>
        <Cell tone="mute">{a.actor_name ?? (a.actor_type === 'staff' ? 'Former user' : a.actor_type)}</Cell>
        <Cell m="main">
          <span class="kz-dt__strong kz-amono">{a.action}</span>
          <span class="kz-dt__ph">
            <span class="kz-dt__sub is-text">
              {a.actor_name ?? (a.actor_type === 'staff' ? 'Former user' : a.actor_type)} · {harareStamp(a.created_at)}
            </span>
          </span>
        </Cell>
        <Cell m="meta" tone="mute">
          {a.entity_id ? (
            <a class="kz-amono" href={`/admin/audit${qs({ entityId: a.entity_id, entityType: undefined })}`}>
              {a.entity_type} · {a.entity_id}
            </a>
          ) : (
            (a.entity_type ?? '')
          )}
        </Cell>
        <Cell m="acts">
          {a.before || a.after ? (
            <details class="kz-apay">
              <summary>Show</summary>
              {a.before ? <pre>Before: {a.before}</pre> : null}
              {a.after ? <pre>After: {a.after}</pre> : null}
            </details>
          ) : (
            <span class="kz-dt__dash">–</span>
          )}
        </Cell>
      </tr>
    ))}
  </DataTable>
  {filter.page > 1 || data.hasMore ? (
    <nav aria-label="Pages" class="kz-apager">
      {filter.page > 1 ? (
        <Button variant="secondary" size="sm" href={qs({ page: filter.page - 1 })} lead="chevron-left">
          Newer
        </Button>
      ) : (
        <span class="kz-apager__gap" />
      )}
      <span class="kz-apager__pos">page {filter.page}</span>
      {data.hasMore ? (
        <Button variant="secondary" size="sm" href={qs({ page: filter.page + 1 })} icon="chevron-right">
          Older
        </Button>
      ) : (
        <span class="kz-apager__gap" />
      )}
    </nav>
  ) : null}
</AdminLayout>
