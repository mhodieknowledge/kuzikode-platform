---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { loadPortalPage } from '../../server/lib/portal-page';
import { getSettings, settingText } from '../../server/modules/cms';
import { portalOverview, type PortalActivityKind } from '../../server/modules/portal';
import { formatMoney } from '../../shared/money';
import { PROJECT_STATUS_LABEL } from '../../shared/projects';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request);
if (page instanceof Response) return page;
const settings = await getSettings(ctx);
const contactEmail = settingText(settings, 'contact.email');
const firstName = page.auth.user.name.split(/\s+/)[0] ?? page.auth.user.name;
const linked = page.clients.length > 0;
const overview = linked ? await portalOverview(ctx) : null;

const dateFmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'Africa/Harare' });
/** Calendar dates (YYYY-MM-DD) are shown as they are; timestamps in Harare time. */
const day = (value: string) => dateFmt.format(new Date(value.length === 10 ? `${value}T12:00:00Z` : value));
const KIND_LABEL: Record<PortalActivityKind, string> = {
  invoice: 'Invoice',
  quotation: 'Quotation',
  payment: 'Payment',
  project_update: 'Project update',
};
const card = 'rounded-lg border border-line bg-surface p-5 md:p-6';
/** Every activity item opens its record. */
const ACTIVITY_PATH: Record<PortalActivityKind, (id: string) => string> = {
  quotation: (id) => `/portal/quotations/${id}`,
  invoice: (id) => `/portal/invoices/${id}`,
  payment: () => '/portal/payments',
  project_update: (id) => `/portal/projects/${id}`,
};
const activityHref = (a: { kind: PortalActivityKind; targetId: string }) => ACTIVITY_PATH[a.kind](a.targetId);
---

<PortalLayout title="Overview" page={page} active="overview">
  <h1 class="text-2xl font-bold tracking-display md:text-3xl">Hello, {firstName}</h1>
  {!linked || !overview ? (
    <section
      class="mt-6 max-w-2xl rounded-lg border border-line bg-canvas p-6 md:p-8"
      aria-labelledby="pending-title"
      data-testid="portal-unlinked"
    >
      <h2 id="pending-title" class="font-sans text-lg font-semibold">
        Your account is waiting to be linked
      </h2>
      <p class="mt-2 text-ink-600">
        Our team links each portal account to the right company before any documents are shown. We will let you know
        when that is done. You can already update your details and security settings.
      </p>
      <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href="/portal/account" class="font-semibold text-brand-600 underline underline-offset-2">
          Your account
        </a>
        {contactEmail ? (
          <a href={`mailto:${contactEmail}`} class="font-semibold text-brand-600 underline underline-offset-2">
            Email {contactEmail}
          </a>
        ) : null}
      </p>
    </section>
  ) : (
    <>
      <p class="mt-1 text-ink-600">{page.clients.map((c) => c.name).join(', ')}</p>

      {overview.areas.finance ? (
        <section class="mt-8" aria-labelledby="balance-title">
          <h2 id="balance-title" class="font-sans text-lg font-semibold">
            Balance
          </h2>
          {overview.balances.length === 0 ? (
            <p class={`mt-3 ${card} text-ink-600`} data-testid="portal-paid-up">
              You have nothing to pay right now.
            </p>
          ) : (
            <ul class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label="Outstanding balance by currency">
              {overview.balances.map((b) => (
                <li class={card} data-testid={`portal-balance-${b.currency}`}>
                  <p class="text-sm font-medium text-ink-600">Outstanding · {b.currency}</p>
                  <p class="mt-1 font-mono text-2xl font-semibold tabular-nums text-ink-950">
                    {formatMoney(b.outstandingMinor, b.currency)}
                  </p>
                  <p class="mt-2 text-sm text-ink-600">
                    <a href="/portal/invoices" class="underline underline-offset-2 hover:text-ink-950">
                      {b.openInvoices} open {b.openInvoices === 1 ? 'invoice' : 'invoices'}
                    </a>
                  </p>
                  {b.overdueMinor > 0 ? (
                    <p class="mt-1 text-sm font-semibold text-danger-700">
                      {formatMoney(b.overdueMinor, b.currency)} overdue ({b.overdueInvoices}{' '}
                      {b.overdueInvoices === 1 ? 'invoice' : 'invoices'})
                    </p>
                  ) : null}
                </li>
              ))}
            </ul>
          )}
        </section>
      ) : null}

      <div class="mt-8 grid gap-8 lg:grid-cols-2">
        {overview.areas.quotations ? (
          <section aria-labelledby="quotes-title">
            <h2 id="quotes-title" class="font-sans text-lg font-semibold">
              Quotations waiting for you{overview.quotations.total ? ` (${overview.quotations.total})` : ''}
            </h2>
            {overview.quotations.items.length === 0 ? (
              <p class={`mt-3 ${card} text-ink-600`}>No quotations are waiting for your answer.</p>
            ) : (
              <ul class="mt-3 divide-y divide-line rounded-lg border border-line bg-surface">
                {overview.quotations.items.map((q) => (
                  <li class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1 px-5 py-4">
                    <div class="min-w-0">
                      <a
                        href={`/portal/quotations/${q.id}`}
                        class="font-semibold text-ink-950 underline-offset-2 hover:underline"
                      >
                        {q.title}
                      </a>
                      <p class="text-sm text-ink-600">
                        <span class="font-mono">{q.number}</span>
                        {q.validUntil ? ` · valid until ${day(q.validUntil)}` : ''}
                      </p>
                    </div>
                    <p class="font-mono font-semibold tabular-nums text-ink-950">
                      {formatMoney(q.totalMinor, q.currency)}
                    </p>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ) : null}

        {overview.areas.projects ? (
          <section aria-labelledby="projects-title">
            <h2 id="projects-title" class="font-sans text-lg font-semibold">
              Active projects{overview.projects.total ? ` (${overview.projects.total})` : ''}
            </h2>
            {overview.projects.items.length === 0 ? (
              <p class={`mt-3 ${card} text-ink-600`}>No projects are in progress.</p>
            ) : (
              <ul class="mt-3 divide-y divide-line rounded-lg border border-line bg-surface">
                {overview.projects.items.map((p) => (
                  <li class="px-5 py-4">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                      <a
                        href={`/portal/projects/${p.id}`}
                        class="font-semibold text-ink-950 underline-offset-2 hover:underline"
                      >
                        {p.name}
                      </a>
                      <p class="text-sm text-ink-600">{PROJECT_STATUS_LABEL[p.status]}</p>
                    </div>
                    <div class="mt-2 flex items-center gap-3">
                      <div
                        class="h-2 flex-1 overflow-hidden rounded-full bg-ink-950/10"
                        role="progressbar"
                        aria-label={`${p.name} progress`}
                        aria-valuemin="0"
                        aria-valuemax="100"
                        aria-valuenow={p.progressPct}
                      >
                        <div class="h-full rounded-full bg-brand-600" style={`width: ${p.progressPct}%`} />
                      </div>
                      <span class="w-10 text-right font-mono text-sm tabular-nums text-ink-800">{p.progressPct}%</span>
                    </div>
                    {p.nextMilestone ? (
                      <p class="mt-2 text-sm text-ink-600">
                        Next: {p.nextMilestone.title}
                        {p.nextMilestone.dueDate ? `, due ${day(p.nextMilestone.dueDate)}` : ''}
                      </p>
                    ) : p.targetDate ? (
                      <p class="mt-2 text-sm text-ink-600">Target date {day(p.targetDate)}</p>
                    ) : null}
                  </li>
                ))}
              </ul>
            )}
          </section>
        ) : null}
      </div>

      <section class="mt-8 max-w-3xl" aria-labelledby="activity-title">
        <h2 id="activity-title" class="font-sans text-lg font-semibold">
          Recent activity
        </h2>
        {overview.activity.length === 0 ? (
          <p class={`mt-3 ${card} text-ink-600`}>Nothing yet. New documents, payments and project updates show here.</p>
        ) : (
          <ol class="mt-3 divide-y divide-line rounded-lg border border-line bg-surface" data-testid="portal-activity">
            {overview.activity.map((a) => (
              <li class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1 px-5 py-4">
                <div class="min-w-0">
                  <p class="text-[13px] font-semibold uppercase tracking-wide text-ink-600">
                    {KIND_LABEL[a.kind]} · <time datetime={a.at}>{day(a.at)}</time>
                  </p>
                  <p class="mt-0.5 font-medium text-ink-950">
                    <a href={activityHref(a)} class="underline-offset-2 hover:underline">
                      {a.title}
                    </a>
                  </p>
                  {a.detail ? <p class="mt-0.5 line-clamp-2 text-sm text-ink-600">{a.detail}</p> : null}
                </div>
                {a.amountMinor !== null && a.currency ? (
                  <p class="font-mono tabular-nums text-ink-950">{formatMoney(a.amountMinor, a.currency)}</p>
                ) : null}
              </li>
            ))}
          </ol>
        )}
      </section>

      {contactEmail ? (
        <p class="mt-8 text-sm text-ink-600">
          Questions? Email{' '}
          <a href={`mailto:${contactEmail}`} class="font-semibold text-brand-600 underline underline-offset-2">
            {contactEmail}
          </a>
          .
        </p>
      ) : null}
    </>
  )}
</PortalLayout>
