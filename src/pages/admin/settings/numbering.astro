---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import SettingsNav from '../../../components/admin/SettingsNav.astro';
import { NumberingRowForm } from '../../../components/admin/SettingsAdmin';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { numbering } from '../../../server/modules/settings';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'settings.view' });
if (page instanceof Response) return page;
const rows = await numbering(ctx);
const canEdit = page.auth.permissions.has('numbering.manage');
---

<AdminLayout title="Numbering" page={page}>
  <SettingsNav current="numbering" canExport={page.auth.permissions.has('data.export')} />
  <section class="mt-6 max-w-5xl rounded-lg border border-line bg-surface p-6" aria-labelledby="num-title">
    <h2 id="num-title" class="font-sans text-base font-semibold">
      Document numbers
    </h2>
    <p class="mt-1 text-sm text-ink-600">
      Use <code class="font-mono">{'{YYYY}'}</code> or <code class="font-mono">{'{YY}'}</code> for the year (numbering
      restarts each year) and
      <code class="font-mono">{'{SEQ:5}'}</code> for a zero-padded number. The next number can be raised but never
      lowered, so numbers are never reused.
      {canEdit ? '' : ' Only a Super Administrator can change numbering.'}
    </p>
    <div class="mt-4">
      {rows.map((r) => (
        <NumberingRowForm
          client:visible
          kind={r.kind}
          label={r.label}
          format={r.format}
          nextValue={r.nextValue}
          example={r.example}
          canEdit={canEdit}
        />
      ))}
    </div>
  </section>
</AdminLayout>
