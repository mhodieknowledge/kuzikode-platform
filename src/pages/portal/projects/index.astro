---
/**
 * Workspace projects (R5.2, PANEL_DESIGN_SPEC §2). Phones and tablets: the list window. From 1024 px: master/detail, the list in
 * the left 4 columns and a "Schedule" window in the right 8 (counts, upcoming targets by date). Opening a project keeps the list
 * beside it (see [id].astro).
 */
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PageHead from '../../../ui/workspace/PageHead.astro';
import Window from '../../../ui/workspace/Window.astro';
import ProjectList from '../../../ui/workspace/projects/ProjectList.astro';
import { loadPortalPage } from '../../../server/lib/portal-page';
import { listPortalProjects } from '../../../server/modules/projects';
import { PROJECT_STATUS_LABEL } from '../../../shared/projects';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request, { area: 'projects' });
if (page instanceof Response) return page;
const projects = await listPortalProjects(ctx);
const multiClient = page.clients.length > 1;
const finishedStates = new Set(['completed', 'cancelled']);
const running = projects.filter((p) => !finishedStates.has(p.status));
const unread = projects.reduce((n, p) => n + p.unreadMessages, 0);
const upcoming = running
  .filter((p) => p.targetDate)
  .sort((a, b) => (a.targetDate ?? '').localeCompare(b.targetDate ?? ''));
const undated = running.filter((p) => !p.targetDate);
const stats = [
  { label: 'In progress', value: running.length },
  { label: 'Finished', value: projects.length - running.length },
  { label: 'New messages', value: unread },
];
---

<PortalLayout title="Projects" page={page} active="projects">
  <PageHead
    title="Projects"
    sub={projects.length ? 'Follow milestones, updates and files for each piece of work.' : undefined}
  />
  {projects.length === 0 ? (
    <div class="kz-wgrid">
      <Window title="Projects" icon="projects" span={8} id="none">
        <div class="kz-wnote">
          <p class="kz-wnote__code">no projects yet</p>
          <p>There are no projects yet. Once work starts, you can follow it here.</p>
        </div>
      </Window>
    </div>
  ) : (
    <div class="kz-pview">
      <ProjectList projects={projects} multiClient={multiClient} class="kz-pview__list" />
      <Window title="Schedule" icon="calendar" id="schedule" class="kz-pview__aside">
        <dl class="kz-pstats">
          {stats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))}
        </dl>
        {upcoming.length || undated.length ? (
          <ol class="kz-sched" aria-label="Target dates">
            {upcoming.map((p) => (
              <li>
                <span class="kz-sched__at">{formatLongDate(p.targetDate ?? '')}</span>
                <span class="kz-sched__name">{p.name}</span>
                <span class="kz-sched__state">{PROJECT_STATUS_LABEL[p.status]}</span>
              </li>
            ))}
            {undated.map((p) => (
              <li>
                <span class="kz-sched__at">no target date</span>
                <span class="kz-sched__name">{p.name}</span>
                <span class="kz-sched__state">{PROJECT_STATUS_LABEL[p.status]}</span>
              </li>
            ))}
          </ol>
        ) : (
          <p class="kz-wnote">Every project is finished. Their files and messages stay here.</p>
        )}
        <p class="kz-sched__hint">Open a project on the left for its milestones, updates, files and messages.</p>
      </Window>
    </div>
  )}
</PortalLayout>
