---
/** One subscription (R6.2): head with status and actions; billing terms, next invoice preview, invoiced periods, linked services. */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import Pane from '../../../../ui/admin/Pane.astro';
import DetailList from '../../../../ui/admin/DetailList.astro';
import StatusPill from '../../../../ui/primitives/StatusPill.astro';
import { SubscriptionActions } from '../../../../ui/admin/subscriptions/SubscriptionActions';
import { INVOICE_STATUS_TONE, SUBSCRIPTION_STATUS } from '../../../../ui/admin/finance/labels';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { AppError } from '../../../../server/lib/errors';
import { ASSET_TYPE_LABELS, getSubscription, periodLabel } from '../../../../server/modules/subscriptions';
import { INVOICE_STATUS_LABEL } from '../../../../shared/invoices';
import { formatMoney, formatQuantity } from '../../../../shared/money';
import { formatLongDate } from '../../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'subscriptions.view' });
if (page instanceof Response) return page;
let data;
try {
  data = await getSubscription(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const s = data.subscription;
const canManage = page.auth.permissions.has('subscriptions.manage');
const status = SUBSCRIPTION_STATUS[s.status] ?? { label: s.status, long: s.status, tone: 'neutral' as const };
const fmt = (m: number) => formatMoney(m, s.currency);
const saved = Astro.url.searchParams.get('saved') === '1';
const terms = [
  { label: 'Quantity', value: formatQuantity(s.quantity_milli), mono: true },
  {
    label: 'Unit price',
    value: `${fmt(s.unit_price_minor)} per ${s.interval === 'month' ? 'month' : 'year'}`,
    mono: true,
  },
  { label: 'Started', value: formatLongDate(s.start_date) },
  {
    label: 'Invoices',
    value: s.auto_issue === 1 ? 'Issued and emailed automatically' : 'Created as drafts for review',
  },
  ...(s.cancelled_at
    ? [
        {
          label: 'Cancelled',
          value: `${formatLongDate(s.cancelled_at)}${s.cancel_reason ? ` · ${s.cancel_reason}` : ''}`,
        },
      ]
    : []),
];
---

<AdminLayout title={s.description} page={page}>
  <PageHead
    title={s.description}
    crumbs={[{ label: 'Subscriptions', href: '/admin/subscriptions' }, { label: s.description }]}
  >
    <Fragment slot="meta">
      <StatusPill tone={status.tone}>{status.long}</StatusPill> ·{' '}
      <a href={`/admin/clients/${data.client.id}`}>{data.client.display_name}</a>
      {data.package ? ` · ${data.package.name}` : ''}
      {data.quotation?.number ? (
        <>
          {' '}
          · from <a href={`/admin/quotations/${data.quotation.id}`}>{data.quotation.number}</a>
        </>
      ) : null}
    </Fragment>
    {canManage && ['active', 'at_risk', 'paused'].includes(s.status) ? (
      <SubscriptionActions slot="actions" client:load id={s.id} status={s.status} />
    ) : null}
  </PageHead>
  {saved ? (
    <div class="kz-anotices">
      <p role="status" class="kz-anotice kz-anotice--ok">
        Saved. Changes apply to periods that haven&apos;t been invoiced yet.
      </p>
    </div>
  ) : null}
  <div class="kz-agrid kz-agrid--2">
    <Pane title="Billing terms" id="terms-title">
      <DetailList items={terms} rows />
    </Pane>
    <Pane title="Next invoice" id="next-title">
      {data.nextInvoice ? (
        <div data-testid="next-invoice" class="kz-astack">
          <p>{data.nextInvoice.description}</p>
          <p class="kz-afeed__t">
            {s.status === 'paused'
              ? 'Not billed while paused.'
              : `Created on or before ${formatLongDate(s.next_billing_date)}.`}
          </p>
          <DetailList
            rows
            items={[
              { label: 'Subtotal', value: fmt(data.nextInvoice.subtotalMinor), mono: true },
              { label: 'Tax', value: fmt(data.nextInvoice.taxMinor), mono: true },
              { label: 'Total', value: fmt(data.nextInvoice.totalMinor), mono: true },
            ]}
          />
        </div>
      ) : (
        <p class="kz-afeed__t">No further invoices: this subscription is {s.status}.</p>
      )}
    </Pane>
  </div>
  <div class="kz-agrid kz-agap">
    <Pane title="Invoiced periods" id="history-title" flush>
      {data.periods.length === 0 ? (
        <p class="kz-anone">
          <span class="kz-anone__code">0 periods</span>No periods invoiced yet.
        </p>
      ) : (
        <ul class="kz-alist" role="list">
          {data.periods.map((p) => (
            <li>
              <div class="kz-alist__main">
                <a href={`/admin/invoices/${p.invoice_id}`} class="kz-alist__t">
                  {p.number ?? 'Draft invoice'}
                </a>
                <span class="kz-alist__m">{periodLabel(p.period_start, p.period_end)}</span>
              </div>
              <StatusPill tone={INVOICE_STATUS_TONE[p.status] ?? 'neutral'}>
                {INVOICE_STATUS_LABEL[p.status as keyof typeof INVOICE_STATUS_LABEL] ?? p.status}
              </StatusPill>
              <span class="kz-alist__r">{fmt(p.total_minor)}</span>
            </li>
          ))}
        </ul>
      )}
    </Pane>
    {data.assets.length ? (
      <Pane title="Linked services" id="assets-title" flush>
        <ul class="kz-alist" role="list">
          {data.assets.map((a) => (
            <li>
              <div class="kz-alist__main">
                <a href={`/admin/assets/${a.id}`} class="kz-alist__t">
                  {ASSET_TYPE_LABELS[a.type] ?? a.type}: {a.name}
                </a>
              </div>
              <span class="kz-alist__r is-date">
                {a.renewal_date ? `Renews ${formatLongDate(a.renewal_date)}` : 'No renewal date'}
              </span>
            </li>
          ))}
        </ul>
      </Pane>
    ) : null}
  </div>
</AdminLayout>
