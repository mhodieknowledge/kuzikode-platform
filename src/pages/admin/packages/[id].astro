---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { PackageForm } from '../../../components/admin/PackagesAdmin';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { AppError } from '../../../server/lib/errors';
import { can } from '../../../server/lib/policies';
import { getPackageAdmin, packageFormOptions, packageInUse } from '../../../server/modules/packages';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'packages.manage' });
if (page instanceof Response) return page;
let p;
try {
  p = await getPackageAdmin(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const [{ services, currencies }, inUse] = await Promise.all([packageFormOptions(ctx), packageInUse(ctx, p.id)]);
if (p.currency && !currencies.includes(p.currency)) currencies.push(p.currency);
const initial = {
  id: p.id,
  serviceId: p.serviceId,
  slug: p.slug,
  name: p.name,
  tagline: p.tagline,
  billingType: p.billingType,
  interval: p.interval,
  priceType: p.priceType,
  priceMinor: p.priceMinor,
  currency: p.currency,
  priceUnit: p.priceUnit,
  altPriceZwgMinor: p.altPriceZwgMinor,
  annualPriceMinor: p.annualPriceMinor,
  minQuantity: p.minQuantity,
  deliveryTime: p.deliveryTime,
  revisionRounds: p.revisionRounds,
  supportPeriod: p.supportPeriod,
  mostPopular: p.mostPopular,
  tab: p.tab,
  status: p.status,
  costNote: p.costNote,
  priceReviewRequired: p.priceReviewRequired,
  features: p.features,
};
---

<AdminLayout title={p.name} page={page}>
  <nav aria-label="Breadcrumb" class="text-[13px] text-ink-600">
    <a href="/admin/packages" class="hover:text-ink-950 hover:underline">
      Packages
    </a>{' '}
    / <span class="text-ink-950">{p.name}</span>
  </nav>
  <h1 class="mt-2 mb-6 text-2xl font-bold tracking-display">{p.name}</h1>
  <div class="max-w-4xl">
    <PackageForm
      client:load
      initial={initial}
      services={services}
      currencies={currencies}
      inUse={inUse}
      canReview={can(ctx, 'packages.price_review')}
    />
  </div>
</AdminLayout>
