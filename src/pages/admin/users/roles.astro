---
/** Roles and permissions (R6.2 group 3): role cards, the permission matrix in its own scroll box (table name is the e2e contract). */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Icon from '../../../ui/icons/Icon.astro';
import { RoleEditor } from '../../../ui/admin/users/RoleEditor';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listRoles } from '../../../server/modules/users';
import { PERMISSIONS, SUPER_ADMIN_ONLY, type Permission } from '../../../shared/permissions';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'users.view' });
if (page instanceof Response) return page;
const roles = await listRoles(ctx);
const canEdit = page.auth.permissions.has('roles.manage');
const modules = new Map<string, { key: Permission; description: string }[]>();
for (const [key, [module, description]] of Object.entries(PERMISSIONS) as [Permission, readonly [string, string]][]) {
  if (!modules.has(module)) modules.set(module, []);
  modules.get(module)!.push({ key, description });
}
const groups = [...modules].map(([module, items]) => ({
  module,
  items: items.map((i) => ({ key: i.key, description: i.description, reserved: SUPER_ADMIN_ONLY.includes(i.key) })),
}));
const has = (role: (typeof roles)[number], p: Permission) => role.key === 'super_admin' || role.permissions.includes(p);
---

<AdminLayout title="Roles and permissions" page={page}>
  <PageHead
    title="Roles and permissions"
    meta={`System roles are fixed. ${canEdit ? 'You can add custom roles.' : 'A Super Administrator can add custom roles.'}`}
    crumbs={[{ label: 'Users', href: '/admin/users' }, { label: 'Roles' }]}
  >
    <Fragment slot="actions">{canEdit ? <RoleEditor client:load groups={groups} /> : null}</Fragment>
  </PageHead>
  <ul class="kz-aroles">
    {roles.map((r) => (
      <li class="kz-arole">
        <div class="kz-arole__top">
          <div>
            <p class="kz-arole__name">{r.name}</p>
            <p class="kz-arole__meta">
              {r.system ? 'System role' : 'Custom role'} · {r.members} {r.members === 1 ? 'person' : 'people'}
            </p>
          </div>
          {canEdit && !r.system ? <RoleEditor client:visible groups={groups} role={r} /> : null}
        </div>
        {r.description ? <p class="kz-arole__d">{r.description}</p> : null}
      </li>
    ))}
  </ul>
  <h2 class="kz-ashead" style="margin-top:24px">
    Permission matrix
  </h2>
  <section class="kz-apane kz-amwrap" aria-label="Permission matrix">
    <div class="kz-apane__body is-flush">
      <div class="kz-rscroll" tabindex="0" role="region" aria-label="Scrollable table">
        <table class="kz-amatrix">
          <caption class="sr-only">Which roles hold each permission</caption>
          <thead>
            <tr>
              <th scope="col">Permission</th>
              {roles.map((r) => (
                <th scope="col">{r.name}</th>
              ))}
            </tr>
          </thead>
          {groups.map((g) => (
            <tbody>
              <tr>
                <th scope="colgroup" colspan={roles.length + 1}>
                  {g.module}
                </th>
              </tr>
              {g.items.map((p) => (
                <tr>
                  <th scope="row">
                    {p.description}
                    <span>
                      {p.key}
                      {p.reserved ? ' · Super Administrator only' : ''}
                    </span>
                  </th>
                  {roles.map((r) => (
                    <td>
                      {has(r, p.key as Permission) ? (
                        <>
                          <span class="is-yes">
                            <Icon name="check" size={16} />
                          </span>
                          <span class="sr-only">Yes</span>
                        </>
                      ) : (
                        <>
                          <span class="is-no" aria-hidden="true">
                            –
                          </span>
                          <span class="sr-only">No</span>
                        </>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>
  </section>
</AdminLayout>
