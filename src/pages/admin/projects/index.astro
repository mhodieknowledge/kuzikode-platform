---
/** Projects (R6.2 group 3): filters (sheet on phones), dense table → list rows with a progress bar and status. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Pager from '../../../ui/admin/Pager.astro';
import Button from '../../../ui/primitives/Button.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import { FilterBar } from '../../../ui/admin/FilterBar';
import { PROJECT_STATUS_TONE } from '../../../ui/admin/projects/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listProjects } from '../../../server/modules/projects';
import { projectListQuery } from '../../../shared/schemas/projects';
import { PROJECT_STATUS_LABEL } from '../../../shared/projects';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { anyOf: ['projects.view', 'projects.view_all'] });
if (page instanceof Response) return page;
const parsed = projectListQuery.safeParse(Object.fromEntries(Astro.url.searchParams));
const filter = parsed.success ? parsed.data : projectListQuery.parse({});
const result = await listProjects(ctx, filter);
const canCreate = page.auth.permissions.has('projects.manage');
const pageHref = (n: number) => {
  const q = new URLSearchParams(Astro.url.searchParams);
  q.set('page', String(n));
  return `/admin/projects?${q.toString()}`;
};
const filtered = !!(filter.q || (filter.status && filter.status !== 'open'));
---

<AdminLayout title="Projects" page={page}>
  <PageHead title="Projects" meta={`${result.total} ${result.total === 1 ? 'project' : 'projects'}`}>
    <Fragment slot="actions">
      {canCreate ? (
        <Button href="/admin/projects/new" lead="add">
          New project
        </Button>
      ) : null}
    </Fragment>
  </PageHead>
  <div class="kz-atools">
    <FilterBar
      client:load
      label="Filter projects"
      hidden={filter.clientId ? { clientId: filter.clientId } : {}}
      clearHref="/admin/projects"
      fields={[
        { kind: 'search', name: 'q', label: 'Search', value: filter.q ?? '', placeholder: 'Reference, name or client' },
        {
          kind: 'select',
          name: 'status',
          label: 'Status',
          value: filter.status ?? 'open',
          options: [
            { value: 'open', label: 'Open (planning, active, on hold)' },
            ...Object.entries(PROJECT_STATUS_LABEL).map(([value, label]) => ({ value, label })),
            { value: 'all', label: 'All' },
          ],
        },
      ]}
    />
  </div>
  <DataTable
    caption="Projects"
    count={result.items.length}
    columns={[
      { label: 'Project' },
      { label: 'Client' },
      { label: 'Status' },
      { label: 'Progress' },
      { label: 'Target' },
    ]}
  >
    <EmptyState
      slot="empty"
      code={filtered ? 'no matches' : '0 open'}
      title={filtered ? 'No projects match these filters.' : 'No open projects.'}
    >
      Projects are created from an accepted quotation or by hand.
    </EmptyState>
    {result.items.map((p) => (
      <tr>
        <Cell
          m="main"
          href={`/admin/projects/${p.id}`}
          title={p.name}
          sub={`${p.reference}${p.lead ? ` · ${p.lead}` : ''}`}
        />
        <Cell m="meta" tone="mute">
          <span>{p.client_name}</span>
          {p.target_date ? <span class="kz-dt__ph"> · target {formatLongDate(p.target_date)}</span> : null}
        </Cell>
        <Cell m="status">
          <StatusPill tone={PROJECT_STATUS_TONE[p.status]}>{PROJECT_STATUS_LABEL[p.status]}</StatusPill>
        </Cell>
        <Cell m="amount">
          <span class="kz-aprog kz-aprog--sm">
            <span class="kz-aprog__row">
              <span class="kz-aprog__pct">{p.progress_pct}%</span>
            </span>
            <span class="kz-aprog__bar" aria-hidden="true">
              <i style={`width:${p.progress_pct}%`} />
            </span>
          </span>
        </Cell>
        <Cell tone="mute">{p.target_date ? formatLongDate(p.target_date) : '—'}</Cell>
      </tr>
    ))}
  </DataTable>
  <Pager page={result.page} pages={result.pages} href={pageHref} />
</AdminLayout>
