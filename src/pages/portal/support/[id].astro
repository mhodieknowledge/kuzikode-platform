---
/**
 * Workspace support request (R5.4, PANEL_DESIGN_SPEC §2 "ticket list + conversation window"). From 1024 px: master/detail, the
 * requests list in the left 4 columns (this one marked current) and the conversation window in the right 8: the thread (mono
 * timestamps, attachments under each message), the reply composer, and "Mark as resolved" at the foot. Below 1024 px the list is
 * left out and "Support" goes back.
 */
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PageHead from '../../../ui/workspace/PageHead.astro';
import Window from '../../../ui/workspace/Window.astro';
import SupportList from '../../../ui/workspace/support/SupportList.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import Icon from '../../../ui/icons/Icon.astro';
import { ReplyComposer } from '../../../ui/workspace/support/ReplyComposer';
import { ResolveButton } from '../../../ui/workspace/support/ResolveButton';
import { SUPPORT_TONE } from '../../../ui/workspace/support/tone';
import { loadPortalPage } from '../../../server/lib/portal-page';
import { getPortalRequest, listPortalRequests } from '../../../server/modules/support/portal';
import { AppError } from '../../../server/lib/errors';
import { harareDateTime } from '../../../shared/devices';
import { formatLongDate } from '../../../shared/service-display';
import { portalSupportStatus } from '../../../shared/support';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request, { area: 'support' });
if (page instanceof Response) return page;
let data;
try {
  data = await getPortalRequest(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND') return new Response(null, { status: 404 });
  throw err;
}
const requests = await listPortalRequests(ctx, { show: 'all' });
const r = data.request;
const multiClient = page.clients.length > 1;
const size = (b: number) =>
  b >= 1_048_576 ? `${(b / 1_048_576).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`;
const n = data.messages.length;
---

<PortalLayout title={r.subject} page={page} active="support">
  <PageHead title={r.subject} back={{ href: '/portal/support', label: 'Support' }}>
    <Fragment slot="meta">
      <p class="kz-wshead__tags">
        <span class="kz-wmono">{r.reference}</span>
        <StatusPill tone={SUPPORT_TONE[r.status]}>{portalSupportStatus(r.status)}</StatusPill>
      </p>
      <p class="kz-sfacts">
        <span>{r.category}</span>
        <span>opened {formatLongDate(r.createdAt)}</span>
        {multiClient ? <span>{r.clientName}</span> : null}
        {r.project ? (
          <span>
            <a href={`/portal/projects/${r.project.id}`}>{r.project.name}</a>
          </span>
        ) : null}
      </p>
    </Fragment>
  </PageHead>

  <div class="kz-pview">
    <SupportList
      requests={requests}
      multiClient={multiClient}
      title="Requests"
      current={r.id}
      class="kz-pview__list is-side"
    />

    <div class="kz-pview__main">
      <Window title="Conversation" icon="send" id="conversation" meta={`${n} ${n === 1 ? 'message' : 'messages'}`}>
        <ol class="kz-thread" data-testid="support-thread">
          {data.messages.map((m) => (
            <li class:list={['kz-msg', m.mine ? 'is-mine' : m.fromTeam ? 'is-team' : 'is-other']}>
              <p class="kz-msg__who">
                {m.mine ? 'You' : m.fromTeam ? `${m.author} · Kuzikode` : m.author}
                <time datetime={m.createdAt}>{harareDateTime(m.createdAt)}</time>
              </p>
              <p class="kz-msg__body">{m.body}</p>
              {m.attachments.length ? (
                <ul class="kz-msg__files" aria-label="Attachments">
                  {m.attachments.map((f) => (
                    <li>
                      <Icon name="download" size={16} />
                      <a href={`/api/v1/portal/files/${f.fileId}`} download>
                        {f.name}
                      </a>
                      <span class="kz-msg__size">{size(f.size)}</span>
                    </li>
                  ))}
                </ul>
              ) : null}
            </li>
          ))}
        </ol>

        {r.status === 'closed' ? (
          <div class="kz-compose-wrap is-after">
            <div class="kz-wnote">
              <p class="kz-wnote__code">request closed</p>
              <p>
                If you still need help, <a href="/portal/support/new">open a new request</a>.
              </p>
            </div>
          </div>
        ) : (
          <Fragment>
            <div class="kz-compose-wrap is-after">
              <ReplyComposer client:visible requestId={r.id} reopens={r.status === 'resolved'} />
            </div>
            {r.status !== 'resolved' ? (
              <div class="kz-sresolve">
                <p>Problem solved? Let us know so we can close the request.</p>
                <ResolveButton client:visible requestId={r.id} />
              </div>
            ) : null}
          </Fragment>
        )}
      </Window>
    </div>
  </div>
</PortalLayout>
