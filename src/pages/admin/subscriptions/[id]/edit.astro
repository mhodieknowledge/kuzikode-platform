---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import { SubscriptionForm } from '../../../../ui/admin/subscriptions/SubscriptionForm';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { AppError } from '../../../../server/lib/errors';
import { formOptions, getSubscription } from '../../../../server/modules/subscriptions';
import { formatQuantity } from '../../../../shared/money';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'subscriptions.manage' });
if (page instanceof Response) return page;
let data;
try {
  data = await getSubscription(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const s = data.subscription;
if (!['active', 'at_risk', 'paused'].includes(s.status)) return Astro.redirect(`/admin/subscriptions/${s.id}`, 303);
const opts = await formOptions(ctx);
if (!opts.clients.some((c) => c.id === data.client.id))
  opts.clients.unshift({ id: data.client.id, name: data.client.display_name, currency: s.currency });
const initial = {
  id: s.id,
  clientId: s.client_id,
  packageId: s.package_id,
  description: s.description,
  quantity: formatQuantity(s.quantity_milli),
  unitPriceMinor: s.unit_price_minor,
  currency: s.currency,
  taxRateId: s.tax_rate_id,
  interval: s.interval,
  startDate: s.start_date,
  nextBillingDate: s.next_billing_date,
  autoIssue: s.auto_issue === 1,
};
---

<AdminLayout title={`Edit ${s.description}`} page={page}>
  <PageHead
    title="Edit subscription"
    crumbs={[
      { label: 'Subscriptions', href: '/admin/subscriptions' },
      { label: s.description, href: `/admin/subscriptions/${s.id}` },
      { label: 'Edit' },
    ]}
  />
  <SubscriptionForm
    client:load
    initial={initial}
    clients={opts.clients}
    packages={opts.packages}
    currencies={opts.currencies}
    taxRates={opts.taxRates}
    billed={data.periods.length > 0}
  />
</AdminLayout>
