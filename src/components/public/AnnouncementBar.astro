---
interface Props {
  announcement: { message: string; linkUrl: string | null; linkLabel: string | null; level: 'info' | 'important' } | null;
}
const { announcement: a } = Astro.props;
const safeLink = a?.linkUrl && (/^https:\/\//.test(a.linkUrl) || (a.linkUrl.startsWith('/') && !a.linkUrl.startsWith('//'))) ? a.linkUrl : null;
---

{
  a ? (
    <div role="region" aria-label="Announcement" class:list={['text-center text-sm', a.level === 'important' ? 'bg-accent-500 text-ink-950' : 'bg-brand-600 text-white']}>
      <p class="container-content py-2.5">
        {a.message}
        {safeLink ? (
          <a href={safeLink} class="ml-2 font-semibold underline underline-offset-2">
            {a.linkLabel ?? 'Learn more'}
          </a>
        ) : null}
      </p>
    </div>
  ) : null
}
