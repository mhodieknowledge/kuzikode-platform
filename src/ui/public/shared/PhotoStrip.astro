---
/**
 * Quiet full-width photograph (BRIEF B.4a: bands and editorial only). Decorative, warm duotone, fixed ratio so the page never
 * shifts. Phones 4:3, desktop 21:9. Illustrative imagery (never staff or clients).
 */
import Picture from '../../primitives/Picture.astro';

interface Props {
  image: string;
  contained?: boolean;
}
const { image, contained = false } = Astro.props;
---

<figure class:list={['kz-pstrip', contained && 'kz-pstrip--in']} aria-hidden="true">
  <div class="container-wide">
    <Picture id={image} alt="" tone="warm" class="kz-pstrip__img" sizes="(min-width: 1280px) 1200px, 100vw" />
  </div>
</figure>

<style>
  .kz-pstrip { margin: 0; padding-block: clamp(1.5rem, 4vw, 3.5rem); }
  .kz-pstrip--in { padding-block: 2rem 0; }
  .kz-pstrip :global(.kz-pstrip__img),
  .kz-pstrip :global(.kz-pstrip__img img) { display: block; width: 100%; }
  .kz-pstrip :global(.kz-pstrip__img img) { aspect-ratio: 4 / 3; object-fit: cover; border-radius: 12px; }
  @media (min-width: 768px) { .kz-pstrip :global(.kz-pstrip__img img) { aspect-ratio: 21 / 9; } }
</style>
