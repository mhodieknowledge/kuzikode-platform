---
/**
 * Home hero (R10.3, HOME_COMPOSITION §1): a full-bleed photograph under a dark overlay, content anchored at the bottom: tag pill,
 * the one H1, one-line sub, "Get a quote" (circular arrow) + WhatsApp, a row of five frosted division chips with section icons,
 * and two glass widgets (price tile, WhatsApp reply tile). Desktop: the widgets float right. The photo is only ever a background.
 */
import Picture from '../../primitives/Picture.astro';
import Icon from '../../icons/Icon.astro';
import { divisionIcon } from '../../icons/registry';
import type { SectionContent } from '../../../shared/schemas/cms';
import { divisionShortName, type FromPrice } from '../../../shared/directory';
import { HOME_IMAGES } from './images';

interface Props {
  content: SectionContent<'hero'>;
  divisions: { slug: string; name: string; href: string }[];
  websitesFrom: FromPrice | null;
  whatsapp?: string | undefined;
}
const { content: c, divisions, websitesFrom, whatsapp } = Astro.props;
const img = HOME_IMAGES.hero;
---

<section class="hm-hero on-night" aria-labelledby="hero-title">
  <Picture id={img.id} mobileId={img.mobileId} alt="" priority class="hm-bg" sizes="100vw" />
  <div class="hm-hero__shade" aria-hidden="true"></div>
  <div class="container-wide hm-hero__grid">
    <div class="hm-hero__copy">
      {c.eyebrow ? <p class="hm-pilltag">{c.eyebrow}</p> : null}
      <h1 id="hero-title" class="hm-hero__title">{c.title}</h1>
      <p class="hm-hero__sub">{c.body}</p>
      <div class="hm-hero__acts">
        <a class="hm-cta" href="/contact" data-hero-cta>
          <span>Get a quote</span>
          <span class="hm-cta__dot" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>
        </a>
        {
          whatsapp ? (
            <a class="hm-ghost" href={whatsapp} target="_blank" rel="noopener noreferrer">
              <Icon name="whatsapp" size={20} />
              <span>WhatsApp</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          ) : null
        }
      </div>
    </div>
    <ul class="hm-chips" role="list" aria-label="What we build">
      {
        divisions.map((d, i) => (
          <li class={`kz-div-${(i % 6) + 1}`}>
            <a href={d.href}>
              <Icon name={divisionIcon(d.slug)} size={20} />
              <span>{divisionShortName(d.slug, d.name)}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="hm-widgets">
      {
        websitesFrom ? (
          <a class="hm-glass hm-glass--price" href="/pricing">
            <span class="hm-glass__k">Websites from</span>
            <span class="hm-glass__v">{websitesFrom.amount}</span>
            <span class="hm-glass__go" aria-hidden="true"><Icon name="arrow-up-right" size={20} /></span>
          </a>
        ) : null
      }
      {
        whatsapp ? (
          <a class="hm-glass hm-glass--wa" href={whatsapp} target="_blank" rel="noopener noreferrer">
            <span class="hm-glass__ic" aria-hidden="true"><Icon name="whatsapp" size={20} /></span>
            <span class="hm-glass__k">We reply on WhatsApp</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        ) : null
      }
    </div>
  </div>
</section>
