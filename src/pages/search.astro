---
import PublicLayout from '../layouts/PublicLayout.astro';
import { MAX_QUERY_LENGTH, SEARCH_KIND_LABEL, searchSite } from '../server/modules/cms';

const { ctx } = Astro.locals;
const q = (Astro.url.searchParams.get('q') ?? '').slice(0, MAX_QUERY_LENGTH).trim();
const results = q ? await searchSite(ctx, q) : [];
---

<PublicLayout title={q ? `Search: ${q} · Kuzikode Technologies` : 'Search · Kuzikode Technologies'} noindex>
  <section class="bg-canvas py-14 md:py-20" aria-labelledby="search-title">
    <div class="container-content max-w-3xl">
      <h1 id="search-title" class="text-4xl font-bold tracking-display md:text-5xl">
        Search
      </h1>
      <form action="/search" method="get" role="search" class="mt-6 flex gap-2">
        <label for="site-search" class="sr-only">
          Search the site
        </label>
        <input
          id="site-search"
          name="q"
          type="search"
          value={q}
          maxlength={MAX_QUERY_LENGTH}
          placeholder="Services, packages, articles…"
          class="h-12 min-w-0 flex-1 rounded-sm border border-line bg-surface px-3 text-[15px] text-ink-950 placeholder:text-ink-400 hover:border-ink-400 focus-visible:border-brand-500 focus-visible:outline-2 focus-visible:outline-brand-500"
        />
        <button
          type="submit"
          class="inline-flex h-12 items-center rounded-sm bg-brand-600 px-5 text-[15px] font-semibold text-white hover:bg-brand-500"
        >
          Search
        </button>
      </form>
    </div>
  </section>
  <section class="bg-surface py-12 md:py-16" aria-label="Search results">
    <div class="container-content max-w-3xl">
      {!q ? (
        <p class="text-ink-600">Type a word or two, such as “website”, “EcoCash” or “email”.</p>
      ) : results.length === 0 ? (
        <p class="text-ink-600" role="status">
          No results for “{q}”. Try a different word, browse our{' '}
          <a href="/services" class="font-semibold text-brand-600 underline underline-offset-2">
            services
          </a>
          , or{' '}
          <a href="/contact" class="font-semibold text-brand-600 underline underline-offset-2">
            ask us
          </a>
          .
        </p>
      ) : (
        <>
          <p class="text-sm text-ink-600" role="status">
            {results.length} result{results.length === 1 ? '' : 's'} for “{q}”
          </p>
          <ol class="mt-6 divide-y divide-line border-y border-line">
            {results.map((r) => (
              <li class="py-5">
                <p class="text-[12px] font-semibold tracking-wide text-ink-600 uppercase">
                  {SEARCH_KIND_LABEL[r.kind]}
                </p>
                <a href={r.href} class="mt-1 block text-lg font-semibold text-ink-950 hover:underline">
                  {r.title}
                </a>
                {r.summary ? <p class="mt-1 line-clamp-2 text-[15px] leading-6 text-ink-600">{r.summary}</p> : null}
              </li>
            ))}
          </ol>
        </>
      )}
    </div>
  </section>
</PublicLayout>
