---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import PeriodForm from '../../../ui/admin/PeriodForm.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { EXPENSE_DISCLAIMER, expenseReport } from '../../../server/modules/expenses';
import { expenseReportQuery } from '../../../shared/schemas/expenses';
import { formatMoney } from '../../../shared/money';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'expenses.view' });
if (page instanceof Response) return page;
const parsed = expenseReportQuery.safeParse(Object.fromEntries(Astro.url.searchParams));
const range = parsed.success ? parsed.data : {};
const report = await expenseReport(ctx, range);
const monthLabel = (m: string) =>
  new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
    new Date(`${m}-01T00:00:00Z`),
  );
const exportQuery = new URLSearchParams({
  ...(range.from ? { from: range.from } : {}),
  ...(range.to ? { to: range.to } : {}),
});
---

<AdminLayout title="Expense report" page={page}>
  <PageHead
    title="Expense report"
    meta={`${EXPENSE_DISCLAIMER} Void expenses are left out.`}
    crumbs={[{ label: 'Expenses', href: '/admin/expenses' }, { label: 'Report' }]}
  />
  <div class="kz-atools">
    <PeriodForm label="Report period" from={range.from ?? ''} to={range.to ?? ''}>
      <a class="kz-btn kz-btn--quiet" href={`/api/v1/admin/expenses/export.csv?${exportQuery.toString()}`} download>
        <span>Export CSV</span>
      </a>
    </PeriodForm>
  </div>
  {report.totals.length === 0 ? (
    <EmptyState code="0 expenses" title="No expenses in this period." />
  ) : (
    <div class="kz-agrid kz-agrid--2">
      <Pane title="By category" id="cat-h" flush>
        <table class="kz-rt">
          <caption class="sr-only">Totals by category</caption>
          <thead>
            <tr>
              <th scope="col">Category</th>
              <th scope="col" class="is-num">
                Count
              </th>
              <th scope="col" class="is-num">
                Total
              </th>
            </tr>
          </thead>
          <tbody>
            {report.byCategory.map((r) => (
              <tr>
                <td>{r.category}</td>
                <td class="is-num">{r.n}</td>
                <td class="is-num">{formatMoney(r.total, r.currency)}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            {report.totals.map((t) => (
              <tr>
                <th scope="row">Total ({t.currency})</th>
                <td class="is-num">{t.n}</td>
                <td class="is-num">{formatMoney(t.total, t.currency)}</td>
              </tr>
            ))}
          </tfoot>
        </table>
      </Pane>
      <Pane title="By month" id="mon-h" flush>
        <table class="kz-rt">
          <caption class="sr-only">Totals by month</caption>
          <thead>
            <tr>
              <th scope="col">Month</th>
              <th scope="col" class="is-num">
                Count
              </th>
              <th scope="col" class="is-num">
                Total
              </th>
            </tr>
          </thead>
          <tbody>
            {report.byMonth.map((r) => (
              <tr>
                <td>{monthLabel(r.month)}</td>
                <td class="is-num">{r.n}</td>
                <td class="is-num">{formatMoney(r.total, r.currency)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </Pane>
    </div>
  )}
</AdminLayout>
