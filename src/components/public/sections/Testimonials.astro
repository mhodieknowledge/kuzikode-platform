---
/** Real, consented testimonials only (docs/12 §C.7). Renders nothing when none are published. */
import type { PublicTestimonial } from '../../../server/modules/cms';

interface Props {
  testimonials: PublicTestimonial[];
}
const { testimonials } = Astro.props;
---

{
  testimonials.length > 0 ? (
    <section class="bg-canvas py-14 md:py-20" aria-labelledby="testimonials-title" data-testimonials>
      <div class="container-content">
        <h2 id="testimonials-title" class="text-3xl font-bold tracking-display">
          What clients say
        </h2>
        <ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {testimonials.map((t) => (
            <li>
              <figure class="flex h-full flex-col rounded-lg border border-line bg-surface p-6">
                <blockquote class="flex-1 text-[16px] leading-7 text-ink-800">“{t.quote}”</blockquote>
                <figcaption class="mt-5 text-sm">
                  <span class="font-semibold text-ink-950">{t.author}</span>
                  {t.role ? <span class="block text-ink-600">{t.role}</span> : null}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ) : null
}
