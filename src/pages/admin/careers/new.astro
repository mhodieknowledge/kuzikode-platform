---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import { PostingForm } from '../../../ui/admin/careers/PostingForm';
import { loadAdminPage } from '../../../server/lib/admin-page';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'careers.manage' });
if (page instanceof Response) return page;
const currencies = (
  await ctx.db
    .prepare('SELECT code FROM currencies WHERE active = 1 ORDER BY is_default DESC, code')
    .all<{ code: string }>()
).results.map((r) => r.code);
const initial = {
  slug: '',
  title: '',
  department: '',
  location: 'Harare',
  employmentType: 'full_time' as const,
  workplace: 'hybrid' as const,
  salaryMinMinor: null,
  salaryMaxMinor: null,
  salaryCurrency: null,
  salaryPeriod: null,
  showSalary: false,
  summary: '',
  description: '',
  responsibilities: [],
  requirements: [],
  niceToHaves: [],
  offer: [],
  howToApply: null,
  questions: [],
  opensAt: null,
  closesAt: null,
};
---

<AdminLayout title="New posting" page={page}>
  <PageHead title="New posting" crumbs={[{ label: 'Careers', href: '/admin/careers' }, { label: 'New posting' }]} />
  <PostingForm client:load initial={initial} currencies={currencies} />
</AdminLayout>
