---
/**
 * Workspace overview (R5.2, PANEL_DESIGN_SPEC §2): Balance 8 / Waiting for you 4, Active projects 6 / Activity 6. Windows only for
 * the areas the client's role can see; spans widen when a neighbour is hidden.
 */
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHead from '../../ui/workspace/PageHead.astro';
import Window from '../../ui/workspace/Window.astro';
import Progress from '../../ui/workspace/Progress.astro';
import Button from '../../ui/primitives/Button.astro';
import StatusPill from '../../ui/primitives/StatusPill.astro';
import Icon from '../../ui/icons/Icon.astro';
import { loadPortalPage } from '../../server/lib/portal-page';
import { getSettings, settingText } from '../../server/modules/cms';
import { portalOverview, type PortalActivityKind } from '../../server/modules/portal';
import { formatMoney } from '../../shared/money';
import { PROJECT_STATUS_LABEL } from '../../shared/projects';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request);
if (page instanceof Response) return page;
const settings = await getSettings(ctx);
const contactEmail = settingText(settings, 'contact.email');
const firstName = page.auth.user.name.split(/\s+/)[0] ?? page.auth.user.name;
const linked = page.clients.length > 0;
const overview = linked ? await portalOverview(ctx) : null;

const dateFmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'Africa/Harare' });
/** Calendar dates (YYYY-MM-DD) are shown as they are; timestamps in Harare time. */
const day = (value: string) => dateFmt.format(new Date(value.length === 10 ? `${value}T12:00:00Z` : value));
const stamp = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', timeZone: 'Africa/Harare' });
const short = (value: string) => stamp.format(new Date(value.length === 10 ? `${value}T12:00:00Z` : value));
const today = new Intl.DateTimeFormat('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  timeZone: 'Africa/Harare',
}).format(new Date());

const KIND: Record<PortalActivityKind, { label: string; href: (id: string) => string }> = {
  invoice: { label: 'Invoice', href: (id) => `/portal/invoices/${id}` },
  quotation: { label: 'Quotation', href: (id) => `/portal/quotations/${id}` },
  payment: { label: 'Payment', href: () => '/portal/payments' },
  project_update: { label: 'Project update', href: (id) => `/portal/projects/${id}` },
};
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const STATUS_TONE = { planning: 'neutral', active: 'lit', on_hold: 'warn' } as const;

const areas = overview?.areas;
const balanceSpan = areas?.quotations ? 8 : 12;
const quoteSpan = areas?.finance ? 4 : 12;
const activitySpan = areas?.projects ? 6 : 12;
---

<PortalLayout title="Overview" page={page} active="overview">
  <PageHead title={`Hello, ${firstName}`} sub={linked ? page.clients.map((c) => c.name).join(', ') : undefined}>
    <p slot="aside" class="kz-wshead__date">
      {today}
    </p>
  </PageHead>

  {!linked || !overview ? (
    <div class="kz-wgrid">
      <Window title="Account waiting to be linked" icon="lock" span={8} id="pending" data-testid="portal-unlinked">
        <div class="kz-wnote">
          <p class="kz-wnote__code">account not linked yet</p>
          <p>
            Our team links each portal account to the right company before any documents are shown. We will let you know
            when that is done. You can already update your details and security settings.
          </p>
          <p class="kz-wnote__acts">
            <Button href="/portal/account" variant="secondary" lead="account">
              Your account
            </Button>
            {contactEmail ? (
              <Button href={`mailto:${contactEmail}`} variant="quiet" lead="email">
                Email {contactEmail}
              </Button>
            ) : null}
          </p>
        </div>
      </Window>
    </div>
  ) : (
    <div class="kz-wgrid">
      {overview.areas.finance ? (
        <Window title="Balance" icon="wallet" span={balanceSpan} id="balance">
          {overview.balances.length === 0 ? (
            <div class="kz-wnote" data-testid="portal-paid-up">
              <p class="kz-wnote__code">nothing outstanding</p>
              <p>You have nothing to pay right now.</p>
            </div>
          ) : (
            <ul class="kz-bal" aria-label="Outstanding balance by currency">
              {overview.balances.map((b) => {
                const overduePct = b.outstandingMinor > 0 ? Math.round((b.overdueMinor / b.outstandingMinor) * 100) : 0;
                return (
                  <li class="kz-bal__item" data-testid={`portal-balance-${b.currency}`}>
                    <p class="kz-bal__label">Outstanding · {b.currency}</p>
                    <p class="kz-bal__fig">{formatMoney(b.outstandingMinor, b.currency)}</p>
                    {b.overdueMinor > 0 ? (
                      <div class="kz-bal__split" aria-hidden="true">
                        <div class="kz-bal__bar">
                          <span style={`width:${overduePct}%`} />
                        </div>
                        <p class="kz-bal__key">
                          <span class="is-over">overdue</span>
                          <span>not yet due</span>
                        </p>
                      </div>
                    ) : null}
                    <p class="kz-bal__meta">
                      <a href="/portal/invoices">{plural(b.openInvoices, 'open invoice', 'open invoices')}</a>
                      {b.overdueMinor > 0 ? (
                        <span class="kz-bal__over">
                          <Icon name="status-warn" size={16} />
                          {`${formatMoney(b.overdueMinor, b.currency)} overdue (${plural(b.overdueInvoices, 'invoice', 'invoices')})`}
                        </span>
                      ) : null}
                    </p>
                  </li>
                );
              })}
            </ul>
          )}
          {overview.balances.length > 0 ? (
            <div class="kz-wfoot">
              <Button href="/portal/invoices" lead="pay" class="kz-wfoot__pay">
                Pay an invoice
              </Button>
              <Button href="/portal/payments" variant="quiet" lead="receipt">
                Payments and receipts
              </Button>
            </div>
          ) : null}
        </Window>
      ) : null}

      {overview.areas.quotations ? (
        <Window
          title="Waiting for you"
          icon="quotations"
          span={quoteSpan}
          id="waiting"
          meta={overview.quotations.total ? String(overview.quotations.total) : undefined}
          flush={overview.quotations.items.length > 0}
        >
          {overview.quotations.items.length === 0 ? (
            <div class="kz-wnote">
              <p class="kz-wnote__code">no open quotations</p>
              <p>No quotations are waiting for your answer.</p>
            </div>
          ) : (
            <ul class="kz-wlist" aria-label="Quotations waiting for your answer">
              {overview.quotations.items.map((q) => (
                <li class="kz-wrow">
                  <div class="kz-wrow__main">
                    <a class="kz-wrow__title kz-wrow__link" href={`/portal/quotations/${q.id}`}>
                      {q.title}
                    </a>
                    <p class="kz-wrow__meta">
                      <span class="kz-wmono">{q.number}</span>
                      {q.validUntil ? ` · valid until ${day(q.validUntil)}` : ''}
                    </p>
                  </div>
                  <p class="kz-wrow__fig">{formatMoney(q.totalMinor, q.currency)}</p>
                </li>
              ))}
            </ul>
          )}
        </Window>
      ) : null}

      {overview.areas.projects ? (
        <Window
          title="Active projects"
          icon="projects"
          span={6}
          id="active"
          meta={overview.projects.total ? String(overview.projects.total) : undefined}
          flush={overview.projects.items.length > 0}
        >
          {overview.projects.items.length === 0 ? (
            <div class="kz-wnote">
              <p class="kz-wnote__code">no projects running</p>
              <p>No projects are in progress.</p>
            </div>
          ) : (
            <ul class="kz-wlist" aria-label="Active projects">
              {overview.projects.items.map((p) => (
                <li class="kz-wrow kz-wrow--stack">
                  <div class="kz-wrow__head">
                    <a class="kz-wrow__title kz-wrow__link" href={`/portal/projects/${p.id}`}>
                      {p.name}
                    </a>
                    <StatusPill tone={STATUS_TONE[p.status]}>{PROJECT_STATUS_LABEL[p.status]}</StatusPill>
                  </div>
                  <Progress label={`${p.name} progress`} pct={p.progressPct} />
                  {p.nextMilestone ? (
                    <p class="kz-wrow__meta">
                      Next: {p.nextMilestone.title}
                      {p.nextMilestone.dueDate ? `, due ${day(p.nextMilestone.dueDate)}` : ''}
                    </p>
                  ) : p.targetDate ? (
                    <p class="kz-wrow__meta">Target date {day(p.targetDate)}</p>
                  ) : null}
                </li>
              ))}
            </ul>
          )}
        </Window>
      ) : null}

      <Window title="Activity" icon="activity" span={activitySpan} id="activity" flush={overview.activity.length > 0}>
        {overview.activity.length === 0 ? (
          <div class="kz-wnote">
            <p class="kz-wnote__code">no activity yet</p>
            <p>Nothing yet. New documents, payments and project updates show here.</p>
          </div>
        ) : (
          <ol class="kz-feed" data-testid="portal-activity" aria-label="Recent activity">
            {overview.activity.map((a) => (
              <li class="kz-feed__item">
                <p class="kz-feed__at">
                  <time datetime={a.at}>{short(a.at)}</time>
                  <span>{KIND[a.kind].label.toLowerCase()}</span>
                </p>
                <div class="kz-feed__main">
                  <a class="kz-feed__title" href={KIND[a.kind].href(a.targetId)}>
                    {a.title}
                  </a>
                  {a.detail ? <p class="kz-feed__detail">{a.detail}</p> : null}
                </div>
                {a.amountMinor !== null && a.currency ? (
                  <p class="kz-feed__fig">{formatMoney(a.amountMinor, a.currency)}</p>
                ) : null}
              </li>
            ))}
          </ol>
        )}
      </Window>
    </div>
  )}

  {overview?.areas.finance && overview.balances.length > 0 ? (
    <div class="kz-wsact">
      <Button href="/portal/invoices" lead="pay" block>
        Pay an invoice
      </Button>
    </div>
  ) : null}

  {linked && contactEmail ? (
    <p class="kz-wsfoot">
      Questions? Email <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
    </p>
  ) : null}
</PortalLayout>
