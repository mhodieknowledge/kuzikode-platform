---
/** Services (R6.2): divisions and services shown on the website and offered in quotations, reorderable in place. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Button from '../../../ui/primitives/Button.astro';
import SavedNotice from '../../../ui/admin/website/SavedNotice.astro';
import { CatalogueList } from '../../../ui/admin/services/CatalogueList';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listCatalogue } from '../../../server/modules/catalogue';
import { pricingLabel } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'services.manage' });
if (page instanceof Response) return page;
const catalogue = await listCatalogue(ctx);
const divisions = catalogue.map((d) => ({
  id: d.id,
  name: d.name,
  slug: d.slug,
  status: d.status,
  featured: d.featured,
  services: d.services.map((s) => ({
    id: s.id,
    name: s.name,
    slug: s.slug,
    status: s.status,
    featured: s.featured,
    price: pricingLabel(s.pricingModel, s.priceMinor, s.currency, true),
  })),
}));
const saved = Astro.url.searchParams.get('saved') === '1';
---

<AdminLayout title="Services" page={page}>
  <PageHead
    title="Services"
    meta="Divisions and services shown on the website and offered in quotations. Changes are live as soon as you save."
  >
    <Button slot="actions" href="/services" variant="secondary" target="_blank" rel="noopener" icon="external">
      View on website<span class="sr-only"> (opens in a new tab)</span>
    </Button>
  </PageHead>
  {saved ? <SavedNotice>Saved. The website now shows your changes.</SavedNotice> : null}
  <CatalogueList client:load divisions={divisions} />
</AdminLayout>
