---
/** "Technologies we work with" (docs/12 §C.11): clearly labelled as tools, never clients or partners. */
import type { Technology } from '../../../server/modules/cms';

interface Props {
  technologies: Technology[];
  tone?: 'surface' | 'canvas';
}
const { technologies, tone = 'surface' } = Astro.props;
---

{
  technologies.length > 0 ? (
    <section class:list={['py-12 md:py-16', tone === 'canvas' ? 'bg-canvas' : 'bg-surface']} aria-labelledby="tech-title">
      <div class="container-content">
        <h2 id="tech-title" class="text-center text-[13px] font-semibold tracking-wide text-ink-600 uppercase">
          Technologies we work with
        </h2>
        <ul class="mt-6 flex flex-wrap justify-center gap-x-8 gap-y-4">
          {technologies.map((t) => (
            <li class="flex items-center text-lg font-semibold text-ink-600" title={t.category}>
              {t.logo ? <img src={t.logo} alt={t.name} class="h-7 w-auto opacity-70 grayscale" loading="lazy" /> : t.name}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ) : null
}
