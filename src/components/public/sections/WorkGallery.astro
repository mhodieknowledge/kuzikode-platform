---
/**
 * Home "working together" strip (docs/13 §4). The photos are illustrative (AI-generated, docs/13 §5): captions describe
 * ways of working, never name or present the people as Kuzikode staff or clients.
 */
import ResponsiveImage from '../../ResponsiveImage.astro';

const items = [
  { id: 'work-planning', caption: 'Planning workshops', body: 'We map the work with you before anything is built.' },
  { id: 'work-presentation', caption: 'Regular demos', body: 'You see real progress at every milestone.' },
  { id: 'work-pairing', caption: 'Reviewed code', body: 'Every change is checked by a second pair of eyes.' },
  { id: 'work-videocall', caption: 'Easy check-ins', body: 'Quick calls whenever a decision needs you.' },
];
---

<section class="bg-surface py-16 md:py-24" aria-labelledby="together-title">
  <div class="container-content">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <h2 id="together-title" class="text-3xl font-bold tracking-display text-ink-950 md:text-4xl">Close collaboration, start to finish</h2>
        <p class="mt-3 text-lg leading-8 text-ink-600">You are part of the process, not waiting at the end of it.</p>
      </div>
      <a href="/how-we-work" class="text-[15px] font-semibold text-brand-600 hover:underline">See how we work</a>
    </div>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((it) => (
          <li>
            <div class="overflow-hidden rounded-lg">
              <ResponsiveImage id={it.id} sizes="(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw" class="aspect-[3/2] h-auto w-full object-cover" />
            </div>
            <h3 class="mt-4 font-sans text-base font-semibold text-ink-950">{it.caption}</h3>
            <p class="mt-1 text-[15px] leading-6 text-ink-600">{it.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
