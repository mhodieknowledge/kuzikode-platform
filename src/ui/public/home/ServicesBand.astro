---
/**
 * "What each route covers" (R4.1, DESIGN_DIRECTION §3 route tabs): the one night band on the home page. Route tabs (division hue
 * swatch + numeral + short name; IMG_5056 tabbed offering switcher, IMG_5066 dark "what we do" band) switch a panel holding the
 * division summary, its published packages with their prices and a warm-duotone photograph; the panel cross-fades in
 * (`.kz-panel`). Phones: the tab strip scrolls sideways, the panel reads photo → name → packages → action.
 * Prices come from the pricing catalogue through `packagePrice` (presentation only); with prices hidden nothing is shown.
 */
import Picture from '../../primitives/Picture.astro';
import Icon from '../../icons/Icon.astro';
import type { SectionContent } from '../../../shared/schemas/cms';
import type { PublicCategory, PublicPackage } from '../../../server/modules/cms';
import { divisionShortName } from '../../../shared/directory';
import { packagePrice, quotationHref, canRequestQuote } from '../../../shared/service-display';
import manifest from '../../../../design/images/manifest.json';

interface Props {
  content: SectionContent<'services_grid'>;
  categories: PublicCategory[];
  packages: PublicPackage[];
  showPrices: boolean;
}
const { content: c, categories, packages, showPrices } = Astro.props;
const images = (manifest as { images: Record<string, unknown> }).images;
const MAX_ROWS = 4;

const routes = categories.map((cat, i) => {
  const pk = packages.filter((p) => p.categorySlug === cat.slug && p.status === 'active');
  const rows =
    pk.length > 0
      ? pk.map((p) => {
          const d = packagePrice(p);
          return {
            name: p.name,
            price:
              showPrices && d.hasPrice
                ? `${d.prefix ? 'from ' : ''}${d.amount}`
                : p.priceType === 'custom_quote'
                  ? 'Quoted'
                  : null,
            unit: showPrices && d.hasPrice && d.suffix !== 'one-off' ? d.suffix : null,
          };
        })
      : cat.services.filter((s) => s.status === 'active').map((s) => ({ name: s.name, price: null, unit: null }));
  return {
    cat,
    n: String(i + 1).padStart(2, '0'),
    hue: `kz-div-${(i % 6) + 1}`,
    short: divisionShortName(cat.slug, cat.name),
    rows: rows.slice(0, MAX_ROWS),
    more: Math.max(0, rows.length - MAX_ROWS),
    image: images[`svc-${cat.slug}`] ? `svc-${cat.slug}` : null,
    quote: canRequestQuote(cat.status),
  };
});
---

<section class="kz-band on-night" aria-labelledby="band-title">
  <div class="container-wide">
    <header class="kz-band__head">
      <h2 id="band-title" class="kz-h2">{c.title}</h2>
      {c.intro ? <p class="kz-band__intro">{c.intro}</p> : null}
    </header>

    <div class="kz-tabs kz-band__tabs" role="tablist" aria-label="Area of work" data-kz-tabs>
      {
        routes.map((r, i) => (
          <button
            type="button"
            role="tab"
            class:list={['kz-tab kz-band__tab', r.hue]}
            id={`band-tab-${r.cat.slug}`}
            aria-controls={`band-panel-${r.cat.slug}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="kz-band__swatch" aria-hidden="true" />
            <span class="kz-band__n">{r.n}</span>
            {r.short}
          </button>
        ))
      }
      <span class="kz-tabs__bar" aria-hidden="true" />
    </div>

    {
      routes.map((r, i) => (
        <div
          class:list={['kz-panel kz-band__panel', r.hue]}
          role="tabpanel"
          id={`band-panel-${r.cat.slug}`}
          aria-labelledby={`band-tab-${r.cat.slug}`}
          hidden={i !== 0}
        >
          {r.image ? (
            <Picture
              id={r.image}
              alt=""
              tone="warm"
              class="kz-band__photo"
              sizes="(min-width: 1024px) 560px, (min-width: 640px) 90vw, 100vw"
            />
          ) : null}
          <div class="kz-band__body">
            <p class="kz-band__route">
              <span class="kz-band__n">{r.n}</span> of {String(routes.length).padStart(2, '0')}
              {r.cat.status === 'coming_soon' ? ' · Coming soon' : null}
            </p>
            <h3 class="kz-band__name">{r.cat.name}</h3>
            <p class="kz-band__summary">{r.cat.summary}</p>
            {r.rows.length > 0 ? (
              <ul class="kz-band__rows" role="list">
                {r.rows.map((row) => (
                  <li>
                    <span>{row.name}</span>
                    {row.price ? (
                      <span class="kz-band__price">
                        <b>{row.price}</b>
                        {row.unit ? <small>{row.unit}</small> : null}
                      </span>
                    ) : null}
                  </li>
                ))}
              </ul>
            ) : null}
            <div class="kz-band__acts">
              {r.quote ? (
                <a class="kz-btn kz-btn--primary" href={quotationHref(r.cat.slug)}>
                  <span>Get a quote</span>
                </a>
              ) : null}
              <a class="kz-link kz-band__more" href={`/services/${r.cat.slug}`}>
                {r.more > 0 ? `All ${r.rows.length + r.more} options` : `Open ${r.short}`}
                <Icon name="arrow-right" size={16} />
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
