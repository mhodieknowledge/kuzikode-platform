---
/** Enquiry inbox (R6.2): view switch with counts, filters (sheet on phones), dense table → list rows on phones. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Views from '../../../ui/admin/Views.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Pager from '../../../ui/admin/Pager.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import { FilterBar } from '../../../ui/admin/FilterBar';
import { ENQUIRY_KIND_LABEL, ENQUIRY_STATUS_LABEL, ENQUIRY_STATUS_TONE } from '../../../ui/admin/enquiries/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listEnquiries } from '../../../server/modules/leads';
import { enquiryListQuery } from '../../../shared/schemas/leads';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'enquiries.view' });
if (page instanceof Response) return page;
const parsed = enquiryListQuery.safeParse(Object.fromEntries(Astro.url.searchParams));
const filter = parsed.success ? parsed.data : enquiryListQuery.parse({});
const result = await listEnquiries(ctx, filter);
const when = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'Africa/Harare' }).format(new Date(iso));
const whenFull = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Africa/Harare' }).format(
    new Date(iso),
  );
const pageHref = (n: number) => {
  const q = new URLSearchParams(Astro.url.searchParams);
  q.set('page', String(n));
  return `/admin/enquiries?${q.toString()}`;
};
const n = (k: string) => result.counts[k] ?? 0;
const views = [
  { key: '', label: 'Inbox', count: n('new') + n('triaged') },
  { key: 'new', label: 'New', count: n('new') },
  { key: 'closed', label: 'Closed', count: n('closed') },
  { key: 'spam', label: 'Spam', count: n('spam') },
  { key: 'all', label: 'All' },
].map((v) => ({ ...v, href: v.key ? `/admin/enquiries?status=${v.key}` : '/admin/enquiries' }));
const current = filter.status ?? '';
const filtered = !!(filter.q || filter.kind);
---

<AdminLayout title="Enquiries" page={page}>
  <PageHead title="Enquiries" meta="Messages from the contact form, project requests and consultation bookings." />
  <div class="kz-atools">
    <Views label="Enquiry views" items={views} current={current} />
    <FilterBar
      client:load
      label="Filter enquiries"
      hidden={filter.status ? { status: filter.status } : {}}
      clearHref={filter.status ? `/admin/enquiries?status=${filter.status}` : '/admin/enquiries'}
      fields={[
        {
          kind: 'search',
          name: 'q',
          label: 'Search',
          value: filter.q ?? '',
          placeholder: 'Name, email or reference',
        },
        {
          kind: 'select',
          name: 'kind',
          label: 'Type',
          value: filter.kind ?? '',
          options: [
            { value: '', label: 'Any' },
            ...Object.entries(ENQUIRY_KIND_LABEL).map(([value, label]) => ({ value, label })),
          ],
        },
      ]}
    />
  </div>
  <DataTable
    caption="Enquiries"
    count={result.items.length}
    columns={[
      { label: 'From' },
      { label: 'Message' },
      { label: 'Type' },
      { label: 'Status' },
      { label: 'Received', num: true },
    ]}
  >
    <EmptyState
      slot="empty"
      code={filtered ? 'no matches' : '0 enquiries'}
      title={filtered ? 'No enquiries match these filters.' : 'No enquiries here.'}
    >
      New enquiries from the website appear here.
    </EmptyState>
    {result.items.map((e) => (
      <tr>
        <Cell
          m="main"
          href={`/admin/enquiries/${e.id}`}
          title={e.organisation ? `${e.name} · ${e.organisation}` : e.name}
          sub={e.reference}
        />
        <Cell m="meta">
          <span class="kz-dt__clip">{e.message}</span>
        </Cell>
        <Cell tone="mute">
          {ENQUIRY_KIND_LABEL[e.kind]}
          {e.budget_range ? <span class="kz-dt__sub is-text">Budget: {e.budget_range}</span> : null}
        </Cell>
        <Cell m="status">
          <StatusPill tone={ENQUIRY_STATUS_TONE[e.status]}>{ENQUIRY_STATUS_LABEL[e.status]}</StatusPill>
        </Cell>
        <Cell m="amount" num>
          <time datetime={e.created_at} title={whenFull(e.created_at)}>
            {when(e.created_at)}
          </time>
        </Cell>
      </tr>
    ))}
  </DataTable>
  <Pager page={result.page} pages={result.pages} href={pageHref} />
</AdminLayout>
