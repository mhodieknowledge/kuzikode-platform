---
import ResponsiveImage from '../../ResponsiveImage.astro';
import type { SectionContent } from '../../../shared/schemas/cms';

interface Props {
  content: SectionContent<'cta'>;
}
const { content: c } = Astro.props;
---

<section class="bg-surface py-16 md:py-24" aria-labelledby="cta-title">
  <div class="container-content">
    <div class="relative overflow-hidden rounded-lg bg-ink-950 px-6 py-12 text-white md:px-14 md:py-16">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 [&_picture]:block [&_picture]:h-full">
        <ResponsiveImage id="bg-cta" alt="" sizes="(min-width: 1280px) 1200px, 100vw" class="h-full w-full object-cover" />
      </div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink-950/85 via-ink-950/55 to-ink-950/10"></div>
      <div class="relative flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
        <div class="max-w-xl">
          <h2 id="cta-title" class="text-3xl font-bold tracking-display text-white md:text-4xl">{c.title}</h2>
          {c.body ? <p class="mt-3 text-lg leading-7 text-white/85">{c.body}</p> : null}
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href={c.primaryCta.href} class="inline-flex h-12 items-center justify-center rounded-sm bg-white px-6 text-[15px] font-semibold text-brand-600 hover:bg-brand-50">{c.primaryCta.label}</a>
          {
            c.secondaryCta ? (
              <a href={c.secondaryCta.href} class="inline-flex h-12 items-center justify-center rounded-sm border border-white/40 px-6 text-[15px] font-semibold text-white hover:border-white">
                {c.secondaryCta.label}
              </a>
            ) : null
          }
        </div>
      </div>
    </div>
  </div>
</section>
