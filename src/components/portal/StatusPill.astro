---
/** Small status label for portal lists. Tone only supports the text; the words carry the meaning. */
interface Props {
  label: string;
  tone: 'neutral' | 'info' | 'success' | 'warning' | 'danger';
}
const { label, tone } = Astro.props;
const TONES: Record<Props['tone'], string> = {
  neutral: 'bg-ink-950/5 text-ink-800',
  info: 'bg-info-50 text-info-700',
  success: 'bg-success-50 text-success-700',
  warning: 'bg-warning-50 text-warning-700',
  danger: 'bg-danger-50 text-danger-700',
};
---

<span class:list={['inline-flex rounded-full px-2 py-0.5 text-[12px] font-semibold', TONES[tone]]}>{label}</span>
