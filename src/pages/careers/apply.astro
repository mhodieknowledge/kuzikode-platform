---
/**
 * General application (R4.7, rebuilt from scratch). Only while `careers.general_applications` is on (404 otherwise, unchanged).
 * Breadcrumb, heading and intro, then the application sheet (IMG_5018: form + summary) with the same numbered form as a role.
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import ApplicationForm from '../../ui/public/forms/ApplicationForm';
import ApplySheet from '../../ui/public/careers/ApplySheet.astro';
import { getSettings, settingBool, settingNumber } from '../../server/modules/cms';

const { ctx } = Astro.locals;
const settings = await getSettings(ctx);
if (!settingBool(settings, 'careers.general_applications')) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const retention = settingNumber(settings, 'careers.retention_months', 12);
---

<PublicLayout
  title="Send us your CV · Careers · Kuzikode Intelligent Technologies"
  description="Send Kuzikode Intelligent Technologies a general application."
  headerTone="bone"
  footerCta={false}
>
  <section class="kz-apply kz-apply--page" aria-labelledby="general-title">
    <div class="container-wide">
      <nav aria-label="Breadcrumb" class="kz-crumbs">
        <ol>
          <li>
            <a href="/careers">Careers</a>
          </li>
          <li aria-current="page">Send us your CV</li>
        </ol>
      </nav>
      <div class="kz-apply__intro">
        <h1 id="general-title" class="kz-job__title" data-enter>
          Send us your CV
        </h1>
        <p class="kz-job__sum" data-enter="2">
          Tell us about yourself. We will keep your details on file and contact you if a suitable role opens.
        </p>
      </div>
      <ApplySheet position="General application" facts={[]} retentionMonths={retention}>
        <ApplicationForm
          client:load
          slug={null}
          position="General application"
          questions={[]}
          siteKey={ctx.config.turnstileSiteKey}
        />
      </ApplySheet>
    </div>
  </section>
</PublicLayout>
