---
/**
 * Lead pipeline (R6.2): list view (dense table → list rows on phones) or board view (one column per stage; a swipe track on
 * phones), filters in a bottom sheet on phones.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Views from '../../../ui/admin/Views.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Pager from '../../../ui/admin/Pager.astro';
import Button from '../../../ui/primitives/Button.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import { FilterBar, type FilterField } from '../../../ui/admin/FilterBar';
import { LEAD_STATUS_TONE } from '../../../ui/admin/leads/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { businessDate } from '../../../server/lib/dates';
import { LEAD_STATUSES, LEAD_STATUS_LABEL, listLeads } from '../../../server/modules/leads';
import { leadListQuery } from '../../../shared/schemas/leads';
import { formatMoney } from '../../../shared/money';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'leads.view' });
if (page instanceof Response) return page;
const parsed = leadListQuery.safeParse(Object.fromEntries(Astro.url.searchParams));
const filter = parsed.success ? parsed.data : leadListQuery.parse({});
const view = filter.view ?? 'list';
// The board always shows every stage, so it lists all statuses; won/lost columns show recent ones.
const result = await listLeads(ctx, {
  ...filter,
  status: view === 'board' ? 'all' : filter.status,
  due: filter.due === '1',
});
const canCreate = page.auth.permissions.has('leads.manage');
const today = businessDate(ctx.now());
const shortDate = (d: string) =>
  new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(`${d}T00:00:00Z`));
const href = (patch: Record<string, string | null>) => {
  const q = new URLSearchParams(Astro.url.searchParams);
  for (const [k, v] of Object.entries(patch)) {
    if (v === null) q.delete(k);
    else q.set(k, v);
  }
  const s = q.toString();
  return `/admin/leads${s ? `?${s}` : ''}`;
};
const columns = LEAD_STATUSES.map((s) => ({ status: s, items: result.items.filter((l) => l.status === s) }));
const money = (l: { estimated_value_minor: number | null; currency: string | null }) =>
  l.estimated_value_minor != null && l.currency ? formatMoney(l.estimated_value_minor, l.currency) : null;
const fields: FilterField[] = [
  { kind: 'search', name: 'q', label: 'Search', value: filter.q ?? '', placeholder: 'Title, contact or email' },
  ...(view === 'list'
    ? [
        {
          kind: 'select' as const,
          name: 'status',
          label: 'Stage',
          value: filter.status ?? 'open',
          options: [
            { value: 'open', label: 'Open' },
            ...LEAD_STATUSES.map((s) => ({ value: s, label: LEAD_STATUS_LABEL[s] })),
            { value: 'all', label: 'All' },
          ],
        },
      ]
    : []),
  {
    kind: 'select',
    name: 'assigned',
    label: 'Assigned',
    value: filter.assigned ?? 'any',
    options: [
      { value: 'any', label: 'Anyone' },
      { value: 'me', label: 'Me' },
      { value: 'none', label: 'Nobody' },
    ],
  },
  { kind: 'check', name: 'due', label: 'Follow-up due', checked: filter.due === '1' },
];
const filtered = !!(filter.q || filter.assigned || filter.due);
const late = (l: { next_follow_up_on: string | null; status: string }) =>
  !!l.next_follow_up_on && l.next_follow_up_on <= today && l.status !== 'won' && l.status !== 'lost';
---

<AdminLayout title="Leads" page={page}>
  <PageHead title="Leads" meta={`${result.total} ${result.total === 1 ? 'lead' : 'leads'}`}>
    {canCreate ? (
      <Button slot="actions" href="/admin/leads/new" lead="add">
        New lead
      </Button>
    ) : null}
  </PageHead>
  <div class="kz-atools">
    <Views
      label="Lead view"
      current={view}
      items={[
        { key: 'list', label: 'List', href: href({ view: null, page: null }) },
        { key: 'board', label: 'Board', href: href({ view: 'board', page: null, status: null }) },
      ]}
    />
    <FilterBar
      client:load
      label="Filter leads"
      fields={fields}
      hidden={view === 'board' ? { view: 'board' } : {}}
      clearHref={view === 'board' ? '/admin/leads?view=board' : '/admin/leads'}
    />
  </div>
  {view === 'board' ? (
    <div class="kz-aboard" aria-label="Pipeline by stage" role="group">
      {columns.map((col) => (
        <section class="kz-aboard__col" aria-labelledby={`col-${col.status}`} data-stage={col.status}>
          <h2 id={`col-${col.status}`} class="kz-aboard__h">
            {LEAD_STATUS_LABEL[col.status]}
            <span class="kz-aboard__n">{col.items.length}</span>
          </h2>
          {col.items.length === 0 ? (
            <p class="kz-aboard__none">none</p>
          ) : (
            <ul class="kz-aboard__list" role="list">
              {col.items.map((l) => (
                <li class="kz-aboard__card">
                  <a href={`/admin/leads/${l.id}`} class="kz-aboard__t">
                    {l.title}
                  </a>
                  <p class="kz-aboard__m">{l.assigned_name ?? 'Unassigned'}</p>
                  {money(l) ? <p class="kz-aboard__v">{money(l)}</p> : null}
                  {l.next_follow_up_on ? (
                    <p class:list={['kz-afu__due', l.next_follow_up_on <= today && 'is-late']}>
                      Follow up {shortDate(l.next_follow_up_on)}
                    </p>
                  ) : null}
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}
    </div>
  ) : (
    <DataTable
      caption="Leads"
      count={result.items.length}
      columns={[
        { label: 'Lead' },
        { label: 'Stage' },
        { label: 'Assigned' },
        { label: 'Next follow-up' },
        { label: 'Value', num: true },
      ]}
    >
      <EmptyState
        slot="empty"
        code={filtered ? 'no matches' : '0 leads'}
        title={filtered ? 'No leads match these filters.' : 'No leads yet.'}
      >
        Leads are created from enquiries or added by hand.
      </EmptyState>
      {result.items.map((l) => (
        <tr>
          <Cell
            m="main"
            href={`/admin/leads/${l.id}`}
            title={l.title}
            sub={[l.contact_name, l.organisation].filter(Boolean).join(' · ') || '—'}
            subText
          />
          <Cell m="status">
            <StatusPill tone={LEAD_STATUS_TONE[l.status]}>{LEAD_STATUS_LABEL[l.status]}</StatusPill>
          </Cell>
          <Cell tone="mute">{l.assigned_name ?? '—'}</Cell>
          <Cell m="meta" tone={late(l) ? 'alert' : undefined}>
            {l.next_follow_up_on ? (
              <span>
                <span class="kz-dt__ph" aria-hidden="true">
                  Follow up{' '}
                </span>
                {shortDate(l.next_follow_up_on)}
              </span>
            ) : (
              <span class="kz-dt__dash">—</span>
            )}
          </Cell>
          <Cell m="amount" num>
            {money(l) ?? '—'}
          </Cell>
        </tr>
      ))}
    </DataTable>
  )}
  <Pager page={result.page} pages={result.pages} href={(n) => href({ page: String(n) })} />
</AdminLayout>
