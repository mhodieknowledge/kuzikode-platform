---
interface Props {
  id: string;
  title: string;
  intro?: string | undefined;
  tone?: 'light' | 'dark';
  align?: 'left' | 'center';
}
const { id, title, intro, tone = 'light', align = 'left' } = Astro.props;
---

<div class:list={['mb-10 max-w-2xl md:mb-14', align === 'center' && 'mx-auto text-center']}>
  <h2 id={id} class:list={['text-3xl font-bold tracking-display md:text-[40px] md:leading-[1.1]', tone === 'dark' ? 'text-white' : 'text-ink-950']}>{title}</h2>
  {intro ? <p class:list={['mt-4 text-lg leading-8', tone === 'dark' ? 'text-white/70' : 'text-ink-600']}>{intro}</p> : null}
</div>
