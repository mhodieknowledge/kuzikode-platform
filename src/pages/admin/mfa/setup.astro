---
import AuthLayout from '../../../layouts/AuthLayout.astro';
import { MfaSetupForm } from '../../../ui/auth/AuthForms';
import { loadAdminPage } from '../../../server/lib/admin-page';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { allowStage: 'mfa-setup' });
if (page instanceof Response) return page;
if (page.auth.mfa.enabled) return Astro.redirect('/admin/account/security', 303);
const required = page.auth.mfa.required;
---

<AuthLayout
  title="Set up two-factor authentication"
  heading="Set up two-factor authentication"
  intro={
    required
      ? 'Your role requires two-factor authentication. It protects your account if your password is ever stolen.'
      : 'Protect your account with a code from your phone each time you sign in.'
  }
  area="admin"
  csrfToken={page.csrfToken}
>
  <MfaSetupForm client:load audience="admin" after={required ? '/admin' : '/admin/account/security'} />
</AuthLayout>
