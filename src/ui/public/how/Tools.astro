---
/**
 * Technologies (R4.5, the "Technologies" part of the task: there is no separate page; the published list lives here). Grouped by
 * the CMS category as columns of plain names under a mono category label, like a parts list. Phones: two columns of groups.
 * Hidden when nothing is published.
 */
import type { Technology } from '../../../server/modules/cms';

interface Props {
  technologies: Technology[];
}
const { technologies } = Astro.props;
const groups = [...new Set(technologies.map((t) => t.category))].map((cat) => ({
  cat,
  items: technologies.filter((t) => t.category === cat),
}));
---

{
  technologies.length > 0 ? (
    <section class="kz-sec kz-tools" id="technologies" aria-labelledby="tools-title">
      <div class="container-wide">
        <header class="kz-sec__head">
          <h2 id="tools-title" class="kz-h2">
            Tools we build with
          </h2>
          <p class="kz-tools__note">Proven, well-supported technology chosen for your budget, users and networks.</p>
        </header>
        <div class="kz-tools__grid" data-reveal-group>
          {groups.map((g) => (
            <div class="kz-tools__group">
              <h3 class="kz-tools__cat">{g.cat}</h3>
              <ul role="list">
                {g.items.map((t) => (
                  <li>{t.name}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : null
}
