---
import AuthLayout from '../../layouts/AuthLayout.astro';
import { ChangePasswordForm } from '../../ui/auth/AuthForms';
import { loadPortalPage } from '../../server/lib/portal-page';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request, { allowStage: 'password' });
if (page instanceof Response) return page;
---

<AuthLayout
  title="Change your password"
  heading="Choose a new password"
  intro="You need to change your password before you continue."
  area="portal"
  step={2}
  csrfToken={page.csrfToken}
>
  <ChangePasswordForm client:load audience="portal" forced />
</AuthLayout>
