---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import Pane from '../../../../ui/admin/Pane.astro';
import { ApplicantPanel } from '../../../../ui/admin/careers/ApplicantPanel';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { AppError } from '../../../../server/lib/errors';
import { getApplication, reviewers } from '../../../../server/modules/careers';
import { APPLICATION_STATUS_LABELS } from '../../../../shared/schemas/careers-admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'careers.view' });
if (page instanceof Response) return page;
let d;
try {
  d = await getApplication(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const a = d.application;
const canManage = page.auth.permissions.has('careers.manage') && !a.anonymised_at;
const people = canManage ? await reviewers(ctx) : [];
const fmt = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Africa/Harare' }).format(
    new Date(iso),
  );
const kb = (n: number) => `${Math.max(1, Math.round(n / 1024))} KB`;
const EVENT: Record<string, string> = {
  note: 'Note',
  status_change: 'Stage',
  email_sent: 'Email sent',
  rating: 'Rating',
  erased: 'Erased',
};
const rows: [string, string | null][] = [
  ['Email', a.email],
  ['Phone', a.phone],
  ['Location', a.location],
  ['Notice period', a.notice_period],
  ['Salary expectation', a.salary_expectation],
];
---

<AdminLayout title={`${a.full_name} (${a.reference})`} page={page}>
  <PageHead
    title={a.full_name}
    crumbs={[
      { label: 'Careers', href: '/admin/careers' },
      { label: 'Applicants', href: `/admin/careers/applicants?posting=${a.posting_id ?? 'general'}` },
      { label: a.reference },
    ]}
  >
    <Fragment slot="meta">
      <span class="kz-amono">{a.reference}</span> · {d.posting ? d.posting.title : 'General application'} · applied{' '}
      {fmt(a.created_at)} ·<strong>{APPLICATION_STATUS_LABELS[a.status]}</strong>
      {d.assignee ? ` · reviewer ${d.assignee.name}` : ''}
    </Fragment>
  </PageHead>
  {a.anonymised_at ? (
    <p role="status" class="kz-anotice kz-anotice--info">
      <span>This applicant's personal data was erased on {fmt(a.anonymised_at)}.</span>
    </p>
  ) : null}
  <div class="kz-agrid kz-agrid--detail">
    <div class="kz-astack">
      <Pane title="Application" id="details-title">
        <dl class="kz-adl kz-adl--rows">
          {rows
            .filter(([, v]) => v)
            .map(([k, v]) => (
              <div class="kz-adl__i">
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          {a.linkedin_url ? (
            <div class="kz-adl__i">
              <dt>LinkedIn</dt>
              <dd>
                <a href={a.linkedin_url} rel="noopener noreferrer nofollow" target="_blank">
                  {a.linkedin_url}
                </a>
              </dd>
            </div>
          ) : null}
          {a.portfolio_url ? (
            <div class="kz-adl__i">
              <dt>Portfolio</dt>
              <dd>
                <a href={a.portfolio_url} rel="noopener noreferrer nofollow" target="_blank">
                  {a.portfolio_url}
                </a>
              </dd>
            </div>
          ) : null}
          {d.cv ? (
            <div class="kz-adl__i">
              <dt>CV</dt>
              <dd>
                <a href={`/api/v1/admin/files/${d.cv.id}`}>{d.cv.original_name}</a>{' '}
                <span class="kz-amono">({kb(d.cv.size_bytes)})</span>
              </dd>
            </div>
          ) : null}
          {d.coverLetterFile ? (
            <div class="kz-adl__i">
              <dt>Cover letter</dt>
              <dd>
                <a href={`/api/v1/admin/files/${d.coverLetterFile.id}`}>{d.coverLetterFile.original_name}</a>
              </dd>
            </div>
          ) : null}
        </dl>
        {a.cover_letter ? (
          <div class="kz-aprose-block">
            <h3 class="kz-asub__t">Cover letter</h3>
            <p class="kz-aprose-block__p">{a.cover_letter}</p>
          </div>
        ) : null}
        {d.answers.length ? (
          <div class="kz-aprose-block">
            <h3 class="kz-asub__t">Answers</h3>
            <dl class="kz-adl">
              {d.answers.map((x) => (
                <div class="kz-adl__i">
                  <dt>{x.label}</dt>
                  <dd class="kz-aprose-block__p">{x.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        ) : null}
      </Pane>
      <Pane title="History" id="history-title" flush={d.events.length > 0}>
        {d.events.length === 0 ? (
          <p class="kz-anone">Nothing yet.</p>
        ) : (
          <ol class="kz-alist">
            {d.events.map((e) => (
              <li>
                <div class="kz-alist__main">
                  <span class="kz-alist__t kz-aprose-block__p">
                    {EVENT[e.type] ?? e.type}: {e.body}
                  </span>
                  <span class="kz-alist__m">
                    {e.actor ?? 'System'} · {fmt(e.created_at)}
                  </span>
                </div>
              </li>
            ))}
          </ol>
        )}
      </Pane>
    </div>
    {canManage ? (
      <aside>
        <ApplicantPanel
          client:load
          id={a.id}
          name={a.full_name}
          status={a.status}
          rating={a.rating}
          tags={a.tags}
          assignedTo={a.assigned_to}
          reviewers={people}
          hasEmail={!!a.email}
        />
      </aside>
    ) : null}
  </div>
</AdminLayout>
