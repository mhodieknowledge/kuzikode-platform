---
/** Settings, integrations (R6.2 group 3): payment gateway accounts, email provider with a test send, recent emails. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import DetailList from '../../../ui/admin/DetailList.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import SettingsNav from '../../../ui/admin/settings/SettingsNav.astro';
import { PaymentAccountForm, TestEmailButton } from '../../../ui/admin/settings/SettingsParts';
import { stampOrNever } from '../../../ui/admin/users/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { integrations } from '../../../server/modules/settings';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'settings.view' });
if (page instanceof Response) return page;
const info = await integrations(ctx);
const canPay = page.auth.permissions.has('payment_settings.manage');
const canEmail = page.auth.permissions.has('settings.manage');
---

<AdminLayout title="Integrations" page={page}>
  <PageHead title="Settings" meta="Integrations" />
  <div class="kz-aset">
    <SettingsNav current="integrations" canExport={page.auth.permissions.has('data.export')} />
    <div class="kz-aset__main">
      <Pane title="Payment gateways" id="pay-title" flush meta={String(info.payments.length)}>
        <p class="kz-apad kz-hint">
          Keys are stored as Worker secrets and never shown here.{' '}
          {canPay ? '' : 'Only a Super Administrator can change these accounts.'}
        </p>
        <ul class="kz-alist">
          {info.payments.map((p) => (
            <li style="display:grid">
              <div class="kz-adev">
                <p class="kz-alist__t">
                  {p.label}{' '}
                  <StatusPill plain class="kz-pill--xs">
                    {p.mode === 'live' ? 'Live' : 'Test mode'}
                  </StatusPill>{' '}
                  <StatusPill tone={p.secretsConfigured ? 'ok' : 'warn'} class="kz-pill--xs">
                    {p.secretsConfigured ? 'Keys configured' : 'Keys not configured'}
                  </StatusPill>
                  {p.enabled ? null : (
                    <StatusPill plain class="kz-pill--xs">
                      Disabled
                    </StatusPill>
                  )}
                </p>
                <p class="kz-alist__m">
                  {p.provider} · {p.currencies.join(', ') || 'no currencies'}
                  {p.note ? ` · ${p.note}` : ''}
                </p>
              </div>
              {canPay ? (
                <div class="kz-agap">
                  <PaymentAccountForm
                    client:visible
                    id={p.id}
                    label={p.label}
                    enabled={p.enabled}
                    mode={p.mode}
                    secretsConfigured={p.secretsConfigured}
                  />
                </div>
              ) : null}
            </li>
          ))}
        </ul>
      </Pane>
      <Pane title="Email" id="mail-title">
        <DetailList
          cols={2}
          items={[
            {
              label: 'Provider',
              value: info.email.provider === 'resend' ? 'Resend' : 'Development log (emails are not sent)',
            },
            { label: 'From', value: info.email.from },
            { label: 'Resend API key', value: info.email.resendConfigured ? 'Configured' : 'Not configured' },
          ]}
        />
        {canEmail ? (
          <div class="kz-agap">
            <TestEmailButton client:visible />
          </div>
        ) : null}
      </Pane>
      <section aria-labelledby="recent-mail">
        <h2 id="recent-mail" class="kz-ashead">
          Recent emails
        </h2>
        <DataTable
          caption="Last 10 emails"
          count={info.email.recent.length}
          columns={[{ label: 'To' }, { label: 'When' }, { label: 'Template' }, { label: 'Status' }]}
        >
          <EmptyState slot="empty" code="0 emails" title="No emails yet." />
          {info.email.recent.map((e) => (
            <tr>
              <Cell m="main" title={e.to} />
              <Cell m="meta" tone="mute" class="kz-dt__nw">
                <span class="kz-amono">{stampOrNever(e.at)}</span>
                <span class="kz-dt__ph"> · {e.template}</span>
              </Cell>
              <Cell>
                <span class="kz-amono">{e.template}</span>
              </Cell>
              <Cell m="status">
                {e.status}
                {e.error ? ` · ${e.error}` : ''}
              </Cell>
            </tr>
          ))}
        </DataTable>
      </section>
    </div>
  </div>
</AdminLayout>
