---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { LeadForm } from '../../../components/admin/LeadsAdmin';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { leadFormOptions } from '../../../server/modules/leads';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'leads.manage' });
if (page instanceof Response) return page;
const options = await leadFormOptions(ctx);
const initial = {
  title: '',
  source: 'manual' as const,
  status: 'new' as const,
  contactName: null,
  email: null,
  phone: null,
  organisation: null,
  assignedTo: page.auth.user.id,
  estimatedValueMinor: null,
  currency: options.currencies[0] ?? 'USD',
  nextFollowUpOn: null,
  lostReason: null,
  notes: null,
  serviceIds: [],
};
---

<AdminLayout title="New lead" page={page}>
  <nav aria-label="Breadcrumb" class="text-[13px] text-ink-600">
    <a href="/admin/leads" class="hover:text-ink-950 hover:underline">
      Leads
    </a>{' '}
    / <span class="text-ink-950">New</span>
  </nav>
  <h1 class="mt-2 mb-6 text-2xl font-bold tracking-display">New lead</h1>
  <div class="max-w-3xl">
    <LeadForm client:load initial={initial} {...options} />
  </div>
</AdminLayout>
