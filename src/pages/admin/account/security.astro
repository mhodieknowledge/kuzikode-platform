---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ChangePasswordForm } from '../../../ui/auth/AuthForms';
import { MfaManage } from '../../../components/admin/AccountActions';
import { loadAdminPage } from '../../../server/lib/admin-page';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request);
if (page instanceof Response) return page;
const { mfa } = page.auth;
---

<AdminLayout title="Security" page={page}>
  <h1 class="text-2xl font-bold tracking-display">Security</h1>
  <div class="mt-6 grid max-w-3xl gap-6">
    <section class="rounded-lg border border-line bg-surface p-6" aria-labelledby="mfa-title">
      <h2 id="mfa-title" class="font-sans text-base font-semibold">
        Two-factor authentication
      </h2>
      <p class="mt-1 text-sm text-ink-600">
        {mfa.enabled
          ? 'On. You enter a code from your authenticator app when you sign in.'
          : 'Off. Turn it on to protect your account if your password is ever stolen.'}
        {mfa.required ? ' Your role requires it.' : ''}
      </p>
      <div class="mt-4">
        {mfa.enabled ? (
          <MfaManage client:visible canDisable={!mfa.required} />
        ) : (
          <a
            href="/admin/mfa/setup"
            class="inline-flex h-10 items-center rounded-sm bg-brand-600 px-4 text-sm font-semibold text-white hover:bg-brand-500"
          >
            Set up two-factor authentication
          </a>
        )}
      </div>
    </section>
    <section class="rounded-lg border border-line bg-surface p-6" aria-labelledby="pw-title">
      <h2 id="pw-title" class="font-sans text-base font-semibold">
        Change password
      </h2>
      <p class="mt-1 text-sm text-ink-600">Changing your password signs out your other sessions.</p>
      <div class="mt-4 max-w-md">
        <ChangePasswordForm client:visible audience="admin" forced={false} />
      </div>
    </section>
    <p class="text-sm">
      <a href="/admin/account/sessions" class="font-semibold text-brand-600 underline underline-offset-2">
        See signed-in devices
      </a>
    </p>
  </div>
</AdminLayout>
