---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Views from '../../../ui/admin/Views.astro';
import Pager from '../../../ui/admin/Pager.astro';
import { FilterBar, type FilterField } from '../../../ui/admin/FilterBar';
import { ApplicantsPipeline } from '../../../ui/admin/careers/ApplicantsPipeline';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listApplications, listPostingsAdmin } from '../../../server/modules/careers';
import { APPLICATION_STATUS_LABELS, applicationListQuery } from '../../../shared/schemas/careers-admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'careers.view' });
if (page instanceof Response) return page;
const params = Object.fromEntries(Astro.url.searchParams);
const parsed = applicationListQuery.safeParse({ ...params, postingId: params.posting || undefined });
const filter = parsed.success ? parsed.data : applicationListQuery.parse({});
const view = Astro.url.searchParams.get('view') === 'board' ? 'board' : 'list';
const [result, { postings }] = await Promise.all([listApplications(ctx, filter), listPostingsAdmin(ctx)]);
const posting = postings.find((p) => p.id === filter.postingId);
const title =
  filter.postingId === 'general' ? 'General applications' : posting ? `Applicants: ${posting.title}` : 'All applicants';
const href = (over: Record<string, string | null>) => {
  const q = new URLSearchParams(Astro.url.searchParams);
  for (const [k, v] of Object.entries(over)) {
    if (v === null) q.delete(k);
    else q.set(k, v);
  }
  return `/admin/careers/applicants?${q.toString()}`;
};
const items = result.items.map((a) => ({
  id: a.id,
  reference: a.reference,
  name: a.full_name,
  posting: filter.postingId ? null : (a.posting_title ?? 'General application'),
  status: a.status,
  rating: a.rating,
  tags: a.tags,
  assignee: a.assignee_name,
  createdAt: a.created_at,
  erased: !!a.anonymised_at,
}));
const fields: FilterField[] = [
  { kind: 'search', name: 'q', label: 'Search', value: filter.q ?? '', placeholder: 'Name, email or reference' },
  {
    kind: 'select',
    name: 'posting',
    label: 'Posting',
    value: filter.postingId ?? '',
    options: [
      { value: '', label: 'All' },
      { value: 'general', label: 'General applications' },
      ...postings.map((p) => ({ value: p.id, label: p.title })),
    ],
  },
  {
    kind: 'select',
    name: 'status',
    label: 'Stage',
    value: !filter.status || filter.status === 'all' ? 'all' : filter.status,
    options: [
      { value: 'all', label: 'All' },
      { value: 'active', label: 'In progress' },
      ...Object.entries(APPLICATION_STATUS_LABELS).map(([k, v]) => ({ value: k, label: v })),
    ],
  },
  {
    kind: 'select',
    name: 'assignee',
    label: 'Reviewer',
    value: filter.assignee ?? '',
    options: [
      { value: '', label: 'Anyone' },
      { value: 'me', label: 'Me' },
      { value: 'none', label: 'Nobody' },
    ],
  },
  { kind: 'text', name: 'tag', label: 'Tag', value: filter.tag ?? '' },
  {
    kind: 'select',
    name: 'minRating',
    label: 'Rating at least',
    value: filter.minRating ? String(filter.minRating) : '',
    options: [{ value: '', label: 'Any' }, ...[1, 2, 3, 4, 5].map((n) => ({ value: String(n), label: String(n) }))],
  },
];
const pageHref = (n: number) => href({ page: String(n) });
---

<AdminLayout title={title} page={page}>
  <PageHead
    title={title}
    meta={`${result.total} ${result.total === 1 ? 'applicant' : 'applicants'}`}
    crumbs={[{ label: 'Careers', href: '/admin/careers' }, { label: 'Applicants' }]}
  />
  <div class="kz-atools">
    <Views
      label="Applicant view"
      current={view}
      items={[
        { key: 'list', label: 'List', href: href({ view: null, page: null }) },
        { key: 'board', label: 'Board', href: href({ view: 'board', page: null }) },
      ]}
    />
    <FilterBar
      client:load
      label="Filter applicants"
      fields={fields}
      hidden={view === 'board' ? { view: 'board' } : {}}
      clearHref={view === 'board' ? '/admin/careers/applicants?view=board' : '/admin/careers/applicants'}
    />
  </div>
  <ApplicantsPipeline client:load items={items} view={view} canManage={page.auth.permissions.has('careers.manage')} />
  <Pager page={result.page} pages={result.pages} href={pageHref} />
</AdminLayout>
