---
/** Closing band (R10.3, HOME_COMPOSITION §8): photo under an overlay, one line, Get a quote + WhatsApp, contact rows from Settings. */
import Picture from '../../primitives/Picture.astro';
import Icon from '../../icons/Icon.astro';
import type { IconName } from '../../icons/registry';
import { HOME_IMAGES } from './images';

interface Props {
  title: string;
  body?: string | undefined;
  contact: { email?: string; phone?: string; whatsapp?: string; whatsappNumber?: string };
}
const { title, body, contact: c } = Astro.props;
const img = HOME_IMAGES.closing;
const digits = (v: string) => v.replace(/[^\d+]/g, '');
interface Option {
  icon: IconName;
  label: string;
  value: string;
  href: string;
  external: boolean;
}
const options = [
  c.whatsapp && c.whatsappNumber
    ? { icon: 'whatsapp', label: 'WhatsApp', value: c.whatsappNumber, href: c.whatsapp, external: true }
    : null,
  c.phone ? { icon: 'phone', label: 'Call', value: c.phone, href: `tel:${digits(c.phone)}`, external: false } : null,
  c.email ? { icon: 'email', label: 'Email', value: c.email, href: `mailto:${c.email}`, external: false } : null,
].filter((o): o is Option => o !== null);
---

<section class="hm-close on-night" aria-labelledby="close-title">
  <Picture id={img.id} mobileId={img.mobileId} alt="" class="hm-bg" sizes="100vw" />
  <div class="hm-close__shade" aria-hidden="true"></div>
  <div class="container-wide hm-close__grid">
    <div class="hm-close__copy">
      <h2 id="close-title" class="hm-h2">{title}</h2>
      {body ? <p class="hm-close__body">{body}</p> : null}
      <div class="hm-hero__acts">
        <a class="hm-cta" href="/contact">
          <span>Get a quote</span>
          <span class="hm-cta__dot" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>
        </a>
        {
          c.whatsapp ? (
            <a class="hm-ghost" href={c.whatsapp} target="_blank" rel="noopener noreferrer">
              <Icon name="whatsapp" size={20} />
              <span>WhatsApp</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          ) : null
        }
      </div>
    </div>
    {
      options.length > 0 ? (
        <ul class="hm-close__rows" aria-label="Other ways to reach us" role="list">
          {options.map((o) => (
            <li>
              <a
                href={o.href}
                {...(o.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="hm-close__ic" aria-hidden="true"><Icon name={o.icon} size={20} /></span>
                <span class="hm-close__label">{o.label}</span>
                <span class="hm-close__value">{o.value}</span>
                {o.external ? <span class="sr-only"> (opens in a new tab)</span> : null}
              </a>
            </li>
          ))}
        </ul>
      ) : null
    }
  </div>
</section>

<script>
  // Hide the floating WhatsApp button while this band is in view (it offers WhatsApp itself).
  const band = document.querySelector('.hm-close');
  if (band && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([e]) => document.documentElement.toggleAttribute('data-hm-close', !!e && e.isIntersecting),
      { threshold: 0.15 },
    ).observe(band);
  }
</script>
