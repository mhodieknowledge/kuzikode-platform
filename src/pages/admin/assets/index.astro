---
/** Managed services register (R6.2): renewals calendar pane, filters (sheet on phones), dense table → list rows. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Pager from '../../../ui/admin/Pager.astro';
import Button from '../../../ui/primitives/Button.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import { FilterBar } from '../../../ui/admin/FilterBar';
import { ASSET_STATUS_TONE } from '../../../ui/admin/finance/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { addDays, businessDate } from '../../../server/lib/dates';
import { ASSET_TYPE_LABELS, listAssets } from '../../../server/modules/subscriptions';
import { assetListQuery, ASSET_TYPES } from '../../../shared/schemas/subscriptions';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'client_assets.manage' });
if (page instanceof Response) return page;
const parsed = assetListQuery.safeParse(Object.fromEntries(Astro.url.searchParams));
const filter = parsed.success ? parsed.data : assetListQuery.parse({});
const today = businessDate(ctx.now());
const [result, upcoming] = await Promise.all([
  listAssets(ctx, filter),
  listAssets(ctx, { status: 'active', renewBy: addDays(today, 90), page: 1 }),
]);
// Renewals calendar: the next 90 days, grouped by month.
const months = new Map<string, typeof upcoming.items>();
for (const a of upcoming.items.filter((x) => x.renewal_date && x.renewal_date >= today)) {
  const k = a.renewal_date!.slice(0, 7);
  months.set(k, [...(months.get(k) ?? []), a]);
}
const monthName = (k: string) =>
  new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
    new Date(`${k}-01T00:00:00Z`),
  );
const overdue = (d: string | null) => !!d && d < today;
const saved = Astro.url.searchParams.get('saved') === '1';
const pageHref = (n: number) => {
  const q = new URLSearchParams(Astro.url.searchParams);
  q.set('page', String(n));
  return `/admin/assets?${q.toString()}`;
};
const filtered = !!(filter.q || filter.type);
const cap = (st: string) => (st === 'all' ? 'All' : st.charAt(0).toUpperCase() + st.slice(1));
---

<AdminLayout title="Managed services" page={page}>
  <PageHead
    title="Managed services"
    meta="Domains, hosting, email and certificates we look after. Reminders go out 30, 14 and 7 days before each renewal."
  >
    <Button slot="actions" href="/admin/assets/new" lead="add">
      Add to register
    </Button>
  </PageHead>
  {saved ? (
    <div class="kz-anotices">
      <p role="status" class="kz-anotice kz-anotice--ok">
        Saved.
      </p>
    </div>
  ) : null}
  <Pane title="Renewals in the next 90 days" id="cal-title">
    {months.size === 0 ? (
      <p class="kz-afeed__t">Nothing renews in the next 90 days.</p>
    ) : (
      <div class="kz-agrid kz-agrid--3 kz-cal">
        {[...months.entries()].map(([k, items]) => (
          <div class="kz-cal__m">
            <h3 class="kz-cal__h">{monthName(k)}</h3>
            <ul class="kz-alist kz-alist--bare" role="list">
              {items.map((a) => (
                <li>
                  <div class="kz-alist__main">
                    <a href={`/admin/assets/${a.id}`} class="kz-alist__t">
                      {a.name}
                    </a>
                    <span class="kz-alist__m">
                      {formatLongDate(a.renewal_date!)} · {a.client_name}
                      {a.auto_renew === 1 ? ' · auto-renews' : ''}
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
  </Pane>
  <div class="kz-atools kz-agap">
    <FilterBar
      client:load
      label="Filter the register"
      clearHref="/admin/assets"
      fields={[
        { kind: 'search', name: 'q', label: 'Search', value: filter.q ?? '', placeholder: 'Name, provider or client' },
        {
          kind: 'select',
          name: 'type',
          label: 'Type',
          value: filter.type ?? '',
          options: [
            { value: '', label: 'Any' },
            ...ASSET_TYPES.map((t) => ({ value: t, label: ASSET_TYPE_LABELS[t] ?? t })),
          ],
        },
        {
          kind: 'select',
          name: 'status',
          label: 'Status',
          value: filter.status ?? 'active',
          options: ['active', 'expired', 'cancelled', 'transferred', 'all'].map((st) => ({
            value: st,
            label: cap(st),
          })),
        },
      ]}
    />
  </div>
  <DataTable
    caption="Managed services"
    count={result.items.length}
    columns={[
      { label: 'Name' },
      { label: 'Type' },
      { label: 'Client' },
      { label: 'Provider' },
      { label: 'Renewal' },
      { label: 'Status' },
    ]}
  >
    <EmptyState
      slot="empty"
      code={filtered ? 'no matches' : '0 services'}
      title={filtered ? 'Nothing matches these filters.' : 'The register is empty.'}
    >
      Domains, hosting and other services we manage for clients are listed here.
    </EmptyState>
    {result.items.map((a) => (
      <tr>
        <Cell
          m="main"
          href={`/admin/assets/${a.id}`}
          title={a.name}
          sub={ASSET_TYPE_LABELS[a.type] ?? a.type}
          subText
        />
        <Cell m="meta" tone="mute">
          <span>{a.client_name}</span>
        </Cell>
        <Cell tone="mute">{ASSET_TYPE_LABELS[a.type] ?? a.type}</Cell>
        <Cell tone="mute">{a.provider ?? '—'}</Cell>
        <Cell m="amount" tone={overdue(a.renewal_date) ? 'alert' : 'mute'}>
          {a.renewal_date ? formatLongDate(a.renewal_date) : '—'}
          {overdue(a.renewal_date) ? ' (passed)' : ''}
        </Cell>
        <Cell m="status">
          <StatusPill tone={ASSET_STATUS_TONE[a.status] ?? 'neutral'}>{cap(a.status)}</StatusPill>
        </Cell>
      </tr>
    ))}
  </DataTable>
  <Pager page={result.page} pages={result.pages} href={pageHref} />
</AdminLayout>
