---
/** Settings, billing and taxes (R6.2 group 3): logo, billing sections, currencies, tax rates. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import SettingsNav from '../../../ui/admin/settings/SettingsNav.astro';
import SettingsSections from '../../../ui/admin/settings/SettingsSections.astro';
import { LogoUploader } from '../../../ui/admin/settings/LogoUploader';
import { CurrencyToggle, NewTaxRateForm, TaxRateRow } from '../../../ui/admin/settings/SettingsParts';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { currentLogo, listCurrencies, listTaxRates, settingsPage } from '../../../server/modules/settings';
import { formatBpAsPercent } from '../../../shared/money';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'settings.view' });
if (page instanceof Response) return page;
const [sections, currencies, taxes, logo] = await Promise.all([
  settingsPage(ctx, 'billing'),
  listCurrencies(ctx),
  listTaxRates(ctx),
  currentLogo(ctx),
]);
const canEdit = page.auth.permissions.has('settings.manage');
---

<AdminLayout title="Billing settings" page={page}>
  <PageHead title="Settings" meta="Billing and taxes" />
  <div class="kz-aset">
    <SettingsNav current="billing" canExport={page.auth.permissions.has('data.export')} />
    <div class="kz-aset__main">
      <Pane title="Logo" id="logo-title">
        <p class="kz-hint">Printed on quotations, invoices and receipts.</p>
        <div class="kz-agap">
          <LogoUploader client:visible current={logo} canEdit={canEdit} />
        </div>
      </Pane>
      <SettingsSections sections={sections} canEdit={canEdit} />
      <Pane title="Currencies" id="cur-title" flush meta={String(currencies.length)}>
        <p class="kz-apad kz-hint">
          Active currencies can be used on quotations and invoices. The default is preselected.
        </p>
        <ul class="kz-alist">
          {currencies.map((c) => (
            <li>
              <div class="kz-alist__main">
                <span class="kz-alist__t">{c.code}</span>
                <span class="kz-alist__m">
                  {c.name} ({c.symbol})
                </span>
              </div>
              <CurrencyToggle
                client:visible
                code={c.code}
                active={c.active}
                isDefault={c.isDefault}
                canEdit={canEdit}
              />
            </li>
          ))}
        </ul>
      </Pane>
      <Pane title="Tax rates" id="tax-title" flush meta={String(taxes.length)}>
        <p class="kz-apad kz-hint">
          Confirm the current ZIMRA rate and your registration status before turning a tax on.
        </p>
        <ul class="kz-alist">
          {taxes.map((t) => (
            <li>
              <div class="kz-alist__main">
                <span class="kz-alist__t">{t.name}</span>
                <span class="kz-alist__m">
                  <span class="kz-amono">{formatBpAsPercent(t.rateBp)}</span>
                  {t.inclusive ? ' (included in prices)' : ''}
                  {t.used ? ' · Used on documents' : ''}
                </span>
              </div>
              <TaxRateRow
                client:visible
                id={t.id}
                name={t.name}
                active={t.active}
                isDefault={t.isDefault}
                canEdit={canEdit}
              />
            </li>
          ))}
        </ul>
        {canEdit ? (
          <div class="kz-apad kz-apad--b kz-asub">
            <NewTaxRateForm client:visible />
          </div>
        ) : null}
      </Pane>
    </div>
  </div>
</AdminLayout>
