---
/**
 * "Why Kuzikode" (R4.1, revised after the B.0d board review): the CMS approach claims as a numbered ledger, paired with a proof
 * object instead of a stock photograph: a payment slip drawn from the client workspace (an illustration with demo references, like
 * the hero window) showing what "every payment confirmed before it is recorded" looks like. Desktop: slip left, ledger right
 * (IMG_5055 numbered full-width rows). Phones: heading, the claims as a swipe track (BRIEF B.1a), then the slip.
 */
import Icon from '../../icons/Icon.astro';
import { cmsIcon } from '../../icons/registry';
import type { SectionContent } from '../../../shared/schemas/cms';

interface Props {
  content: SectionContent<'features'>;
  anchor: string;
}
const { content: c, anchor } = Astro.props;
---

<section class="kz-sec kz-approach" id={anchor} aria-labelledby={`${anchor}-title`}>
  <div class="container-wide kz-approach__grid">
    <header class="kz-approach__head">
      <h2 id={`${anchor}-title`} class="kz-h2">{c.title}</h2>
      {c.intro ? <p class="kz-lede">{c.intro}</p> : null}
    </header>
    <div class="kz-approach__claims">
      <ol class="kz-track kz-approach__track" role="list" data-kz-track>
        {
          c.items.map((it, i) => (
            <li class="kz-claim">
              <span class="kz-claim__n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="kz-claim__title">
                <Icon name={cmsIcon(it.icon)} size={20} />
                {it.title}
              </h3>
              <p class="kz-claim__body">{it.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="kz-track__dots" aria-hidden="true" data-kz-track-dots>
        {c.items.map((_, i) => <i class:list={[i === 0 && 'is-on']} />)}
      </div>
    </div>
    <figure class="kz-slip-scene" data-reveal>
      <div
        class="kz-slip"
        role="img"
        aria-label="Illustration: a payment slip in the client workspace. An EcoCash payment of $250.00 for an invoice, confirmed by Paynow, then recorded with a receipt."
      >
        <div class="kz-slip__top">
          <span class="kz-slip__ok"><Icon name="status-ok" size={16} /> Payment confirmed</span>
          <span class="kz-slip__time">Mon 09:42</span>
        </div>
        <p class="kz-slip__amt">$250.00</p>
        <dl class="kz-slip__rows">
          <div><dt>Invoice</dt><dd>INV-0108 · milestone 2</dd></div>
          <div><dt>Method</dt><dd>EcoCash via Paynow</dd></div>
          <div><dt>Gateway status</dt><dd>Paid</dd></div>
          <div><dt>Receipt</dt><dd>R-0042 issued</dd></div>
        </dl>
        <ol class="kz-slip__steps" aria-hidden="true">
          <li class="is-done">Started</li>
          <li class="is-done">Confirmed</li>
          <li class="is-now">Recorded</li>
        </ol>
      </div>
      <figcaption class="kz-slip__cap">Illustration with demo references: how a payment reaches your workspace.</figcaption>
    </figure>
  </div>
</section>
