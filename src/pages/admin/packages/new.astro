---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import { PackageForm } from '../../../ui/admin/packages/PackageForm';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { can } from '../../../server/lib/policies';
import { packageFormOptions } from '../../../server/modules/packages';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'packages.manage' });
if (page instanceof Response) return page;
const { services, currencies } = await packageFormOptions(ctx);
if (services.length === 0) return Astro.redirect('/admin/services/new', 303);
const initial = {
  serviceId: services[0]!.id,
  slug: '',
  name: '',
  tagline: null,
  billingType: 'one_off' as const,
  interval: null,
  priceType: 'fixed' as const,
  priceMinor: null,
  currency: currencies[0] ?? 'USD',
  priceUnit: null,
  altPriceZwgMinor: null,
  annualPriceMinor: null,
  minQuantity: 1,
  deliveryTime: null,
  revisionRounds: null,
  supportPeriod: null,
  mostPopular: false,
  tab: 'websites' as const,
  status: 'inactive' as const,
  costNote: null,
  features: [],
};
---

<AdminLayout title="New package" page={page}>
  <PageHead title="New package" crumbs={[{ label: 'Packages', href: '/admin/packages' }, { label: 'New package' }]} />
  <PackageForm
    client:load
    initial={initial}
    services={services}
    currencies={currencies}
    inUse={false}
    canReview={can(ctx, 'packages.price_review')}
  />
</AdminLayout>
