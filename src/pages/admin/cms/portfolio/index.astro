---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import CmsTabs from '../../../../components/admin/CmsTabs.astro';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { listPortfolioAdmin } from '../../../../server/modules/cms/admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'cms.manage' });
if (page instanceof Response) return page;
const items = await listPortfolioAdmin(ctx);
---

<AdminLayout title="Our work" page={page}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold tracking-display">Website</h1>
    <a
      href="/admin/cms/portfolio/new"
      class="inline-flex h-10 items-center rounded-sm bg-brand-600 px-4 text-sm font-semibold text-white hover:bg-brand-500"
    >
      New case study
    </a>
  </div>
  <CmsTabs current="portfolio" />
  <p class="mt-4 max-w-3xl text-sm text-ink-600">
    Only real, completed work. Name a client only with their permission.
  </p>
  <ul class="mt-4 divide-y divide-line rounded-lg border border-line bg-surface">
    {items.length === 0 ? (
      <li class="px-4 py-10 text-center text-sm text-ink-600">
        No case studies yet. The public page shows a tasteful empty state until you add one.
      </li>
    ) : null}
    {items.map((p) => (
      <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
        <div>
          <a href={`/admin/cms/portfolio/${p.id}`} class="font-semibold text-ink-950 hover:underline">
            {p.name}
          </a>
          <p class="text-[12px] text-ink-600">
            /work/{p.slug} · {p.category}
            {p.featured ? ' · featured' : ''}
          </p>
        </div>
        <span
          class={`rounded-full px-2 py-0.5 text-[12px] font-semibold ${p.status === 'published' ? 'bg-success-50 text-success-700' : 'bg-ink-950/5 text-ink-800'}`}
        >
          {p.status === 'published' ? 'Published' : 'Draft'}
        </span>
      </li>
    ))}
  </ul>
</AdminLayout>
