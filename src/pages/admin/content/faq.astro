---
/** FAQ (R6.2): questions by category, shown on /faq and on related service and pricing pages. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import ContentTabs from '../../../ui/admin/website/ContentTabs.astro';
import { FaqManager } from '../../../ui/admin/content/Managers';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listFaqsAdmin, serviceOptions } from '../../../server/modules/cms/content-admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'content.manage' });
if (page instanceof Response) return page;
const [faqs, services] = await Promise.all([listFaqsAdmin(ctx), serviceOptions(ctx)]);
---

<AdminLayout title="FAQ" page={page}>
  <PageHead title="Content" meta="Questions appear on /faq by category, and on related service and pricing pages." />
  <div class="kz-atools">
    <ContentTabs current="faq" permissions={page.auth.permissions} />
  </div>
  <FaqManager client:load faqs={faqs as never[]} services={services} />
</AdminLayout>
