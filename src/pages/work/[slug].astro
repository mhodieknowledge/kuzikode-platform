---
/**
 * Case study (R4.4, rebuilt from scratch). Header: crumbs, title, summary and a ruled spec sheet (client when shown, category,
 * completion, live site). Then a full-width visual (the cover, or the project's monogram plate when there is none),
 * the story as numbered sections in a reading column, the gallery (swipe track on phones, 2-column grid on desktop), and "More
 * case studies" (the same cards as /work; a rail on phones from three). Content comes from the CMS only.
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import Icon from '../../ui/icons/Icon.astro';
import WorkGrid from '../../ui/public/work/WorkGrid.astro';
import {
  breadcrumbLd,
  caseStudyLd,
  getPortfolioGallery,
  getPortfolioItem,
  listPortfolio,
} from '../../server/modules/cms';

const { ctx } = Astro.locals;
const item = await getPortfolioItem(ctx, Astro.params.slug ?? '');
if (!item) return new Response(null, { status: 404 });
const [gallery, all] = await Promise.all([getPortfolioGallery(ctx, item.slug), listPortfolio(ctx)]);
// The next studies in the list order, wrapping round, at most three.
const at = all.findIndex((p) => p.slug === item.slug);
const more = [...all.slice(at + 1), ...all.slice(0, Math.max(0, at))].slice(0, 3);
const ld = [
  caseStudyLd(ctx, item),
  breadcrumbLd(ctx, [
    { name: 'Our Work', path: '/work' },
    { name: item.name, path: `/work/${item.slug}` },
  ]),
];
const completed = item.completionDate
  ? new Date(`${item.completionDate}T00:00:00Z`).toLocaleDateString('en-GB', {
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    })
  : null;
const label = (c: string) => c.replace(/[-_]/g, ' ').replace(/^\w/, (m) => m.toUpperCase());
const monogram = item.name
  .split(/\s+/)
  .filter((w) => /^[\p{L}\p{N}]/u.test(w))
  .slice(0, 2)
  .map((w) => w.charAt(0).toUpperCase())
  .join('');
const story = [
  { id: 'overview', title: 'Overview', html: item.description },
  { id: 'challenge', title: 'The challenge', html: item.challenge },
  { id: 'solution', title: 'What we built', html: item.solution },
].filter((s) => s.html);
const host = (() => {
  try {
    return item.externalUrl ? new URL(item.externalUrl).host.replace(/^www\./, '') : null;
  } catch {
    return null;
  }
})();
---

<PublicLayout
  structuredData={ld}
  ogType="article"
  title={`${item.seoTitle ?? item.name} · Kuzikode Technologies`}
  description={item.seoDescription ?? item.summary}
  headerTone="bone"
  footerLead={{ title: 'Have a project like this?' }}
>
  <article class="kz-case">
    <header class="kz-case__head">
      <div class="container-wide">
        <nav aria-label="Breadcrumb" class="kz-crumbs">
          <ol>
            <li>
              <a href="/work">Our Work</a>
            </li>
            <li aria-current="page">{item.name}</li>
          </ol>
        </nav>
        <div class="kz-case__grid">
          <div>
            <h1 class="kz-case__title" data-enter>
              {item.name}
            </h1>
            <p class="kz-case__sum" data-enter="2">
              {item.summary}
            </p>
          </div>
          <dl class="kz-case__spec">
            {item.clientName ? (
              <div>
                <dt>Client</dt>
                <dd>{item.clientName}</dd>
              </div>
            ) : null}
            <div>
              <dt>Category</dt>
              <dd>{label(item.category)}</dd>
            </div>
            {completed ? (
              <div>
                <dt>Completed</dt>
                <dd>{completed}</dd>
              </div>
            ) : null}
            {item.externalUrl && host ? (
              <div>
                <dt>Live site</dt>
                <dd>
                  <a class="kz-link" href={item.externalUrl} rel="noopener noreferrer" target="_blank">
                    {host}
                    <Icon name="external" size={16} />
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                </dd>
              </div>
            ) : null}
          </dl>
        </div>
      </div>
    </header>

    <div class="container-wide">
      {item.cover ? (
        <figure class="kz-case__cover">
          <img
            src={item.cover.src}
            alt={item.cover.alt}
            width={item.cover.width ?? 1600}
            height={item.cover.height ?? 900}
            fetchpriority="high"
          />
        </figure>
      ) : (
        <div class="kz-case__cover kz-case__plate on-night" aria-hidden="true">
          <b>{monogram}</b>
          <span>{label(item.category)}</span>
        </div>
      )}
    </div>

    {story.length > 0 ? (
      <div class="container-wide kz-case__body">
        <div class="kz-case__story">
          {story.map((s, i) => (
            <section aria-labelledby={s.id} class="kz-case__part">
              <h2 id={s.id} class="kz-case__h">
                <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {s.title}
              </h2>
              <div class="prose-kz" set:html={s.html} />
            </section>
          ))}
        </div>
      </div>
    ) : null}

    {gallery.length > 0 ? (
      <section class="kz-sec kz-sec--inset" aria-labelledby="gallery-title">
        <div class="container-wide">
          <h2 id="gallery-title" class="kz-h2">
            Gallery
          </h2>
          <ul class="kz-track kz-case__gallery" role="list" data-kz-track>
            {gallery.map((g) => (
              <li>
                <img
                  src={g.src}
                  alt={g.alt}
                  width={g.width ?? 1200}
                  height={g.height ?? 800}
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
          {gallery.length > 1 ? (
            <div class="kz-track__dots kz-case__dots" data-kz-track-dots aria-hidden="true">
              {gallery.map((_, i) => (
                <i class:list={[i === 0 && 'is-on']} />
              ))}
            </div>
          ) : null}
        </div>
      </section>
    ) : null}
  </article>

  {more.length > 0 ? (
    <section class="kz-sec kz-case__more" aria-labelledby="more-title">
      <div class="container-wide">
        <header class="kz-sec__head">
          <h2 id="more-title" class="kz-h2">
            More case studies
          </h2>
          <a class="kz-link" href="/work">
            All work
            <Icon name="arrow-right" size={16} />
          </a>
        </header>
        <WorkGrid items={more} label={label} lead={false} />
      </div>
    </section>
  ) : null}
</PublicLayout>
