---
import { Check, Minus } from 'lucide-react';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { RoleEditor } from '../../../components/admin/UsersAdmin';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listRoles } from '../../../server/modules/users';
import { PERMISSIONS, SUPER_ADMIN_ONLY, type Permission } from '../../../shared/permissions';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'users.view' });
if (page instanceof Response) return page;
const roles = await listRoles(ctx);
const canEdit = page.auth.permissions.has('roles.manage');
const modules = new Map<string, { key: Permission; description: string }[]>();
for (const [key, [module, description]] of Object.entries(PERMISSIONS) as [Permission, readonly [string, string]][]) {
  if (!modules.has(module)) modules.set(module, []);
  modules.get(module)!.push({ key, description });
}
const groups = [...modules].map(([module, items]) => ({
  module,
  items: items.map((i) => ({ key: i.key, description: i.description, reserved: SUPER_ADMIN_ONLY.includes(i.key) })),
}));
const has = (role: (typeof roles)[number], p: Permission) => role.key === 'super_admin' || role.permissions.includes(p);
---

<AdminLayout title="Roles and permissions" page={page}>
  <nav aria-label="Breadcrumb" class="text-[13px] text-ink-600">
    <a href="/admin/users" class="hover:text-ink-950 hover:underline">
      Users
    </a>{' '}
    / <span class="text-ink-950">Roles</span>
  </nav>
  <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold tracking-display">Roles and permissions</h1>
      <p class="mt-1 text-sm text-ink-600">
        System roles are fixed. {canEdit ? 'You can add custom roles.' : 'A Super Administrator can add custom roles.'}
      </p>
    </div>
    {canEdit ? <RoleEditor client:idle groups={groups} /> : null}
  </div>
  <ul class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {roles.map((r) => (
      <li class="rounded-lg border border-line bg-surface p-5">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="font-semibold text-ink-950">{r.name}</p>
            <p class="text-[12px] text-ink-600">
              {r.system ? 'System role' : 'Custom role'} · {r.members} {r.members === 1 ? 'person' : 'people'}
            </p>
          </div>
          {canEdit && !r.system ? <RoleEditor client:visible groups={groups} role={r} /> : null}
        </div>
        {r.description ? <p class="mt-2 text-sm text-ink-600">{r.description}</p> : null}
      </li>
    ))}
  </ul>
  <h2 class="mt-10 text-lg font-bold tracking-display">Permission matrix</h2>
  <div class="mt-4 overflow-x-auto rounded-lg border border-line bg-surface">
    <table class="w-full text-left text-[13px]">
      <caption class="sr-only">Which roles hold each permission</caption>
      <thead class="sticky top-0 bg-canvas text-ink-600">
        <tr>
          <th scope="col" class="min-w-64 px-3 py-3 font-semibold">
            Permission
          </th>
          {roles.map((r) => (
            <th scope="col" class="px-3 py-3 text-center font-semibold whitespace-nowrap">
              {r.name}
            </th>
          ))}
        </tr>
      </thead>
      {groups.map((g) => (
        <tbody>
          <tr class="border-t border-line bg-canvas/60">
            <th
              scope="colgroup"
              colspan={roles.length + 1}
              class="px-3 py-2 text-[11px] font-semibold tracking-wide text-ink-600 uppercase"
            >
              {g.module}
            </th>
          </tr>
          {g.items.map((p) => (
            <tr class="border-t border-line">
              <th scope="row" class="px-3 py-2 font-normal text-ink-800">
                {p.description}
                <span class="block font-mono text-[11px] text-ink-600">
                  {p.key}
                  {p.reserved ? ' · Super Administrator only' : ''}
                </span>
              </th>
              {roles.map((r) => (
                <td class="px-3 py-2 text-center">
                  {has(r, p.key as Permission) ? (
                    <>
                      <Check size={16} className="inline text-brand-600" aria-hidden="true" />
                      <span class="sr-only">Yes</span>
                    </>
                  ) : (
                    <>
                      <Minus size={16} className="inline text-ink-400" aria-hidden="true" />
                      <span class="sr-only">No</span>
                    </>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>
</AdminLayout>
