---
/** Code-drawn cover (docs/13: insights use illustrations, not generated photos). Pattern varies by slug. */
interface Props {
  slug: string;
  label?: string | undefined;
  class?: string;
}
const { slug, label, class: className } = Astro.props;
let h = 0;
for (const ch of slug) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const variant = h % 3;
const dots = Array.from({ length: 6 * 10 }, (_, i) => ({ x: (i % 10) * 24 + 12, y: Math.floor(i / 10) * 24 + 12, on: ((h >> (i % 24)) & 1) === 1 }));
---

<div class:list={['relative overflow-hidden bg-brand-600', className]} aria-hidden="true">
  <svg viewBox="0 0 240 144" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full">
    {
      variant === 0 ? (
        dots.map((d) => <circle cx={d.x} cy={d.y} r={d.on ? 4 : 2} fill="white" fill-opacity={d.on ? 0.55 : 0.18} />)
      ) : variant === 1 ? (
        <>
          <circle cx="200" cy="20" r="90" fill="white" fill-opacity="0.12" />
          <circle cx="40" cy="140" r="70" fill="white" fill-opacity="0.1" />
          <path d="M0 110 L80 60 L140 90 L240 30" stroke="white" stroke-opacity="0.6" stroke-width="3" fill="none" />
        </>
      ) : (
        <>
          <rect x="24" y="24" width="96" height="60" rx="6" fill="white" fill-opacity="0.16" />
          <rect x="132" y="24" width="84" height="28" rx="6" fill="white" fill-opacity="0.28" />
          <rect x="132" y="60" width="84" height="60" rx="6" fill="white" fill-opacity="0.12" />
          <rect x="24" y="92" width="96" height="28" rx="6" fill="white" fill-opacity="0.24" />
        </>
      )
    }
  </svg>
  {label ? <span class="absolute bottom-3 left-4 rounded-full bg-ink-950/55 px-2.5 py-1 text-[11px] font-semibold tracking-wide text-white uppercase">{label}</span> : null}
</div>
