---
/**
 * Services index (R4.2, clean slate): photo-led night hero (B.4a) → the atlas of every service by area (drawing, numeral,
 * run-on services, from price) → the footer's routes. Data: the services page CMS intro, the service catalogue, published "from" prices.
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import ServicesHero from '../../ui/public/services/ServicesHero.astro';
import DivisionAtlas from '../../ui/public/services/DivisionAtlas.astro';
import { getPage, getPricingCatalogue, getServiceCatalogue } from '../../server/modules/cms';
import { divisionFromPrice } from '../../shared/directory';
import type { Section } from '../../shared/schemas/cms';

const { ctx } = Astro.locals;
const [page, categories, pricing] = await Promise.all([
  getPage(ctx, 'services'),
  getServiceCatalogue(ctx),
  getPricingCatalogue(ctx),
]);
const intro = page?.sections.find((s) => s.type === 'rich_text') as Section<'rich_text'> | undefined;
const froms = Object.fromEntries(
  categories.map((c) => [c.slug, pricing.showPrices ? divisionFromPrice(pricing.packages, c.slug) : null]),
);
---

<PublicLayout
  title={page?.seoTitle ?? 'Services · Kuzikode Technologies'}
  description={page?.seoDescription ?? undefined}
  headerTone="night"
>
  <ServicesHero
    title={intro?.content.title ?? 'Services'}
    html={intro?.content.html ?? null}
    areas={categories.length}
    services={categories.reduce((n, c) => n + c.services.length, 0)}
  />
  <DivisionAtlas categories={categories} froms={froms} />
</PublicLayout>
