---
import { ArrowRight } from 'lucide-react';
import SectionHeading from './SectionHeading.astro';
import type { SectionContent } from '../../../shared/schemas/cms';

interface Props {
  content: SectionContent<'values'>;
  anchor: string;
  tone?: 'surface' | 'canvas';
}
const { content: c, anchor, tone = 'surface' } = Astro.props;
---

<section class:list={['py-16 md:py-24', tone === 'canvas' ? 'bg-canvas' : 'bg-surface']} aria-labelledby={`${anchor}-title`}>
  <div class="container-content">
    <SectionHeading id={`${anchor}-title`} title={c.title} />
    <dl class:list={['grid gap-x-10 gap-y-8', c.items.length > 3 ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-3']}>
      {
        c.items.map((v) => (
          <div class="border-l-2 border-brand-600 pl-5">
            <dt class="font-display text-lg font-bold tracking-display text-ink-950">{v.title}</dt>
            <dd class="mt-2 text-[15px] leading-6 text-ink-600">{v.body}</dd>
          </div>
        ))
      }
    </dl>
    {
      c.link ? (
        <a href={c.link.href} class="mt-10 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600">
          {c.link.label} <ArrowRight size={16} aria-hidden="true" />
        </a>
      ) : null
    }
  </div>
</section>
