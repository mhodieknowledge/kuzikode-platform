---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Button from '../../../ui/primitives/Button.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import { ProjectForm } from '../../../ui/admin/projects/ProjectForm';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { formOptions } from '../../../server/modules/projects';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'projects.manage' });
if (page instanceof Response) return page;
const opts = await formOptions(ctx);
const clientId = Astro.url.searchParams.get('clientId') ?? '';
const initial = {
  clientId: opts.clients.some((c) => c.id === clientId) ? clientId : '',
  name: '',
  description: null,
  status: 'planning',
  startDate: null,
  targetDate: null,
  budgetMinor: null,
  currency: null,
  leadId: null,
  memberIds: [],
};
---

<AdminLayout title="New project" page={page}>
  <PageHead title="New project" crumbs={[{ label: 'Projects', href: '/admin/projects' }, { label: 'New' }]} />
  {opts.clients.length === 0 ? (
    <EmptyState code="0 clients" title="Add a client first">
      Projects are run for a client record.
      <Button slot="action" href="/admin/clients/new" lead="add">
        New client
      </Button>
    </EmptyState>
  ) : (
    <ProjectForm client:load initial={initial} {...opts} />
  )}
</AdminLayout>
