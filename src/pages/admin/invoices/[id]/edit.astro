---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import { InvoiceEditor } from '../../../../ui/admin/invoices/InvoiceEditor';
import { fromApiLine } from '../../../../ui/admin/documents/lines';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { AppError } from '../../../../server/lib/errors';
import { getInvoice } from '../../../../server/modules/invoices';
import { editorProps } from '../../../../server/modules/quotations';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'invoices.update' });
if (page instanceof Response) return page;
let data;
try {
  data = await getInvoice(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const inv = data.invoice;
if (inv.status !== 'draft') return Astro.redirect(`/admin/invoices/${inv.id}`, 303);
const props = await editorProps(ctx, 'invoices.create');
if (data.client && !props.clients.some((c) => c.id === data.client!.id))
  props.clients.push({
    id: data.client.id,
    name: `${data.client.display_name} (archived)`,
    number: data.client.client_number,
    currency: inv.currency,
  });
const initial = {
  clientId: inv.client_id,
  contactId: inv.contact_id,
  currency: inv.currency,
  issueDate: inv.issue_date,
  dueDate: inv.due_date,
  paymentTermsDays: inv.payment_terms_days,
  notes: inv.notes,
  terms: inv.terms,
  discountType: inv.discount_type,
  discountValue: inv.discount_value,
  lines: data.items.map(fromApiLine),
};
---

<AdminLayout title="Edit draft invoice" page={page}>
  <PageHead
    title="Edit draft invoice"
    crumbs={[
      { label: 'Invoices', href: '/admin/invoices' },
      { label: 'Draft', href: `/admin/invoices/${inv.id}` },
      { label: 'Edit' },
    ]}
  />
  <InvoiceEditor client:load id={inv.id} initial={initial} {...props} />
</AdminLayout>
