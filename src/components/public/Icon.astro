---
/** Renders a Lucide icon by the name stored in CMS content (unknown names fall back to a neutral dot). */
import {
  ArrowRight,
  BarChart3,
  Check,
  Circle,
  Cloud,
  Gauge,
  Globe,
  Layers,
  LifeBuoy,
  LineChart,
  ListChecks,
  ShieldCheck,
  Smartphone,
  Sparkles,
  Wallet,
  Workflow,
} from 'lucide-react';

const ICONS = {
  'arrow-right': ArrowRight,
  'bar-chart': BarChart3,
  check: Check,
  cloud: Cloud,
  gauge: Gauge,
  globe: Globe,
  layers: Layers,
  'life-buoy': LifeBuoy,
  'line-chart': LineChart,
  'list-checks': ListChecks,
  'shield-check': ShieldCheck,
  smartphone: Smartphone,
  sparkles: Sparkles,
  wallet: Wallet,
  workflow: Workflow,
} as const;

interface Props {
  name: string | null | undefined;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
const Cmp = (name && ICONS[name as keyof typeof ICONS]) || Circle;
---

<Cmp size={size} strokeWidth={1.5} aria-hidden="true" className={className} />
