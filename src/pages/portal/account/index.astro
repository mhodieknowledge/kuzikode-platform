---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { ChangePasswordForm } from '../../../components/auth/AuthForms';
import { MfaManage } from '../../../components/admin/AccountActions';
import { ProfileForm, SendVerificationButton } from '../../../components/portal/PortalAccount';
import { loadPortalPage } from '../../../server/lib/portal-page';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request);
if (page instanceof Response) return page;
const user = await ctx.db
  .prepare('SELECT name, email, phone, email_verified_at FROM users WHERE id = ?')
  .bind(page.auth.user.id)
  .first<{ name: string; email: string; phone: string | null; email_verified_at: string | null }>();
if (!user) return Astro.redirect('/portal/login', 303);
const { mfa } = page.auth;
---

<PortalLayout title="Your account" page={page} active="account">
  <h1 class="text-2xl font-bold tracking-display md:text-3xl">Your account</h1>
  <div class="mt-6 grid max-w-3xl gap-6">
    <section class="rounded-lg border border-line p-6" aria-labelledby="details-title">
      <h2 id="details-title" class="font-sans text-base font-semibold">
        Your details
      </h2>
      <dl class="mt-3 text-sm">
        <dt class="text-ink-600">Email</dt>
        <dd class="mt-0.5 flex flex-wrap items-center gap-2 font-medium text-ink-950">
          {user.email}
          {user.email_verified_at ? (
            <span class="rounded-full bg-success-50 px-2 py-0.5 text-[12px] font-semibold text-success-700">
              Confirmed
            </span>
          ) : (
            <span class="rounded-full bg-warning-50 px-2 py-0.5 text-[12px] font-semibold text-warning-700">
              Not confirmed
            </span>
          )}
        </dd>
      </dl>
      <p class="mt-1 text-[13px] text-ink-600">To change your email address, ask Kuzikode.</p>
      {user.email_verified_at ? null : (
        <div class="mt-3">
          <SendVerificationButton client:visible />
        </div>
      )}
      <div class="mt-5">
        <ProfileForm client:visible name={user.name} phone={user.phone ?? ''} />
      </div>
    </section>
    {page.clients.length ? (
      <section class="rounded-lg border border-line p-6" aria-labelledby="companies-title">
        <h2 id="companies-title" class="font-sans text-base font-semibold">
          Companies
        </h2>
        <ul class="mt-2 text-sm text-ink-800">
          {page.clients.map((c) => (
            <li>{c.name}</li>
          ))}
        </ul>
        <p class="mt-2 text-[13px] text-ink-600">To change company details, contact Kuzikode.</p>
      </section>
    ) : null}
    <section class="rounded-lg border border-line p-6" aria-labelledby="pw-title">
      <h2 id="pw-title" class="font-sans text-base font-semibold">
        Change password
      </h2>
      <p class="mt-1 text-sm text-ink-600">Changing your password signs out your other devices.</p>
      <div class="mt-4 max-w-md">
        <ChangePasswordForm client:visible audience="portal" forced={false} />
      </div>
    </section>
    <section class="rounded-lg border border-line p-6" aria-labelledby="mfa-title">
      <h2 id="mfa-title" class="font-sans text-base font-semibold">
        Two-factor authentication
      </h2>
      <p class="mt-1 text-sm text-ink-600">
        {mfa.enabled
          ? 'On. You enter a code from your authenticator app when you sign in.'
          : 'Optional. Adds a code from your phone when you sign in.'}
      </p>
      <div class="mt-4">
        {mfa.enabled ? (
          <MfaManage client:visible canDisable audience="portal" />
        ) : (
          <a
            href="/portal/mfa/setup"
            class="inline-flex h-10 items-center rounded-sm border border-line px-4 text-sm font-semibold text-ink-950 hover:bg-canvas"
          >
            Set up two-factor authentication
          </a>
        )}
      </div>
    </section>
    <p class="text-sm">
      <a href="/portal/account/sessions" class="font-semibold text-brand-600 underline underline-offset-2">
        See signed-in devices
      </a>
    </p>
  </div>
</PortalLayout>
