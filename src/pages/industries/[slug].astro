---
/**
 * One sector (R4.5, rebuilt from scratch). Header: crumbs, the sector icon beside the route line, "Solutions for …", summary,
 * actions and the areas of work that serve the sector as numbered chips (numeral in division hue → division page); the Route
 * drawing of the sector's main area of work is the hero visual (right on desktop, under the copy on phones; BRIEF B.4a). Then: challenges as a numbered ledger + the sector essay, the relevant services as directory rows (area numeral,
 * name, summary, both ways in), and the packages to start from in the pricing plan deck (prices from the pricing catalogue only).
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import Icon from '../../ui/icons/Icon.astro';
import { industryIcon } from '../../ui/icons/registry';
import DivisionArt from '../../ui/illustrations/DivisionArt.astro';
import PlanDeck from '../../ui/public/pricing/PlanDeck.astro';
import { breadcrumbLd, getIndustry, getServiceCatalogue } from '../../server/modules/cms';
import { divisionShortName } from '../../shared/directory';
import { quotationHref } from '../../shared/service-display';

const { ctx } = Astro.locals;
const [industry, categories] = await Promise.all([getIndustry(ctx, Astro.params.slug ?? ''), getServiceCatalogue(ctx)]);
if (!industry) return new Response(null, { status: 404, statusText: 'Not found' });
const ld = [
  breadcrumbLd(ctx, [
    { name: 'Industries', path: '/industries' },
    { name: industry.name, path: `/industries/${industry.slug}` },
  ]),
];
const pad = (n: number) => String(n).padStart(2, '0');
const areaIndex = (slug: string) => categories.findIndex((c) => c.slug === slug);
const areas = [...new Set(industry.services.map((s) => s.categorySlug))]
  .map((slug) => ({ slug, i: areaIndex(slug) }))
  .filter((a) => a.i >= 0)
  .sort((a, b) => a.i - b.i)
  .map((a) => ({ ...a, name: divisionShortName(a.slug, categories[a.i]!.name) }));
// The area with the most relevant services leads the hero drawing (ties go to the earlier area).
const lead = areas
  .map((a) => ({ a, n: industry.services.filter((s) => s.categorySlug === a.slug).length }))
  .sort((x, y) => y.n - x.n || x.a.i - y.a.i)[0]?.a;
const services = [...industry.services].sort((a, b) => areaIndex(a.categorySlug) - areaIndex(b.categorySlug));
const packages = industry.packages.slice(0, 3);
---

<PublicLayout
  structuredData={ld}
  title={industry.seoTitle ?? `${industry.name} · Kuzikode Intelligent Technologies`}
  description={industry.seoDescription ?? industry.summary}
  whatsappMessage={`Hi Kuzikode, I'd like to talk about solutions for ${industry.name}.`}
  headerTone="bone"
>
  <section class="kz-isec-head" aria-labelledby="industry-title">
    <div class="container-wide kz-isec-head__grid">
      <div class="kz-isec-head__copy">
        <nav class="kz-crumbs" aria-label="Breadcrumb">
          <ol>
            <li>
              <a href="/industries">Industries</a>
            </li>
            <li aria-current="page">{industry.name}</li>
          </ol>
        </nav>
        <p class="kz-isec-head__icon" aria-hidden="true">
          <Icon name={industryIcon(industry.slug, industry.icon)} size={24} />
        </p>
        <h1 id="industry-title" class="kz-isec-head__title" data-enter>
          Solutions for {industry.name}
        </h1>
        <p class="kz-isec-head__sum" data-enter="2">
          {industry.summary}
        </p>
        <div class="kz-isec-head__acts" data-enter="3">
          <a class="kz-btn kz-btn--primary kz-btn--lg" href="/contact" data-hero-cta>
            <span>Get a quote</span>
          </a>
          <a class="kz-link" href="/pricing">
            See all pricing
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
        {areas.length > 0 ? (
          <nav class="kz-isec-areas" aria-label={`Areas of work for ${industry.name}`} data-enter="3">
            <p class="kz-isec-areas__h">Areas of work for this sector</p>
            <ul role="list">
              {areas.map((a) => (
                <li class={`kz-div-${(a.i % 6) + 1}`}>
                  <a href={`/services/${a.slug}`}>
                    <b>{pad(a.i + 1)}</b>
                    {a.name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ) : null}
      </div>
      {lead ? (
        <div class={`kz-isec-head__art kz-div-${(lead.i % 6) + 1}`} data-enter="2">
          <DivisionArt slug={lead.slug} />
        </div>
      ) : null}
    </div>
  </section>

  {industry.challenges.length > 0 ? (
    <section class="kz-sec kz-ichal" aria-labelledby="challenges-title">
      <div class="container-wide">
        <h2 id="challenges-title" class="kz-h2">
          Challenges we solve
        </h2>
        <ol class="kz-ichal__list" role="list" data-reveal-group>
          {industry.challenges.map((c, i) => (
            <li>
              <span class="kz-ichal__n">{pad(i + 1)}</span>
              <h3 class="kz-ichal__title">{c.title}</h3>
              <p class="kz-ichal__body">{c.body}</p>
            </li>
          ))}
        </ol>
        {industry.body ? <div class="kz-ichal__essay prose-kz" set:html={industry.body} /> : null}
      </div>
    </section>
  ) : null}

  {services.length > 0 ? (
    <section class="kz-sec kz-sec--inset kz-isvc" aria-labelledby="services-title">
      <div class="container-wide">
        <h2 id="services-title" class="kz-h2">
          Relevant services
        </h2>
        <ul class="kz-track kz-isvc__list" role="list" data-kz-track data-reveal-group>
          {services.map((s) => {
            const i = areaIndex(s.categorySlug);
            return (
              <li class={i >= 0 ? `kz-div-${(i % 6) + 1}` : undefined}>
                <p class="kz-isvc__area">
                  {i >= 0 ? <span class="kz-isvc__n">{pad(i + 1)}</span> : null}
                  {s.categoryName}
                </p>
                <h3 class="kz-isvc__name">{s.name}</h3>
                <p class="kz-isvc__sum">{s.summary}</p>
                <div class="kz-isvc__acts">
                  <a class="kz-link" href={quotationHref(s.categorySlug, s.slug)}>
                    Request a quotation<span class="sr-only"> for {s.name}</span>
                  </a>
                  <a class="kz-isvc__more" href={`/services/${s.categorySlug}`}>
                    About this service<span class="sr-only">: {s.name}</span>
                  </a>
                </div>
              </li>
            );
          })}
        </ul>
        <div class="kz-track__dots kz-isvc__dots" aria-hidden="true" data-kz-track-dots>
          {services.map((_, i) => (
            <i class:list={[i === 0 && 'is-on']} />
          ))}
        </div>
      </div>
    </section>
  ) : null}

  {packages.length > 0 ? (
    <section class="kz-sec kz-ipk" aria-labelledby="packages-title">
      <div class="container-wide">
        <header class="kz-sec__head">
          <h2 id="packages-title" class="kz-h2">
            Packages to start from
          </h2>
          <a class="kz-link" href="/pricing">
            See all pricing
            <Icon name="arrow-right" size={16} />
          </a>
        </header>
        <PlanDeck packages={packages} label="Packages to start from" id={`ind-${industry.slug}`} />
      </div>
    </section>
  ) : null}
</PublicLayout>
