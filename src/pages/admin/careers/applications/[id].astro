---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { ApplicantPanel } from '../../../../components/admin/CareersAdmin';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { AppError } from '../../../../server/lib/errors';
import { getApplication, reviewers } from '../../../../server/modules/careers';
import { APPLICATION_STATUS_LABELS } from '../../../../shared/schemas/careers-admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'careers.view' });
if (page instanceof Response) return page;
let d;
try {
  d = await getApplication(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const a = d.application;
const canManage = page.auth.permissions.has('careers.manage') && !a.anonymised_at;
const people = canManage ? await reviewers(ctx) : [];
const fmt = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Africa/Harare' }).format(
    new Date(iso),
  );
const kb = (n: number) => `${Math.max(1, Math.round(n / 1024))} KB`;
const card = 'rounded-lg border border-line bg-surface p-6';
const EVENT: Record<string, string> = {
  note: 'Note',
  status_change: 'Stage',
  email_sent: 'Email sent',
  rating: 'Rating',
  erased: 'Erased',
};
const rows: [string, string | null][] = [
  ['Email', a.email],
  ['Phone', a.phone],
  ['Location', a.location],
  ['Notice period', a.notice_period],
  ['Salary expectation', a.salary_expectation],
];
---

<AdminLayout title={`${a.full_name} (${a.reference})`} page={page}>
  <nav aria-label="Breadcrumb" class="text-[13px] text-ink-600">
    <a href="/admin/careers" class="hover:text-ink-950 hover:underline">
      Careers
    </a>{' '}
    /
    <a
      href={`/admin/careers/applicants?posting=${a.posting_id ?? 'general'}`}
      class="hover:text-ink-950 hover:underline"
    >
      Applicants
    </a>{' '}
    /<span class="text-ink-950">{a.reference}</span>
  </nav>
  <h1 class="mt-2 text-2xl font-bold tracking-display">{a.full_name}</h1>
  <p class="mt-1 text-sm text-ink-600">
    {a.reference} · {d.posting ? d.posting.title : 'General application'} · applied {fmt(a.created_at)} ·
    <strong class="font-semibold text-ink-950">{APPLICATION_STATUS_LABELS[a.status]}</strong>
    {d.assignee ? ` · reviewer ${d.assignee.name}` : ''}
  </p>
  {a.anonymised_at ? (
    <p role="status" class="mt-4 rounded-md border border-line bg-surface px-4 py-3 text-sm text-ink-800">
      This applicant's personal data was erased on {fmt(a.anonymised_at)}.
    </p>
  ) : null}
  <div class="mt-6 grid items-start gap-6 lg:grid-cols-[3fr_2fr]">
    <div class="flex flex-col gap-6">
      <section class={card} aria-labelledby="details-title">
        <h2 id="details-title" class="font-sans text-base font-semibold">
          Application
        </h2>
        <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
          {rows
            .filter(([, v]) => v)
            .map(([k, v]) => (
              <>
                <dt class="text-ink-600">{k}</dt>
                <dd class="text-ink-950 break-words">{v}</dd>
              </>
            ))}
          {a.linkedin_url ? (
            <>
              <dt class="text-ink-600">LinkedIn</dt>
              <dd>
                <a
                  href={a.linkedin_url}
                  rel="noopener noreferrer nofollow"
                  target="_blank"
                  class="break-all text-brand-600 underline"
                >
                  {a.linkedin_url}
                </a>
              </dd>
            </>
          ) : null}
          {a.portfolio_url ? (
            <>
              <dt class="text-ink-600">Portfolio</dt>
              <dd>
                <a
                  href={a.portfolio_url}
                  rel="noopener noreferrer nofollow"
                  target="_blank"
                  class="break-all text-brand-600 underline"
                >
                  {a.portfolio_url}
                </a>
              </dd>
            </>
          ) : null}
          {d.cv ? (
            <>
              <dt class="text-ink-600">CV</dt>
              <dd>
                <a href={`/api/v1/admin/files/${d.cv.id}`} class="font-semibold text-brand-600 underline">
                  {d.cv.original_name}
                </a>{' '}
                <span class="text-ink-600">({kb(d.cv.size_bytes)})</span>
              </dd>
            </>
          ) : null}
          {d.coverLetterFile ? (
            <>
              <dt class="text-ink-600">Cover letter</dt>
              <dd>
                <a href={`/api/v1/admin/files/${d.coverLetterFile.id}`} class="font-semibold text-brand-600 underline">
                  {d.coverLetterFile.original_name}
                </a>
              </dd>
            </>
          ) : null}
        </dl>
        {a.cover_letter ? (
          <div class="mt-4">
            <h3 class="text-sm font-semibold text-ink-950">Cover letter</h3>
            <p class="mt-1 text-sm whitespace-pre-line text-ink-800">{a.cover_letter}</p>
          </div>
        ) : null}
        {d.answers.length ? (
          <div class="mt-4">
            <h3 class="text-sm font-semibold text-ink-950">Answers</h3>
            <dl class="mt-2 flex flex-col gap-3 text-sm">
              {d.answers.map((x) => (
                <div>
                  <dt class="font-medium text-ink-950">{x.label}</dt>
                  <dd class="whitespace-pre-line text-ink-800">{x.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        ) : null}
      </section>
      <section class={card} aria-labelledby="history-title">
        <h2 id="history-title" class="font-sans text-base font-semibold">
          History
        </h2>
        {d.events.length === 0 ? (
          <p class="mt-3 text-sm text-ink-600">Nothing yet.</p>
        ) : (
          <ol class="mt-3 flex flex-col gap-3">
            {d.events.map((e) => (
              <li class="text-sm">
                <p class="text-ink-950">
                  <span class="font-semibold">{EVENT[e.type] ?? e.type}:</span>{' '}
                  <span class="whitespace-pre-line">{e.body}</span>
                </p>
                <p class="text-[12px] text-ink-600">
                  {e.actor ?? 'System'} · {fmt(e.created_at)}
                </p>
              </li>
            ))}
          </ol>
        )}
      </section>
    </div>
    {canManage ? (
      <ApplicantPanel
        client:load
        id={a.id}
        name={a.full_name}
        status={a.status}
        rating={a.rating}
        tags={a.tags}
        assignedTo={a.assigned_to}
        reviewers={people}
        hasEmail={!!a.email}
      />
    ) : null}
  </div>
</AdminLayout>
