---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ReplyComposer, RequestControls } from '../../../components/admin/SupportAdmin';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { AppError } from '../../../server/lib/errors';
import { getRequest, supportStaff } from '../../../server/modules/support';
import { SUPPORT_CATEGORIES, SUPPORT_PRIORITY_LABEL, SUPPORT_STATUS_LABEL } from '../../../shared/support';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'support.view' });
if (page instanceof Response) return page;
let data;
try {
  data = await getRequest(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const { request: r, client, project, messages, openedBy } = data;
const perms = page.auth.permissions;
const canManage = perms.has('support.manage');
const staff = canManage ? await supportStaff(ctx) : [];
const when = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Africa/Harare' }).format(
    new Date(iso),
  );
const kb = (n: number) =>
  n < 1024 * 1024 ? `${Math.max(1, Math.round(n / 1024))} KB` : `${(n / 1024 / 1024).toFixed(1)} MB`;
const category = SUPPORT_CATEGORIES.find((c) => c.value === r.category)?.label ?? r.category;
---

<AdminLayout title={`${r.reference}: ${r.subject}`} page={page}>
  <nav aria-label="Breadcrumb" class="text-[13px] text-ink-600">
    <a href="/admin/support" class="hover:text-ink-950 hover:underline">
      Support
    </a>{' '}
    / <span class="font-mono text-ink-950">{r.reference}</span>
  </nav>
  <h1 class="mt-2 text-2xl font-bold tracking-display">{r.subject}</h1>
  <p class="mt-1 text-sm text-ink-600">
    <span class="font-mono">{r.reference}</span> · {SUPPORT_STATUS_LABEL[r.status]} ·{' '}
    {SUPPORT_PRIORITY_LABEL[r.priority]} · {category} ·{' '}
    <a href={`/admin/clients/${r.client_id}`} class="text-brand-600 underline">
      {client?.display_name}
    </a>
    {project ? (
      <>
        {' '}
        ·{' '}
        <a href={`/admin/projects/${project.id}`} class="text-brand-600 underline">
          {project.reference}
        </a>
      </>
    ) : null}
  </p>
  <div class="mt-6 grid gap-6 xl:grid-cols-[1fr_320px]">
    <div class="flex flex-col gap-6">
      <ol class="flex flex-col gap-3" aria-label="Conversation">
        {messages.map((m) => (
          <li
            class={`rounded-lg border p-4 text-sm ${m.is_internal_note ? 'border-warning-600/40 bg-warning-50' : m.user_type === 'client' ? 'border-line bg-surface' : 'border-brand-600/20 bg-brand-50'}`}
          >
            <p class="text-[12px] text-ink-600">
              <span class="font-semibold text-ink-950">{m.author}</span>
              {m.user_type === 'client' ? ' (client)' : ''} · {when(m.created_at)}
              {m.is_internal_note ? ' · internal note' : ''}
            </p>
            <p class="mt-2 whitespace-pre-line text-ink-950">{m.body}</p>
            {m.attachments.length ? (
              <ul class="mt-2 flex flex-wrap gap-3 text-[13px]">
                {m.attachments.map((f) => (
                  <li>
                    <a href={`/api/v1/admin/files/${f.file_id}`} class="text-brand-600 underline">
                      {f.original_name}
                    </a>{' '}
                    <span class="text-ink-600">({kb(f.size_bytes)})</span>
                  </li>
                ))}
              </ul>
            ) : null}
          </li>
        ))}
      </ol>
      {perms.has('support.reply') ? (
        <section class="rounded-lg border border-line bg-surface p-5" aria-label="Reply">
          <ReplyComposer client:load requestId={r.id} canManage={canManage} />
        </section>
      ) : null}
    </div>
    <aside class="flex flex-col gap-6">
      {canManage ? (
        <section class="rounded-lg border border-line bg-surface p-5" aria-labelledby="ctl-h">
          <h2 id="ctl-h" class="mb-3 font-sans text-base font-semibold">
            Request
          </h2>
          <RequestControls
            client:load
            requestId={r.id}
            status={r.status}
            priority={r.priority}
            assignedTo={r.assigned_to}
            staff={staff}
          />
        </section>
      ) : null}
      <section class="rounded-lg border border-line bg-surface p-5 text-sm" aria-labelledby="info-h">
        <h2 id="info-h" class="font-sans text-base font-semibold">
          Details
        </h2>
        <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
          <dt class="text-ink-600">Opened</dt>
          <dd>{when(r.created_at)}</dd>
          <dt class="text-ink-600">By</dt>
          <dd>
            {openedBy?.name ?? '—'}
            {openedBy?.user_type === 'staff' ? ' (staff, for the client)' : ''}
          </dd>
        </dl>
      </section>
    </aside>
  </div>
</AdminLayout>
