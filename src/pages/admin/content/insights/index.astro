---
/** Insights (R6.2): articles with status and date, and the article categories beside them. */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import ContentTabs from '../../../../ui/admin/website/ContentTabs.astro';
import DataTable from '../../../../ui/admin/DataTable.astro';
import Cell from '../../../../ui/admin/Cell.astro';
import Button from '../../../../ui/primitives/Button.astro';
import StatusPill from '../../../../ui/primitives/StatusPill.astro';
import EmptyState from '../../../../ui/primitives/EmptyState.astro';
import { CategoriesManager } from '../../../../ui/admin/content/Managers';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { listPostCategoriesAdmin, listPostsAdmin } from '../../../../server/modules/cms/content-admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'content.manage' });
if (page instanceof Response) return page;
const [posts, categories] = await Promise.all([listPostsAdmin(ctx), listPostCategoriesAdmin(ctx)]);
const statusLabel = { draft: 'Draft', scheduled: 'Scheduled', published: 'Published' } as const;
const statusTone = { draft: 'neutral', scheduled: 'warn', published: 'ok' } as const;
const when = (p: (typeof posts)[number]) =>
  p.status === 'published' ? p.published_at : p.status === 'scheduled' ? p.publish_at : p.updated_at;
---

<AdminLayout title="Insights" page={page}>
  <PageHead title="Content" meta={`${posts.length} ${posts.length === 1 ? 'article' : 'articles'}`}>
    <Button slot="actions" href="/admin/content/insights/new" lead="add">
      New article
    </Button>
  </PageHead>
  <div class="kz-atools">
    <ContentTabs current="insights" permissions={page.auth.permissions} />
  </div>
  <div class="kz-agrid kz-agrid--detail">
    <section aria-label="Articles">
      <DataTable
        caption="Articles"
        count={posts.length}
        columns={[{ label: 'Title' }, { label: 'Category' }, { label: 'Status' }, { label: 'Date (UTC)' }]}
      >
        <EmptyState slot="empty" code="0 articles" title="No articles yet." />
        {posts.map((p) => (
          <tr>
            <Cell
              m="main"
              href={`/admin/content/insights/${p.id}`}
              title={p.title}
              sub={p.category_name ?? 'No category'}
              subText
            />
            <Cell tone="mute">{p.category_name ?? 'None'}</Cell>
            <Cell m="status">
              <StatusPill tone={statusTone[p.status]}>{statusLabel[p.status]}</StatusPill>
            </Cell>
            <Cell m="meta" tone="mute">
              <span class="kz-amono">{(when(p) ?? '').slice(0, 16).replace('T', ' ')}</span>
            </Cell>
          </tr>
        ))}
      </DataTable>
    </section>
    <aside>
      <CategoriesManager client:load categories={categories} />
    </aside>
  </div>
</AdminLayout>
