---
/** Payment gateways: provider accounts and routing (docs/06 §2, P6.3c). Super Administrators only. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Views from '../../../ui/admin/Views.astro';
import { PaymentGateways } from '../../../ui/admin/payments/PaymentGateways';
import { forbiddenPage, loadAdminPage } from '../../../server/lib/admin-page';
import { isSuperAdmin } from '../../../server/lib/policies';
import { paymentConfig } from '../../../server/modules/payments';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'settings.manage' });
if (page instanceof Response) return page;
if (!isSuperAdmin(ctx)) return forbiddenPage();
const config = await paymentConfig(ctx);
const currencies = (
  await ctx.db
    .prepare('SELECT code FROM currencies WHERE active = 1 ORDER BY is_default DESC, code')
    .all<{ code: string }>()
).results.map((c) => c.code);
---

<AdminLayout title="Payment gateways" page={page}>
  <PageHead title="Payments">
    <Fragment slot="meta">
      Clients pay through the account that a route picks for the invoice&apos;s currency and the chosen method: an exact
      currency beats &quot;any&quot;, then an exact method beats &quot;any&quot;, then the lowest priority number.
      Accounts with missing secrets are skipped. Switching gateway is a change of route; payments already started finish
      on their own account. Secrets are set as Worker secrets by name (never here).
    </Fragment>
  </PageHead>
  <div class="kz-atools">
    <Views
      label="Payment views"
      items={[
        { key: 'all', label: 'All payments', href: '/admin/payments' },
        { key: 'unmatched', label: 'Unmatched', href: '/admin/payments?view=unmatched' },
        { key: 'gateways', label: 'Gateways', href: '/admin/payments/gateways' },
      ]}
      current="gateways"
    />
  </div>
  <PaymentGateways client:load initial={config} currencies={currencies} />
</AdminLayout>
