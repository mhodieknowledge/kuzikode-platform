---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import { PortfolioForm } from '../../../../ui/admin/cms/PortfolioForm';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { AppError } from '../../../../server/lib/errors';
import { getPortfolioAdmin, listMedia } from '../../../../server/modules/cms/admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'cms.manage' });
if (page instanceof Response) return page;
const id = Astro.params.id ?? '';
const media = (await listMedia(ctx)).map((m) => ({ id: m.id, file_id: m.file_id, alt_text: m.alt_text }));
let item: Record<string, unknown> | null = null;
let gallery: string[] = [];
if (id !== 'new') {
  try {
    const data = await getPortfolioAdmin(ctx, id);
    item = data.item;
    gallery = data.gallery;
  } catch (err) {
    if (err instanceof AppError && err.code === 'NOT_FOUND')
      return new Response(null, { status: 404, statusText: 'Not found' });
    throw err;
  }
}
const str = (k: string) => (item?.[k] as string | null | undefined) ?? null;
let technologies: string[] = [];
try {
  technologies = item ? (JSON.parse(String(item['technologies'] ?? '[]')) as string[]) : [];
} catch {
  technologies = [];
}
const initial = {
  slug: str('slug') ?? '',
  name: str('name') ?? '',
  clientName: str('client_name'),
  showClientName: item?.['show_client_name'] === 1,
  category: str('category') ?? '',
  summary: str('summary') ?? '',
  description: str('description'),
  challenge: str('challenge'),
  solution: str('solution'),
  technologies,
  completionDate: str('completion_date'),
  externalUrl: str('external_url'),
  coverMediaId: str('cover_media_id'),
  galleryMediaIds: gallery,
  featured: item?.['featured'] === 1,
  sortOrder: Number(item?.['sort_order'] ?? 0),
  seoTitle: str('seo_title'),
  seoDescription: str('seo_description'),
};
const title = item ? String(item['name']) : 'New case study';
---

<AdminLayout title={title} page={page}>
  <PageHead
    title={title}
    meta={
      item ? (item['status'] === 'published' ? 'Published' : 'Draft (not on the website)') : 'Saved as a draft first.'
    }
    crumbs={[{ label: 'Our work', href: '/admin/cms/portfolio' }, { label: title }]}
  />
  {item ? (
    <PortfolioForm client:load id={id} status={String(item['status'])} initial={initial} media={media} />
  ) : (
    <PortfolioForm client:load initial={initial} media={media} />
  )}
</AdminLayout>
