---
/** Quotations (R6.2): filters (sheet on phones), dense table → list rows (title, number, total + status). */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Pager from '../../../ui/admin/Pager.astro';
import Button from '../../../ui/primitives/Button.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import { FilterBar } from '../../../ui/admin/FilterBar';
import { QUOTATION_STATUS_TONE } from '../../../ui/admin/quotations/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listQuotations } from '../../../server/modules/quotations';
import { quotationListQuery } from '../../../shared/schemas/quotations';
import { QUOTATION_STATUS_LABEL } from '../../../shared/quotations';
import { formatMoney } from '../../../shared/money';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'quotations.view' });
if (page instanceof Response) return page;
const parsed = quotationListQuery.safeParse(Object.fromEntries(Astro.url.searchParams));
const filter = parsed.success ? parsed.data : quotationListQuery.parse({});
const result = await listQuotations(ctx, filter);
const canCreate = page.auth.permissions.has('quotations.create');
const pageHref = (n: number) => {
  const q = new URLSearchParams(Astro.url.searchParams);
  q.set('page', String(n));
  return `/admin/quotations?${q.toString()}`;
};
const filtered = !!(filter.q || filter.status);
---

<AdminLayout title="Quotations" page={page}>
  <PageHead title="Quotations" meta={`${result.total} ${result.total === 1 ? 'quotation' : 'quotations'}`}>
    {canCreate ? (
      <Button slot="actions" href="/admin/quotations/new" lead="add">
        New quotation
      </Button>
    ) : null}
  </PageHead>
  <div class="kz-atools">
    <FilterBar
      client:load
      label="Filter quotations"
      hidden={filter.clientId ? { clientId: filter.clientId } : {}}
      clearHref="/admin/quotations"
      fields={[
        { kind: 'search', name: 'q', label: 'Search', value: filter.q ?? '', placeholder: 'Number, title or client' },
        {
          kind: 'select',
          name: 'status',
          label: 'Status',
          value: filter.status ?? 'open',
          options: [
            { value: 'open', label: 'Open (draft, sent, viewed)' },
            ...Object.entries(QUOTATION_STATUS_LABEL).map(([value, label]) => ({ value, label })),
            { value: 'all', label: 'All' },
          ],
        },
      ]}
    />
  </div>
  <DataTable
    caption="Quotations"
    count={result.items.length}
    columns={[
      { label: 'Quotation' },
      { label: 'Client' },
      { label: 'Status' },
      { label: 'Valid until' },
      { label: 'Total', num: true },
    ]}
  >
    <EmptyState
      slot="empty"
      code={filtered ? 'no matches' : '0 open'}
      title={filtered ? 'No quotations match these filters.' : 'No open quotations.'}
    >
      Drafts, sent and viewed quotations appear here. Change the status filter to see the rest.
    </EmptyState>
    {result.items.map((q) => (
      <tr>
        <Cell
          m="main"
          href={`/admin/quotations/${q.id}`}
          title={q.title}
          sub={`${q.number ?? 'Draft'}${q.superseded_by_id ? ' · replaced by a newer version' : ''}`}
        />
        <Cell m="meta" tone="mute">
          <span>{q.client_name}</span>
        </Cell>
        <Cell m="status">
          <StatusPill tone={QUOTATION_STATUS_TONE[q.status]} class={q.status === 'void' ? 'kz-pill--void' : undefined}>
            {QUOTATION_STATUS_LABEL[q.status]}
          </StatusPill>
        </Cell>
        <Cell tone="mute">{q.valid_until ? formatLongDate(q.valid_until) : '—'}</Cell>
        <Cell m="amount" num>
          {formatMoney(q.total_minor, q.currency)}
        </Cell>
      </tr>
    ))}
  </DataTable>
  <Pager page={result.page} pages={result.pages} href={pageHref} />
</AdminLayout>
