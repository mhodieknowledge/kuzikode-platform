---
import { Briefcase, CalendarClock, MapPin } from 'lucide-react';
import PublicLayout from '../../layouts/PublicLayout.astro';
import ApplicationForm from '../../components/forms/ApplicationForm';
import { breadcrumbLd } from '../../server/modules/cms';
import { employmentTypeLabel, getPostingView, jobPostingLd, workplaceLabel } from '../../server/modules/careers';
import { formatLongDate, formatPriceTag } from '../../shared/service-display';

const { ctx } = Astro.locals;
const view = await getPostingView(ctx, Astro.params.slug ?? '');
if (!view) return new Response(null, { status: 404, statusText: 'Not found' });
if (view.state === 'gone') return new Response(null, { status: 410, statusText: 'Gone' });
const p = view.posting;
const open = view.state === 'open';
const ld = [
  breadcrumbLd(ctx, [
    { name: 'Careers', path: '/careers' },
    { name: p.title, path: `/careers/${p.slug}` },
  ]),
  ...(open ? [await jobPostingLd(ctx, p)] : []),
];
const per = { hour: 'per hour', month: 'per month', year: 'per year' } as const;
const salary = p.salary
  ? [p.salary.min, p.salary.max]
      .filter((v): v is number => v !== null)
      .map((v) => formatPriceTag(v, p.salary!.currency))
      .join(' – ') + ` ${per[p.salary.period]}`
  : null;
const url = new URL(`/careers/${p.slug}`, ctx.config.siteUrl).toString();
const share = [
  ['LinkedIn', `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`],
  ['WhatsApp', `https://wa.me/?text=${encodeURIComponent(`${p.title} at Kuzikode Technologies ${url}`)}`],
  ['X', `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(p.title)}`],
] as const;
const sections = [
  ['Responsibilities', p.responsibilities],
  ['Requirements', p.requirements],
  ['Nice to have', p.niceToHaves],
  ['What we offer', p.offer],
] as const;
---

<PublicLayout
  structuredData={ld}
  title={`${p.title} · Careers · Kuzikode Technologies`}
  description={p.summary}
  noindex={!open}
  whatsappMessage={`Hi Kuzikode, I have a question about the ${p.title} role.`}
>
  <section class="bg-canvas py-12 md:py-16" aria-labelledby="job-title">
    <div class="container-content max-w-3xl">
      <nav aria-label="Breadcrumb" class="text-[13px] text-ink-600">
        <ol class="flex gap-1.5">
          <li>
            <a href="/careers" class="hover:text-ink-950 hover:underline">
              Careers
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink-950">
            {p.title}
          </li>
        </ol>
      </nav>
      <p class="mt-6 text-[13px] font-medium text-ink-600">{p.department}</p>
      <h1 id="job-title" class="mt-1 text-4xl font-bold tracking-display md:text-5xl">
        {p.title}
      </h1>
      <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[15px] text-ink-800">
        <li class="inline-flex items-center gap-1.5">
          <MapPin size={16} aria-hidden="true" />
          {p.location} · {workplaceLabel(p.workplace)}
        </li>
        <li class="inline-flex items-center gap-1.5">
          <Briefcase size={16} aria-hidden="true" />
          {employmentTypeLabel(p.employmentType)}
        </li>
        {p.closesAt && open ? (
          <li class="inline-flex items-center gap-1.5">
            <CalendarClock size={16} aria-hidden="true" />
            Apply by {formatLongDate(p.closesAt)}
          </li>
        ) : null}
        {salary ? <li class="tnum font-semibold text-ink-950">{salary}</li> : null}
      </ul>
      {open ? null : (
        <p
          role="status"
          class="mt-6 rounded-md border border-line bg-surface px-4 py-3 font-semibold text-ink-950"
          data-posting-closed
        >
          This position is closed and no longer accepts applications.{' '}
          <a href="/careers" class="text-brand-600 underline underline-offset-2">
            See open roles
          </a>
          .
        </p>
      )}
    </div>
  </section>
  <section class="bg-surface py-12 md:py-16" aria-label="Role details">
    <div class="container-content max-w-3xl">
      <p class="text-lg leading-8 text-ink-800">{p.summary}</p>
      {p.description ? <div class="prose-kz mt-6" set:html={p.description} /> : null}
      {sections.map(([title, items]) =>
        items.length ? (
          <div class="mt-10">
            <h2 class="text-2xl font-bold tracking-display">{title}</h2>
            <ul class="mt-4 flex list-disc flex-col gap-2 pl-5 text-[16px] leading-7 text-ink-800">
              {items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ) : null,
      )}
      {p.howToApply ? (
        <div class="mt-10">
          <h2 class="text-2xl font-bold tracking-display">How to apply</h2>
          <p class="mt-4 text-ink-800">{p.howToApply}</p>
        </div>
      ) : null}
      <div class="mt-10 border-t border-line pt-6">
        <p class="text-sm font-semibold text-ink-950">Share this role</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {share.map(([name, href]) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-9 items-center rounded-sm border border-line px-3 text-sm font-semibold text-ink-800 hover:border-ink-400"
              >
                {name}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
  {open ? (
    <section class="bg-canvas py-12 md:py-16" aria-labelledby="apply-title">
      <div class="container-content max-w-3xl">
        <h2 id="apply-title" class="text-3xl font-bold tracking-display">
          Apply for this role
        </h2>
        <div class="mt-8 rounded-lg border border-line bg-surface p-6 md:p-8">
          <ApplicationForm
            client:visible
            slug={p.slug}
            position={p.title}
            questions={p.questions}
            siteKey={ctx.config.turnstileSiteKey}
          />
        </div>
      </div>
    </section>
  ) : null}
</PublicLayout>
