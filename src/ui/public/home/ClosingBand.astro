---
/**
 * Closing call to action (R9.6, REFINEMENTS §7): a full-bleed image band under a night overlay with the CMS closing words, the one
 * primary action ("Get a quote") and the contact options from Settings (WhatsApp, telephone, email; blank ones are not rendered).
 * The footer's own closing band is switched off on the home page so this is the only one.
 */
import Picture from '../../primitives/Picture.astro';
import Icon from '../../icons/Icon.astro';
import type { IconName } from '../../icons/registry';
import { HOME_IMAGES } from './images';

interface Props {
  title: string;
  body?: string | undefined;
  contact: { email?: string; phone?: string; whatsapp?: string; whatsappNumber?: string };
}
const { title, body, contact: c } = Astro.props;
const img = HOME_IMAGES.closing;
const digits = (v: string) => v.replace(/[^\d+]/g, '');
interface Option {
  icon: IconName;
  label: string;
  value: string;
  href: string;
  external: boolean;
}
const candidates: (Option | null)[] = [
  c.whatsapp && c.whatsappNumber
    ? { icon: 'whatsapp', label: 'WhatsApp', value: c.whatsappNumber, href: c.whatsapp, external: true }
    : null,
  c.phone ? { icon: 'phone', label: 'Call', value: c.phone, href: `tel:${digits(c.phone)}`, external: false } : null,
  c.email ? { icon: 'email', label: 'Email', value: c.email, href: `mailto:${c.email}`, external: false } : null,
];
const options = candidates.filter((o): o is Option => o !== null);
---

<section class="kz-iband kz-close on-night" aria-labelledby="close-title">
  <Picture id={img.id} mobileId={img.mobileId} alt="" class="kz-iband__img" sizes="100vw" />
  <div class="kz-iband__shade" aria-hidden="true"></div>
  <div class="container-wide kz-close__grid">
    <div class="kz-close__copy">
      <h2 id="close-title" class="kz-h2">{title}</h2>
      {body ? <p class="kz-iband__lede">{body}</p> : null}
      <a class="kz-btn kz-btn--primary kz-btn--lg kz-close__cta" href="/contact"><span>Get a quote</span></a>
    </div>
    {
      options.length > 0 ? (
        <ul class="kz-close__options" aria-label="Other ways to reach us" role="list" data-reveal-group>
          {options.map((o) => (
            <li>
              <a
                class="kz-close__option"
                href={o.href}
                {...(o.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="kz-close__icon" aria-hidden="true">
                  <Icon name={o.icon} size={20} />
                </span>
                <span class="kz-close__label">{o.label}</span>
                <span class="kz-close__value">{o.value}</span>
                {o.external ? <span class="sr-only"> (opens in a new tab)</span> : null}
              </a>
            </li>
          ))}
        </ul>
      ) : null
    }
  </div>
</section>
