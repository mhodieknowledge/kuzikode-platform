---
/**
 * "Why Kuzikode" as the home's mid-page image band (R9.6, REFINEMENTS §3, §7): the owner's shop-counter photograph full-bleed under
 * a night overlay, the CMS approach claims on top, and a payment-confirmed widget floating over the photograph (an illustration
 * with demo references of what "every payment confirmed before it is recorded" looks like).
 * Phones: the photograph shows clearly at the top with the widget over it, the copy follows on the deepened overlay and the
 * claims become a swipe track (B.1a). Desktop: copy left, widget right over the photo's subject, claims as a 2 × 2 ledger.
 */
import Picture from '../../primitives/Picture.astro';
import Icon from '../../icons/Icon.astro';
import { cmsIcon } from '../../icons/registry';
import type { SectionContent } from '../../../shared/schemas/cms';
import { HOME_IMAGES } from './images';

interface Props {
  content: SectionContent<'features'>;
  anchor: string;
}
const { content: c, anchor } = Astro.props;
const img = HOME_IMAGES.why;
---

<section class="kz-iband kz-why on-night" id={anchor} aria-labelledby={`${anchor}-title`}>
  <Picture id={img.id} mobileId={img.mobileId} alt="" class="kz-iband__img" sizes="100vw" />
  <div class="kz-iband__shade" aria-hidden="true"></div>
  <div class="container-wide kz-iband__grid">
    <figure class="kz-why__widget" data-reveal>
      <div
        class="kz-payok"
        role="img"
        aria-label="Illustration: an EcoCash payment of $250.00 for an invoice, confirmed by Paynow, then recorded with a receipt."
      >
        <div class="kz-payok__top" aria-hidden="true">
          <span class="kz-payok__ok"><Icon name="status-ok" size={16} /> Payment confirmed</span>
          <span>09:42</span>
        </div>
        <span class="kz-payok__amt" aria-hidden="true">$250.00</span>
        <span class="kz-payok__meta" aria-hidden="true">EcoCash via Paynow · INV-0108</span>
        <ol class="kz-payok__steps" aria-hidden="true">
          <li class="is-done">Started</li>
          <li class="is-done">Confirmed</li>
          <li class="is-now">Recorded</li>
        </ol>
      </div>
    </figure>
    <div class="kz-iband__copy">
      <h2 id={`${anchor}-title`} class="kz-h2">{c.title}</h2>
      {c.intro ? <p class="kz-iband__lede">{c.intro}</p> : null}
      <ol class="kz-why__claims" role="list" data-kz-track>
        {
          c.items.map((it) => (
            <li class="kz-why__claim">
              <h3>
                <Icon name={cmsIcon(it.icon)} size={20} />
                {it.title}
              </h3>
              <p>{it.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="kz-track__dots kz-why__dots" aria-hidden="true" data-kz-track-dots>
        {c.items.map((_, i) => <i class:list={[i === 0 && 'is-on']} />)}
      </div>
    </div>
  </div>
</section>
