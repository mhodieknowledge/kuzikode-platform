---
/**
 * Division page (R9.2, REFINEMENTS §2): header with the division drawing → the division's own packages as a carousel (swipe on phones,
 * dots + arrows; a full row on desktop when it fits) → directly below, a comparison table with every package as a column (sticky
 * feature column) → one "Get a quote" band. A division with a single priced offer shows one strong offer card instead (what is
 * included + the CTA) and no table. Divisions of separate services without comparison features show the carousel only. Data and URLs
 * unchanged (catalogue, packagesForCategory, quotationHref, packageQuoteHref). A division with no packages yet (e.g. just
 * created in the CMS) shows its description, services and benefits instead, so its content is never hidden.
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import DivisionHeader from '../../ui/public/services/DivisionHeader.astro';
import PackageCompare from '../../ui/public/services/PackageCompare.astro';
import PlanDeck from '../../ui/public/pricing/PlanDeck.astro';
import OfferCard from '../../ui/public/pricing/OfferCard.astro';
import ServiceLedger from '../../ui/public/services/ServiceLedger.astro';
import QuoteBand from '../../ui/public/shared/QuoteBand.astro';
import Icon from '../../ui/icons/Icon.astro';
import {
  breadcrumbLd,
  getServiceCatalogue,
  getSettings,
  packagesForCategory,
  serviceLd,
  settingBool,
} from '../../server/modules/cms';
import { canRequestQuote, isComparable, quotationHref } from '../../shared/service-display';
import { RETIRED_DIVISIONS, divisionFromPrice } from '../../shared/directory';

const { ctx } = Astro.locals;
const catalogue = await getServiceCatalogue(ctx);
const index = catalogue.findIndex((c) => c.slug === (Astro.params.slug ?? ''));
const cat = catalogue[index];
if (!cat) {
  // Divisions retired in R9.1 (REFINEMENTS §1): permanent redirect to the closest remaining page.
  const moved = RETIRED_DIVISIONS[Astro.params.slug ?? ''];
  if (moved) return Astro.redirect(moved, 301);
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const settings = await getSettings(ctx);
const showPrices = settingBool(settings, 'pricing.show_prices');
const { packages } = await packagesForCategory(ctx, cat.slug);
const compare = isComparable(packages);
const quotable = canRequestQuote(cat.status);
const n = index + 1;
const hue = `kz-div-${((n - 1) % 6) + 1}`;
const from = showPrices ? divisionFromPrice(packages, cat.slug) : null;
const ld = [
  serviceLd(ctx, cat),
  breadcrumbLd(ctx, [
    { name: 'Services', path: '/services' },
    { name: cat.name, path: `/services/${cat.slug}` },
  ]),
];
---

<PublicLayout
  structuredData={ld}
  ogImage={`/brand/og/services-${cat.slug}.png`}
  title={`${cat.seoTitle ?? cat.name} · Kuzikode Intelligent Technologies`}
  description={cat.seoDescription ?? cat.summary}
  whatsappMessage={`Hi Kuzikode, I'm interested in ${cat.name}.`}
  headerTone="bone"
  footerCta={false}
>
  <DivisionHeader
    slug={cat.slug}
    name={cat.name}
    summary={cat.summary}
    n={n}
    total={catalogue.length}
    comingSoon={cat.status === 'coming_soon'}
    quoteHref={quotable ? quotationHref(cat.slug) : null}
    from={from}
  />

  {packages.length > 0 ? (
    <section class={`kz-sec kz-pdiv ${hue}`} aria-labelledby="packages-title">
      <div class="container-wide">
        <header class="kz-sec__head">
          <div>
            <h2 id="packages-title" class="kz-h2">
              {packages.length === 1 ? 'Price and what is included' : 'Packages and prices'}
            </h2>
            <p class="kz-lede">Published prices. The written quotation confirms the final amount before work starts.</p>
          </div>
          <a class="kz-link" href="/pricing">
            Compare all pricing
            <Icon name="arrow-right" size={16} />
          </a>
        </header>
        {packages.length === 1 ? (
          <OfferCard pkg={packages[0]!} deliverables={cat.deliverables} id="plans" />
        ) : (
          <PlanDeck packages={packages} label={cat.name} id="plans" />
        )}
        {compare ? (
          <div class="kz-pdiv__compare">
            <h3 class="kz-pdiv__sub">Compare every package</h3>
            <PackageCompare packages={packages} caption={`${cat.name} packages compared`} id="compare" />
          </div>
        ) : null}
      </div>
    </section>
  ) : null}

  {packages.length === 0 && (cat.services.length > 0 || cat.description || cat.benefits.length > 0) ? (
    <Fragment>
      {cat.description ? (
        <section class={`kz-sec ${hue}`} aria-label="Overview">
          <div class="container-wide kz-overview__grid">
            <div class="prose-kz" set:html={cat.description} />
          </div>
        </section>
      ) : null}
      {cat.services.length > 0 ? <ServiceLedger cat={cat} n={n} showPrices={showPrices} packages={packages} /> : null}
      {cat.benefits.length > 0 ? (
        <section class={`kz-sec kz-gains ${hue}`} aria-label="Benefits">
          <div class="container-wide">
            <h2 class="kz-h2">Why it matters</h2>
            <dl class="kz-gains__list" data-reveal-group>
              {cat.benefits.map((b, i) => (
                <div class="kz-gains__row">
                  <dt>
                    <span class="kz-gains__n">{String(i + 1).padStart(2, '0')}</span>
                    {b.title}
                  </dt>
                  <dd>{b.body}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      ) : null}
    </Fragment>
  ) : null}

  {quotable ? (
    <QuoteBand
      title="Tell us what you need"
      body="We reply with questions or a written quotation."
      href={quotationHref(cat.slug)}
    />
  ) : null}
</PublicLayout>
