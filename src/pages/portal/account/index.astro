---
/**
 * Workspace account (R5.4, PANEL_DESIGN_SPEC §2 "profile, security (password, 2FA, sessions/devices) as stacked windows"). From
 * 1024 px: details + password stacked in 8 columns, two-step verification, devices and companies stacked in 4. Phones: one column
 * in that order. "Save details" is the one emerald action; the rest are secondary plates.
 */
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PageHead from '../../../ui/workspace/PageHead.astro';
import Window from '../../../ui/workspace/Window.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import Button from '../../../ui/primitives/Button.astro';
import { ChangePasswordForm } from '../../../ui/auth/AuthForms';
import { MfaManage } from '../../../ui/workspace/account/MfaManage';
import { ProfileForm } from '../../../ui/workspace/account/ProfileForm';
import { SendVerification } from '../../../ui/workspace/account/SendVerification';
import { loadPortalPage } from '../../../server/lib/portal-page';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request);
if (page instanceof Response) return page;
const user = await ctx.db
  .prepare('SELECT name, email, phone, email_verified_at FROM users WHERE id = ?')
  .bind(page.auth.user.id)
  .first<{ name: string; email: string; phone: string | null; email_verified_at: string | null }>();
if (!user) return Astro.redirect('/portal/login', 303);
const { mfa } = page.auth;
---

<PortalLayout title="Your account" page={page} active="account">
  <PageHead
    title="Your account"
    sub="Your details, password, two-factor authentication and the devices you are signed in on."
  />

  <div class="kz-acct">
    <div class="kz-acct__main">
      <Window title="Your details" icon="account" id="details">
        <dl class="kz-acct__email">
          <dt>Email</dt>
          <dd>
            <span class="kz-acct__addr">{user.email}</span>
            {user.email_verified_at ? (
              <StatusPill tone="ok">Confirmed</StatusPill>
            ) : (
              <StatusPill tone="warn">Not confirmed</StatusPill>
            )}
          </dd>
        </dl>
        <p class="kz-acct__hint">To change your email address, ask Kuzikode.</p>
        {user.email_verified_at ? null : (
          <div class="kz-acct__verify">
            <SendVerification client:visible />
          </div>
        )}
        <div class="kz-acct__form">
          <ProfileForm client:visible name={user.name} phone={user.phone ?? ''} />
        </div>
      </Window>

      <Window title="Change password" icon="key" id="password">
        <p class="kz-acct__lead">Changing your password signs out your other devices.</p>
        <ChangePasswordForm client:visible audience="portal" forced={false} />
      </Window>
    </div>

    <div class="kz-acct__side">
      <Window title="Two-factor authentication" icon="lock" id="mfa">
        <StatusPill slot="actions" tone={mfa.enabled ? 'ok' : 'neutral'}>
          {mfa.enabled ? 'On' : 'Off'}
        </StatusPill>
        <p class="kz-acct__lead">
          {mfa.enabled
            ? 'On. You enter a code from your authenticator app when you sign in.'
            : 'Optional. Adds a code from your phone when you sign in.'}
        </p>
        {mfa.enabled ? (
          <MfaManage client:visible />
        ) : (
          <Button href="/portal/mfa/setup" variant="secondary" size="sm" lead="lock">
            Set up two-factor authentication
          </Button>
        )}
      </Window>

      <Window title="Devices" icon="smartphone" id="devices">
        <p class="kz-acct__lead">See where you are signed in and sign out any device you don't recognise.</p>
        <a class="kz-acct__go" href="/portal/account/sessions">
          See signed-in devices
          <span aria-hidden="true">→</span>
        </a>
      </Window>

      {page.clients.length ? (
        <Window title="Companies" icon="clients" id="companies" meta={String(page.clients.length)}>
          <ul class="kz-acct__cos">
            {page.clients.map((c) => (
              <li>{c.name}</li>
            ))}
          </ul>
          <p class="kz-acct__hint">To change company details, contact Kuzikode.</p>
        </Window>
      ) : null}
    </div>
  </div>
</PortalLayout>
