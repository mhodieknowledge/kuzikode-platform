---
import { Check } from 'lucide-react';
import type { SectionContent } from '../../../shared/schemas/cms';

interface Props {
  content: SectionContent<'list'>;
  anchor: string;
}
const { content: c, anchor } = Astro.props;
---

<section class="bg-surface py-14 md:py-20" aria-labelledby={`${anchor}-title`}>
  <div class="container-content grid gap-8 lg:grid-cols-[1fr_2fr]">
    <h2 id={`${anchor}-title`} class="text-3xl font-bold tracking-display text-ink-950">{c.title}</h2>
    <ul class="flex flex-col gap-4">
      {
        c.items.map((item) => (
          <li class="flex gap-3 text-[17px] leading-7 text-ink-800">
            <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600">
              <Check size={14} strokeWidth={2.5} aria-hidden="true" />
            </span>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>
