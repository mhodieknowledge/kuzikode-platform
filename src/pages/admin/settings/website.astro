---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import SettingsNav from '../../../ui/admin/settings/SettingsNav.astro';
import SettingsSections from '../../../ui/admin/settings/SettingsSections.astro';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { settingsPage } from '../../../server/modules/settings';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'settings.view' });
if (page instanceof Response) return page;
const sections = await settingsPage(ctx, 'website');
const canEdit = page.auth.permissions.has('settings.manage');
---

<AdminLayout title="Website settings" page={page}>
  <PageHead title="Settings" meta="Website" />
  <div class="kz-aset">
    <SettingsNav current="website" canExport={page.auth.permissions.has('data.export')} />
    <div class="kz-aset__main">
      <SettingsSections sections={sections} canEdit={canEdit} />
    </div>
  </div>
</AdminLayout>
