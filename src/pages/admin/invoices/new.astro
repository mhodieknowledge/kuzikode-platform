---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import Button from '../../../ui/primitives/Button.astro';
import { InvoiceEditor } from '../../../ui/admin/invoices/InvoiceEditor';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { getSettings, settingText } from '../../../server/modules/cms';
import { editorProps } from '../../../server/modules/quotations';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'invoices.create' });
if (page instanceof Response) return page;
const [props, settings] = await Promise.all([editorProps(ctx, 'invoices.create'), getSettings(ctx)]);
const clientId = Astro.url.searchParams.get('clientId') ?? '';
const client = props.clients.find((c) => c.id === clientId);
const initial = {
  clientId: client?.id ?? '',
  contactId: null,
  currency: client?.currency ?? props.currencies[0]?.code ?? 'USD',
  issueDate: null,
  dueDate: null,
  paymentTermsDays: null,
  notes: null,
  terms: settingText(settings, 'invoice.default_terms_text') ?? null,
  discountType: 'none' as const,
  discountValue: 0,
  lines: [],
};
---

<AdminLayout title="New invoice" page={page}>
  <PageHead title="New invoice" crumbs={[{ label: 'Invoices', href: '/admin/invoices' }, { label: 'New' }]} />
  {props.clients.length === 0 ? (
    <Pane title="Add a client first" class="kz-anarrow">
      <p class="kz-adlg__desc">Invoices are made for a client record.</p>
      <Button slot="actions" href="/admin/clients/new" size="sm" lead="add">
        New client
      </Button>
    </Pane>
  ) : (
    <InvoiceEditor client:load initial={initial} {...props} />
  )}
</AdminLayout>
