---
import AuthLayout from '../../layouts/AuthLayout.astro';
import { ForgotPasswordForm } from '../../components/auth/AuthForms';
---

<AuthLayout
  title="Reset your password"
  heading="Reset your password"
  intro="We will email you a link to choose a new password."
  area="Admin"
>
  <ForgotPasswordForm client:load audience="admin" />
  <p slot="after" class="mt-6 text-center text-sm">
    <a href="/admin/login" class="font-semibold text-brand-600 underline underline-offset-2">
      Back to sign in
    </a>
  </p>
</AuthLayout>
