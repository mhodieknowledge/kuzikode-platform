---
import DocumentLayout from '../../layouts/DocumentLayout.astro';
import QuotationDocument from '../../components/documents/QuotationDocument.astro';
import { QuotationResponse } from '../../components/forms/QuotationResponse';
import { getPublicQuotation } from '../../server/modules/quotations';
import { publicDocumentPageLimit } from '../../server/lib/rate-limit';
import { formatMoney } from '../../shared/money';
import { formatLongDate } from '../../shared/service-display';

const { ctx } = Astro.locals;
const token = Astro.params.token ?? '';
const limited = await publicDocumentPageLimit(ctx);
if (limited) return limited;
const data = await getPublicQuotation(ctx, token);
if (!data) return new Response(null, { status: 404, statusText: 'Not found' });
const q = data.quotation;
const total = formatMoney(q.total_minor, q.currency);
const notice =
  q.status === 'accepted'
    ? `Accepted${q.accepted_by_name ? ` by ${q.accepted_by_name}` : ''}${q.accepted_at ? ` on ${formatLongDate(q.accepted_at)}` : ''}. Thank you.`
    : q.status === 'rejected'
      ? 'You declined this quotation. Reply to our email if you would like an updated one.'
      : q.status === 'void'
        ? 'This quotation has been withdrawn.'
        : q.status === 'expired' || (!data.open && !q.superseded_by_id && q.valid_until)
          ? 'This quotation has expired. Contact us for an updated one.'
          : null;
---

<DocumentLayout title={q.number ?? 'Quotation'}>
  <div class="mx-auto flex max-w-4xl flex-col gap-6">
    {data.newerVersionLink ? (
      <p role="status" class="rounded-sm border border-info-700/30 bg-info-50 px-4 py-3 text-sm text-info-700">
        There is a newer version of this quotation.{' '}
        <a href={data.newerVersionLink} class="font-semibold underline">
          View the latest version
        </a>
      </p>
    ) : notice ? (
      <p role="status" class="rounded-sm border border-line bg-surface px-4 py-3 text-sm text-ink-800">
        {notice}
      </p>
    ) : null}
    <QuotationDocument
      number={q.number}
      title={q.title}
      status={q.status}
      introHtml={q.intro_html}
      currency={q.currency}
      issueDate={q.issue_date}
      validUntil={q.valid_until}
      paymentTerms={q.payment_terms}
      notes={q.notes}
      terms={q.terms}
      totals={{ subtotal: q.subtotal_minor, discount: q.discount_minor, tax: q.tax_minor, total: q.total_minor }}
      items={data.items}
      client={data.client}
      business={data.business}
    />
    <p class="flex justify-end">
      <a
        href={`/api/v1/public/quotations/${token}/pdf`}
        download
        class="inline-flex h-10 items-center rounded-sm border border-line bg-surface px-4 text-sm font-semibold text-ink-950 hover:border-ink-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
      >
        Download PDF
      </a>
    </p>
    {data.open ? <QuotationResponse client:load token={token} total={total} /> : null}
    <p class="text-center text-[12px] text-ink-600">This page is private to you. Please don't share the link.</p>
  </div>
</DocumentLayout>
