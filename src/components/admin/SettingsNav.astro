---
interface Props {
  current: 'general' | 'billing' | 'numbering' | 'website' | 'integrations' | 'export';
  /** Show the Data export tab (Super Admin, data.export). */
  canExport?: boolean;
}
const { current, canExport = false } = Astro.props;
const tabs = [
  ['general', 'General', '/admin/settings'],
  ['billing', 'Billing & taxes', '/admin/settings/billing'],
  ['numbering', 'Numbering', '/admin/settings/numbering'],
  ['website', 'Website', '/admin/settings/website'],
  ['integrations', 'Integrations', '/admin/settings/integrations'],
  ...(canExport ? ([['export', 'Data export', '/admin/settings/data-export']] as const) : []),
] as const;
---

<h1 class="text-2xl font-bold tracking-display">Settings</h1>
<nav aria-label="Settings sections" class="mt-4 relative overflow-x-auto border-b border-line">
  <ul class="flex gap-1">
    {tabs.map(([key, label, href]) => (
      <li class="shrink-0">
        <a
          href={href}
          aria-current={current === key ? 'page' : undefined}
          class:list={[
            'inline-flex h-10 items-center border-b-2 px-3 text-sm font-semibold',
            current === key ? 'border-brand-600 text-brand-600' : 'border-transparent text-ink-600 hover:text-ink-950',
          ]}
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>
