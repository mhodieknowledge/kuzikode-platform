---
import { Check, Minus } from 'lucide-react';
import type { PublicPackage } from '../../../server/modules/cms';
import { packagePrice, startProjectHref } from '../../../shared/service-display';

interface Props {
  pkg: PublicPackage;
  /** When the tab also shows a comparison table, the feature list is only shown below `lg` (stacked cards on mobile). */
  featuresMobileOnly?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { pkg, featuresMobileOnly = false, headingLevel = 'h3' } = Astro.props;
const price = packagePrice(pkg);
const Heading = headingLevel;
const facts = [
  ['Delivery', pkg.deliveryTime],
  ['Revisions', pkg.revisionRounds],
  ['Support', pkg.supportPeriod],
].filter((f): f is [string, string] => Boolean(f[1]));
const unit = pkg.priceUnit?.replace(/^per\s+/i, '') ?? 'unit';
const unitPlural = /(x|s|ch|sh)$/.test(unit) ? `${unit}es` : `${unit}s`;
---

<article
  class:list={[
    'relative flex flex-col rounded-lg border bg-surface p-6',
    pkg.mostPopular ? 'border-brand-600 shadow-[0_0_0_1px_var(--color-brand-600)]' : 'border-line',
  ]}
  aria-labelledby={`pkg-${pkg.slug}`}
  data-package={pkg.slug}
>
  {
    pkg.mostPopular ? (
      <span class="absolute -top-3 left-6 rounded-full bg-brand-600 px-2.5 py-0.5 text-xs font-semibold text-white">
        Most popular
      </span>
    ) : null
  }
  <Heading id={`pkg-${pkg.slug}`} class="font-sans text-lg font-semibold text-ink-950">{pkg.name}</Heading>
  {pkg.tagline ? <p class="mt-1 text-[15px] leading-6 text-ink-600">{pkg.tagline}</p> : null}

  <div class="mt-5" data-price>
    {price.prefix ? <span class="block text-[13px] font-medium text-ink-600">{price.prefix}</span> : null}
    <span class:list={['tnum font-bold text-ink-950', price.hasPrice ? 'text-3xl tracking-display' : 'text-xl']}>
      {price.amount}
    </span>
    {price.suffix ? <span class="ml-1 text-sm text-ink-600">{price.suffix}</span> : null}
    {price.annual ? <p class="tnum mt-1 text-[13px] text-ink-600">{price.annual}</p> : null}
    {
      pkg.minQuantity > 1 ? (
        <p class="mt-1 text-[13px] text-ink-600">
          Minimum {pkg.minQuantity} {unitPlural}
        </p>
      ) : null
    }
  </div>

  {
    facts.length > 0 ? (
      <dl class="mt-5 grid grid-cols-3 gap-2 border-y border-line py-4 text-[13px]">
        {facts.map(([k, v]) => (
          <div>
            <dt class="text-ink-600">{k}</dt>
            <dd class="mt-0.5 font-medium text-ink-950">{v}</dd>
          </div>
        ))}
      </dl>
    ) : null
  }

  {
    pkg.features.length > 0 ? (
      <ul class:list={['mt-5 flex flex-col gap-2.5 text-[15px]', featuresMobileOnly && 'lg:hidden']}>
        {pkg.features.map((f) => (
          <li class:list={['flex gap-2.5', f.value === 'not_included' ? 'text-ink-600' : 'text-ink-800']}>
            {f.value === 'not_included' ? (
              <Minus size={18} className="mt-0.5 shrink-0 text-ink-400" aria-hidden="true" />
            ) : (
              <Check size={18} className="mt-0.5 shrink-0 text-brand-600" aria-hidden="true" />
            )}
            <span>
              {f.value === 'not_included' ? <span class="sr-only">Not included: </span> : null}
              {f.label}
              {f.value === 'text' ? <span class="font-semibold text-ink-950">: {f.text}</span> : null}
            </span>
          </li>
        ))}
      </ul>
    ) : null
  }

  <div class="mt-auto pt-6">
    {
      pkg.status === 'coming_soon' ? (
        <span class="inline-flex rounded-full bg-ink-950/5 px-2.5 py-0.5 text-xs font-semibold text-ink-800">
          Coming soon
        </span>
      ) : (
        <a
          href={startProjectHref(pkg.slug)}
          class:list={[
            'inline-flex h-11 w-full items-center justify-center rounded-sm px-5 text-[15px] font-semibold',
            pkg.mostPopular
              ? 'bg-brand-600 text-white hover:bg-brand-500'
              : 'border border-line bg-surface text-ink-950 hover:border-ink-400',
          ]}
        >
          {price.hasPrice ? 'Get started' : 'Request a quote'}
          <span class="sr-only">: {pkg.name}</span>
        </a>
      )
    }
  </div>
</article>
