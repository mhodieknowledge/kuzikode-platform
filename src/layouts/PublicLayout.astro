---
/**
 * Public site layout (redesign R3): new header (directory mega-panel + mobile directory sheet), footer, WhatsApp button,
 * announcement and preview strip, structured data. Data comes from the existing CMS services; nothing here computes business rules.
 */
import Base from './Base.astro';
import JsonLd from '../components/JsonLd.astro';
import Announcement from '../ui/public/shell/Announcement.astro';
import Header, { type DirectoryDivision } from '../ui/public/shell/Header.astro';
import Footer from '../ui/public/shell/Footer.astro';
import WhatsApp from '../ui/public/shell/WhatsApp.astro';
import {
  currentAnnouncement,
  getPricingCatalogue,
  getServiceCatalogue,
  getSettings,
  organizationLd,
  settingText,
  siteNavigation,
  websiteLd,
} from '../server/modules/cms';
import { divisionFromPrice } from '../shared/directory';

interface Props {
  title: string;
  description?: string | undefined;
  canonicalPath?: string;
  noindex?: boolean;
  /** `dark` (or `sign`): the page opens on a sign hero and the header joins it. */
  headerTone?: 'light' | 'dark' | 'night' | 'bone';
  ogImage?: string | undefined;
  ogType?: 'website' | 'article';
  /** Page-specific schema.org objects; Organization is always included, WebSite on the home page. */
  structuredData?: Record<string, unknown>[];
  /** Prefilled WhatsApp message for this page. */
  whatsappMessage?: string;
  /** Hide the footer's closing call to action on pages that are themselves the action (contact, wizard). */
  footerCta?: boolean;
  /** Closing words above the footer's routes (defaults to "Where next"). */
  footerLead?: { title: string; body?: string | undefined } | undefined;
}
const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  headerTone = 'light',
  ogImage,
  ogType,
  structuredData = [],
  whatsappMessage,
  footerCta = true,
  footerLead,
} = Astro.props;
const { ctx } = Astro.locals;
const [nav, announcement, org, settings, catalogue, pricing] = await Promise.all([
  siteNavigation(ctx),
  currentAnnouncement(ctx),
  organizationLd(ctx),
  getSettings(ctx),
  getServiceCatalogue(ctx),
  getPricingCatalogue(ctx),
]);
const divisions: DirectoryDivision[] = catalogue.map((c) => ({
  slug: c.slug,
  name: c.name,
  summary: c.summary,
  icon: c.icon,
  href: `/services/${c.slug}`,
  services: c.services.map((s) => ({ name: s.name })),
  from: pricing.showPrices ? divisionFromPrice(pricing.packages, c.slug) : null,
}));
const whatsappNumber = settingText(settings, 'contact.whatsapp_number');
const whatsappText =
  whatsappMessage ??
  settingText(settings, 'contact.whatsapp_message') ??
  'Hi Kuzikode, I would like to talk about a project.';
const ld = [org, ...(Astro.url.pathname === '/' ? [websiteLd(ctx)] : []), ...structuredData];
const tone = headerTone === 'dark' || headerTone === 'night' ? 'night' : 'bone';
---

<Base
  title={title}
  description={description}
  canonicalPath={noindex ? undefined : canonicalPath}
  noindex={noindex}
  ogImage={ogImage}
  ogType={ogType}
  themeColor={tone === 'night' ? '#141412' : '#F2EEE6'}
  bodyClass="flex min-h-screen flex-col bg-bone-50 text-ink-700"
>
  <Fragment slot="head">
    {noindex ? null : <JsonLd data={ld} />}
    <slot name="head" />
  </Fragment>
  {ctx.preview ? (
    <p role="status" class="sticky top-0 z-[60] bg-warn-700 px-4 py-2 text-center text-small font-semibold text-white">
      Preview of unpublished changes. Visitors still see the published version.
    </p>
  ) : null}
  <Announcement announcement={announcement} />
  <Header nav={nav} divisions={divisions} tone={tone} />
  <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
    <slot />
  </main>
  <Footer nav={nav} cta={footerCta} lead={footerLead} />
  <WhatsApp number={whatsappNumber} message={whatsappText} />
</Base>
