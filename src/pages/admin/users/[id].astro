---
/** One staff member (R6.2 group 3): head with email, management panes (name, roles, access) beside account facts and history. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import DetailList from '../../../ui/admin/DetailList.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import { StaffActions } from '../../../ui/admin/users/StaffActions';
import {
  roleNames,
  STAFF_STATUS_LABEL,
  STAFF_STATUS_TONE,
  stampOrNever,
  USER_ACTION_LABEL,
} from '../../../ui/admin/users/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { AppError } from '../../../server/lib/errors';
import { getStaff, listRoles } from '../../../server/modules/users';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'users.view' });
if (page instanceof Response) return page;
let user;
try {
  user = await getStaff(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const roles = await listRoles(ctx);
const isSuper = page.auth.roles.includes('super_admin');
const targetIsSuper = user.roles.includes('super_admin');
const canManage = page.auth.permissions.has('users.manage') && (isSuper || !targetIsSuper);
const assignable = roles
  .filter((r) => r.key !== 'super_admin' || isSuper)
  .map((r) => ({ key: r.key, name: r.name, description: r.description }));
const names = new Map(roles.map((r) => [r.key, r.name]));
---

<AdminLayout title={user.name} page={page}>
  <PageHead
    title={user.name}
    meta={user.email}
    crumbs={[{ label: 'Users', href: '/admin/users' }, { label: user.name }]}
  />
  <div class="kz-agrid kz-agrid--detail">
    <div class="kz-astack">
      {canManage ? (
        <StaffActions
          client:load
          userId={user.id}
          name={user.name}
          status={user.status}
          roles={user.roles}
          allRoles={assignable}
          mfaEnabled={user.mfaEnabled}
          isSelf={user.id === page.auth.user.id}
        />
      ) : (
        <Pane title="Roles" id="roles-title">
          <p class="kz-aprose">{roleNames(user.roles, names) === '—' ? 'No roles' : roleNames(user.roles, names)}</p>
          {targetIsSuper && !isSuper ? (
            <p class="kz-hint">Only a Super Administrator can change this account.</p>
          ) : null}
        </Pane>
      )}
    </div>
    <aside class="kz-astack" aria-label="Account summary">
      <Pane title="Account" id="facts-title">
        <DetailList
          rows
          items={[
            { label: 'Two-factor', value: user.mfaEnabled ? 'On' : 'Off' },
            { label: 'Last sign-in', value: stampOrNever(user.lastLoginAt), mono: true },
            { label: 'Active sessions', value: user.activeSessions, mono: true },
            { label: 'Created', value: stampOrNever(user.createdAt), mono: true },
          ]}
        />
        <div class="kz-asub">
          <h3 class="kz-asub__t">Status</h3>
          <StatusPill tone={STAFF_STATUS_TONE[user.status]}>{STAFF_STATUS_LABEL[user.status]}</StatusPill>
        </div>
      </Pane>
      <Pane title="History" id="history-title" flush meta={String(user.history.length)}>
        {user.history.length === 0 ? (
          <p class="kz-anone">
            <span class="kz-anone__code">0 changes</span>No changes recorded yet.
          </p>
        ) : (
          <ol class="kz-afeed">
            {user.history.map((h) => (
              <li>
                <span class="kz-afeed__k">{USER_ACTION_LABEL[h.action] ?? h.action}</span>
                <span class="kz-afeed__t">
                  {stampOrNever(h.created_at)}
                  {h.actor_name ? ` · by ${h.actor_name}` : ''}
                </span>
              </li>
            ))}
          </ol>
        )}
      </Pane>
    </aside>
  </div>
</AdminLayout>
