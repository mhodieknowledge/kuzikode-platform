---
/**
 * Server error (R4.7, rebuilt from scratch). Kept independent of the database (no CMS, no navigation queries) so it renders even
 * when D1 is unavailable: the wordmark, a plain sentence, one way home and the "road runs out" drawing.
 */
import Head from '../ui/head/Head.astro';
import Logo from '../ui/brand/Logo.astro';
import Icon from '../ui/icons/Icon.astro';
import CoverArt from '../ui/illustrations/CoverArt.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <Head title="Something went wrong · Kuzikode Technologies" noindex />
  </head>
  <body class="kz-bare">
    <header class="kz-bare__bar">
      <div class="container-wide">
        <Logo />
      </div>
    </header>
    <main id="main" class="kz-lost">
      <div class="container-wide kz-lost__grid">
        <div class="kz-lost__text">
          <p class="kz-lost__code is-err">500 · Server error</p>
          <h1 class="kz-xhead__title">Something went wrong on our side.</h1>
          <p class="kz-lost__body">
            Please try again in a moment. If it keeps happening, email us or use the contact page.
          </p>
          <p class="kz-lost__acts">
            <a href="/" class="kz-btn kz-btn--primary">
              <span>Back to the home page</span>
            </a>
            <a href="/contact" class="kz-link">
              Contact us
              <Icon name="arrow-right" size={16} />
            </a>
          </p>
        </div>
        <div class="kz-lost__art" aria-hidden="true">
          <CoverArt motif="end" />
        </div>
      </div>
    </main>
  </body>
</html>
