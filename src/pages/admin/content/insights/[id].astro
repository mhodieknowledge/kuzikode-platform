---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import { PostEditor } from '../../../../ui/admin/content/PostEditor';
import SavedNotice from '../../../../ui/admin/website/SavedNotice.astro';
import type { PostValues } from '../../../../ui/admin/content/useContent';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { AppError } from '../../../../server/lib/errors';
import { listMedia } from '../../../../server/modules/cms/admin';
import { getPostAdmin, listPostCategoriesAdmin } from '../../../../server/modules/cms/content-admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'content.manage' });
if (page instanceof Response) return page;
const id = Astro.params.id ?? '';
let item: Awaited<ReturnType<typeof getPostAdmin>> | null = null;
if (id !== 'new') {
  try {
    item = await getPostAdmin(ctx, id);
  } catch (err) {
    if (err instanceof AppError && err.code === 'NOT_FOUND')
      return new Response(null, { status: 404, statusText: 'Not found' });
    throw err;
  }
}
const [categories, media] = await Promise.all([listPostCategoriesAdmin(ctx), listMedia(ctx)]);
const s = (k: string) => (item?.[k] as string | null | undefined) ?? null;
const initial: PostValues = {
  slug: s('slug') ?? '',
  title: s('title') ?? '',
  excerpt: s('excerpt') ?? '',
  body: s('body') ?? '',
  coverMediaId: s('cover_media_id'),
  categoryId: s('category_id'),
  tags: item?.tags ?? [],
  authorDisplayName: s('author_display_name') ?? 'Kuzikode Technologies',
  status: (s('status') as PostValues['status'] | null) ?? 'draft',
  publishAt: s('publish_at'),
  seoTitle: s('seo_title'),
  seoDescription: s('seo_description'),
};
const title = item ? initial.title : 'New article';
const saved = Astro.url.searchParams.get('saved') === '1';
---

<AdminLayout title={title} page={page}>
  <PageHead title={title} crumbs={[{ label: 'Insights', href: '/admin/content/insights' }, { label: title }]} />
  {saved ? <SavedNotice>Saved.</SavedNotice> : null}
  {item ? (
    <PostEditor
      client:load
      id={id}
      initial={initial}
      categories={categories}
      media={media.map((m) => ({ id: m.id, file_id: m.file_id, alt_text: m.alt_text }))}
    />
  ) : (
    <PostEditor
      client:load
      initial={initial}
      categories={categories}
      media={media.map((m) => ({ id: m.id, file_id: m.file_id, alt_text: m.alt_text }))}
    />
  )}
</AdminLayout>
