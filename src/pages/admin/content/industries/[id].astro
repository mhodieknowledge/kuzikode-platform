---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import { IndustryEditor } from '../../../../ui/admin/content/IndustryEditor';
import SavedNotice from '../../../../ui/admin/website/SavedNotice.astro';
import type { IndustryValues } from '../../../../ui/admin/content/useContent';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { AppError } from '../../../../server/lib/errors';
import { getIndustryAdmin, serviceOptions } from '../../../../server/modules/cms/content-admin';
import { CMS_ICONS } from '../../../../shared/icons';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'content.manage' });
if (page instanceof Response) return page;
const id = Astro.params.id ?? '';
let item: Awaited<ReturnType<typeof getIndustryAdmin>> | null = null;
if (id !== 'new') {
  try {
    item = await getIndustryAdmin(ctx, id);
  } catch (err) {
    if (err instanceof AppError && err.code === 'NOT_FOUND')
      return new Response(null, { status: 404, statusText: 'Not found' });
    throw err;
  }
}
const services = await serviceOptions(ctx);
const s = (k: string) => (item?.[k] as string | null | undefined) ?? null;
const initial: IndustryValues = {
  slug: s('slug') ?? '',
  name: s('name') ?? '',
  summary: s('summary') ?? '',
  challenges: Array.isArray(item?.challenges) ? (item.challenges as IndustryValues['challenges']) : [],
  body: s('body'),
  icon: s('icon'),
  status: (s('status') as IndustryValues['status'] | null) ?? 'draft',
  sortOrder: Number(item?.['sort_order'] ?? 0),
  serviceIds: item?.serviceIds ?? [],
  seoTitle: s('seo_title'),
  seoDescription: s('seo_description'),
};
const title = item ? initial.name : 'New industry';
const saved = Astro.url.searchParams.get('saved') === '1';
---

<AdminLayout title={title} page={page}>
  <PageHead title={title} crumbs={[{ label: 'Industries', href: '/admin/content/industries' }, { label: title }]} />
  {saved ? <SavedNotice>Saved.</SavedNotice> : null}
  {item ? (
    <IndustryEditor client:load id={id} initial={initial} services={services} icons={CMS_ICONS} />
  ) : (
    <IndustryEditor client:load initial={initial} services={services} icons={CMS_ICONS} />
  )}
</AdminLayout>
