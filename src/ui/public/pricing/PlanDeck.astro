---
/**
 * Package carousel (R9.2, REFINEMENTS §2): the primary view of a division's packages at every size.
 * Built on the Rail primitive (scroll-snap track, dots, prev/next buttons, arrow keys, off-centre cards dimmed): phones swipe with the next
 * card peeking; tablets show about two cards; desktop shows the whole row when it fits (up to 4 cards, controls hidden by the rail
 * controller) and otherwise scrolls with the arrow buttons. There is no selector or tab control: the dots and arrows are the controls.
 * Each card: name, tagline, price (from `packagePrice`: "From", "one-off", "per page" exactly as stored), minimum quantity, the first four
 * included features, "All features" disclosing the rest (including what is not included), and "Get a quote", which opens the contact
 * form with the package preselected (`packageQuoteHref`). The package flagged most popular in the CMS is a night card with a badge.
 */
import Icon from '../../icons/Icon.astro';
import Rail from '../../primitives/Rail.astro';
import type { PublicPackage } from '../../../server/modules/cms';
import { packagePrice, packageQuoteHref } from '../../../shared/service-display';

interface Props {
  packages: PublicPackage[];
  label: string;
  id: string;
}
const { packages, label, id } = Astro.props;
const FIRST = 4;
const plural = (unit: string) => (/(x|s|ch|sh)$/.test(unit) ? `${unit}es` : `${unit}s`);
const view = packages.map((p) => {
  const facts = (
    [
      ['Delivery', p.deliveryTime],
      ['Revisions', p.revisionRounds],
      ['Support', p.supportPeriod],
    ] as [string, string | null][]
  ).filter((f): f is [string, string] => Boolean(f[1]));
  // Included and valued features first (as stored), then the not-included rows; the order inside each group is the CMS order.
  const shown = p.features.filter((f) => f.value !== 'not_included');
  const absent = p.features.filter((f) => f.value === 'not_included');
  return {
    p,
    price: packagePrice(p),
    facts,
    first: shown.slice(0, FIRST),
    rest: [...shown.slice(FIRST), ...absent],
    unit: p.priceUnit?.replace(/^per\s+/i, '') ?? 'unit',
  };
});
---

<Rail label={`${label} packages`} class="kz-pcar" style={`--pc:${packages.length}`} list id={id}>
  {
    view.map(({ p, price, facts, first, rest, unit }) => (
      <li
        id={`${id}-${p.slug}`}
        class:list={['kz-plan', p.mostPopular && 'is-rec on-night']}
        data-package={p.slug}
        aria-labelledby={`${id}-${p.slug}-name`}
      >
        <div class="kz-plan__top">
          <h3 class="kz-plan__name" id={`${id}-${p.slug}-name`}>
            {p.name}
          </h3>
          {p.mostPopular ? <span class="kz-plan__rec">Most popular</span> : null}
        </div>
        {p.tagline ? <p class="kz-plan__tag">{p.tagline}</p> : null}
        <p class="kz-plan__price" data-price>
          {price.prefix ? <small class="kz-plan__pre">{price.prefix}</small> : null}
          <b class:list={[!price.hasPrice && 'is-quote']}>{price.amount}</b>
          {price.suffix ? <small>{price.suffix}</small> : null}
        </p>
        {price.annual || p.minQuantity > 1 ? (
          <p class="kz-plan__terms">
            {price.annual ? <span>{price.annual}</span> : null}
            {p.minQuantity > 1 ? (
              <span>
                Minimum {p.minQuantity} {plural(unit)}
              </span>
            ) : null}
          </p>
        ) : null}
        {facts.length > 0 ? (
          <dl class="kz-plan__facts">
            {facts.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        ) : null}
        {first.length > 0 ? (
          <ul class="kz-plan__feats" role="list">
            {first.map((f) => (
              <li>
                <Icon name="check" size={16} />
                <span>
                  {f.label}
                  {f.value === 'text' ? <b>: {f.text}</b> : null}
                </span>
              </li>
            ))}
          </ul>
        ) : null}
        {rest.length > 0 ? (
          <details class="kz-plan__more">
            <summary>
              <span>All features</span>
              <small>+{rest.length}</small>
              <Icon name="chevron-down" size={16} />
            </summary>
            <ul class="kz-plan__feats" role="list">
              {rest.map((f) => (
                <li class:list={[f.value === 'not_included' && 'is-no']}>
                  <Icon name={f.value === 'not_included' ? 'remove' : 'check'} size={16} />
                  <span>
                    {f.value === 'not_included' ? <span class="sr-only">Not included: </span> : null}
                    {f.label}
                    {f.value === 'text' ? <b>: {f.text}</b> : null}
                  </span>
                </li>
              ))}
            </ul>
          </details>
        ) : null}
        <div class="kz-plan__act">
          {p.status === 'coming_soon' ? (
            <span class="kz-plan__soon">Coming soon</span>
          ) : (
            <a
              class:list={['kz-btn kz-btn--block', p.mostPopular ? 'kz-btn--primary' : 'kz-btn--secondary']}
              href={packageQuoteHref(p)}
            >
              <span>Get a quote</span>
              <span class="sr-only">: {p.name}</span>
            </a>
          )}
        </div>
      </li>
    ))
  }
</Rail>
