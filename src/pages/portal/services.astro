---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { CancellationRequest } from '../../components/portal/SupportForms';
import { loadPortalPage } from '../../server/lib/portal-page';
import { listPortalServices } from '../../server/modules/subscriptions/portal';
import { formatMoney } from '../../shared/money';
import { formatLongDate } from '../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request, { area: 'finance' });
if (page instanceof Response) return page;
const groups = await listPortalServices(ctx);
const multiClient = groups.length > 1;
const empty = groups.every((g) => g.subscriptions.length === 0 && g.assets.length === 0);
const section = 'rounded-lg border border-line bg-surface p-5 md:p-6';
---

<PortalLayout title="Your services" page={page} active="services">
  <h1 class="text-2xl font-bold tracking-display md:text-3xl">Your services</h1>
  <p class="mt-1 max-w-2xl text-ink-600">
    Ongoing services you have with Kuzikode, and the domains and hosting we look after for you.
  </p>
  {empty ? (
    <p class="mt-6 max-w-2xl rounded-lg border border-line bg-surface p-6 text-ink-600">
      You have no ongoing services with us at the moment.
    </p>
  ) : (
    groups.map((g) => (
      <div class="mt-6 flex flex-col gap-6">
        {multiClient ? <h2 class="text-xl font-semibold">{g.client.name}</h2> : null}
        <section class={section} aria-label={`Subscriptions${multiClient ? ` for ${g.client.name}` : ''}`}>
          <h3 class="font-sans text-lg font-semibold">Subscriptions</h3>
          {g.subscriptions.length === 0 ? (
            <p class="mt-2 text-sm text-ink-600">No subscriptions.</p>
          ) : (
            <ul class="mt-3 divide-y divide-line" data-testid="subscriptions">
              {g.subscriptions.map((s) => (
                <li class="flex flex-col gap-3 py-4 md:flex-row md:items-start md:justify-between">
                  <div class="min-w-0">
                    <p class="font-medium text-ink-950 [overflow-wrap:anywhere]">{s.description}</p>
                    <p class="text-sm text-ink-600">
                      <span class="font-mono tabular-nums">{formatMoney(s.amountMinor, s.currency)}</span> per{' '}
                      {s.interval}
                      {s.quantity !== '1' ? ` · quantity ${s.quantity}` : ''}
                      {' · '}
                      {s.paused ? 'Paused' : s.nextBillingDate ? `Next bill ${formatLongDate(s.nextBillingDate)}` : ''}
                    </p>
                  </div>
                  <div class="md:max-w-sm md:text-right">
                    {s.cancellationRequested ? (
                      <p class="text-sm font-medium text-ink-800">
                        Cancellation requested.{' '}
                        <a
                          href="/portal/support?show=open"
                          class="font-semibold text-brand-600 underline underline-offset-2"
                        >
                          See your requests
                        </a>
                      </p>
                    ) : (
                      <CancellationRequest client:visible subscriptionId={s.id} description={s.description} />
                    )}
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>
        {g.assets.length ? (
          <section class={section} aria-label={`Domains and hosting${multiClient ? ` for ${g.client.name}` : ''}`}>
            <h3 class="font-sans text-lg font-semibold">Domains, hosting and accounts</h3>
            <ul class="mt-3 divide-y divide-line" data-testid="assets">
              {g.assets.map((a) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3">
                  <div class="min-w-0">
                    <p class="font-medium text-ink-950 [overflow-wrap:anywhere]">{a.name}</p>
                    <p class="text-sm text-ink-600">
                      {a.typeLabel}
                      {a.provider ? ` · ${a.provider}` : ''}
                    </p>
                  </div>
                  <p class="text-sm text-ink-600">
                    {a.renewalDate
                      ? `${a.autoRenew ? 'Renews' : 'Expires'} ${formatLongDate(a.renewalDate)}`
                      : 'No renewal date'}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        ) : null}
      </div>
    ))
  )}
  <p class="mt-6 text-sm text-ink-600">
    Questions about a service?{' '}
    <a href="/portal/support/new" class="font-semibold text-brand-600 underline underline-offset-2">
      Ask our team
    </a>
    .
  </p>
</PortalLayout>
