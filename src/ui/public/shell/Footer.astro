---
/**
 * Public footer (R3.2, DESIGN_DIRECTION §3): on night. Opens with "Where next": three routes as large rows (get a quote,
 * book a consultation, see all prices) instead of the generic closing band; then the brand and contact channels, the link
 * directories, the newsletter and the legal line. Contact lines left blank in Settings are not rendered. No oversized
 * wordmark (it covered the links and read as a 2024 trend).
 */
import Logo from '../../brand/Logo.astro';
import Icon from '../../icons/Icon.astro';
import Newsletter from '../forms/Newsletter';
import type { SiteNavigation } from '../../../server/modules/cms';
import { divisionShortName } from '../../../shared/directory';

interface Props {
  nav: SiteNavigation;
  /** Pages that end with their own call to action (contact, consultation) hide the footer's routes. */
  cta?: boolean;
  /** The page's own closing words (e.g. the home page's CMS `cta` section) shown above the routes instead of "Where next". */
  lead?: { title: string; body?: string | undefined } | undefined;
}
const { nav, cta = true, lead } = Astro.props;
const { footer } = nav;
const year = new Date().getFullYear();
const c = footer.contact;
const routes = [
  { href: '/contact', title: 'Get a quote', body: 'Tell us what you need. We reply with questions or a written quotation.' },
  { href: '/consultation', title: 'Book a consultation', body: 'Pick a time to talk it through before you decide.' },
  { href: '/pricing', title: 'See all prices', body: 'Every published package, side by side.' },
];
---

<footer class="kz-footer on-night" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  {
    cta ? (
      <div class="container-wide kz-footer__next">
        <div>
          <h2 class="kz-footer__lead">{lead?.title ?? 'Where next'}</h2>
          {lead?.body ? <p class="kz-footer__lead-body">{lead.body}</p> : null}
        </div>
        <ol class="kz-footer__routes" role="list">
          {routes.map((r, i) => (
            <li>
              <a href={r.href} class="kz-footer__route">
                <span class="kz-footer__route-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="kz-footer__route-title">{r.title}</span>
                <span class="kz-footer__route-body">{r.body}</span>
                <Icon name="arrow-right" class="kz-footer__route-arrow" />
              </a>
            </li>
          ))}
        </ol>
      </div>
    ) : null
  }

  <div class="container-wide kz-footer__grid">
    <div class="kz-footer__brand">
      <Logo height={26} />
      {footer.blurb ? <p class="kz-footer__blurb">{footer.blurb}</p> : null}
      <ul class="kz-footer__channels" aria-label="Contact" role="list">
        {
          c.whatsapp ? (
            <li>
              <a href={c.whatsapp} rel="noopener noreferrer" target="_blank" class="kz-channel">
                <Icon name="whatsapp" /> WhatsApp<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ) : null
        }
        {
          c.phone ? (
            <li>
              <a href={`tel:${c.phone.replace(/[^\d+]/g, '')}`} class="kz-channel">
                <Icon name="phone" /> {c.phone}
              </a>
            </li>
          ) : null
        }
        {
          c.email ? (
            <li>
              <a href={`mailto:${c.email}`} class="kz-channel">
                <Icon name="email" /> {c.email}
              </a>
            </li>
          ) : null
        }
        <li>
          <a href="/contact" class="kz-channel">
            <Icon name="send" /> {c.email || c.phone || c.whatsapp ? 'Contact form' : 'Send us a message'}
          </a>
        </li>
      </ul>
      {
        c.address || c.location ? (
          <p class="kz-footer__place">
            <Icon name="location" size={20} />
            <span>{c.address ?? c.location}</span>
          </p>
        ) : null
      }
    </div>

    <nav aria-labelledby="footer-services" class="kz-footer__col">
      <h3 id="footer-services" class="kz-footer__h">Services</h3>
      <ul role="list">
        {
          footer.services.map((l) => (
            <li>
              <a href={l.href} class="kz-footer__link">
                {divisionShortName(l.href.replace(/^\/services\//, ''), l.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-labelledby="footer-company" class="kz-footer__col">
      <h3 id="footer-company" class="kz-footer__h">Company</h3>
      <ul role="list">
        {
          footer.company.map((l) => (
            <li>
              <a href={l.href} class="kz-footer__link">
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/portal/login" class="kz-footer__link">Client workspace</a>
        </li>
      </ul>
    </nav>

    <section aria-labelledby="newsletter-heading" class="kz-footer__news">
      <h3 id="newsletter-heading" class="kz-footer__h">Newsletter</h3>
      <Newsletter client:idle source="footer" />
      {
        footer.social.length > 0 ? (
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Social media" role="list">
            {footer.social.map((s) => (
              <li>
                <a href={s.href} rel="noopener noreferrer" target="_blank" class="kz-btn kz-btn--secondary kz-btn--sm">
                  <span>{s.label}</span>
                  <Icon name="arrow-up-right" size={16} />
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
    </section>
  </div>

  <div class="container-wide">
    <div class="kz-footer__legal">
      <p>© {year} {footer.companyName}{footer.registration ? ` · ${footer.registration}` : ''}</p>
      <ul role="list" aria-label="Legal">
        {
          footer.legal.map((l) => (
            <li>
              <a href={l.href} class="kz-footer__link">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
