---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import { NewRequestForm } from '../../../ui/admin/support/NewRequestForm';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { newRequestOptions } from '../../../server/modules/support';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'support.reply' });
if (page instanceof Response) return page;
const opts = await newRequestOptions(ctx);
const clientId = Astro.url.searchParams.get('clientId') ?? '';
---

<AdminLayout title="New support request" page={page}>
  <PageHead
    title="New support request"
    meta="For a request that came in by phone, WhatsApp or email."
    crumbs={[{ label: 'Support', href: '/admin/support' }, { label: 'New' }]}
  />
  <NewRequestForm client:load initialClientId={opts.clients.some((c) => c.id === clientId) ? clientId : ''} {...opts} />
</AdminLayout>
