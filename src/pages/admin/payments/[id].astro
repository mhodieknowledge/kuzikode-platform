---
/** One payment (R6.2): head with receipt / refund actions; details, applied-to, refunds and the gateway timeline in panes. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import DetailList from '../../../ui/admin/DetailList.astro';
import Button from '../../../ui/primitives/Button.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import { RefundAction } from '../../../ui/admin/payments/RefundAction';
import { PAYMENT_METHOD, PAYMENT_STATUS, formatWhen } from '../../../ui/admin/finance/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { AppError } from '../../../server/lib/errors';
import { getPayment } from '../../../server/modules/payments';
import { formatMoney } from '../../../shared/money';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'payments.view' });
if (page instanceof Response) return page;
let data;
try {
  data = await getPayment(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const { payment: p, client, allocations, refunds, attempt, events, account } = data;
const digits =
  (
    await ctx.db
      .prepare('SELECT minor_digits FROM currencies WHERE code = ?')
      .bind(p.currency)
      .first<{ minor_digits: number }>()
  )?.minor_digits ?? 2;
const money = (m: number) => formatMoney(m, p.currency, digits);
const allocated = allocations.reduce((s, a) => s + a.amount_minor, 0);
const canRefund = page.auth.permissions.has('payments.refund') && data.refundable > 0 && p.status !== 'reversed';
const status = PAYMENT_STATUS[p.status] ?? { label: p.status, tone: 'neutral' as const };
const details = [
  { label: 'Amount', value: money(p.amount_minor), mono: true },
  { label: 'Received', value: formatWhen(p.received_at) },
  { label: 'Method', value: PAYMENT_METHOD[p.method] ?? p.method },
  {
    label: 'Provider',
    value:
      p.provider_key === 'manual'
        ? 'Recorded manually'
        : `${account?.label ?? p.provider_key}${account?.mode === 'test' ? ' (test mode)' : ''}`,
  },
  ...(p.reference ? [{ label: 'Reference', value: p.reference, mono: true }] : []),
  ...(p.provider_reference ? [{ label: 'Gateway reference', value: p.provider_reference, mono: true }] : []),
  ...(data.recordedBy ? [{ label: 'Recorded by', value: data.recordedBy }] : []),
];
---

<AdminLayout title={p.receipt_number} page={page}>
  <PageHead
    title={p.receipt_number}
    crumbs={[{ label: 'Payments', href: '/admin/payments' }, { label: p.receipt_number }]}
  >
    <Fragment slot="meta">
      <StatusPill tone={status.tone}>{status.label}</StatusPill> ·{' '}
      <a href={`/admin/clients/${p.client_id}`}>{client?.display_name}</a>
    </Fragment>
    <div slot="actions" class="kz-aacts">
      <div class="kz-ahead__acts">
        <Button variant="secondary" lead="download" href={`/api/v1/admin/documents/receipts/${p.id}/pdf`} download>
          Download receipt
        </Button>
        {canRefund ? (
          <RefundAction
            client:load
            paymentId={p.id}
            receiptNumber={p.receipt_number}
            currency={p.currency}
            minorDigits={digits}
            refundableMinor={data.refundable}
            accountCreditMinor={data.refundSources.accountCredit}
            creditNotes={data.refundSources.creditNotes}
          />
        ) : null}
      </div>
    </div>
  </PageHead>
  <div class="kz-agrid kz-agrid--2">
    <Pane title="Details" id="d-h">
      <DetailList items={details} rows />
      {p.notes ? <p class="kz-aprose">{p.notes}</p> : null}
    </Pane>
    <Pane title="Applied to" id="a-h" flush>
      <ul class="kz-alist" role="list">
        {allocations.map((a) => (
          <li>
            <div class="kz-alist__main">
              <a href={`/admin/invoices/${a.invoice_id}`} class="kz-alist__t kz-amono">
                {a.number}
              </a>
            </div>
            <span class="kz-alist__r">{money(a.amount_minor)}</span>
          </li>
        ))}
        {p.amount_minor > allocated ? (
          <li>
            <div class="kz-alist__main">
              <span class="kz-alist__t">Kept as account credit</span>
            </div>
            <span class="kz-alist__r">{money(p.amount_minor - allocated)}</span>
          </li>
        ) : null}
      </ul>
    </Pane>
    <Pane title="Refunds" id="r-h" flush>
      {refunds.length === 0 ? (
        <p class="kz-anone">
          <span class="kz-anone__code">0 refunds</span>No refunds.
        </p>
      ) : (
        <ul class="kz-alist" role="list">
          {refunds.map((r) => (
            <li>
              <div class="kz-alist__main">
                <span class="kz-alist__t">{r.reason}</span>
                <span class="kz-alist__m">
                  {formatWhen(r.created_at)}
                  {r.recorded_by ? ` · ${r.recorded_by}` : ''}
                  {r.credit_note_number ? ` · ${r.credit_note_number}` : ' · from account credit'}
                  {r.provider_reference ? ` · ${r.provider_reference}` : ''}
                </span>
              </div>
              <span class="kz-alist__r">{money(r.amount_minor)}</span>
            </li>
          ))}
        </ul>
      )}
    </Pane>
    {attempt ? (
      <Pane title="Gateway timeline" id="t-h" flush>
        <p class="kz-apad kz-afeed__t">
          Attempt <span class="kz-amono">{String(attempt['merchant_reference'])}</span> · {String(attempt['status'])}
          {attempt['failure_reason'] ? ` · ${String(attempt['failure_reason'])}` : ''}
        </p>
        <ol class="kz-afeed">
          {events.map((e) => (
            <li>
              <p class="kz-afeed__k">{e.event_type.replace(/_/g, ' ')}</p>
              <p class="kz-afeed__t">{formatWhen(e.received_at)}</p>
              {e.payload_redacted ? (
                <details>
                  <summary class="kz-afeed__t">Payload (redacted)</summary>
                  <pre class="kz-apre">{e.payload_redacted}</pre>
                </details>
              ) : null}
            </li>
          ))}
        </ol>
      </Pane>
    ) : null}
  </div>
  <p class="kz-afeed__t kz-agap">
    Received {formatLongDate(p.received_at)}. Payments are never deleted; corrections are refunds or credit notes.
  </p>
</AdminLayout>
