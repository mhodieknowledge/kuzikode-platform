---
/**
 * One client (R6.2): head with number / type / status, tags and document actions; sections as a view switch (overview,
 * contacts, notes, services, portal access), each a set of panes.
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import Pane from '../../../../ui/admin/Pane.astro';
import Views from '../../../../ui/admin/Views.astro';
import DetailList from '../../../../ui/admin/DetailList.astro';
import Button from '../../../../ui/primitives/Button.astro';
import {
  ClientStatusActions,
  ContactsPanel,
  NoteForm,
  PortalAccessPanel,
} from '../../../../ui/admin/clients/ClientPanels';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { AppError } from '../../../../server/lib/errors';
import { getClient } from '../../../../server/modules/clients';
import { formatMoney } from '../../../../shared/money';
import { ASSET_TYPE_LABELS, clientServices } from '../../../../server/modules/subscriptions';
import { formatLongDate } from '../../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'clients.view' });
if (page instanceof Response) return page;
let data;
try {
  data = await getClient(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const { client: c, contacts, notes, credits, access, related } = data;
const tabs = [
  { key: 'overview', label: 'Overview' },
  { key: 'contacts', label: 'Contacts', count: contacts.length },
  { key: 'notes', label: 'Notes', count: notes.length },
  { key: 'services', label: 'Services' },
  { key: 'portal', label: 'Portal access' },
].map((t) => ({ ...t, href: `/admin/clients/${c.id}${t.key === 'overview' ? '' : `?tab=${t.key}`}` }));
const tab = tabs.some((t) => t.key === Astro.url.searchParams.get('tab'))
  ? Astro.url.searchParams.get('tab')!
  : 'overview';
const perms = page.auth.permissions;
const canEdit = perms.has('clients.update') && c.status === 'active';
const canSubs = perms.has('subscriptions.view');
const canAssets = perms.has('client_assets.manage');
const services = tab === 'services' ? await clientServices(ctx, c.id) : null;
const canArchive = perms.has('clients.archive');
const unused = !(
  related.quotations ||
  related.invoices ||
  related.projects ||
  related.credits ||
  related.access ||
  related.subscriptions
);
const fmt = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Africa/Harare' }).format(
    new Date(iso),
  );
const address = c.billingAddress
  ? [
      c.billingAddress.line1,
      c.billingAddress.line2,
      c.billingAddress.city,
      c.billingAddress.region,
      c.billingAddress.postalCode,
      c.billingAddress.country,
    ]
      .filter(Boolean)
      .join(', ')
  : null;
---

<AdminLayout title={c.displayName} page={page}>
  <PageHead title={c.displayName} crumbs={[{ label: 'Clients', href: '/admin/clients' }, { label: c.displayName }]}>
    <Fragment slot="meta">
      <span class="kz-amono">{c.number}</span> · {c.type === 'business' ? 'Business' : 'Individual'}
      {c.status === 'archived' ? ' · Archived' : ''}
    </Fragment>
    <Fragment slot="actions">
      {perms.has('quotations.create') && c.status === 'active' ? (
        <Button href={`/admin/quotations/new?clientId=${c.id}`} variant="secondary" lead="quotations">
          New quotation
        </Button>
      ) : null}
      {perms.has('invoices.create') && c.status === 'active' ? (
        <Button href={`/admin/invoices/new?clientId=${c.id}`} variant="secondary" lead="invoices">
          New invoice
        </Button>
      ) : null}
      {canEdit ? (
        <Button href={`/admin/clients/${c.id}/edit`} variant="secondary" lead="edit">
          Edit
        </Button>
      ) : null}
      {canArchive ? <ClientStatusActions client:visible clientId={c.id} status={c.status} canDelete={unused} /> : null}
    </Fragment>
    {c.tags.length ? (
      <p class="kz-dt__tags">
        {c.tags.map((t) => (
          <span class="kz-tag">{t}</span>
        ))}
      </p>
    ) : null}
  </PageHead>
  <div class="kz-atools">
    <Views label="Client sections" items={tabs} current={tab} />
  </div>
  {tab === 'overview' ? (
    <div class="kz-agrid kz-agrid--detail">
      <Pane title="Details" id="d-title">
        <DetailList
          cols={2}
          items={[
            { label: 'Registered name', value: c.legalName },
            { label: 'Email', value: c.email, href: c.email ? `mailto:${c.email}` : undefined },
            { label: 'Phone', value: c.phone },
            { label: 'Website', value: c.website },
            { label: 'Tax / VAT number', value: c.taxNumber, mono: true },
            { label: 'Billing address', value: address },
            { label: 'Default currency', value: c.defaultCurrency, mono: true },
            { label: 'Payment terms', value: `${c.paymentTermsDays} days` },
          ]}
        />
        {c.notes ? (
          <div class="kz-asub">
            <h3 class="kz-asub__t">Internal notes</h3>
            <p class="kz-aprose">{c.notes}</p>
          </div>
        ) : null}
      </Pane>
      <aside class="kz-astack" aria-label="Client summary">
        <Pane title="Credit balance" id="cr-title">
          {credits.length === 0 ? (
            <p class="kz-anone">
              <span class="kz-anone__code">0.00</span>No credit.
            </p>
          ) : (
            <ul class="kz-alist kz-alist--bare" role="list">
              {credits.map((x) => (
                <li>
                  <span class="kz-alist__r kz-alist__big">{formatMoney(x.balance, x.currency)}</span>
                </li>
              ))}
            </ul>
          )}
        </Pane>
        <Pane title="Activity" id="rel-title">
          <DetailList
            rows
            items={[
              { label: 'Quotations', value: related.quotations, mono: true },
              { label: 'Invoices', value: related.invoices, mono: true },
              { label: 'Projects', value: related.projects, mono: true },
              { label: 'Subscriptions', value: related.subscriptions, mono: true },
              { label: 'Created', value: fmt(c.createdAt), mono: true },
            ]}
          />
        </Pane>
      </aside>
    </div>
  ) : tab === 'contacts' ? (
    <ContactsPanel client:load clientId={c.id} contacts={contacts} canEdit={canEdit} />
  ) : tab === 'notes' ? (
    <div class="kz-agrid kz-agrid--detail">
      <Pane title="Notes" id="notes-title" flush meta={String(notes.length)}>
        {notes.length === 0 ? (
          <p class="kz-anone">
            <span class="kz-anone__code">0 notes</span>No notes yet.
          </p>
        ) : (
          <ol class="kz-afeed">
            {notes.map((n) => (
              <li>
                <p class="kz-afeed__b">{n.body}</p>
                <p class="kz-afeed__t">
                  {n.author} · {fmt(n.created_at)}
                </p>
              </li>
            ))}
          </ol>
        )}
      </Pane>
      {canEdit ? (
        <Pane title="New note" id="note-new">
          <NoteForm client:load clientId={c.id} />
        </Pane>
      ) : null}
    </div>
  ) : tab === 'services' && services ? (
    <div class="kz-agrid kz-agrid--2">
      <Pane title="Subscriptions" id="subs-title" flush>
        {perms.has('subscriptions.manage') && c.status === 'active' ? (
          <a slot="actions" href={`/admin/subscriptions/new?client=${c.id}`} class="kz-apane__link">
            New subscription
          </a>
        ) : null}
        {services.subscriptions.length === 0 ? (
          <p class="kz-anone">
            <span class="kz-anone__code">0 active</span>No active subscriptions.
          </p>
        ) : (
          <ul class="kz-alist" role="list">
            {services.subscriptions.map((s) => (
              <li>
                <div class="kz-alist__main">
                  {canSubs ? (
                    <a href={`/admin/subscriptions/${s.id}`} class="kz-alist__t">
                      {s.description}
                    </a>
                  ) : (
                    <span class="kz-alist__t">{s.description}</span>
                  )}
                  <span class="kz-alist__m">
                    {s.paused ? 'Paused' : `Next invoice ${formatLongDate(s.nextBillingDate!)}`}
                  </span>
                </div>
                <span class="kz-alist__r">
                  {formatMoney(s.amountMinor, s.currency)} / {s.interval === 'month' ? 'month' : 'year'}
                </span>
              </li>
            ))}
          </ul>
        )}
      </Pane>
      <Pane title="Managed services" id="assets-title" flush>
        {canAssets ? (
          <a slot="actions" href={`/admin/assets/new?client=${c.id}`} class="kz-apane__link">
            Add to register
          </a>
        ) : null}
        {services.assets.length === 0 ? (
          <p class="kz-anone">
            <span class="kz-anone__code">0 items</span>Nothing in the register for this client.
          </p>
        ) : (
          <ul class="kz-alist" role="list">
            {services.assets.map((a) => (
              <li>
                <div class="kz-alist__main">
                  {canAssets ? (
                    <a href={`/admin/assets/${a.id}`} class="kz-alist__t">
                      {a.name}
                    </a>
                  ) : (
                    <span class="kz-alist__t">{a.name}</span>
                  )}
                  <span class="kz-alist__m">
                    {ASSET_TYPE_LABELS[a.type] ?? a.type}
                    {a.provider ? ` · ${a.provider}` : ''}
                  </span>
                </div>
                <span class="kz-alist__r is-date">
                  {a.renewalDate ? `Renews ${formatLongDate(a.renewalDate)}` : 'No renewal date'}
                </span>
              </li>
            ))}
          </ul>
        )}
      </Pane>
    </div>
  ) : (
    <PortalAccessPanel
      client:load
      clientId={c.id}
      access={access.map((x) => ({
        id: x.id,
        role: x.role,
        status: x.status,
        name: x.name,
        email: x.email,
        userStatus: x.user_status,
      }))}
      contacts={contacts.map((x) => ({ id: x.id, name: x.name, email: x.email }))}
      canEdit={canEdit}
    />
  )}
</AdminLayout>
