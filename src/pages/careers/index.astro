---
/**
 * Careers (R4.7, rebuilt from scratch). Hero (heading, CMS intro, one action, live status; the mentoring photograph with the
 * "closing next" plate), the numbered roles directory (IMG_5055) or its designed empty state, then how applying works (IMG_5015)
 * with the careers FAQs. Filters and `careers.general_applications` gating unchanged.
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import CareersHero from '../../ui/public/careers/CareersHero.astro';
import RoleIndex, { type RoleRow } from '../../ui/public/careers/RoleIndex.astro';
import HowApplying from '../../ui/public/careers/HowApplying.astro';
import { breadcrumbLd, getSettings, listFaqs, settingBool, settingNumber, settingText } from '../../server/modules/cms';
import { employmentTypeLabel, listOpenPostings, workplaceLabel } from '../../server/modules/careers';

const { ctx } = Astro.locals;
const q = Astro.url.searchParams;
const filter = {
  department: q.get('department')?.slice(0, 80) || undefined,
  type: q.get('type')?.slice(0, 20) || undefined,
  workplace: q.get('workplace')?.slice(0, 20) || undefined,
};
const [settings, result, faqs] = await Promise.all([
  getSettings(ctx),
  listOpenPostings(ctx, filter),
  listFaqs(ctx, 'careers'),
]);
const intro = settingText(settings, 'careers.intro');
const general = settingBool(settings, 'careers.general_applications');
const retention = settingNumber(settings, 'careers.retention_months', 12);
const shortDate = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'Africa/Harare',
  }).format(new Date(iso));
const roles: RoleRow[] = result.postings.map((p) => ({
  slug: p.slug,
  title: p.title,
  department: p.department,
  type: employmentTypeLabel(p.employmentType),
  place: `${p.location}, ${workplaceLabel(p.workplace)}`,
  closes: p.closesAt ? shortDate(p.closesAt) : null,
}));
const soonest = [...result.all].sort((a, b) => (a.closesAt ?? '9999').localeCompare(b.closesAt ?? '9999'))[0];
const next = soonest
  ? {
      title: soonest.title,
      meta: `${employmentTypeLabel(soonest.employmentType)}, ${soonest.location}, ${workplaceLabel(soonest.workplace)}`,
      closes: soonest.closesAt ? shortDate(soonest.closesAt) : null,
    }
  : null;
---

<PublicLayout
  structuredData={[breadcrumbLd(ctx, [{ name: 'Careers', path: '/careers' }])]}
  title="Careers · Kuzikode Technologies"
  description="Open roles at Kuzikode Technologies and how to apply."
  canonicalPath="/careers"
  headerTone="bone"
>
  <CareersHero intro={intro} openCount={result.all.length} general={general} next={next} />
  <RoleIndex
    roles={roles}
    total={result.all.length}
    departments={result.departments}
    filter={filter}
    general={general}
  />
  <HowApplying retentionMonths={retention} faqs={faqs} />
</PublicLayout>
