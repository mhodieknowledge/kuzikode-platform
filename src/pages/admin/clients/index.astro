---
/** Client directory (R6.2): filters (sheet on phones), dense table → list rows, portal sign-ups waiting as a head action. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Pager from '../../../ui/admin/Pager.astro';
import Button from '../../../ui/primitives/Button.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import { FilterBar, type FilterField } from '../../../ui/admin/FilterBar';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { allTags, listClients, listPortalSignups } from '../../../server/modules/clients';
import { clientListQuery } from '../../../shared/schemas/clients';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'clients.view' });
if (page instanceof Response) return page;
const parsed = clientListQuery.safeParse(Object.fromEntries(Astro.url.searchParams));
const filter = parsed.success ? parsed.data : clientListQuery.parse({});
const [result, tags, signups] = await Promise.all([listClients(ctx, filter), allTags(ctx), listPortalSignups(ctx)]);
const canCreate = page.auth.permissions.has('clients.create');
const pageHref = (n: number) => {
  const q = new URLSearchParams(Astro.url.searchParams);
  q.set('page', String(n));
  return `/admin/clients?${q.toString()}`;
};
const fields: FilterField[] = [
  { kind: 'search', name: 'q', label: 'Search', value: filter.q ?? '', placeholder: 'Name, number or email' },
  {
    kind: 'select',
    name: 'status',
    label: 'Status',
    value: filter.status ?? 'active',
    options: [
      { value: 'active', label: 'Active' },
      { value: 'archived', label: 'Archived' },
      { value: 'all', label: 'All' },
    ],
  },
  ...(tags.length > 0
    ? [
        {
          kind: 'select' as const,
          name: 'tag',
          label: 'Tag',
          value: filter.tag ?? '',
          options: [{ value: '', label: 'Any' }, ...tags.map((t) => ({ value: t, label: t }))],
        },
      ]
    : []),
];
const filtered = !!(filter.q || filter.tag || filter.status !== 'active');
---

<AdminLayout title="Clients" page={page}>
  <PageHead title="Clients" meta={`${result.total} ${result.total === 1 ? 'client' : 'clients'}`}>
    <Fragment slot="actions">
      {signups.length > 0 ? (
        <Button href="/admin/clients/portal-signups" variant="secondary">
          Portal sign-ups ({signups.length})
        </Button>
      ) : null}
      {canCreate ? (
        <Button href="/admin/clients/new" lead="add">
          New client
        </Button>
      ) : null}
    </Fragment>
  </PageHead>
  <div class="kz-atools">
    <FilterBar client:load label="Filter clients" fields={fields} clearHref="/admin/clients" />
  </div>
  <DataTable
    caption="Clients"
    count={result.items.length}
    columns={[
      { label: 'Client' },
      { label: 'Main contact' },
      { label: 'Email' },
      { label: 'Tags' },
      { label: 'Currency' },
    ]}
  >
    <EmptyState
      slot="empty"
      code={filtered ? 'no matches' : '0 clients'}
      title={filtered ? 'No clients match these filters.' : 'No clients yet.'}
    >
      Clients are added here or created from a won lead.
    </EmptyState>
    {result.items.map((c) => (
      <tr>
        <Cell
          m="main"
          href={`/admin/clients/${c.id}`}
          title={c.displayName}
          sub={c.status === 'archived' ? `${c.number} · archived` : c.number}
        />
        <Cell m="meta" tone="mute">
          <span>{c.primaryContact ?? '—'}</span>
        </Cell>
        <Cell tone="mute">{c.email ?? '—'}</Cell>
        <Cell>
          {c.tags.length ? (
            <span class="kz-dt__tags">
              {c.tags.map((t) => (
                <span class="kz-tag">{t}</span>
              ))}
            </span>
          ) : null}
        </Cell>
        <Cell m="amount" num>
          {c.defaultCurrency}
        </Cell>
      </tr>
    ))}
  </DataTable>
  <Pager page={result.page} pages={result.pages} href={pageHref} />
</AdminLayout>
