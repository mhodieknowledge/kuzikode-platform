---
import AuthLayout from '../../layouts/AuthLayout.astro';
import { ChangePasswordForm } from '../../components/auth/AuthForms';
import { loadAdminPage } from '../../server/lib/admin-page';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { allowStage: 'password' });
if (page instanceof Response) return page;
---

<AuthLayout
  title="Change your password"
  heading="Choose a new password"
  intro="You need to change your password before you continue."
  area="Admin"
  csrfToken={page.csrfToken}
>
  <ChangePasswordForm client:load audience="admin" forced />
</AuthLayout>
