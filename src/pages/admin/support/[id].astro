---
/**
 * One support request (R6.2 group 3): head with reference, status, priority, category and links; the conversation (mono
 * timestamps, internal notes marked) with the reply composer, and a side column with controls and details.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import DetailList from '../../../ui/admin/DetailList.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import { ReplyComposer } from '../../../ui/admin/support/ReplyComposer';
import { RequestControls } from '../../../ui/admin/support/RequestControls';
import { messageKind, SUPPORT_TONE } from '../../../ui/admin/support/labels';
import { fileSize, harareStamp } from '../../../ui/admin/projects/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { AppError } from '../../../server/lib/errors';
import { getRequest, supportStaff } from '../../../server/modules/support';
import { SUPPORT_CATEGORIES, SUPPORT_PRIORITY_LABEL, SUPPORT_STATUS_LABEL } from '../../../shared/support';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'support.view' });
if (page instanceof Response) return page;
let data;
try {
  data = await getRequest(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const { request: r, client, project, messages, openedBy } = data;
const perms = page.auth.permissions;
const canManage = perms.has('support.manage');
const staff = canManage ? await supportStaff(ctx) : [];
const category = SUPPORT_CATEGORIES.find((c) => c.value === r.category)?.label ?? r.category;
---

<AdminLayout title={`${r.reference}: ${r.subject}`} page={page}>
  <PageHead title={r.subject} crumbs={[{ label: 'Support', href: '/admin/support' }, { label: r.reference }]}>
    <Fragment slot="meta">
      <span class="kz-amono">{r.reference}</span> ·
      <StatusPill tone={SUPPORT_TONE[r.status]} plain>
        {SUPPORT_STATUS_LABEL[r.status]}
      </StatusPill>{' '}
      · {SUPPORT_PRIORITY_LABEL[r.priority]} · {category} ·{' '}
      <a href={`/admin/clients/${r.client_id}`}>{client?.display_name}</a>
      {project ? (
        <>
          {' '}
          · <a href={`/admin/projects/${project.id}`}>{project.reference}</a>
        </>
      ) : null}
    </Fragment>
  </PageHead>
  <div class="kz-agrid kz-agrid--detail">
    <div class="kz-astack">
      <Pane title="Conversation" id="conv-h" meta={String(messages.length)}>
        <ol class="kz-athread" aria-label="Conversation">
          {messages.map((m) => (
            <li class="kz-amsg" data-who={messageKind(m)}>
              <p class="kz-amsg__head">
                <span class="kz-amsg__who">
                  {m.author}
                  {m.user_type === 'client' ? ' (client)' : ''}
                </span>
                <span class="kz-amsg__t">{harareStamp(m.created_at)}</span>
                {m.is_internal_note ? <span class="kz-amsg__tag">internal note</span> : null}
              </p>
              <p class="kz-amsg__body">{m.body}</p>
              {m.attachments.length ? (
                <ul class="kz-amsg__files">
                  {m.attachments.map((f) => (
                    <li>
                      <a class="kz-afile" href={`/api/v1/admin/files/${f.file_id}`}>
                        {f.original_name}
                      </a>
                      <span class="kz-amono">{fileSize(f.size_bytes)}</span>
                    </li>
                  ))}
                </ul>
              ) : null}
            </li>
          ))}
        </ol>
      </Pane>
      {perms.has('support.reply') ? (
        <Pane title="Reply" id="reply-h">
          <ReplyComposer client:load requestId={r.id} canManage={canManage} />
        </Pane>
      ) : null}
    </div>
    <aside class="kz-astack" aria-label="Request summary">
      {canManage ? (
        <Pane title="Request" id="ctl-h">
          <RequestControls
            client:load
            requestId={r.id}
            status={r.status}
            priority={r.priority}
            assignedTo={r.assigned_to}
            staff={staff}
          />
        </Pane>
      ) : null}
      <Pane title="Details" id="info-h">
        <DetailList
          rows
          items={[
            { label: 'Opened', value: harareStamp(r.created_at), mono: true },
            {
              label: 'By',
              value: `${openedBy?.name ?? '—'}${openedBy?.user_type === 'staff' ? ' (staff, for the client)' : ''}`,
            },
          ]}
        />
      </Pane>
    </aside>
  </div>
</AdminLayout>
