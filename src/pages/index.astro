---
/**
 * Home (R10.3 rebuild, docs/redesign/HOME_COMPOSITION.md). Order: photo hero (glass widgets, division chips) → marquee →
 * services cards with section icons ("from" prices only) → why → how we work → pricing entry → selected work and client words
 * (only when published / consented) → closing photo band with the Settings contact options. Copy comes from the CMS `home` page.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import Hero from '../ui/public/home2/Hero.astro';
import Marquee from '../ui/public/home2/Marquee.astro';
import Services from '../ui/public/home2/Services.astro';
import Why from '../ui/public/home2/Why.astro';
import How from '../ui/public/home2/How.astro';
import PricingEntry from '../ui/public/home2/PricingEntry.astro';
import Work from '../ui/public/home2/Work.astro';
import Voices from '../ui/public/home2/Voices.astro';
import Closing from '../ui/public/home2/Closing.astro';
import { divisionFromPrice } from '../shared/directory';
import {
  getPage,
  getPricingCatalogue,
  getServiceCatalogue,
  listPortfolio,
  listTestimonials,
  siteNavigation,
} from '../server/modules/cms';
import type { Section } from '../shared/schemas/cms';

const { ctx } = Astro.locals;
const [page, catalogue, pricing, portfolio, testimonials, nav] = await Promise.all([
  getPage(ctx, 'home'),
  getServiceCatalogue(ctx),
  getPricingCatalogue(ctx),
  listPortfolio(ctx),
  listTestimonials(ctx),
  siteNavigation(ctx),
]);
if (!page) return new Response('Not found', { status: 404 });
// Home shows the featured divisions only (the Add-ons division is priced but is not a home widget, REFINEMENTS §1, §7).
const divisions = catalogue
  .filter((c) => c.featured)
  .map((c) => ({
    slug: c.slug,
    name: c.name,
    summary: c.summary,
    href: `/services/${c.slug}`,
    from: pricing.showPrices ? divisionFromPrice(pricing.packages, c.slug) : null,
  }));
const featured = portfolio.filter((p) => p.featured).length ? portfolio.filter((p) => p.featured) : portfolio;
const sections = page.sections as Section[];
// Section order is the design's, not the CMS list order; content stays the CMS's.
const byType = (t: Section['type']) => sections.find((s) => s.type === t);
const hero = byType('hero');
const services = byType('services_grid');
const process = byType('process');
const why = byType('features');
const work = byType('work_grid');
const closing = byType('cta')?.content as Section<'cta'>['content'] | undefined;
---

<PublicLayout
  title={page.seoTitle ?? 'Kuzikode Intelligent Technologies'}
  description={page.seoDescription ?? undefined}
  canonicalPath="/"
  headerTone="night"
  footerCta={false}
>
  {hero ? (
    <Hero
      content={hero.content as Section<'hero'>['content']}
      divisions={divisions}
      websitesFrom={divisions.find((d) => d.slug === 'websites')?.from ?? null}
      whatsapp={nav.footer.contact.whatsapp}
    />
  ) : null}
  <Marquee divisions={divisions} />
  {services ? (
    <Services content={services.content as Section<'services_grid'>['content']} divisions={divisions} />
  ) : null}
  {why ? <Why content={why.content as Section<'features'>['content']} anchor={why.key} /> : null}
  {process ? <How content={process.content as Section<'process'>['content']} anchor={process.key} /> : null}
  <PricingEntry divisions={divisions} />
  {work ? <Work content={work.content as Section<'work_grid'>['content']} items={featured} /> : null}
  <Voices testimonials={testimonials} />
  <Closing
    title={closing?.title ?? 'Tell us what you need'}
    body={closing?.body ?? 'We reply with questions or a written quotation, usually within one business day.'}
    contact={nav.footer.contact}
  />
</PublicLayout>
