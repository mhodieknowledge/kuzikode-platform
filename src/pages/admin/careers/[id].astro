---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import SavedNotice from '../../../ui/admin/website/SavedNotice.astro';
import { PostingActions } from '../../../ui/admin/careers/PostingActions';
import { PostingForm } from '../../../ui/admin/careers/PostingForm';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { AppError } from '../../../server/lib/errors';
import { getPostingAdmin } from '../../../server/modules/careers';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'careers.view' });
if (page instanceof Response) return page;
let p;
try {
  p = await getPostingAdmin(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const canManage = page.auth.permissions.has('careers.manage');
const currencies = (
  await ctx.db
    .prepare('SELECT code FROM currencies WHERE active = 1 ORDER BY is_default DESC, code')
    .all<{ code: string }>()
).results.map((r) => r.code);
const { status, closedAt: _c, updatedAt: _u, ...initial } = p;
const saved = Astro.url.searchParams.get('saved') === '1';
const STATUS: Record<string, string> = { draft: 'Draft', open: 'Open', closed: 'Closed', archived: 'Archived' };
---

<AdminLayout title={p.title} page={page}>
  <PageHead title={p.title} crumbs={[{ label: 'Careers', href: '/admin/careers' }, { label: p.title }]}>
    <Fragment slot="meta">
      {STATUS[status]} ·
      <a href={`/careers/${p.slug}?preview=1`} target="_blank" rel="noopener">
        Preview<span class="sr-only"> (opens in a new tab)</span>
      </a>
      ·<a href={`/admin/careers/applicants?posting=${p.id}&view=board`}>Applicants</a>
    </Fragment>
    {canManage ? <PostingActions slot="actions" client:load id={p.id} status={status} /> : null}
  </PageHead>
  {saved ? <SavedNotice>Saved.</SavedNotice> : null}
  {canManage ? (
    <PostingForm client:load initial={initial} currencies={currencies} />
  ) : (
    <p class="kz-hint">{p.summary}</p>
  )}
</AdminLayout>
