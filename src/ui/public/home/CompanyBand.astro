---
/**
 * Values band (R4.1). Desktop: the heading and the about link above a 3-column values ledger (each value under a hairline).
 * Phones: heading, then the values as rows. Products and the tools line were removed in R9.1 (REFINEMENTS §1, §4).
 */
import Icon from '../../icons/Icon.astro';
import type { SectionContent } from '../../../shared/schemas/cms';

interface Props {
  values: SectionContent<'values'> | undefined;
  anchor: string;
}
const { values: v, anchor } = Astro.props;
---

<section class="kz-sec kz-company" id={anchor} aria-labelledby={v ? `${anchor}-title` : undefined}>
  <div class="container-wide">
    {
      v ? (
        <>
          <header class="kz-sec__head">
            <h2 id={`${anchor}-title`} class="kz-h2">
              {v.title}
            </h2>
            {v.link ? (
              <a class="kz-link" href={v.link.href}>
                {v.link.label}
                <Icon name="arrow-right" size={16} />
              </a>
            ) : null}
          </header>
          <dl class="kz-values__list" data-reveal-group>
            {v.items.map((it, i) => (
              <div class="kz-values__row">
                <dt>
                  <span class="kz-values__n">{String(i + 1).padStart(2, '0')}</span>
                  {it.title}
                </dt>
                <dd>{it.body}</dd>
              </div>
            ))}
          </dl>
        </>
      ) : null
    }
  </div>
</section>
