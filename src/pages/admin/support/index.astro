---
/** Support requests (R6.2 group 3): filters (sheet on phones), dense table → list rows with priority and status. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Pager from '../../../ui/admin/Pager.astro';
import Button from '../../../ui/primitives/Button.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import { FilterBar } from '../../../ui/admin/FilterBar';
import { isUrgent, SUPPORT_TONE } from '../../../ui/admin/support/labels';
import { harareStamp } from '../../../ui/admin/projects/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listRequests } from '../../../server/modules/support';
import { supportListQuery } from '../../../shared/schemas/support';
import { SUPPORT_PRIORITY_LABEL, SUPPORT_STATUS_LABEL } from '../../../shared/support';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'support.view' });
if (page instanceof Response) return page;
const parsed = supportListQuery.safeParse(Object.fromEntries(Astro.url.searchParams));
const filter = parsed.success ? parsed.data : supportListQuery.parse({});
const result = await listRequests(ctx, filter);
const pageHref = (n: number) => {
  const q = new URLSearchParams(Astro.url.searchParams);
  q.set('page', String(n));
  return `/admin/support?${q.toString()}`;
};
const active = (result.counts['open'] ?? 0) + (result.counts['awaiting_client'] ?? 0);
const filtered = !!(filter.q || filter.priority || filter.assignee || (filter.status && filter.status !== 'active'));
---

<AdminLayout title="Support" page={page}>
  <PageHead title="Support" meta={`${active} active · ${result.counts['open'] ?? 0} need a reply`}>
    <Fragment slot="actions">
      {page.auth.permissions.has('support.reply') ? (
        <Button href="/admin/support/new" lead="add">
          New request
        </Button>
      ) : null}
    </Fragment>
  </PageHead>
  <div class="kz-atools">
    <FilterBar
      client:load
      label="Filter support requests"
      hidden={filter.clientId ? { clientId: filter.clientId } : {}}
      clearHref="/admin/support"
      fields={[
        {
          kind: 'search',
          name: 'q',
          label: 'Search',
          value: filter.q ?? '',
          placeholder: 'Reference, subject or client',
        },
        {
          kind: 'select',
          name: 'status',
          label: 'Status',
          value: filter.status ?? 'active',
          options: [
            { value: 'active', label: 'Active (open, waiting)' },
            ...Object.entries(SUPPORT_STATUS_LABEL).map(([value, label]) => ({ value, label })),
            { value: 'all', label: 'All' },
          ],
        },
        {
          kind: 'select',
          name: 'priority',
          label: 'Priority',
          value: filter.priority ?? '',
          options: [
            { value: '', label: 'Any' },
            ...Object.entries(SUPPORT_PRIORITY_LABEL).map(([value, label]) => ({ value, label })),
          ],
        },
        {
          kind: 'select',
          name: 'assignee',
          label: 'Assigned',
          value: filter.assignee ?? '',
          options: [
            { value: '', label: 'Anyone' },
            { value: 'me', label: 'Me' },
            { value: 'none', label: 'Unassigned' },
          ],
        },
      ]}
    />
  </div>
  <DataTable
    caption="Support requests"
    count={result.items.length}
    columns={[
      { label: 'Request' },
      { label: 'Client' },
      { label: 'Assigned' },
      { label: 'Last message' },
      { label: 'Priority' },
      { label: 'Status' },
    ]}
  >
    <EmptyState
      slot="empty"
      code={filtered ? 'no matches' : '0 active'}
      title={filtered ? 'No support requests match these filters.' : 'No support requests here.'}
    >
      Requests from clients and ones taken by phone appear here.
    </EmptyState>
    {result.items.map((r) => (
      <tr>
        <Cell m="main" href={`/admin/support/${r.id}`} title={r.subject} sub={r.reference} />
        <Cell m="meta" tone="mute">
          <span>{r.client_name}</span>
          <span class="kz-dt__ph">
            {r.last_message_at ? ` · ${harareStamp(r.last_message_at)}` : ''}
            {r.last_author_type === 'client' ? ' · client replied' : ''}
          </span>
        </Cell>
        <Cell tone="mute">{r.assignee ?? 'Unassigned'}</Cell>
        <Cell tone="mute" class="kz-dt__nw">
          {r.last_message_at ? harareStamp(r.last_message_at) : '—'}
          {r.last_author_type === 'client' ? <span class="kz-amono"> · client replied</span> : null}
        </Cell>
        <Cell m="amount">
          {isUrgent(r.priority) ? (
            <StatusPill tone="danger">{SUPPORT_PRIORITY_LABEL[r.priority]}</StatusPill>
          ) : (
            <span class="kz-dt__dash">—</span>
          )}
        </Cell>
        <Cell m="status">
          <StatusPill tone={SUPPORT_TONE[r.status]}>{SUPPORT_STATUS_LABEL[r.status]}</StatusPill>
        </Cell>
      </tr>
    ))}
  </DataTable>
  <Pager page={result.page} pages={result.pages} href={pageHref} />
</AdminLayout>
