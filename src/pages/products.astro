---
/**
 * Products (R4.7, rebuilt from scratch; BRIEF B.7). A short bone header (CMS title and intro), then one modest panel per
 * published product with its status tag, the Route drawing and the interest form. No photograph (B.4a), no purchase wording.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import ProductPanel from '../ui/public/products/ProductPanel.astro';
import { getPage, listProducts } from '../server/modules/cms';
import type { Section } from '../shared/schemas/cms';

const { ctx } = Astro.locals;
const [page, products] = await Promise.all([getPage(ctx, 'products'), listProducts(ctx)]);
const intro = page?.sections.find((s) => s.type === 'rich_text') as Section<'rich_text'> | undefined;
---

<PublicLayout
  title={page?.seoTitle ?? 'Products · Kuzikode Technologies'}
  description={page?.seoDescription ?? undefined}
  canonicalPath="/products"
  headerTone="bone"
>
  <section class="kz-phead" aria-labelledby="products-title">
    <div class="container-wide kz-phead__grid">
      <h1 id="products-title" class="kz-phead__title" data-enter>
        {intro?.content.title ?? 'Products'}
      </h1>
      {intro ? <div class="kz-phead__intro prose-kz" data-enter="2" set:html={intro.content.html} /> : null}
    </div>
  </section>
  <section class="kz-sec kz-pbody" aria-label="Products">
    <div class="container-wide">
      {products.length === 0 ? (
        <p class="kz-pbody__none">No products to show yet.</p>
      ) : (
        products.map((p) => <ProductPanel product={p} siteKey={ctx.config.turnstileSiteKey} />)
      )}
    </div>
  </section>
</PublicLayout>
