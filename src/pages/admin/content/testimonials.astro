---
/** Testimonials (R6.2): real quotes only; each belongs to a client record and needs recorded consent and its date. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import ContentTabs from '../../../ui/admin/website/ContentTabs.astro';
import { TestimonialsManager } from '../../../ui/admin/content/Managers';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listTestimonialsAdmin, testimonialSources } from '../../../server/modules/cms/content-admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'content.manage' });
if (page instanceof Response) return page;
const [items, sources] = await Promise.all([listTestimonialsAdmin(ctx), testimonialSources(ctx)]);
---

<AdminLayout title="Testimonials" page={page}>
  <PageHead
    title="Content"
    meta="Only real testimonials: each one belongs to a client record and needs the client's recorded consent and its date."
  />
  <div class="kz-atools">
    <ContentTabs current="testimonials" permissions={page.auth.permissions} />
  </div>
  <TestimonialsManager
    client:load
    items={items as never[]}
    clients={sources.clients}
    projects={sources.projects}
    today={ctx.now().toISOString().slice(0, 10)}
  />
</AdminLayout>
