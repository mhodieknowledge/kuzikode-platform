---
/**
 * About (R4.5, rebuilt from scratch). Order: photo-led hero with the six-area route plate → the story as an editorial photo band →
 * mission and vision on night → values ledger → approach essay + numbered objectives → team (only real, published members) →
 * the careers line → the footer's routes. Data: the about page CMS sections, the service catalogue, team.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import AboutHero from '../ui/public/about/AboutHero.astro';
import Statements from '../ui/public/about/Statements.astro';
import ValuesLedger from '../ui/public/about/ValuesLedger.astro';
import ApproachLedger from '../ui/public/about/ApproachLedger.astro';
import PhotoBand from '../ui/public/shared/PhotoBand.astro';
import Icon from '../ui/icons/Icon.astro';
import { getPage, getServiceCatalogue, listTeam } from '../server/modules/cms';
import { divisionShortName } from '../shared/directory';
import type { Section } from '../shared/schemas/cms';
import manifest from '../../design/images/manifest.json';

const { ctx } = Astro.locals;
const [page, team, categories] = await Promise.all([getPage(ctx, 'about'), listTeam(ctx), getServiceCatalogue(ctx)]);
if (!page) return new Response('Not found', { status: 404 });
const sections = page.sections as Section[];
const rich = sections.filter((s) => s.type === 'rich_text') as Section<'rich_text'>[];
const overview = rich[0];
const story = rich.find((s) => s.key === 'story') ?? rich[1];
const approach = rich.find((s) => s.key === 'approach') ?? rich.find((s) => s !== overview && s !== story);
const statements = (sections.filter((s) => s.type === 'statement') as Section<'statement'>[]).map((s) => ({
  key: s.key,
  ...s.content,
}));
const values = sections.find((s) => s.type === 'values') as Section<'values'> | undefined;
const objectives = sections.find((s) => s.type === 'list') as Section<'list'> | undefined;
// Areas of work: the featured divisions (Add-ons is priced but is not an area of work, REFINEMENTS §1).
const divisions = categories
  .filter((c) => c.featured)
  .map((c) => ({ slug: c.slug, short: divisionShortName(c.slug, c.name) }));
const bandImage = 'about-studio' in manifest.images ? 'about-studio' : 'home-developer';
---

<PublicLayout
  ogImage="/brand/og/about.png"
  title={page.seoTitle ?? 'About Kuzikode Intelligent Technologies'}
  description={page.seoDescription ?? undefined}
  headerTone="bone"
>
  <AboutHero
    title={overview?.content.title ?? page.title}
    html={overview?.content.html ?? null}
    divisions={divisions}
  />

  {story ? (
    <PhotoBand image={bandImage} label={story.content.title ?? 'Our story'}>
      <div id={story.key}>
        <h2 class="kz-pband__title">{story.content.title}</h2>
        <div class="kz-pband__prose prose-kz" set:html={story.content.html} />
      </div>
    </PhotoBand>
  ) : null}

  {statements.length > 0 ? <Statements items={statements} /> : null}

  {values ? <ValuesLedger content={values.content} anchor={values.key} /> : null}

  {approach || objectives ? (
    <ApproachLedger
      approach={approach ? { anchor: approach.key, content: approach.content } : undefined}
      objectives={objectives ? { anchor: objectives.key, content: objectives.content } : undefined}
    />
  ) : null}

  {team.length > 0 ? (
    <section id="team" class="kz-sec kz-team" aria-labelledby="team-title">
      <div class="container-wide">
        <h2 id="team-title" class="kz-h2">
          Team
        </h2>
        <ul class="kz-team__list" role="list">
          {team.map((m) => (
            <li>
              <img
                src={m.photo.src}
                alt={m.photo.alt}
                width={m.photo.width ?? 400}
                height={m.photo.height ?? 400}
                loading="lazy"
              />
              <p class="kz-team__name">{m.name}</p>
              <p class="kz-team__role">{m.role}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ) : null}

  <section class="kz-careers-row" aria-labelledby="join-title">
    <div class="container-wide kz-careers-row__in">
      <h2 id="join-title" class="kz-careers-row__h">
        Careers at Kuzikode
      </h2>
      <p>See open roles and how we hire.</p>
      <a class="kz-link" href="/careers">
        Open roles
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>
</PublicLayout>
