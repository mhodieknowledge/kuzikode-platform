---
import AppLayout from './AppLayout.astro';
import Logo from '../components/Logo.astro';

export interface NavGroup {
  label: string;
  items: { label: string; href: string; active?: boolean }[];
}
interface Props {
  title: string;
  nav?: NavGroup[];
  csrfToken?: string | undefined;
  userName?: string;
}
const { title, nav = [], csrfToken, userName } = Astro.props;
---

<AppLayout title={`${title} · Kuzikode Admin`} csrfToken={csrfToken}>
  <div class="flex min-h-screen">
    <aside class="hidden w-60 shrink-0 border-r border-line bg-surface lg:flex lg:flex-col" aria-label="Admin">
      <div class="flex h-16 items-center px-5">
        <Logo href="/admin" height={24} />
      </div>
      <nav aria-label="Admin navigation" class="flex-1 overflow-y-auto px-3 pb-6">
        {nav.map((group) => (
          <div class="mt-4">
            <p class="px-2 pb-1 text-[11px] font-semibold tracking-wider text-ink-600 uppercase">{group.label}</p>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.active ? 'page' : undefined}
                    class:list={[
                      'flex h-9 items-center rounded-sm px-2 text-sm',
                      item.active ? 'bg-brand-50 font-semibold text-brand-600' : 'text-ink-800 hover:bg-ink-950/5',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>
    <div class="flex min-w-0 flex-1 flex-col">
      <header class="flex h-16 items-center justify-between gap-4 border-b border-line bg-surface px-4 lg:px-8">
        <div class="lg:hidden">
          <Logo href="/admin" height={22} />
        </div>
        <slot name="topbar" />
        {userName ? <span class="text-sm text-ink-600">{userName}</span> : null}
      </header>
      <main id="main" tabindex="-1" class="flex-1 px-4 py-6 focus:outline-none lg:px-8">
        <slot />
      </main>
    </div>
  </div>
</AppLayout>
