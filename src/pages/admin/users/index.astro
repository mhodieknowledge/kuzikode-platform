---
/** Staff users (R6.2 group 3): filters (sheet on phones), dense table → list rows, invite as a head action. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Button from '../../../ui/primitives/Button.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import { FilterBar } from '../../../ui/admin/FilterBar';
import { InviteStaffButton } from '../../../ui/admin/users/InviteStaff';
import { dayOrNever, roleNames, STAFF_STATUS_LABEL, STAFF_STATUS_TONE } from '../../../ui/admin/users/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listRoles, listStaff } from '../../../server/modules/users';
import { staffListQuery } from '../../../shared/schemas/users';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'users.view' });
if (page instanceof Response) return page;
const parsed = staffListQuery.safeParse(Object.fromEntries(Astro.url.searchParams));
const filter = parsed.success ? parsed.data : {};
const [staff, roles] = await Promise.all([listStaff(ctx, filter), listRoles(ctx)]);
const canManage = page.auth.permissions.has('users.manage');
const names = new Map(roles.map((r) => [r.key, r.name]));
const assignable = roles
  .filter((r) => r.key !== 'super_admin' || page.auth.roles.includes('super_admin'))
  .map((r) => ({ key: r.key, name: r.name, description: r.description }));
const filtered = !!(filter.q || filter.status || filter.role);
---

<AdminLayout title="Users" page={page}>
  <PageHead title="Users" meta={`Kuzikode staff accounts · ${staff.length} shown`}>
    <Fragment slot="actions">
      <Button href="/admin/users/roles" variant="secondary" lead="settings">
        Roles and permissions
      </Button>
      {canManage ? <InviteStaffButton client:load roles={assignable} /> : null}
    </Fragment>
  </PageHead>
  <div class="kz-atools">
    <FilterBar
      client:load
      label="Filter users"
      clearHref="/admin/users"
      fields={[
        { kind: 'search', name: 'q', label: 'Search', value: filter.q ?? '', placeholder: 'Name or email' },
        {
          kind: 'select',
          name: 'status',
          label: 'Status',
          value: filter.status ?? '',
          options: [
            { value: '', label: 'All' },
            ...Object.entries(STAFF_STATUS_LABEL).map(([value, label]) => ({ value, label })),
          ],
        },
        {
          kind: 'select',
          name: 'role',
          label: 'Role',
          value: filter.role ?? '',
          options: [{ value: '', label: 'All' }, ...roles.map((r) => ({ value: r.key, label: r.name }))],
        },
      ]}
    />
  </div>
  <DataTable
    caption="Staff users"
    count={staff.length}
    columns={[{ label: 'Name' }, { label: 'Roles' }, { label: 'Status' }, { label: '2FA' }, { label: 'Last sign-in' }]}
  >
    <EmptyState
      slot="empty"
      code={filtered ? 'no matches' : '0 users'}
      title={filtered ? 'No users match these filters.' : 'No staff accounts.'}
    />
    {staff.map((u) => (
      <tr>
        <Cell m="main" href={`/admin/users/${u.id}`} title={u.name} sub={u.email} subText />
        <Cell m="meta" tone="mute">
          <span>{roleNames(u.roles, names)}</span>
        </Cell>
        <Cell m="status">
          <StatusPill tone={STAFF_STATUS_TONE[u.status]}>{STAFF_STATUS_LABEL[u.status]}</StatusPill>
        </Cell>
        <Cell m="amount" tone="mute">
          <span class="kz-dt__ph">2FA </span>
          {u.mfaEnabled ? 'On' : 'Off'}
        </Cell>
        <Cell tone="mute">{dayOrNever(u.lastLoginAt)}</Cell>
      </tr>
    ))}
  </DataTable>
</AdminLayout>
