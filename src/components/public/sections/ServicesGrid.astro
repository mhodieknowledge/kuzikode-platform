---
import { ArrowRight } from 'lucide-react';
import Icon from '../Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { SectionContent } from '../../../shared/schemas/cms';
import type { PublicCategory } from '../../../server/modules/cms';

interface Props {
  content: SectionContent<'services_grid'>;
  categories: PublicCategory[];
}
const { content: c, categories } = Astro.props;
---

<section class="bg-surface py-16 md:py-24 lg:py-28" aria-labelledby="services-title">
  <div class="container-content">
    <SectionHeading id="services-title" title={c.title} intro={c.intro} />
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((cat) => (
          <li>
            <a href={`/services/${cat.slug}`} class="group flex h-full flex-col rounded-md border border-line bg-surface p-6 transition-colors hover:border-brand-500">
              <span class="flex h-11 w-11 items-center justify-center rounded-sm bg-brand-50 text-brand-600">
                <Icon name={cat.icon} size={22} />
              </span>
              <span class="mt-5 font-display text-lg font-bold tracking-display text-ink-950">{cat.name}</span>
              <span class="mt-2 flex-1 text-[15px] leading-6 text-ink-600">{cat.summary}</span>
              {cat.status === 'coming_soon' ? (
                <span class="mt-5 inline-flex w-fit rounded-full bg-ink-950/5 px-2 py-0.5 text-xs font-semibold text-ink-800">Coming soon</span>
              ) : (
                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600">
                  Learn more
                  <ArrowRight size={16} aria-hidden="true" className="transition-transform group-hover:translate-x-0.5" />
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
