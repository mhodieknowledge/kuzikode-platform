---
/**
 * A role (R4.7, rebuilt from scratch). Head: breadcrumb, department, title, summary and a ruled spec sheet (type, workplace,
 * location, closing date, salary when shown). Body: an editorial reading column with numbered parts (responsibilities,
 * requirements, nice to have, what we offer, how to apply) and sharing, beside a sticky "ready to apply" plate on desktop. Then the
 * application sheet (IMG_5018: form + summary). Phones get a sticky apply bar that scrolls to the sheet.
 * Data, 404/410, staff preview, noindex and JobPosting JSON-LD are unchanged.
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import ApplicationForm from '../../ui/public/forms/ApplicationForm';
import ApplySheet from '../../ui/public/careers/ApplySheet.astro';
import ApplyBar from '../../ui/public/careers/ApplyBar.astro';
import Icon from '../../ui/icons/Icon.astro';
import { breadcrumbLd, getSettings, settingNumber } from '../../server/modules/cms';
import { employmentTypeLabel, getPostingView, jobPostingLd, workplaceLabel } from '../../server/modules/careers';
import { formatLongDate, formatPriceTag } from '../../shared/service-display';

const { ctx } = Astro.locals;
const view = await getPostingView(ctx, Astro.params.slug ?? '');
if (!view) return new Response(null, { status: 404, statusText: 'Not found' });
if (view.state === 'gone') return new Response(null, { status: 410, statusText: 'Gone' });
const p = view.posting;
const open = view.state === 'open';
const preview = view.state === 'preview';
const ld = [
  breadcrumbLd(ctx, [
    { name: 'Careers', path: '/careers' },
    { name: p.title, path: `/careers/${p.slug}` },
  ]),
  ...(open ? [await jobPostingLd(ctx, p)] : []),
];
const retention = settingNumber(await getSettings(ctx), 'careers.retention_months', 12);
const per = { hour: 'per hour', month: 'per month', year: 'per year' } as const;
const salary = p.salary
  ? [p.salary.min, p.salary.max]
      .filter((v): v is number => v !== null)
      .map((v) => formatPriceTag(v, p.salary!.currency))
      .join(' – ') + ` ${per[p.salary.period]}`
  : null;
const closes = p.closesAt && open ? formatLongDate(p.closesAt) : null;
const url = new URL(`/careers/${p.slug}`, ctx.config.siteUrl).toString();
const share = [
  ['LinkedIn', `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`],
  ['WhatsApp', `https://wa.me/?text=${encodeURIComponent(`${p.title} at Kuzikode Intelligent Technologies ${url}`)}`],
  ['X', `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(p.title)}`],
] as const;
const parts = (
  [
    ['Responsibilities', p.responsibilities],
    ['Requirements', p.requirements],
    ['Nice to have', p.niceToHaves],
    ['What we offer', p.offer],
  ] as const
).filter(([, items]) => items.length > 0);
const spec = [
  { k: 'Type', v: employmentTypeLabel(p.employmentType) },
  { k: 'Workplace', v: workplaceLabel(p.workplace) },
  { k: 'Location', v: p.location },
  ...(closes ? [{ k: 'Apply by', v: closes }] : []),
  ...(salary ? [{ k: 'Salary', v: salary }] : []),
];
const n = (i: number) => String(i + 1).padStart(2, '0');
---

<PublicLayout
  structuredData={ld}
  title={`${p.title} · Careers · Kuzikode Intelligent Technologies`}
  description={p.summary}
  noindex={!open}
  headerTone="bone"
  footerCta={!open}
  whatsappMessage={`Hi Kuzikode, I have a question about the ${p.title} role.`}
>
  <article class="kz-job">
    <header class="kz-job__head">
      <div class="container-wide">
        <nav aria-label="Breadcrumb" class="kz-crumbs">
          <ol>
            <li>
              <a href="/careers">Careers</a>
            </li>
            <li aria-current="page">{p.title}</li>
          </ol>
        </nav>
        <div class="kz-job__grid">
          <div>
            <p class="kz-job__dept" data-enter>
              {p.department}
            </p>
            <h1 id="job-title" class="kz-job__title" data-enter>
              {p.title}
            </h1>
            <p class="kz-job__sum" data-enter="2">
              {p.summary}
            </p>
          </div>
          <dl class="kz-job__spec" data-enter="3">
            {spec.map((s) => (
              <div class:list={[s.k === 'Salary' && 'is-wide']}>
                <dt>{s.k}</dt>
                <dd class:list={[s.k === 'Salary' && 'tnum']}>{s.v}</dd>
              </div>
            ))}
          </dl>
        </div>
        {preview ? (
          <p role="status" class="kz-job__note kz-job__note--warn">
            <Icon name="status-warn" size={20} />
            Staff preview. The application form appears once the posting is open.
          </p>
        ) : open ? null : (
          <p role="status" class="kz-job__note" data-posting-closed>
            <Icon name="status-info" size={20} />
            <span>
              This position is closed and no longer accepts applications. <a href="/careers">See open roles</a>.
            </span>
          </p>
        )}
      </div>
    </header>

    <div class="container-wide kz-job__body">
      <div class="kz-job__story">
        {p.description ? <div class="prose-kz kz-job__desc" set:html={p.description} /> : null}
        {parts.map(([title, items], i) => (
          <section class="kz-job__part" aria-labelledby={`part-${i}`}>
            <h2 class="kz-job__h" id={`part-${i}`}>
              <span aria-hidden="true">{n(i)}</span>
              {title}
            </h2>
            <ul class="kz-job__list" role="list">
              {items.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </section>
        ))}
        {p.howToApply ? (
          <section class="kz-job__part" aria-labelledby="part-how">
            <h2 class="kz-job__h" id="part-how">
              <span aria-hidden="true">{n(parts.length)}</span>
              How to apply
            </h2>
            <p class="kz-job__how">{p.howToApply}</p>
          </section>
        ) : null}
        <div class="kz-job__share">
          <p class="kz-job__share-k">Share this role</p>
          <ul role="list">
            {share.map(([name, href]) => (
              <li>
                <a href={href} target="_blank" rel="noopener noreferrer">
                  {name}
                  <Icon name="external" size={16} />
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      {open ? (
        <aside class="kz-job__aside" aria-label="Ready to apply">
          <div class="kz-job__plate">
            <p class="kz-job__plate-t">Ready to apply?</p>
            {closes ? (
              <p class="kz-job__plate-d">
                <Icon name="calendar" size={16} />
                Apply by {closes}
              </p>
            ) : null}
            <p class="kz-job__plate-b">
              You'll need your CV as a PDF or Word file. The form is further down this page.
            </p>
            <a class="kz-btn kz-btn--primary kz-btn--lg kz-btn--block" href="#apply">
              <span>Apply now</span>
            </a>
          </div>
        </aside>
      ) : null}
    </div>

    {open ? (
      <section class="kz-apply" id="apply" aria-labelledby="apply-title">
        <div class="container-wide">
          <h2 id="apply-title" class="kz-h2 kz-apply__title">
            Apply for this role
          </h2>
          <ApplySheet
            position={p.title}
            facts={[
              { k: 'Department', v: p.department },
              { k: 'Type', v: employmentTypeLabel(p.employmentType) },
              { k: 'Where', v: `${p.location}, ${workplaceLabel(p.workplace)}` },
              ...(closes ? [{ k: 'Closes', v: closes }] : []),
            ]}
            retentionMonths={retention}
          >
            <ApplicationForm
              client:visible
              slug={p.slug}
              position={p.title}
              questions={p.questions}
              siteKey={ctx.config.turnstileSiteKey}
            />
          </ApplySheet>
        </div>
      </section>
    ) : null}
  </article>
  {open ? <ApplyBar title={p.title} closes={closes} /> : null}
</PublicLayout>
