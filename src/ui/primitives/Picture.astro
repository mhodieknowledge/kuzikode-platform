---
/**
 * A committed site image (design/images/manifest.json) as <picture> with AVIF/WebP/JPEG srcsets (DESIGN_DIRECTION §8).
 * `tone="warm"` applies the warm neutral duotone (#151412 shadows → #F4F1EA highlights) in CSS, so the existing owner photos
 * (graded cool) sit in the earth palette without new files. Lazy by default; `priority` for an LCP image. Decorative: alt="".
 */
import manifest from '../../../design/images/manifest.json';

interface Props {
  id: string;
  sizes?: string;
  priority?: boolean;
  alt?: string;
  tone?: 'warm' | 'none';
  class?: string;
  /** Optional art-directed phone crop (another manifest id), served below 768 px. */
  mobileId?: string | undefined;
}
const { id, sizes = '100vw', priority = false, alt, tone = 'none', class: className, mobileId } = Astro.props;
const entry = (
  manifest as {
    images: Record<string, { alt: string; width: number; height: number; widths: number[]; placeholder: string }>;
  }
).images[id];
if (!entry) throw new Error(`Unknown site image "${id}"`);
const images = (manifest as { images: Record<string, { widths: number[] }> }).images;
const srcset = (img: string, ext: string) =>
  images[img]!.widths.map((w) => `/images/site/${img}-${w}.${ext} ${w}w`).join(', ');
const set = (ext: string) => srcset(id, ext);
const phone = mobileId && images[mobileId] ? mobileId : null;
const PHONE = '(max-width: 767px)';
const fallback = `/images/site/${id}-${entry.widths.at(-1)}.jpg`;
---

<picture class={['kz-pic', tone === 'warm' && 'kz-pic--warm', className].filter(Boolean).join(' ')}>
  {phone ? <source media={PHONE} type="image/avif" srcset={srcset(phone, 'avif')} sizes="100vw" /> : null}
  {phone ? <source media={PHONE} type="image/webp" srcset={srcset(phone, 'webp')} sizes="100vw" /> : null}
  {phone ? <source media={PHONE} type="image/jpeg" srcset={srcset(phone, 'jpg')} sizes="100vw" /> : null}
  <source type="image/avif" srcset={set('avif')} sizes={sizes} />
  <source type="image/webp" srcset={set('webp')} sizes={sizes} />
  <img
    src={fallback}
    srcset={set('jpg')}
    sizes={sizes}
    alt={alt ?? entry.alt}
    width={entry.width}
    height={entry.height}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
</picture>
