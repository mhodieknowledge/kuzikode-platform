---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import { LeadForm } from '../../../ui/admin/leads/LeadForm';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { leadFormOptions } from '../../../server/modules/leads';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'leads.manage' });
if (page instanceof Response) return page;
const options = await leadFormOptions(ctx);
const initial = {
  title: '',
  source: 'manual' as const,
  status: 'new' as const,
  contactName: null,
  email: null,
  phone: null,
  organisation: null,
  assignedTo: page.auth.user.id,
  estimatedValueMinor: null,
  currency: options.currencies[0] ?? 'USD',
  nextFollowUpOn: null,
  lostReason: null,
  notes: null,
  serviceIds: [],
};
---

<AdminLayout title="New lead" page={page}>
  <PageHead title="New lead" crumbs={[{ label: 'Leads', href: '/admin/leads' }, { label: 'New' }]} />
  <LeadForm client:load initial={initial} {...options} />
</AdminLayout>
