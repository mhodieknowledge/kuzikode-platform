<table role="presentation" cellpadding="0" cellspacing="0" style="margin:8px 0 24px"><tr><td style="background:#2747E8;border-radius:6px"><a href="https://example.com/i/abc" style="display:inline-block;padding:12px 22px;font-size:15px;font-weight:600;color:#FFFFFF;text-decoration:none">View invoice</a></td></tr></table>
<p style="margin:0 0 12px;font-size:13px;line-height:1.5;color:#475066">Keep this email for your records.</p>
</td></tr>
<tr><td style="padding:20px 32px;border-top:1px solid #E4E7EE;font-size:12px;line-height:1.5;color:#475066">Kuzikode Technologies<br><a href="https://kuzikode.example/" style="color:#475066">kuzikode.example</a></td></tr>
