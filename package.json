{
  "name": "kuzikode-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview:worker": "astro build && wrangler dev --port 8787",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:payments:live": "NODE_USE_ENV_PROXY=1 vitest run --project payments-live",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run build",
    "verify:full": "npm run verify && npm run test:e2e",
    "cf:types": "wrangler types --strict-vars=false src/worker-configuration.d.ts",
    "build:staging": "CLOUDFLARE_ENV=staging astro build",
    "build:production": "CLOUDFLARE_ENV=production astro build",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "deploy:production": "npm run build:production && wrangler deploy",
    "deploy:staging:dry": "npm run build:staging && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "seed:build": "node scripts/seeds/build-base-seed.ts",
    "db:seed:local": "node scripts/seed.ts --env local",
    "bootstrap:admin": "node scripts/bootstrap-admin.ts",
    "img:gen": "node scripts/images/generate.mjs",
    "img:process": "node scripts/images/process.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.16",
    "lucide-react": "^1.69.0",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "2.0.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ultrahtml": "^1.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.5",
    "@astrojs/react": "^7.1.3",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.6",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
