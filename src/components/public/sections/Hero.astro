---
import ResponsiveImage from '../../ResponsiveImage.astro';
import type { SectionContent } from '../../../shared/schemas/cms';

interface Props {
  content: SectionContent<'hero'>;
}
const { content: c } = Astro.props;
---

<section class="relative overflow-hidden bg-ink-950 text-white" aria-labelledby="hero-title">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.07]"
    style="background-image:linear-gradient(to right,#fff 1px,transparent 1px),linear-gradient(to bottom,#fff 1px,transparent 1px);background-size:48px 48px"
  >
  </div>
  <div class="container-content relative grid items-center gap-12 py-16 md:py-20 lg:grid-cols-[1.05fr_1fr] lg:py-28">
    <div>
      {c.eyebrow ? <p class="mb-5 text-sm font-semibold tracking-wide text-dark-brand">{c.eyebrow}</p> : null}
      <h1 id="hero-title" class="text-[40px] leading-[1.05] font-bold tracking-display text-white sm:text-5xl lg:text-[56px] xl:text-[64px]">{c.title}</h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-white/75">{c.body}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={c.primaryCta.href} class="inline-flex h-12 items-center justify-center rounded-sm bg-brand-600 px-6 text-[15px] font-semibold text-white hover:bg-brand-500">{c.primaryCta.label}</a>
        {
          c.secondaryCta ? (
            <a href={c.secondaryCta.href} class="inline-flex h-12 items-center justify-center rounded-sm border border-white/25 px-6 text-[15px] font-semibold text-white hover:border-white/60">
              {c.secondaryCta.label}
            </a>
          ) : null
        }
      </div>
    </div>
    <div class="relative">
      <div class="overflow-hidden rounded-lg border border-white/10">
        <ResponsiveImage id="home-hero" priority sizes="(min-width: 1024px) 560px, 100vw" class="aspect-[16/10] h-auto w-full object-cover" />
      </div>
      <div aria-hidden="true" class="absolute -bottom-6 -left-4 hidden w-64 rounded-md bg-surface p-4 text-ink-950 shadow-2 sm:block lg:-left-10">
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs text-ink-600">INV-2026-00012</span>
          <span class="inline-flex items-center gap-1 rounded-full bg-success-50 px-2 py-0.5 text-xs font-semibold text-success-700"><span class="h-1.5 w-1.5 rounded-full bg-current"></span>Paid</span>
        </div>
        <p class="mt-3 text-xs text-ink-600">Paid with EcoCash</p>
        <p class="tnum font-display text-2xl font-bold tracking-display">$750.00</p>
      </div>
      <div aria-hidden="true" class="absolute -top-5 -right-3 hidden rounded-md border border-white/10 bg-dark-surface/95 p-4 font-mono text-xs leading-5 text-white/70 shadow-2 md:block">
        <span class="text-success-600">200 OK</span><br />
        {'{'} <span class="text-dark-brand">"status"</span>: <span class="text-accent-500">"paid"</span> {'}'}
      </div>
    </div>
  </div>
</section>
