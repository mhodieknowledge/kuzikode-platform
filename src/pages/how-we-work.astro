---
/**
 * How we work (R4.5, rebuilt from scratch). Order: night hero with the scope-sheet composition → the process road → ways to work
 * with us → what you can expect (photo band) → quality and security (night checklist) → the footer's routes,
 * led by the CMS closing call to action. Data: the how-we-work page CMS sections (the tools section was removed in R9.1, REFINEMENTS §4).
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import HowHero from '../ui/public/how/HowHero.astro';
import ProcessRoad from '../ui/public/how/ProcessRoad.astro';
import Models from '../ui/public/how/Models.astro';
import Expect from '../ui/public/how/Expect.astro';
import Quality from '../ui/public/how/Quality.astro';
import { breadcrumbLd, getPage } from '../server/modules/cms';
import type { Section } from '../shared/schemas/cms';

const { ctx } = Astro.locals;
const page = await getPage(ctx, 'how-we-work');
if (!page) return new Response(null, { status: 404, statusText: 'Not found' });
const sections = page.sections as Section[];
const intro = sections.find((s) => s.type === 'rich_text') as Section<'rich_text'> | undefined;
const process = sections.find((s) => s.type === 'process') as Section<'process'> | undefined;
const models = sections.find((s) => s.type === 'features') as Section<'features'> | undefined;
const expect = sections.find((s) => s.type === 'values') as Section<'values'> | undefined;
const quality = sections.find((s) => s.type === 'list') as Section<'list'> | undefined;
const cta = sections.find((s) => s.type === 'cta') as Section<'cta'> | undefined;
---

<PublicLayout
  structuredData={[breadcrumbLd(ctx, [{ name: 'How we work', path: '/how-we-work' }])]}
  title={page.seoTitle ?? 'How we work · Kuzikode Intelligent Technologies'}
  description={page.seoDescription ?? undefined}
  headerTone="night"
  footerLead={cta ? { title: cta.content.title, body: cta.content.body } : undefined}
>
  <HowHero
    title={intro?.content.title ?? page.title}
    html={intro?.content.html ?? null}
    steps={process?.content.steps.map((s) => s.title) ?? []}
  />
  {process ? <ProcessRoad content={process.content} anchor={process.key} /> : null}
  {models ? <Models content={models.content} anchor={models.key} /> : null}
  {expect ? <Expect content={expect.content} anchor={expect.key} /> : null}
  {quality ? <Quality content={quality.content} anchor={quality.key} /> : null}
</PublicLayout>
