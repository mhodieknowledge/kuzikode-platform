---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import { AssetForm } from '../../../ui/admin/subscriptions/AssetForm';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { formOptions } from '../../../server/modules/subscriptions';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'client_assets.manage' });
if (page instanceof Response) return page;
const opts = await formOptions(ctx);
const wanted = Astro.url.searchParams.get('client');
const initial = {
  clientId: opts.clients.find((c) => c.id === wanted)?.id ?? opts.clients[0]?.id ?? '',
  type: 'domain' as const,
  name: '',
  provider: null,
  subscriptionId: null,
  renewalDate: null,
  autoRenew: false,
  billableToClient: true,
  costNote: null,
  credentialsNote: null,
  status: 'active' as const,
};
---

<AdminLayout title="Add to register" page={page}>
  <PageHead
    title="Add to the register"
    crumbs={[{ label: 'Managed services', href: '/admin/assets' }, { label: 'Add' }]}
  />
  <AssetForm client:load initial={initial} clients={opts.clients} subscriptions={opts.subscriptions} />
</AdminLayout>
