---
/**
 * Workspace support (R5.4, PANEL_DESIGN_SPEC §2): the filter (all / open), the requests window (8) and an "At a glance" window
 * (4) with the counts per state; one emerald action, "New request", in the page head. Empty: a plain mono line in the window.
 */
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PageHead from '../../../ui/workspace/PageHead.astro';
import Window from '../../../ui/workspace/Window.astro';
import FilterNav from '../../../ui/workspace/finance/FilterNav.astro';
import SupportList from '../../../ui/workspace/support/SupportList.astro';
import Button from '../../../ui/primitives/Button.astro';
import { loadPortalPage } from '../../../server/lib/portal-page';
import { listPortalRequests } from '../../../server/modules/support/portal';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request, { area: 'support' });
if (page instanceof Response) return page;
const show = Astro.url.searchParams.get('show') === 'open' ? 'open' : 'all';
const requests = await listPortalRequests(ctx, { show });
const multiClient = page.clients.length > 1;
const tabs = [
  { key: 'all', label: 'All', href: '/portal/support' },
  { key: 'open', label: 'Open', href: '/portal/support?show=open' },
];
const count = (pred: (s: string) => boolean) => requests.filter((r) => pred(r.status)).length;
const glance = [
  { label: 'Open', value: count((s) => s === 'open') },
  { label: 'Waiting for your reply', value: count((s) => s === 'awaiting_client') },
  ...(show === 'all' ? [{ label: 'Resolved or closed', value: count((s) => s === 'resolved' || s === 'closed') }] : []),
];
---

<PortalLayout title="Support" page={page} active="support">
  <PageHead title="Support" sub="Ask the Kuzikode team for help and follow every request here.">
    <Button slot="aside" href="/portal/support/new" lead="add">
      New request
    </Button>
  </PageHead>
  <FilterNav label="Filter requests" items={tabs} current={show} />

  <div class="kz-wgrid">
    {requests.length === 0 ? (
      <Window title="Requests" icon="support" id="slist" span={8}>
        <div class="kz-wnote">
          <p class="kz-wnote__code">{show === 'open' ? 'no open requests' : 'no requests yet'}</p>
          <p>
            {show === 'open'
              ? 'You have no open requests.'
              : 'You have not asked for help yet. When you need something, open a request and our team will reply here.'}
          </p>
        </div>
      </Window>
    ) : (
      <Fragment>
        <SupportList
          requests={requests}
          multiClient={multiClient}
          title={show === 'open' ? 'Open requests' : 'All requests'}
          span={8}
        />
        <Window title="At a glance" icon="activity" id="glance" span={4} class="kz-sglance">
          <dl class="kz-sglance__list">
            {glance.map((g) => (
              <div>
                <dt>{g.label}</dt>
                <dd>{g.value}</dd>
              </div>
            ))}
          </dl>
        </Window>
      </Fragment>
    )}
  </div>
</PortalLayout>
