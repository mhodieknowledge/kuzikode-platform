---
/** Website announcements (R6.2): one active announcement at a time, inside its start and end dates. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import CmsTabs from '../../../ui/admin/website/CmsTabs.astro';
import { AnnouncementsManager } from '../../../ui/admin/cms/AnnouncementsManager';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listAnnouncementsAdmin } from '../../../server/modules/cms/admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'cms.manage' });
if (page instanceof Response) return page;
const announcements = (await listAnnouncementsAdmin(ctx)) as never[];
---

<AdminLayout title="Announcements" page={page}>
  <PageHead title="Website" meta="The site shows one active announcement at a time, inside its start and end dates." />
  <div class="kz-atools">
    <CmsTabs current="announcements" />
  </div>
  <AnnouncementsManager client:load announcements={announcements} />
</AdminLayout>
