---
/** Settings, data export (R6.2 group 3): one pane per area with a JSON download and a CSV link per table. Every download is audited. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import Button from '../../../ui/primitives/Button.astro';
import SettingsNav from '../../../ui/admin/settings/SettingsNav.astro';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { EXPORT_MODULES } from '../../../server/modules/audit';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'data.export' });
if (page instanceof Response) return page;
---

<AdminLayout title="Data export" page={page}>
  <PageHead title="Settings" meta="Data export" />
  <div class="kz-aset">
    <SettingsNav current="export" canExport />
    <div class="kz-aset__main">
      <p class="kz-anotice kz-anotice--info">
        Download your business data per area as JSON (every table) or one table at a time as CSV. Passwords, security
        codes, tokens and payment credentials are never included. Every download is recorded in the audit log.
      </p>
      <div class="kz-agrid kz-agrid--2">
        {Object.entries(EXPORT_MODULES).map(([key, m]) => (
          <Pane title={m.label} id={`exp-${key}`}>
            <Button slot="actions" size="sm" href={`/api/v1/admin/data-export/${key}`} download lead="download">
              Download JSON
            </Button>
            <div class="kz-adownload" style="padding:0">
              <p class="kz-hint">CSV per table:</p>
              <ul class="kz-adownload__tables">
                {m.tables.map((t) => (
                  <li>
                    <a href={`/api/v1/admin/data-export/${key}/${t}.csv`} download>
                      {t}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </Pane>
        ))}
      </div>
    </div>
  </div>
</AdminLayout>
