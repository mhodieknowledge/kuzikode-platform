---
/**
 * Admin dashboard (R6.2): KPI strip (one grooved band of mono figures, per currency), the two charts in panes, then the
 * working lists (payments, invoices due, renewals, milestones, activity, notifications) and the account pane. Sections a
 * user may not see are absent (the service returns null for them).
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHead from '../../ui/admin/PageHead.astro';
import Pane from '../../ui/admin/Pane.astro';
import KpiStrip, { type Kpi } from '../../ui/admin/KpiStrip.astro';
import BarChart from '../../ui/admin/BarChart.astro';
import Icon from '../../ui/icons/Icon.astro';
import { adminShellNav } from '../../ui/admin/nav';
import { loadAdminPage } from '../../server/lib/admin-page';
import { listNotifications } from '../../server/modules/notifications';
import { getDashboard, type CurrencyAmount } from '../../server/modules/dashboard';
import { formatMoney } from '../../shared/money';
import { MANUAL_PAYMENT_METHODS } from '../../shared/invoices';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request);
if (page instanceof Response) return page;
const [{ items }, d] = await Promise.all([listNotifications(ctx, page.auth.user.id, { limit: 5 }), getDashboard(ctx)]);
const dateFmt = (ymd: string) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(
    new Date(`${ymd}T00:00:00Z`),
  );
const methods = new Map<string, string>(MANUAL_PAYMENT_METHODS.map((m) => [m.value, m.label.replace(' (manual)', '')]));
/** Amounts per currency, never added together. */
const perCurrency = (list: CurrencyAmount[]) => list.map((a) => formatMoney(a.amountMinor, a.currency));
const compact = (currency: string) => (minor: number) =>
  `${currency} ${new Intl.NumberFormat('en-GB', { notation: 'compact', maximumFractionDigits: 1 }).format(minor / 100)}`;
const ENTITY_PATHS: Record<string, string> = {
  client: 'clients',
  invoice: 'invoices',
  quotation: 'quotations',
  project: 'projects',
  support_request: 'support',
  payment: 'payments',
  enquiry: 'enquiries',
  lead: 'leads',
  expense: 'expenses',
  user: 'users',
};
const entityLink = (type: string | null, id: string | null) =>
  type && id && ENTITY_PATHS[type] ? `/admin/${ENTITY_PATHS[type]}/${encodeURIComponent(id)}` : null;
const actionLabel = (a: string) => {
  const t = a.replace(/[._]/g, ' ').trim();
  return t.charAt(0).toUpperCase() + t.slice(1);
};
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const tiles: Kpi[] = [];
if (d.financial) {
  const f = d.financial;
  tiles.push(
    { label: 'Revenue received (all time)', values: perCurrency(f.revenueAllTime), href: '/admin/payments' },
    { label: 'Revenue this month', values: perCurrency(f.revenueThisMonth), href: '/admin/payments' },
    {
      label: 'Outstanding',
      values: perCurrency(f.outstanding),
      note: plural(
        f.outstanding.reduce((n, a) => n + (a.count ?? 0), 0),
        'open invoice',
      ),
      href: '/admin/invoices',
    },
    {
      label: 'Overdue',
      values: perCurrency(f.overdue),
      note: plural(
        f.overdue.reduce((n, a) => n + (a.count ?? 0), 0),
        'overdue invoice',
      ),
      href: '/admin/invoices?status=overdue',
    },
  );
}
if (d.recurring)
  tiles.push({
    label: 'Recurring revenue (MRR)',
    values: d.recurring.map((r) => `${formatMoney(r.mrrMinor, r.currency)} / mo`),
    note: d.recurring.length
      ? `ARR ${d.recurring.map((r) => formatMoney(r.arrMinor, r.currency)).join(' · ')}`
      : undefined,
    href: '/admin/subscriptions',
  });
if (d.quotations)
  tiles.push({
    label: 'Pending quotations',
    values: [String(d.quotations.pending)],
    note: d.quotations.pendingValue.length ? perCurrency(d.quotations.pendingValue).join(' · ') : undefined,
    href: '/admin/quotations',
  });
if (d.projects)
  tiles.push(
    { label: 'Active projects', values: [String(d.projects.active)], href: '/admin/projects' },
    { label: 'Completed projects', values: [String(d.projects.completed)], href: '/admin/projects?status=completed' },
  );
if (d.enquiries)
  tiles.push({
    label: 'New enquiries (7 days)',
    values: [String(d.enquiries.last7Days)],
    note: `${d.enquiries.briefs7Days} project ${d.enquiries.briefs7Days === 1 ? 'brief' : 'briefs'}`,
    href: '/admin/enquiries',
  });
if (d.careers)
  tiles.push({
    label: 'Open roles',
    values: [String(d.careers.openRoles)],
    note: `${d.careers.newApplicants7Days} new ${d.careers.newApplicants7Days === 1 ? 'applicant' : 'applicants'} this week`,
  });
const sections = adminShellNav(page.nav)
  .flatMap((g) => g.items)
  .filter((i) => i.href !== '/admin');
const firstName = page.auth.user.name.split(/\s+/)[0] ?? page.auth.user.name;
const fmt = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Africa/Harare' }).format(
    new Date(iso),
  );
const today = new Intl.DateTimeFormat('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  timeZone: 'Africa/Harare',
}).format(ctx.now());
---

<AdminLayout title="Dashboard" page={page}>
  <PageHead title={`Welcome, ${firstName}`}>
    <Fragment slot="meta">
      {today} · <kbd class="kz-amono">⌘K</kbd> (<kbd class="kz-amono">Ctrl K</kbd> on Windows) finds a client, invoice,
      quotation or project.
    </Fragment>
  </PageHead>
  {d.priceReview ? (
    <div role="status" class="kz-anotice">
      <p>
        <strong>
          {d.priceReview} {d.priceReview === 1 ? 'package price is' : 'package prices are'} awaiting review.
        </strong>{' '}
        Until approved they are suggested launch prices.
      </p>
      <a href="/admin/packages?review=1">Review prices</a>
    </div>
  ) : null}
  {tiles.length > 0 ? <KpiStrip items={tiles} testId="kpi-tiles" /> : null}
  {d.financial ? (
    <div class="kz-agrid kz-agrid--2">
      <Pane title="Revenue received" meta="last 12 months" id="pane-revenue">
        {d.financial.charts.revenue.length === 0 ? (
          <BarChart
            id="revenue-none"
            title="Revenue received per month"
            months={d.financial.charts.months}
            series={[{ label: 'Revenue', values: d.financial.charts.months.map(() => 0) }]}
            format={(v) => String(v)}
          />
        ) : (
          <div class="kz-astack">
            {d.financial.charts.revenue.map((r) => (
              <BarChart
                id={`revenue-${r.currency}`}
                title={`Revenue received per month (${r.currency})`}
                months={d.financial!.charts.months}
                series={[{ label: r.currency, values: r.values }]}
                format={(v) => formatMoney(v, r.currency)}
                tick={compact(r.currency)}
              />
            ))}
          </div>
        )}
      </Pane>
      <Pane title="Invoices" meta="issued vs paid" id="pane-invoices-chart">
        <BarChart
          id="invoices-issued-paid"
          title="Invoices issued vs paid per month"
          months={d.financial.charts.months}
          series={[
            { label: 'Issued', values: d.financial.charts.issued, color: 'var(--granite)' },
            { label: 'Paid', values: d.financial.charts.paid, color: 'var(--teal)' },
          ]}
          format={(v) => `${v} ${v === 1 ? 'invoice' : 'invoices'}`}
          tick={(v) => (Number.isInteger(v) ? String(v) : '')}
        />
      </Pane>
    </div>
  ) : null}
  <div class="kz-agrid kz-agrid--3 kz-agap">
    {d.recentPayments ? (
      <Pane title="Recent payments" flush>
        <a slot="actions" href="/admin/payments" class="kz-apane__link">
          See all<span class="sr-only"> payments</span>
        </a>
        {d.recentPayments.length === 0 ? (
          <p class="kz-anone">
            <span class="kz-anone__code">0 payments</span>No payments recorded yet.
          </p>
        ) : (
          <ul class="kz-alist" role="list">
            {d.recentPayments.map((p) => (
              <li>
                <div class="kz-alist__main">
                  <a href={`/admin/payments/${p.id}`} class="kz-alist__t">
                    {p.client}
                  </a>
                  <span class="kz-alist__m">
                    <span class="kz-amono">{p.receiptNumber}</span> · {methods.get(p.method) ?? p.method} ·{' '}
                    {fmt(p.receivedAt)}
                    {p.providerReference ? ` · Ref ${p.providerReference}` : ''}
                  </span>
                </div>
                <span class="kz-alist__r">{formatMoney(p.amountMinor, p.currency)}</span>
              </li>
            ))}
          </ul>
        )}
      </Pane>
    ) : null}
    {d.dueInvoices ? (
      <Pane title="Invoices due in the next 14 days" flush id="pane-due">
        <a slot="actions" href="/admin/invoices" class="kz-apane__link">
          See all<span class="sr-only"> invoices</span>
        </a>
        {d.dueInvoices.length === 0 ? (
          <p class="kz-anone">
            <span class="kz-anone__code">0 due</span>No open invoices fall due in the next two weeks.
          </p>
        ) : (
          <ul class="kz-alist" role="list">
            {d.dueInvoices.map((i) => (
              <li>
                <div class="kz-alist__main">
                  <a href={`/admin/invoices/${i.id}`} class="kz-alist__t kz-amono">
                    {i.number}
                  </a>
                  <span class="kz-alist__m">
                    {i.client} · due {dateFmt(i.dueDate)}
                  </span>
                </div>
                <span class="kz-alist__r">{formatMoney(i.balanceMinor, i.currency)}</span>
              </li>
            ))}
          </ul>
        )}
      </Pane>
    ) : null}
    {d.renewals ? (
      <Pane
        title="Upcoming renewals (30 days)"
        flush
        id="pane-renewals"
        meta={d.renewals.total > d.renewals.items.length ? `${d.renewals.total} in total` : undefined}
      >
        {d.renewals.items.length === 0 ? (
          <p class="kz-anone">
            <span class="kz-anone__code">0 renewals</span>Nothing renews or bills in the next 30 days.
          </p>
        ) : (
          <ul class="kz-alist" role="list">
            {d.renewals.items.map((r) => (
              <li>
                <div class="kz-alist__main">
                  <a href={r.href} class="kz-alist__t">
                    {r.name}
                  </a>
                  <span class="kz-alist__m">
                    {r.client} · {r.kind === 'subscription' ? 'next invoice' : 'renewal'}
                  </span>
                </div>
                <span class="kz-alist__r is-date">{dateFmt(r.date)}</span>
              </li>
            ))}
          </ul>
        )}
      </Pane>
    ) : null}
    {d.projects ? (
      <Pane title="Upcoming milestones" flush>
        <a slot="actions" href="/admin/projects" class="kz-apane__link">
          See all<span class="sr-only"> projects</span>
        </a>
        {d.projects.upcomingMilestones.length === 0 ? (
          <p class="kz-anone">
            <span class="kz-anone__code">0 milestones</span>No milestones are due in the next 30 days.
          </p>
        ) : (
          <ul class="kz-alist" role="list">
            {d.projects.upcomingMilestones.map((m) => (
              <li>
                <div class="kz-alist__main">
                  <a href={`/admin/projects/${m.projectId}`} class="kz-alist__t">
                    {m.title}
                  </a>
                  <span class="kz-alist__m">
                    <span class="kz-amono">{m.reference}</span> · {m.projectName}
                  </span>
                </div>
                <span class="kz-alist__r is-date">{dateFmt(m.dueDate)}</span>
              </li>
            ))}
          </ul>
        )}
      </Pane>
    ) : null}
    {d.activity ? (
      <Pane title="Recent activity" flush>
        {d.activity.length === 0 ? (
          <p class="kz-anone">
            <span class="kz-anone__code">0 events</span>No activity yet.
          </p>
        ) : (
          <ol class="kz-afeed">
            {d.activity.map((a) => {
              const link = entityLink(a.entityType, a.entityId);
              return (
                <li>
                  {link ? (
                    <a href={link} class="kz-afeed__k">
                      {actionLabel(a.action)}
                    </a>
                  ) : (
                    <p class="kz-afeed__k">{actionLabel(a.action)}</p>
                  )}
                  <p class="kz-afeed__t">
                    {a.actor ?? 'System'} · {fmt(a.createdAt)}
                  </p>
                </li>
              );
            })}
          </ol>
        )}
      </Pane>
    ) : null}
    <Pane title="Recent notifications" flush>
      <a slot="actions" href="/admin/notifications" class="kz-apane__link">
        See all
      </a>
      {items.length === 0 ? (
        <p class="kz-anone">
          <span class="kz-anone__code">0 unread</span>Nothing new. Notifications about enquiries, applications and
          payments appear here.
        </p>
      ) : (
        <ol class="kz-afeed">
          {items.map((n) => (
            <li data-kind={n.readAt ? undefined : 'lit'}>
              {n.link ? (
                <a href={n.link} class="kz-afeed__k">
                  {n.title}
                </a>
              ) : (
                <p class="kz-afeed__k">{n.title}</p>
              )}
              <p class="kz-afeed__t">{fmt(n.createdAt)}</p>
            </li>
          ))}
        </ol>
      )}
    </Pane>
    <Pane title="Your account" class="kz-span-all">
      <div class="kz-aacc">
        <div class="kz-astack">
          <dl class="kz-adl kz-adl--rows">
            <div class="kz-adl__i">
              <dt>Signed in as</dt>
              <dd class="is-mono">{page.auth.user.email}</dd>
            </div>
            <div class="kz-adl__i">
              <dt>Two-factor authentication</dt>
              <dd>{page.auth.mfa.enabled ? 'On' : 'Off'}</dd>
            </div>
          </dl>
          <a href="/admin/account/security" class="kz-apane__link">
            Security settings
          </a>
        </div>
        {sections.length > 0 ? (
          <div>
            <h3 class="kz-asub__t">Your sections</h3>
            <ul class="kz-achips" role="list">
              {sections.map((s) => (
                <li>
                  <a href={s.href}>
                    <Icon name={s.icon} size={16} />
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : null}
      </div>
    </Pane>
  </div>
</AdminLayout>
