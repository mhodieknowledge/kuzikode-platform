---
/**
 * Industries (R4.5, rebuilt from scratch): light header with the signpost drawing, then the numbered sector directory. Each row
 * shows which areas of work serve the sector (from the industry's linked services). Data: industries page CMS intro, industries,
 * the service catalogue.
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import SceneArt from '../../ui/illustrations/SceneArt.astro';
import IndustryIndex from '../../ui/public/industries/IndustryIndex.astro';
import { breadcrumbLd, getPage, getServiceCatalogue, listIndustries, sectionOf } from '../../server/modules/cms';
import { divisionShortName } from '../../shared/directory';

const { ctx } = Astro.locals;
const [page, industries, categories] = await Promise.all([
  getPage(ctx, 'industries'),
  listIndustries(ctx),
  getServiceCatalogue(ctx),
]);
const intro = sectionOf(page, 'intro', 'rich_text');
const areaOf = new Map<string, number>();
categories.forEach((c, i) => c.services.forEach((s) => areaOf.set(s.id, i)));
const rows = industries.map((i) => {
  const idx = [...new Set(i.serviceIds.map((id) => areaOf.get(id)).filter((n): n is number => n !== undefined))].sort(
    (a, b) => a - b,
  );
  return {
    ...i,
    areas: idx.map((n) => ({ n: n + 1, name: divisionShortName(categories[n]!.slug, categories[n]!.name) })),
  };
});
---

<PublicLayout
  structuredData={[breadcrumbLd(ctx, [{ name: 'Industries', path: '/industries' }])]}
  title={page?.seoTitle ?? 'Industries · Kuzikode Intelligent Technologies'}
  description={page?.seoDescription ?? undefined}
  headerTone="bone"
>
  <section class="kz-ihead" aria-labelledby="industries-title">
    <div class="container-wide kz-ihead__grid">
      <div>
        <h1 id="industries-title" class="kz-ihead__title" data-enter>
          {intro?.content.title ?? 'Industries'}
        </h1>
        {intro ? <div class="kz-ihead__intro" data-enter="2" set:html={intro.content.html} /> : null}
        <p class="kz-ihead__count" data-enter="2">
          <b>{String(industries.length).padStart(2, '0')}</b>
          {' sectors, served by '}
          <b>{categories.length}</b>
          {' areas of work'}
        </p>
      </div>
      <div class="kz-ihead__art kz-div-6" data-enter="3">
        <SceneArt kind="signpost" />
      </div>
    </div>
  </section>
  <IndustryIndex industries={rows} areas={categories.map((c) => divisionShortName(c.slug, c.name))} />
</PublicLayout>
