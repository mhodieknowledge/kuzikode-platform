---
/**
 * One project (R6.2 group 3): head with reference, status, client and progress; sections as a view switch (overview, tasks,
 * updates, files, messages, time, activity), each a set of panes. Query `?tab=` and every control label are the e2e contract.
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import Pane from '../../../../ui/admin/Pane.astro';
import Views from '../../../../ui/admin/Views.astro';
import DataTable from '../../../../ui/admin/DataTable.astro';
import Cell from '../../../../ui/admin/Cell.astro';
import DetailList from '../../../../ui/admin/DetailList.astro';
import Button from '../../../../ui/primitives/Button.astro';
import EmptyState from '../../../../ui/primitives/EmptyState.astro';
import StatusPill from '../../../../ui/primitives/StatusPill.astro';
import {
  FileActions,
  FileUploader,
  MessageComposer,
  MilestonesPanel,
  ProgressSettings,
  TaskBoard,
  UpdateComposer,
} from '../../../../ui/admin/projects/ProjectPanels';
import { EntryDialogButton } from '../../../../ui/admin/time/EntryDialog';
import { billingLabel, workLabel } from '../../../../ui/admin/time/labels';
import { fileSize, harareStamp, PROJECT_ACTION_LABEL, PROJECT_STATUS_TONE } from '../../../../ui/admin/projects/labels';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { AppError } from '../../../../server/lib/errors';
import { getProject, staffOptions } from '../../../../server/modules/projects';
import { projectTime, trackingOptions } from '../../../../server/modules/timetracking';
import { businessDate } from '../../../../server/lib/dates';
import { formatMinutes } from '../../../../shared/schemas/time';
import { PROJECT_STATUS_LABEL } from '../../../../shared/projects';
import { formatMoney } from '../../../../shared/money';
import { formatLongDate } from '../../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { anyOf: ['projects.view', 'projects.view_all'] });
if (page instanceof Response) return page;
let data;
try {
  data = await getProject(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const {
  project: p,
  client,
  members,
  milestones,
  tasks,
  updates,
  files,
  messages,
  activity,
  quotation,
  invoices,
} = data;
const canManage = page.auth.permissions.has('projects.manage');
const staff = canManage ? await staffOptions(ctx) : [];
const perms = page.auth.permissions;
const timeVisible = perms.has('time.track') || perms.has('time.view_all') || perms.has('time.bill');
const tabs = [
  { key: 'overview', label: 'Overview' },
  { key: 'tasks', label: 'Tasks', count: tasks.length },
  { key: 'updates', label: 'Updates', count: updates.length },
  { key: 'files', label: 'Files', count: files.length },
  { key: 'messages', label: 'Messages', count: messages.length },
  ...(timeVisible ? [{ key: 'time', label: 'Time' }] : []),
  { key: 'activity', label: 'Activity' },
].map((t) => ({ ...t, href: `/admin/projects/${p.id}${t.key === 'overview' ? '' : `?tab=${t.key}`}` }));
const tabParam = Astro.url.searchParams.get('tab');
const tab = tabs.some((t) => t.key === tabParam) ? tabParam! : 'overview';
const time = tab === 'time' ? await projectTime(ctx, p.id) : null;
const timeProjects =
  tab === 'time' && perms.has('time.track') ? (await trackingOptions(ctx)).filter((o) => o.id === p.id) : [];
---

<AdminLayout title={p.name} page={page}>
  <PageHead title={p.name} crumbs={[{ label: 'Projects', href: '/admin/projects' }, { label: p.reference }]}>
    <Fragment slot="meta">
      <span class="kz-amono">{p.reference}</span> ·
      <StatusPill tone={PROJECT_STATUS_TONE[p.status]} plain>
        {PROJECT_STATUS_LABEL[p.status]}
      </StatusPill>{' '}
      · <a href={`/admin/clients/${p.client_id}`}>{client?.display_name}</a>
      {quotation ? (
        <>
          {' '}
          · from <a href={`/admin/quotations/${quotation.id}`}>{quotation.number}</a>
        </>
      ) : null}
    </Fragment>
    <Fragment slot="actions">
      {canManage ? (
        <Button href={`/admin/projects/${p.id}/edit`} variant="secondary" lead="edit">
          Edit project
        </Button>
      ) : null}
    </Fragment>
    <div
      class="kz-aprog"
      role="progressbar"
      aria-label="Project progress"
      aria-valuenow={p.progress_pct}
      aria-valuemin="0"
      aria-valuemax="100"
    >
      <span class="kz-aprog__row">
        <span>Progress</span>
        <span class="kz-aprog__pct">{p.progress_pct}%</span>
      </span>
      <span class="kz-aprog__bar" aria-hidden="true">
        <i style={`width:${p.progress_pct}%`} />
      </span>
    </div>
  </PageHead>
  <div class="kz-atools">
    <Views label="Project sections" items={tabs} current={tab} />
  </div>

  {tab === 'overview' ? (
    <div class="kz-agrid kz-agrid--detail">
      <div class="kz-astack">
        <MilestonesPanel
          client:load
          projectId={p.id}
          milestones={milestones}
          invoices={invoices}
          canManage={canManage}
        />
        {p.description ? (
          <Pane title="Description" id="desc-h">
            <p class="kz-aprose">{p.description}</p>
          </Pane>
        ) : null}
      </div>
      <aside class="kz-astack" aria-label="Project summary">
        <Pane title="Details" id="facts-h">
          <DetailList
            rows
            items={[
              { label: 'Start', value: p.start_date ? formatLongDate(p.start_date) : null },
              { label: 'Target', value: p.target_date ? formatLongDate(p.target_date) : null },
              ...(p.completed_at ? [{ label: 'Completed', value: formatLongDate(p.completed_at) }] : []),
              {
                label: 'Budget',
                value: p.budget_minor != null && p.currency ? formatMoney(p.budget_minor, p.currency) : null,
                mono: true,
              },
            ]}
          />
        </Pane>
        <Pane title="Team" id="team-h" flush meta={String(members.length)}>
          {members.length === 0 ? (
            <p class="kz-anone">
              <span class="kz-anone__code">0 members</span>No team yet.
            </p>
          ) : (
            <ul class="kz-alist">
              {members.map((m) => (
                <li>
                  <span class="kz-alist__t">{m.name}</span>
                  {m.role === 'lead' ? (
                    <StatusPill tone="lit" plain class="kz-pill--xs">
                      Lead
                    </StatusPill>
                  ) : null}
                </li>
              ))}
            </ul>
          )}
        </Pane>
        {canManage ? (
          <Pane title="Progress and notes" id="prog-h">
            <ProgressSettings
              client:load
              projectId={p.id}
              mode={p.progress_mode}
              pct={p.progress_pct}
              notes={p.internal_notes}
            />
          </Pane>
        ) : p.internal_notes ? (
          <Pane title="Internal notes" id="notes-h">
            <p class="kz-aprose">{p.internal_notes}</p>
          </Pane>
        ) : null}
      </aside>
    </div>
  ) : null}

  {tab === 'tasks' ? (
    <TaskBoard
      client:load
      projectId={p.id}
      tasks={tasks}
      milestones={milestones.map((m) => ({ id: m.id, title: m.title }))}
      staff={staff}
      canManage={canManage}
      userId={page.auth.user.id}
    />
  ) : null}

  {tab === 'updates' ? (
    <div class="kz-agrid kz-agrid--detail">
      <Pane title="Updates" id="upd-h" flush meta={String(updates.length)}>
        {updates.length === 0 ? (
          <p class="kz-anone">
            <span class="kz-anone__code">0 updates</span>No updates yet.
          </p>
        ) : (
          <ol class="kz-afeed">
            {updates.map((u) => (
              <li data-kind={u.visibility === 'client' ? 'lit' : undefined}>
                <p class="kz-afeed__b">{u.body}</p>
                <p class="kz-afeed__t">
                  {harareStamp(u.created_at)} · {u.author} ·{' '}
                  {u.visibility === 'client' ? 'shared with the client' : 'internal'}
                </p>
              </li>
            ))}
          </ol>
        )}
      </Pane>
      {canManage ? (
        <Pane title="New update" id="upd-new">
          <UpdateComposer client:load projectId={p.id} />
        </Pane>
      ) : null}
    </div>
  ) : null}

  {tab === 'files' ? (
    <div class="kz-agrid kz-agrid--detail">
      <Pane title="Files and deliverables" id="files-h" flush meta={String(files.length)}>
        {files.length === 0 ? (
          <p class="kz-anone">
            <span class="kz-anone__code">0 files</span>No files yet.
          </p>
        ) : (
          <ul class="kz-alist">
            {files.map((f) => (
              <li>
                <div class="kz-alist__main">
                  <a href={`/api/v1/admin/files/${f.file_id}`} class="kz-afile">
                    {f.label}
                  </a>
                  <span class="kz-alist__m">
                    {f.original_name} · {fileSize(f.size_bytes)} · {f.kind}
                    {f.client_visible ? ' · visible to the client' : ' · staff only'}
                  </span>
                </div>
                {canManage ? (
                  <FileActions
                    client:visible
                    projectId={p.id}
                    id={f.id}
                    label={f.label}
                    kind={f.kind}
                    clientVisible={f.client_visible === 1}
                  />
                ) : null}
              </li>
            ))}
          </ul>
        )}
      </Pane>
      {canManage ? (
        <Pane title="Upload" id="up-h">
          <FileUploader client:load projectId={p.id} />
        </Pane>
      ) : null}
    </div>
  ) : null}

  {tab === 'messages' ? (
    <div class="kz-agrid kz-agrid--detail">
      <Pane title="Messages with the client" id="msg-h" meta={String(messages.length)}>
        {messages.length === 0 ? (
          <p class="kz-anone">
            <span class="kz-anone__code">0 messages</span>No messages yet.
          </p>
        ) : (
          <ol class="kz-athread" aria-label="Messages">
            {messages.map((m) => (
              <li class="kz-amsg" data-who={m.user_type === 'client' ? 'client' : 'staff'}>
                <p class="kz-amsg__head">
                  <span class="kz-amsg__who">{m.author}</span>
                  <span class="kz-amsg__t">{harareStamp(m.created_at)}</span>
                  {m.user_type !== 'client' && m.read_by_client_at ? <span class="kz-amsg__tag">read</span> : null}
                </p>
                <p class="kz-amsg__body">{m.body}</p>
              </li>
            ))}
          </ol>
        )}
      </Pane>
      <Pane title="New message" id="msg-new">
        <MessageComposer client:load projectId={p.id} />
      </Pane>
    </div>
  ) : null}

  {tab === 'time' && time ? (
    <div class="kz-asect">
      <Pane title="Time" id="time-h">
        <div slot="actions" class="kz-aacts-row">
          {timeProjects.length ? (
            <EntryDialogButton client:load projects={timeProjects} today={businessDate(ctx.now())} />
          ) : null}
          {perms.has('time.bill') && time.unbilled.length ? (
            <Button href={`/admin/time/bill/${p.id}`} size="sm">
              Bill unbilled time
            </Button>
          ) : null}
        </div>
        <p class="kz-amono">
          {formatMinutes(time.totalMinutes)} logged{time.seesEveryone ? '' : ' by you'}
          {time.unbilled
            .map((u) => ` · ${formatMinutes(u.minutes)} unbilled (${formatMoney(u.amountMinor, u.currency)})`)
            .join('')}
        </p>
      </Pane>
      <DataTable
        caption="Time logged on this project"
        count={time.entries.length}
        columns={[
          { label: 'Date' },
          { label: 'Person' },
          { label: 'Work' },
          { label: 'Time', num: true },
          { label: 'Billing' },
        ]}
      >
        <EmptyState slot="empty" code="0 entries" title="No time logged yet." />
        {time.entries.map((e) => (
          <tr>
            <Cell m="meta" class="kz-dt__nw">
              <span class="kz-amono">{e.entry_date}</span>
              <span class="kz-dt__ph"> · {e.user_name}</span>
            </Cell>
            <Cell>{e.user_name}</Cell>
            <Cell m="main">{workLabel(e)}</Cell>
            <Cell m="amount" num>
              {formatMinutes(e.minutes ?? 0)}
            </Cell>
            <Cell m="status" tone="mute">
              {billingLabel(e)}
            </Cell>
          </tr>
        ))}
      </DataTable>
    </div>
  ) : null}

  {tab === 'activity' ? (
    <Pane title="Activity" id="act-h" flush meta={String(activity.length)}>
      {activity.length === 0 ? (
        <p class="kz-anone">
          <span class="kz-anone__code">0 events</span>Nothing recorded yet.
        </p>
      ) : (
        <ol class="kz-afeed">
          {activity.map((a) => (
            <li>
              <span class="kz-afeed__k">{PROJECT_ACTION_LABEL[a.action] ?? a.action}</span>
              <span class="kz-afeed__t">
                {harareStamp(a.created_at)}
                {a.actor ? ` · ${a.actor}` : ''}
              </span>
            </li>
          ))}
        </ol>
      )}
    </Pane>
  ) : null}
</AdminLayout>
