---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import { NotificationPrefsForm } from '../../../ui/admin/settings/NotificationPrefsForm';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { notificationPreferences } from '../../../server/modules/settings';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request);
if (page instanceof Response) return page;
const prefs = await notificationPreferences(ctx);
---

<AdminLayout title="Notification preferences" page={page}>
  <PageHead
    title="Notification preferences"
    meta="Choose how you hear about each event. You only receive notifications for areas your role can see."
    crumbs={[{ label: 'Notifications', href: '/admin/notifications' }, { label: 'Preferences' }]}
  />
  <div class="kz-aset__main">
    <NotificationPrefsForm client:load prefs={prefs.map((p) => ({ ...p }))} />
  </div>
</AdminLayout>
