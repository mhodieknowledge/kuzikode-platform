---
import BaseHead from '../components/BaseHead.astro';
import AnnouncementBar from '../components/public/AnnouncementBar.astro';
import SiteFooter from '../components/public/SiteFooter.astro';
import SiteHeader from '../components/public/SiteHeader.astro';
import { currentAnnouncement, siteNavigation } from '../server/modules/cms';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  headerTone?: 'light' | 'dark';
}
const { title, description, canonicalPath = Astro.url.pathname, noindex = false, headerTone = 'light' } = Astro.props;
const { ctx } = Astro.locals;
const [nav, announcement] = await Promise.all([siteNavigation(ctx), currentAnnouncement(ctx)]);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} canonicalPath={canonicalPath} noindex={noindex} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-surface">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <AnnouncementBar announcement={announcement} />
    <SiteHeader nav={nav} tone={headerTone} />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter nav={nav} />
  </body>
</html>
