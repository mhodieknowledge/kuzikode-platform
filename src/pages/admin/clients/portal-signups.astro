---
/** Self-registered portal accounts waiting to be linked to a client (R6.2). Rows stay list items (e2e contract). */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import { PortalSignupActions } from '../../../ui/admin/clients/PortalSignupActions';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listPortalSignups } from '../../../server/modules/clients';
import { portalRegistrationEnabled } from '../../../server/modules/auth/service';
import { harareDateTime } from '../../../shared/devices';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'clients.view' });
if (page instanceof Response) return page;
const [signups, enabled] = await Promise.all([listPortalSignups(ctx), portalRegistrationEnabled(ctx)]);
const canEdit = page.auth.permissions.has('clients.update');
const clients = canEdit
  ? (
      await ctx.db
        .prepare(
          "SELECT id, display_name AS name FROM clients WHERE status = 'active' ORDER BY display_name LIMIT 1000",
        )
        .all<{ id: string; name: string }>()
    ).results
  : [];
---

<AdminLayout title="Portal sign-ups" page={page}>
  <PageHead
    title="Portal sign-ups"
    crumbs={[{ label: 'Clients', href: '/admin/clients' }, { label: 'Portal sign-ups' }]}
    meta="People who created a portal account themselves. They see nothing until you link them to a client. Accounts are never linked automatically, even when the email matches a contact."
  />
  <Pane title="Waiting" meta={String(signups.length)} flush>
    <StatusPill slot="actions" tone={enabled ? 'ok' : 'neutral'}>
      {enabled ? 'Self-registration is on' : 'Self-registration is off'}
    </StatusPill>
    {!enabled ? <p class="kz-apad kz-adlg__desc">Turn it on under Settings → General → Client portal.</p> : null}
    {signups.length === 0 ? (
      <p class="kz-anone">
        <span class="kz-anone__code">0 waiting</span>No sign-ups are waiting.
      </p>
    ) : (
      <ul class="kz-alist" aria-label="Portal sign-ups">
        {signups.map((s) => (
          <li>
            <div class="kz-alist__main">
              <p class="kz-alist__t">{s.name}</p>
              <p class="kz-alist__m">
                <span class="kz-amono">{s.email}</span>
                {s.phone ? ` · ${s.phone}` : ''}
              </p>
              <p class="kz-alist__m">
                {s.company ? `Says they are from ${s.company} · ` : ''}Signed up {harareDateTime(s.registeredAt)}
              </p>
            </div>
            {canEdit ? <PortalSignupActions client:visible userId={s.userId} name={s.name} clients={clients} /> : null}
          </li>
        ))}
      </ul>
    )}
  </Pane>
</AdminLayout>
