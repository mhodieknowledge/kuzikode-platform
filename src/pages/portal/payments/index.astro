---
/**
 * Workspace payments (R5.3, PANEL_DESIGN_SPEC §2): the receipts ledger (8): mono date, mono receipt number, method and the
 * invoices it paid, the amount in mono, the state and the receipt download. Saved cards sit in their own window (4) beside it
 * (below it on phones and tablets). Without saved cards the ledger takes the full width.
 */
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PageHead from '../../../ui/workspace/PageHead.astro';
import Window from '../../../ui/workspace/Window.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import Icon from '../../../ui/icons/Icon.astro';
import { SavedCards } from '../../../ui/workspace/finance/SavedCards';
import { loadPortalPage } from '../../../server/lib/portal-page';
import { listPortalPayments, listPortalSavedCards } from '../../../server/modules/payments';
import { formatMoney } from '../../../shared/money';
import { paymentMethodLabel } from '../../../shared/payment-methods';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request, { area: 'finance' });
if (page instanceof Response) return page;
const [payments, cards] = await Promise.all([listPortalPayments(ctx), listPortalSavedCards(ctx)]);
const multiClient = new Set(cards.map((c) => c.clientId)).size > 1;
const STATUS = {
  completed: { label: 'Received', tone: 'ok' },
  partially_refunded: { label: 'Part refunded', tone: 'warn' },
  refunded: { label: 'Refunded', tone: 'neutral' },
  reversed: { label: 'Reversed', tone: 'danger' },
} as const;
---

<PortalLayout title="Payments" page={page} active="payments">
  <PageHead title="Payments" sub="Every payment we have received from you, with its receipt." />

  <div class="kz-wgrid">
    <Window
      title="Receipts"
      icon="receipt"
      span={cards.length ? 8 : 12}
      id="list"
      meta={payments.length ? String(payments.length) : undefined}
      flush={payments.length > 0}
    >
      {payments.length === 0 ? (
        <div class="kz-wnote">
          <p class="kz-wnote__code">no payments yet</p>
          <p>No payments yet. Receipts for what you pay appear here.</p>
        </div>
      ) : (
        <ul class="kz-wlist" aria-label="Payments">
          {payments.map((p) => (
            <li class="kz-fpay">
              <p class="kz-fpay__at">
                <time datetime={p.receivedAt}>{formatLongDate(p.receivedAt)}</time>
              </p>
              <div class="kz-fpay__main">
                <p class="kz-frow__title kz-wmono">{p.receiptNumber}</p>
                <p class="kz-wrow__meta">
                  {paymentMethodLabel(p.method)}
                  {p.invoices.length ? ' · for ' : ''}
                  {p.invoices.map((i, n) => (
                    <Fragment>
                      {n > 0 ? ', ' : ''}
                      <a class="kz-frow__ref" href={`/portal/invoices/${i.id}`}>
                        {i.number}
                      </a>
                    </Fragment>
                  ))}
                </p>
              </div>
              <div class="kz-fpay__end">
                <p class="kz-wrow__fig">{formatMoney(p.amountMinor, p.currency)}</p>
                <StatusPill tone={STATUS[p.status].tone}>{STATUS[p.status].label}</StatusPill>
              </div>
              <a class="kz-frow__dl kz-fpay__dl" href={`/api/v1/portal/payments/${p.id}/receipt`} download>
                <Icon name="download" size={16} />
                Receipt<span class="sr-only"> {p.receiptNumber}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </Window>

    {cards.length ? (
      <Window title="Saved cards" icon="wallet" span={4} id="cards" meta={String(cards.length)} flush>
        <p class="kz-fcards__intro">
          Cards you saved when paying. We keep only a secure token from our payment partner, never your card number.
        </p>
        <SavedCards client:load cards={cards} showClient={multiClient} />
      </Window>
    ) : null}
  </div>
</PortalLayout>
