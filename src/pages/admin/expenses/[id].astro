---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import DetailList from '../../../ui/admin/DetailList.astro';
import Button from '../../../ui/primitives/Button.astro';
import { ExpenseForm } from '../../../ui/admin/expenses/ExpenseForm';
import { VoidExpense } from '../../../ui/admin/expenses/VoidExpense';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { AppError } from '../../../server/lib/errors';
import { formOptions, getExpense } from '../../../server/modules/expenses';
import { EXPENSE_PAYMENT_METHODS } from '../../../shared/schemas/expenses';
import { formatMoney } from '../../../shared/money';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'expenses.view' });
if (page instanceof Response) return page;
let data;
try {
  data = await getExpense(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const e = data.expense;
const canEdit = page.auth.permissions.has('expenses.manage') && e.status === 'recorded';
const opts = canEdit ? await formOptions(ctx) : null;
if (opts && !opts.categories.some((c) => c.id === e.category_id))
  opts.categories.push({ id: e.category_id, name: `${e.category} (inactive)` });
if (opts && e.project_id && !opts.projects.some((p) => p.id === e.project_id))
  opts.projects.push({ id: e.project_id, label: `${e.project_reference} · ${e.project_name}` });
const method = EXPENSE_PAYMENT_METHODS.find((m) => m.value === e.payment_method)?.label;
---

<AdminLayout title={e.description} page={page}>
  <PageHead
    title={`${formatMoney(e.amount_minor, e.currency)} · ${e.description}`}
    crumbs={[{ label: 'Expenses', href: '/admin/expenses' }, { label: e.description }]}
    meta={`${formatLongDate(e.expense_date)} · ${e.category}${e.status === 'void' ? ' · void' : ''}${data.recordedBy ? ` · recorded by ${data.recordedBy}` : ''}`}
  >
    <div slot="actions" class="kz-aacts">
      <div class="kz-ahead__acts">
        {e.receipt_file_id ? (
          <Button variant="secondary" lead="view" href={`/api/v1/admin/files/${e.receipt_file_id}`}>
            View receipt
          </Button>
        ) : null}
        {canEdit ? <VoidExpense client:load id={e.id} /> : null}
      </div>
    </div>
  </PageHead>
  {e.status === 'void' ? (
    <div class="kz-anotices">
      <p role="status" class="kz-anotice">
        Voided: {e.void_reason}
      </p>
    </div>
  ) : null}
  {opts ? (
    <ExpenseForm
      client:load
      id={e.id}
      hasReceipt={!!e.receipt_file_id}
      initial={{
        categoryId: e.category_id,
        expenseDate: e.expense_date,
        vendor: e.vendor,
        description: e.description,
        amountMinor: e.amount_minor,
        currency: e.currency,
        paymentMethod: e.payment_method,
        reference: e.reference,
        projectId: e.project_id,
        clientId: e.client_id,
        notes: e.notes,
      }}
      {...opts}
    />
  ) : (
    <Pane title="Details" class="kz-anarrow">
      <DetailList
        rows
        items={[
          { label: 'Vendor', value: e.vendor },
          { label: 'Payment method', value: method },
          { label: 'Reference', value: e.reference, mono: true },
          { label: 'Project', value: e.project_reference ? `${e.project_reference} · ${e.project_name}` : null },
          { label: 'Client', value: e.client_name },
          { label: 'Notes', value: e.notes },
        ]}
      />
    </Pane>
  )}
</AdminLayout>
