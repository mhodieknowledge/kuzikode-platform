---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Views from '../../../ui/admin/Views.astro';
import Button from '../../../ui/primitives/Button.astro';
import SavedNotice from '../../../ui/admin/website/SavedNotice.astro';
import { AddonsManager } from '../../../ui/admin/packages/AddonsManager';
import { PackagesList } from '../../../ui/admin/packages/PackagesList';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { can } from '../../../server/lib/policies';
import { listPackagesAdmin } from '../../../server/modules/packages';
import { formatMoney } from '../../../shared/money';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'packages.manage' });
if (page instanceof Response) return page;
const [overview, { results }] = await Promise.all([
  listPackagesAdmin(ctx),
  ctx.db.prepare('SELECT code FROM currencies WHERE active = 1 ORDER BY is_default DESC, code').all<{ code: string }>(),
]);
const currencies = results.map((r) => r.code);
const priceLabel = (p: (typeof overview.packages)[number]) => {
  if (p.priceType === 'custom_quote' || p.priceMinor == null || !p.currency) return 'Custom quote';
  const amount = formatMoney(p.priceMinor, p.currency);
  const per = p.billingType === 'recurring' ? (p.interval === 'year' ? ' / year' : ' / month') : '';
  return `${p.priceType === 'starting_from' ? 'From ' : ''}${amount}${per}`;
};
const packages = overview.packages.map((p) => ({
  id: p.id,
  name: p.name,
  serviceName: p.serviceName,
  tab: p.tab,
  status: p.status,
  price: priceLabel(p),
  priceReviewRequired: p.priceReviewRequired,
  mostPopular: p.mostPopular,
}));
const reviewOnly = Astro.url.searchParams.get('review') === '1';
const saved = Astro.url.searchParams.get('saved') === '1';
---

<AdminLayout title="Packages & pricing" page={page}>
  <PageHead
    title="Packages & pricing"
    meta="Priced bundles shown on /pricing and the division pages, and offered in quotations."
  >
    <Fragment slot="actions">
      <Button href="/pricing" variant="secondary" target="_blank" rel="noopener" icon="external">
        View /pricing<span class="sr-only"> (opens in a new tab)</span>
      </Button>
      <Button href="/admin/packages/new" lead="add">
        New package
      </Button>
    </Fragment>
  </PageHead>
  {saved ? <SavedNotice>Saved. The website now shows your changes.</SavedNotice> : null}
  <p class="kz-anotice kz-anotice--info" data-testid="show-prices">
    <span>
      Public prices are <strong>{overview.showPrices ? 'shown' : 'hidden'}</strong>
      {overview.showPrices ? '.' : ' (visitors see "Request a quote").'}{' '}
      {can(ctx, 'settings.manage') ? <a href="/admin/settings">Change in Settings</a> : null}
    </span>
  </p>
  <div class="kz-atools">
    <Views
      label="Package view"
      current={reviewOnly ? 'review' : 'all'}
      items={[
        { key: 'all', label: 'All packages', href: '/admin/packages' },
        { key: 'review', label: 'Awaiting review', href: '/admin/packages?review=1', count: overview.reviewCount },
      ]}
    />
  </div>
  <div class="kz-astack">
    <PackagesList
      client:load
      packages={packages}
      canReview={can(ctx, 'packages.price_review')}
      reviewOnly={reviewOnly}
    />
    {reviewOnly ? null : (
      <AddonsManager
        client:visible
        addons={overview.addons.map((a) => ({
          id: a.id,
          packageId: a.packageId,
          packageName: a.packageName,
          name: a.name,
          description: a.description,
          priceMinor: a.priceMinor,
          currency: a.currency,
          unit: a.unit,
          billingType: a.billingType,
          active: a.active,
        }))}
        packages={overview.packages.map((p) => ({ id: p.id, name: p.name }))}
        currencies={currencies}
      />
    )}
  </div>
</AdminLayout>
