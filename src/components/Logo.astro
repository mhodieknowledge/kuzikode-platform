---
interface Props {
  variant?: 'dark' | 'light';
  href?: string | null;
  class?: string;
  height?: number;
}
const { variant = 'dark', href = '/', class: className = '', height = 28 } = Astro.props;
const src = variant === 'light' ? '/brand/logo-white.svg' : '/brand/logo.svg';
const width = Math.round((height * 174.39) / 32);
---

{href ? (
  <a href={href} class:list={['inline-flex items-center', className]} aria-label="Kuzikode Technologies, home">
    <img src={src} alt="" width={width} height={height} />
  </a>
) : (
  <img src={src} alt="Kuzikode Technologies" width={width} height={height} class={className} />
)}
