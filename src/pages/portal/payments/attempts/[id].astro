---
/**
 * Workspace payment attempt (R5.3): the live status of one online payment inside a window, the same AttemptResult as the public
 * return pages (polling in useAttemptStatus): the road strip while waiting, then the outcome, the receipt slip, the receipt
 * download and the way back to the invoice.
 */
import PortalLayout from '../../../../layouts/PortalLayout.astro';
import PageHead from '../../../../ui/workspace/PageHead.astro';
import Window from '../../../../ui/workspace/Window.astro';
import { AttemptResult } from '../../../../ui/public/checkout/AttemptResult';
import { loadPortalPage } from '../../../../server/lib/portal-page';
import { getPortalAttempt } from '../../../../server/modules/payments';
import { AppError } from '../../../../server/lib/errors';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request, { area: 'finance' });
if (page instanceof Response) return page;
let attempt;
try {
  attempt = await getPortalAttempt(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND') return new Response(null, { status: 404 });
  throw err;
}
---

<PortalLayout title="Payment status" page={page} active="payments">
  <PageHead title="Payment status" back={{ href: '/portal/payments', label: 'Payments' }} />
  <div class="kz-wgrid">
    <Window title="Online payment" icon="pay" span={7} id="attempt" meta={attempt.invoice.number}>
      <AttemptResult client:load initial={attempt} />
    </Window>
  </div>
</PortalLayout>
