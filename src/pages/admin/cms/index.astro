---
/** Website pages (R6.2): every editable page with its path, section count, last publish and unpublished-changes flag. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import CmsTabs from '../../../ui/admin/website/CmsTabs.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listPages } from '../../../server/modules/cms/admin';
import { pagePath } from '../../../shared/cms-fields';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'cms.manage' });
if (page instanceof Response) return page;
const pages = await listPages(ctx);
const when = (iso: string | null) =>
  iso
    ? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'Africa/Harare' }).format(new Date(iso))
    : 'never';
---

<AdminLayout title="Website pages" page={page}>
  <PageHead
    title="Website"
    meta="Edit a page's sections as drafts, preview them on the real page, then publish. Visitors only ever see published content."
  />
  <div class="kz-atools">
    <CmsTabs current="pages" />
  </div>
  <DataTable
    caption="Website pages"
    count={pages.length}
    columns={[
      { label: 'Page' },
      { label: 'Address' },
      { label: 'Sections', num: true },
      { label: 'Published' },
      { label: 'State' },
    ]}
  >
    {pages.map((p) => (
      <tr>
        <Cell
          m="main"
          href={`/admin/cms/pages/${p.key}`}
          title={p.title}
          sub={`${pagePath(p.key)} · ${p.sections} ${p.sections === 1 ? 'section' : 'sections'}`}
        />
        <Cell tone="mute">
          <span class="kz-amono">{pagePath(p.key)}</span>
        </Cell>
        <Cell num>{p.sections}</Cell>
        <Cell m="meta" tone="mute">
          published {when(p.published_at)}
        </Cell>
        <Cell m="status">{p.has_changes ? <StatusPill tone="warn">Unpublished changes</StatusPill> : null}</Cell>
      </tr>
    ))}
  </DataTable>
</AdminLayout>
