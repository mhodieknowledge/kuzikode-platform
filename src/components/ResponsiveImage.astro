---
/**
 * Renders a committed site image (design/images/manifest.json) as <picture> with AVIF/WebP/JPEG srcsets.
 * Lazy by default; pass priority for the LCP hero (eager + fetchpriority=high). Alt text comes from the manifest
 * unless overridden; decorative images pass alt="".
 */
import manifest from '../../design/images/manifest.json';

interface Props {
  id: string;
  sizes?: string;
  priority?: boolean;
  alt?: string;
  class?: string;
}
const { id, sizes = '100vw', priority = false, alt, class: className } = Astro.props;
const entry = (
  manifest as {
    images: Record<string, { alt: string; width: number; height: number; widths: number[]; placeholder: string }>;
  }
).images[id];
if (!entry) throw new Error(`Unknown site image "${id}"`);
const set = (ext: string) => entry.widths.map((w) => `/images/site/${id}-${w}.${ext} ${w}w`).join(', ');
const fallback = `/images/site/${id}-${entry.widths.at(-1)}.jpg`;
---

<picture>
  <source type="image/avif" srcset={set('avif')} sizes={sizes} />
  <source type="image/webp" srcset={set('webp')} sizes={sizes} />
  <img
    src={fallback}
    srcset={set('jpg')}
    sizes={sizes}
    alt={alt ?? entry.alt}
    width={entry.width}
    height={entry.height}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    class={className}
    style={`background-image:url(${entry.placeholder});background-size:cover`}
  />
</picture>
