---
/**
 * Workspace project (R5.2, PANEL_DESIGN_SPEC §2). From 1024 px: master/detail, the projects list in the left 4 columns (this
 * project marked current) and the project in the right 8: Progress + Deliverables side by side, then the milestone track, the
 * updates log (mono timestamps) and the message thread + composer. Below 1024 px the list is left out and "Projects" goes back.
 */
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PageHead from '../../../ui/workspace/PageHead.astro';
import Window from '../../../ui/workspace/Window.astro';
import Progress from '../../../ui/workspace/Progress.astro';
import ProjectList from '../../../ui/workspace/projects/ProjectList.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import Icon from '../../../ui/icons/Icon.astro';
import { MessageComposer } from '../../../ui/workspace/projects/MessageComposer';
import { loadPortalPage } from '../../../server/lib/portal-page';
import { getPortalProject, listPortalProjects } from '../../../server/modules/projects';
import { AppError } from '../../../server/lib/errors';
import { MILESTONE_STATUS_LABEL, PROJECT_STATUS_LABEL } from '../../../shared/projects';
import { formatLongDate } from '../../../shared/service-display';
import { harareDateTime } from '../../../shared/devices';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request, { area: 'projects' });
if (page instanceof Response) return page;
let data;
try {
  data = await getPortalProject(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND') return new Response(null, { status: 404 });
  throw err;
}
const projects = await listPortalProjects(ctx);
const p = data.project;
const size = (b: number) =>
  b >= 1_048_576 ? `${(b / 1_048_576).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`;
const PROJECT_TONE = {
  planning: 'neutral',
  active: 'lit',
  on_hold: 'warn',
  completed: 'ok',
  cancelled: 'neutral',
} as const;
const done = data.milestones.filter((m) => m.status === 'completed').length;
const counted = data.milestones.filter((m) => m.status !== 'cancelled').length;
const milestoneWhen = (m: (typeof data.milestones)[number]) =>
  m.status === 'completed' && m.completedAt
    ? `done ${formatLongDate(m.completedAt)}`
    : m.dueDate
      ? `due ${formatLongDate(m.dueDate)}`
      : null;
---

<PortalLayout title={p.name} page={page} active="projects">
  <PageHead title={p.name} back={{ href: '/portal/projects', label: 'Projects' }}>
    <p slot="meta" class="kz-wshead__tags">
      <span class="kz-wmono">{p.reference}</span>
      <StatusPill tone={PROJECT_TONE[p.status]}>{PROJECT_STATUS_LABEL[p.status]}</StatusPill>
    </p>
  </PageHead>

  <div class="kz-pview">
    <ProjectList
      projects={projects}
      multiClient={page.clients.length > 1}
      current={p.id}
      class="kz-pview__list is-side"
    />

    <div class="kz-pview__main">
      <div class="kz-pdetail__top">
        <Window
          title="Progress"
          icon="gauge"
          id="progress"
          meta={counted ? `${done}/${counted} milestones` : undefined}
        >
          <p class="kz-psum__fig">
            {p.progressPct}
            <span>%</span>
          </p>
          <Progress label={`${p.name} progress`} pct={p.progressPct} size="lg" />
          <dl class="kz-psum__dates">
            {p.startDate ? (
              <div>
                <dt>Started</dt>
                <dd>{formatLongDate(p.startDate)}</dd>
              </div>
            ) : null}
            {p.completedAt ? (
              <div>
                <dt>Completed</dt>
                <dd>{formatLongDate(p.completedAt)}</dd>
              </div>
            ) : p.targetDate ? (
              <div>
                <dt>Target</dt>
                <dd>{formatLongDate(p.targetDate)}</dd>
              </div>
            ) : null}
          </dl>
        </Window>

        <Window
          title="Deliverables"
          icon="download"
          id="files"
          meta={data.deliverables.length ? String(data.deliverables.length) : undefined}
          flush={data.deliverables.length > 0}
        >
          {data.deliverables.length === 0 ? (
            <div class="kz-wnote">
              <p class="kz-wnote__code">no files shared yet</p>
              <p>Files the team shares with you appear here.</p>
            </div>
          ) : (
            <ul class="kz-wlist" aria-label="Deliverables">
              {data.deliverables.map((f) => (
                <li class="kz-dfile">
                  <span class="kz-dfile__icon" aria-hidden="true">
                    <Icon name="download" size={16} />
                  </span>
                  <div class="kz-dfile__main">
                    <a class="kz-dfile__name" href={`/api/v1/portal/files/${f.fileId}`} download>
                      {f.label}
                    </a>
                    <p class="kz-dfile__meta">
                      {f.name} · {size(f.size)} · {formatLongDate(f.createdAt)}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </Window>
      </div>

      {data.milestones.length ? (
        <Window title="Milestones" icon="list-checks" id="milestones">
          <ol class="kz-mtrack" aria-label="Milestones">
            {data.milestones.map((m, i) => (
              <li class:list={['kz-mtrack__stop', `is-${m.status}`]}>
                <span class="kz-mtrack__node" aria-hidden="true">
                  {m.status === 'completed' ? <Icon name="check" size={16} /> : <span>{i + 1}</span>}
                </span>
                <div class="kz-mtrack__body">
                  <p class="kz-mtrack__title">{m.title}</p>
                  <p class="kz-mtrack__due">
                    <span class="kz-mtrack__state">{MILESTONE_STATUS_LABEL[m.status]}</span>
                    {milestoneWhen(m) ? ` · ${milestoneWhen(m)}` : ''}
                  </p>
                  {m.description ? <p class="kz-mtrack__desc">{m.description}</p> : null}
                </div>
              </li>
            ))}
          </ol>
        </Window>
      ) : null}

      <Window
        title="Updates"
        icon="activity"
        id="updates"
        meta={data.updates.length ? String(data.updates.length) : undefined}
      >
        {data.updates.length === 0 ? (
          <div class="kz-wnote">
            <p class="kz-wnote__code">no updates yet</p>
            <p>The team posts progress notes here.</p>
          </div>
        ) : (
          <ol class="kz-log" data-testid="project-updates">
            {data.updates.map((u) => (
              <li class="kz-log__item">
                <p class="kz-log__head">
                  <time datetime={u.createdAt}>{harareDateTime(u.createdAt)}</time>
                  <span>{u.author}</span>
                </p>
                <p class="kz-log__body">{u.body}</p>
              </li>
            ))}
          </ol>
        )}
      </Window>

      <Window title="Messages" icon="send" id="messages">
        {data.messages.length ? (
          <ol class="kz-thread" data-testid="project-messages">
            {data.messages.map((m) => (
              <li class:list={['kz-msg', m.mine ? 'is-mine' : m.fromTeam ? 'is-team' : 'is-other']}>
                <p class="kz-msg__who">
                  {m.mine ? 'You' : m.fromTeam ? `${m.author} · Kuzikode` : m.author}
                  <time datetime={m.createdAt}>{harareDateTime(m.createdAt)}</time>
                </p>
                <p class="kz-msg__body">{m.body}</p>
              </li>
            ))}
          </ol>
        ) : null}
        <div class:list={['kz-compose-wrap', data.messages.length > 0 && 'is-after']}>
          <MessageComposer client:visible projectId={p.id} />
        </div>
      </Window>
    </div>
  </div>
</PortalLayout>
