---
/**
 * Payments (R6.2): views (all / unmatched / gateways), received strip, filters (sheet on phones), dense table → list rows
 * (receipt, client, amount + status). Unmatched gateway notifications keep their own list.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import Views from '../../../ui/admin/Views.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Pager from '../../../ui/admin/Pager.astro';
import KpiStrip, { type Kpi } from '../../../ui/admin/KpiStrip.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import { FilterBar } from '../../../ui/admin/FilterBar';
import { PAYMENT_METHOD, PAYMENT_PROVIDER, PAYMENT_STATUS } from '../../../ui/admin/finance/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { isSuperAdmin } from '../../../server/lib/policies';
import { listPayments, listUnmatched } from '../../../server/modules/payments';
import { paymentListQuery, PAYMENT_STATUSES } from '../../../shared/schemas/payments';
import { formatMoney } from '../../../shared/money';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'payments.view' });
if (page instanceof Response) return page;
const params = new URLSearchParams(Astro.url.searchParams);
const unmatchedView = params.get('view') === 'unmatched';
params.delete('view');
const parsed = paymentListQuery.safeParse(Object.fromEntries(params));
const filter = parsed.success ? parsed.data : paymentListQuery.parse({});
const result = unmatchedView ? null : await listPayments(ctx, filter);
const unmatched = await listUnmatched(ctx, unmatchedView ? filter.page : 1);
const currencies = (
  await ctx.db
    .prepare('SELECT code FROM currencies WHERE active = 1 ORDER BY is_default DESC, code')
    .all<{ code: string }>()
).results;
const pages = unmatchedView ? unmatched.pages : result!.pages;
const current = unmatchedView ? unmatched.page : result!.page;
const pageHref = (n: number) => {
  const q = new URLSearchParams(Astro.url.searchParams);
  q.set('page', String(n));
  return `/admin/payments?${q.toString()}`;
};
const filtered = parsed.success && Object.keys(Object.fromEntries(params)).length > 0;
const tiles: Kpi[] =
  result && result.totals.length
    ? [
        { label: 'Received', values: result.totals.map((t) => formatMoney(t.received, t.currency)) },
        ...(result.totals.some((t) => t.refunded > 0)
          ? [
              {
                label: 'Refunded',
                values: result.totals.filter((t) => t.refunded > 0).map((t) => formatMoney(t.refunded, t.currency)),
              },
            ]
          : []),
      ]
    : [];
const views = [
  { key: 'all', label: 'All payments', href: '/admin/payments' },
  { key: 'unmatched', label: 'Unmatched', href: '/admin/payments?view=unmatched', count: unmatched.total || undefined },
  ...(isSuperAdmin(ctx) ? [{ key: 'gateways', label: 'Gateways', href: '/admin/payments/gateways' }] : []),
];
---

<AdminLayout title="Payments" page={page}>
  <PageHead title="Payments" meta="Money received, by receipt." />
  <div class="kz-atools">
    <Views label="Payment views" items={views} current={unmatchedView ? 'unmatched' : 'all'} />
  </div>
  {unmatchedView ? (
    <Pane title="Unmatched gateway notifications" flush>
      <p class="kz-apad kz-afeed__t">
        Notifications from a payment gateway that did not match any payment started here. Check the reference in the
        gateway&apos;s merchant dashboard; if the client really paid, record the payment on the right invoice. Entries
        stay here for the record.
      </p>
      {unmatched.items.length === 0 ? (
        <p class="kz-anone">
          <span class="kz-anone__code">0 unmatched</span>Nothing unmatched.
        </p>
      ) : (
        <ul class="kz-alist" role="list">
          {unmatched.items.map((e) => (
            <li>
              <div class="kz-alist__main">
                <span class="kz-alist__t">
                  {PAYMENT_PROVIDER[e.provider_key] ?? e.provider_key}
                  {e.account ? ` · ${e.account}` : ''} ·{' '}
                  <span class="kz-amono">{e.provider_reference ?? 'no reference'}</span>
                </span>
                <span class="kz-alist__m">{formatLongDate(e.received_at)}</span>
                {e.payload_redacted ? <pre class="kz-apre">{e.payload_redacted}</pre> : null}
              </div>
            </li>
          ))}
        </ul>
      )}
    </Pane>
  ) : (
    <>
      {tiles.length ? <KpiStrip items={tiles} testId="payment-kpis" /> : null}
      <div class="kz-atools kz-agap">
        <FilterBar
          client:load
          label="Filter payments"
          hidden={filter.clientId ? { clientId: filter.clientId } : {}}
          clearHref="/admin/payments"
          fields={[
            {
              kind: 'search',
              name: 'q',
              label: 'Search',
              value: filter.q ?? '',
              placeholder: 'Receipt, invoice, reference or client',
            },
            {
              kind: 'select',
              name: 'status',
              label: 'Status',
              value: filter.status ?? '',
              options: [
                { value: '', label: 'Any' },
                ...PAYMENT_STATUSES.map((s) => ({ value: s, label: PAYMENT_STATUS[s]!.label })),
              ],
            },
            {
              kind: 'select',
              name: 'provider',
              label: 'Provider',
              value: filter.provider ?? '',
              options: [
                { value: '', label: 'Any' },
                ...Object.entries(PAYMENT_PROVIDER).map(([value, label]) => ({ value, label })),
              ],
            },
            {
              kind: 'select',
              name: 'method',
              label: 'Method',
              value: filter.method ?? '',
              options: [
                { value: '', label: 'Any' },
                ...Object.entries(PAYMENT_METHOD).map(([value, label]) => ({ value, label })),
              ],
            },
            {
              kind: 'select',
              name: 'currency',
              label: 'Currency',
              value: filter.currency ?? '',
              options: [{ value: '', label: 'Any' }, ...currencies.map((c) => ({ value: c.code, label: c.code }))],
            },
            { kind: 'date', name: 'from', label: 'From', value: filter.from ?? '' },
            { kind: 'date', name: 'to', label: 'To', value: filter.to ?? '' },
          ]}
        />
      </div>
      <DataTable
        caption="Payments"
        count={result!.items.length}
        columns={[
          { label: 'Receipt' },
          { label: 'Client' },
          { label: 'Invoices' },
          { label: 'Method' },
          { label: 'Status' },
          { label: 'Amount', num: true },
        ]}
      >
        <EmptyState
          slot="empty"
          code={filtered ? 'no matches' : '0 payments'}
          title={filtered ? 'No payments match these filters.' : 'No payments yet.'}
        >
          Payments recorded on invoices appear here.
        </EmptyState>
        {result!.items.map((p) => (
          <tr>
            <Cell
              m="main"
              class="kz-dt__nowrap"
              href={`/admin/payments/${p.id}`}
              title={p.receipt_number}
              sub={formatLongDate(p.received_at)}
            />
            <Cell m="meta" tone="mute">
              <span>{p.client_name}</span>
            </Cell>
            <Cell>
              <span class="kz-amono">{p.invoices ?? '—'}</span>
            </Cell>
            <Cell>
              <span class="kz-dt__strong kz-dt__nw">{PAYMENT_METHOD[p.method] ?? p.method}</span>
              <span class="kz-dt__sub is-text">{PAYMENT_PROVIDER[p.provider_key] ?? p.provider_key}</span>
              {p.provider_reference || p.reference ? (
                <span class="kz-dt__sub kz-dt__ref" title="Gateway or bank reference">
                  {p.provider_reference ?? p.reference}
                </span>
              ) : null}
            </Cell>
            <Cell m="status">
              <StatusPill tone={PAYMENT_STATUS[p.status]?.tone ?? 'neutral'}>
                {PAYMENT_STATUS[p.status]?.label ?? p.status}
              </StatusPill>
            </Cell>
            <Cell m="amount" num>
              {formatMoney(p.amount_minor, p.currency)}
            </Cell>
          </tr>
        ))}
      </DataTable>
    </>
  )}
  <Pager page={current} pages={pages} href={pageHref} />
</AdminLayout>
