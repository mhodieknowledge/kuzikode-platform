---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { PageMetaForm, PublishBar, SectionEditor } from '../../../../components/admin/CmsAdmin';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { AppError } from '../../../../server/lib/errors';
import { getPageAdmin, listMedia } from '../../../../server/modules/cms/admin';
import { pagePath, SECTION_FIELDS, SECTION_TYPE_LABEL } from '../../../../shared/cms-fields';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'cms.manage' });
if (page instanceof Response) return page;
let data;
try {
  data = await getPageAdmin(ctx, Astro.params.key ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const { page: p, sections } = data;
const media = (await listMedia(ctx)).map((m) => ({ id: m.id, file_id: m.file_id, alt_text: m.alt_text }));
const path = pagePath(p.key);
---

<AdminLayout title={`Edit ${p.title}`} page={page}>
  <nav aria-label="Breadcrumb" class="text-[13px] text-ink-600">
    <a href="/admin/cms" class="hover:text-ink-950 hover:underline">
      Website
    </a>{' '}
    / <span class="text-ink-950">{p.title}</span>
  </nav>
  <div class="mt-2 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-display">{p.title}</h1>
      <p class="mt-1 text-sm text-ink-600">
        <span class="font-mono">{path}</span> · {sections.filter((s) => s.changed).length} sections with unpublished
        changes
      </p>
    </div>
    <PublishBar client:load pageKey={p.key} previewHref={`${path}?preview=1`} liveHref={path} />
  </div>
  <div class="mt-6 grid gap-6 xl:grid-cols-[1fr_340px]">
    <div class="flex flex-col gap-6">
      {sections.length === 0 ? <p class="text-sm text-ink-600">This page has no editable sections.</p> : null}
      {sections.map((s, i) => (
        <SectionEditor
          client:load
          pageKey={p.key}
          sectionKey={s.key}
          typeLabel={SECTION_TYPE_LABEL[s.type] ?? s.type}
          fields={SECTION_FIELDS[s.type] ?? []}
          draft={s.draft}
          visible={s.visible}
          changed={s.changed}
          first={i === 0}
          last={i === sections.length - 1}
        />
      ))}
    </div>
    <aside>
      <section class="rounded-lg border border-line bg-surface p-5" aria-labelledby="meta-h">
        <h2 id="meta-h" class="mb-3 font-sans text-base font-semibold">
          Page details and search
        </h2>
        <PageMetaForm
          client:load
          pageKey={p.key}
          initial={{
            title: p.title,
            seoTitle: p.seo_title,
            seoDescription: p.seo_description,
            ogImageId: p.og_image_id,
          }}
          media={media}
        />
      </section>
    </aside>
  </div>
</AdminLayout>
