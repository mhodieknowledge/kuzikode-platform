---
/**
 * Workspace services (R5.3, PANEL_DESIGN_SPEC §2 "Services": cards-as-windows). One window per subscription: the plan name as
 * title with its state pill in the title bar, the price in mono with the cycle, the next bill, the automatic-payment consent and
 * the cancellation request at the foot. One compact window per domain/hosting/account (renewal date as mono title-bar meta), or
 * one list window when there are more than four. No billing-period bar: the period start is not part of the data.
 */
import PortalLayout from '../../layouts/PortalLayout.astro';
import PageHead from '../../ui/workspace/PageHead.astro';
import Window from '../../ui/workspace/Window.astro';
import StatusPill from '../../ui/primitives/StatusPill.astro';
import { CancellationRequest } from '../../ui/workspace/support/CancellationRequest';
import { AutoCharge } from '../../ui/workspace/finance/AutoCharge';
import { loadPortalPage } from '../../server/lib/portal-page';
import { listPortalServices } from '../../server/modules/subscriptions/portal';
import { portalAutoChargeOptions } from '../../server/modules/payments';
import { formatMoney } from '../../shared/money';
import { formatLongDate } from '../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request, { area: 'finance' });
if (page instanceof Response) return page;
const groups = await listPortalServices(ctx);
const multiClient = groups.length > 1;
const autoCharge = await portalAutoChargeOptions(
  ctx,
  groups.flatMap((g) => g.subscriptions.map((s) => s.id)),
);
const empty = groups.every((g) => g.subscriptions.length === 0 && g.assets.length === 0);
const level = 'h3';
const GroupLabel = multiClient ? 'p' : 'h2';
---

<PortalLayout title="Your services" page={page} active="services">
  <PageHead
    title="Your services"
    sub="Ongoing services you have with Kuzikode, and the domains and hosting we look after for you."
  />
  {empty ? (
    <div class="kz-wgrid">
      <Window title="Services" icon="services" span={8} id="none">
        <div class="kz-wnote">
          <p class="kz-wnote__code">no services yet</p>
          <p>You have no ongoing services with us at the moment.</p>
        </div>
      </Window>
    </div>
  ) : (
    groups.map((g, gi) => (
      <section class="kz-fsvc" aria-label={multiClient ? g.client.name : undefined}>
        {multiClient ? <h2 class="kz-fsvc__client">{g.client.name}</h2> : null}

        {g.subscriptions.length ? (
          <div class="kz-fsvc__main">
            <GroupLabel class="kz-fsvc__label">Subscriptions</GroupLabel>
            <div class="kz-wgrid" data-testid="subscriptions">
              {g.subscriptions.map((s, si) => (
                <Window title={s.description} icon="subscriptions" level={level} span={12} id={`sub-${gi}-${si}`}>
                  <StatusPill slot="actions" tone={s.paused ? 'warn' : 'lit'}>
                    {s.paused ? 'Paused' : 'Active'}
                  </StatusPill>
                  <p class="kz-fsvc__price">
                    <span class="kz-fsvc__fig">{formatMoney(s.amountMinor, s.currency)}</span>
                    <span> per {s.interval}</span>
                    {s.quantity !== '1' ? <span>{` · quantity ${s.quantity}`}</span> : null}
                  </p>
                  <dl class="kz-fsum__facts kz-fsvc__facts">
                    <div>
                      <dt>Next bill</dt>
                      <dd class="kz-wmono">
                        {s.paused ? 'Paused' : s.nextBillingDate ? formatLongDate(s.nextBillingDate) : '—'}
                      </dd>
                    </div>
                    <div>
                      <dt>Billing cycle</dt>
                      <dd>
                        {s.interval === 'year' ? 'Yearly' : s.interval === 'month' ? 'Monthly' : `Every ${s.interval}`}
                      </dd>
                    </div>
                  </dl>
                  {autoCharge[s.id]?.cards.length ? (
                    <div class="kz-fsvc__auto">
                      <AutoCharge
                        client:visible
                        subscriptionId={s.id}
                        description={s.description}
                        cards={autoCharge[s.id]!.cards}
                        current={autoCharge[s.id]!.current}
                      />
                    </div>
                  ) : null}
                  <div class="kz-fsub__acts">
                    {s.cancellationRequested ? (
                      <p class="kz-fsub__req">
                        Cancellation requested. <a href="/portal/support?show=open">See your requests</a>
                      </p>
                    ) : (
                      <CancellationRequest client:visible subscriptionId={s.id} description={s.description} />
                    )}
                  </div>
                </Window>
              ))}
            </div>
          </div>
        ) : null}
        <div class="kz-fsvc__side">
          {g.assets.length ? (
            <Fragment>
              <GroupLabel class="kz-fsvc__label">Domains, hosting and accounts</GroupLabel>
              {g.assets.length > 4 ? (
                <div class="kz-wgrid">
                  <Window
                    title="Domains, hosting and accounts"
                    icon="managed-services"
                    level={level}
                    id={`assets-${gi}`}
                    meta={String(g.assets.length)}
                    flush
                    data-testid="assets"
                  >
                    <ul class="kz-wlist">
                      {g.assets.map((a) => (
                        <li class="kz-wrow">
                          <div class="kz-wrow__main">
                            <p class="kz-wrow__title">{a.name}</p>
                            <p class="kz-wrow__meta">
                              {a.typeLabel}
                              {a.provider ? ` · ${a.provider}` : ''}
                            </p>
                          </div>
                          <p class="kz-fasset__when">
                            {a.renewalDate ? (
                              <Fragment>
                                <span>{a.autoRenew ? 'Renews' : 'Expires'}</span>
                                <span class="kz-wmono">{formatLongDate(a.renewalDate)}</span>
                              </Fragment>
                            ) : (
                              'No renewal date'
                            )}
                          </p>
                        </li>
                      ))}
                    </ul>
                  </Window>
                </div>
              ) : (
                <div class="kz-wgrid" data-testid="assets">
                  {g.assets.map((a, ai) => (
                    <Window
                      title={a.name}
                      icon="managed-services"
                      level={level}
                      span={12}
                      id={`asset-${gi}-${ai}`}
                      meta={a.renewalDate ? formatLongDate(a.renewalDate) : undefined}
                    >
                      <p class="kz-fasset__type">
                        {a.typeLabel}
                        {a.provider ? ` · ${a.provider}` : ''}
                      </p>
                      <p class="kz-fasset__renew">
                        {a.renewalDate
                          ? `${a.autoRenew ? 'Renews' : 'Expires'} ${formatLongDate(a.renewalDate)}`
                          : 'No renewal date'}
                      </p>
                    </Window>
                  ))}
                </div>
              )}
            </Fragment>
          ) : null}
          {gi === groups.length - 1 ? (
            <Window title="Need a change?" icon="support" level={level} id="svc-help">
              <p class="kz-fsvc__help">
                Questions about a service, a renewal or a new domain? <a href="/portal/support/new">Ask our team</a>.
              </p>
            </Window>
          ) : null}
        </div>
      </section>
    ))
  )}
  {empty ? (
    <p class="kz-wsfoot">
      Questions about a service? <a href="/portal/support/new">Ask our team</a>.
    </p>
  ) : null}
</PortalLayout>
