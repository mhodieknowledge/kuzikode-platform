---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { EXPENSE_DISCLAIMER, listCategories, listExpenses } from '../../../server/modules/expenses';
import { expenseListQuery } from '../../../shared/schemas/expenses';
import { formatMoney } from '../../../shared/money';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'expenses.view' });
if (page instanceof Response) return page;
const parsed = expenseListQuery.safeParse(Object.fromEntries(Astro.url.searchParams));
const filter = parsed.success ? parsed.data : expenseListQuery.parse({});
const [result, categories] = await Promise.all([listExpenses(ctx, filter), listCategories(ctx)]);
const currencies = (
  await ctx.db
    .prepare('SELECT code FROM currencies WHERE active = 1 ORDER BY is_default DESC, code')
    .all<{ code: string }>()
).results;
const canManage = page.auth.permissions.has('expenses.manage');
const field = 'h-10 rounded-sm border border-line bg-surface px-3 text-sm text-ink-950';
const exportQuery = new URLSearchParams(Astro.url.searchParams);
exportQuery.delete('page');
const pageHref = (n: number) => {
  const q = new URLSearchParams(Astro.url.searchParams);
  q.set('page', String(n));
  return `/admin/expenses?${q.toString()}`;
};
const filtered = [...new URLSearchParams(Astro.url.searchParams).keys()].some((k) => k !== 'page');
const link =
  'inline-flex h-10 items-center rounded-sm border border-line bg-surface px-4 text-sm font-semibold text-ink-950 hover:border-ink-400';
---

<AdminLayout title="Expenses" page={page}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold tracking-display">Expenses</h1>
      <p class="mt-1 text-sm text-ink-600">{EXPENSE_DISCLAIMER}</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/admin/expenses/report" class={link}>
        Report
      </a>
      <a href="/admin/expenses/categories" class={link}>
        Categories
      </a>
      <a href={`/api/v1/admin/expenses/export.csv?${exportQuery.toString()}`} download class={link}>
        Export CSV
      </a>
      {canManage ? (
        <a
          href="/admin/expenses/new"
          class="inline-flex h-10 items-center rounded-sm bg-brand-600 px-4 text-sm font-semibold text-white hover:bg-brand-500"
        >
          Record expense
        </a>
      ) : null}
    </div>
  </div>
  {result.totals.length ? (
    <dl class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {result.totals.map((t) => (
        <div class="rounded-lg border border-line bg-surface p-4">
          <dt class="text-[13px] font-semibold text-ink-600">Total ({t.currency})</dt>
          <dd class="tnum mt-1 text-xl font-bold text-ink-950">{formatMoney(t.total, t.currency)}</dd>
          <dd class="text-[13px] text-ink-600">
            {t.n} {t.n === 1 ? 'expense' : 'expenses'}
          </dd>
        </div>
      ))}
    </dl>
  ) : null}
  <form method="get" class="mt-6 flex flex-wrap items-end gap-3" aria-label="Filter expenses">
    <label class="flex flex-col gap-1 text-sm font-medium text-ink-950">
      Search
      <input
        name="q"
        type="search"
        value={filter.q ?? ''}
        maxlength="80"
        class={field}
        placeholder="Description, vendor or reference"
      />
    </label>
    <label class="flex flex-col gap-1 text-sm font-medium text-ink-950">
      Category
      <select name="categoryId" class={field}>
        <option value="">Any</option>
        {categories.map((c) => (
          <option value={c.id} selected={filter.categoryId === c.id}>
            {c.name}
          </option>
        ))}
      </select>
    </label>
    <label class="flex flex-col gap-1 text-sm font-medium text-ink-950">
      Currency
      <select name="currency" class={field}>
        <option value="">Any</option>
        {currencies.map((c) => (
          <option value={c.code} selected={filter.currency === c.code}>
            {c.code}
          </option>
        ))}
      </select>
    </label>
    <label class="flex flex-col gap-1 text-sm font-medium text-ink-950">
      Status
      <select name="status" class={field}>
        <option value="recorded" selected={!filter.status || filter.status === 'recorded'}>
          Recorded
        </option>
        <option value="void" selected={filter.status === 'void'}>
          Void
        </option>
        <option value="all" selected={filter.status === 'all'}>
          All
        </option>
      </select>
    </label>
    <label class="flex flex-col gap-1 text-sm font-medium text-ink-950">
      From
      <input name="from" type="date" value={filter.from ?? ''} class={field} />
    </label>
    <label class="flex flex-col gap-1 text-sm font-medium text-ink-950">
      To
      <input name="to" type="date" value={filter.to ?? ''} class={field} />
    </label>
    <button
      type="submit"
      class="h-10 rounded-sm border border-line bg-surface px-4 text-sm font-semibold text-ink-950 hover:border-ink-400"
    >
      Filter
    </button>
  </form>
  <div class="mt-6 overflow-x-auto rounded-lg border border-line bg-surface">
    <table class="w-full min-w-[640px] text-left text-sm">
      <caption class="sr-only">Expenses</caption>
      <thead class="bg-canvas text-[13px] text-ink-600">
        <tr>
          <th scope="col" class="px-4 py-3 font-semibold">
            Date
          </th>
          <th scope="col" class="px-4 py-3 font-semibold">
            Description
          </th>
          <th scope="col" class="px-4 py-3 font-semibold">
            Category
          </th>
          <th scope="col" class="px-4 py-3 font-semibold">
            Project / client
          </th>
          <th scope="col" class="px-4 py-3 text-right font-semibold">
            Amount
          </th>
        </tr>
      </thead>
      <tbody>
        {result.items.length === 0 ? (
          <tr>
            <td colspan="5" class="px-4 py-10 text-center text-ink-600">
              {filtered ? 'No expenses match these filters.' : 'No expenses recorded yet.'}
            </td>
          </tr>
        ) : (
          result.items.map((e) => (
            <tr class="border-t border-line">
              <td class="px-4 py-3 whitespace-nowrap text-ink-800">{formatLongDate(e.expense_date)}</td>
              <td class="px-4 py-3">
                <a
                  href={`/admin/expenses/${e.id}`}
                  class={`font-semibold text-ink-950 hover:underline ${e.status === 'void' ? 'line-through' : ''}`}
                >
                  {e.description}
                </a>
                <span class="block text-[12px] text-ink-600">
                  {e.vendor ?? 'No vendor'}
                  {e.receipt_file_id ? ' · receipt attached' : ''}
                  {e.status === 'void' ? ' · void' : ''}
                </span>
              </td>
              <td class="px-4 py-3 text-ink-800">{e.category}</td>
              <td class="px-4 py-3 text-ink-800">{e.project_reference ?? e.client_name ?? '—'}</td>
              <td class="tnum px-4 py-3 text-right font-medium text-ink-950">
                {formatMoney(e.amount_minor, e.currency)}
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>
  {result.pages > 1 ? (
    <nav aria-label="Pagination" class="mt-4 flex items-center justify-between text-sm font-semibold">
      {result.page > 1 ? (
        <a href={pageHref(result.page - 1)} rel="prev" class="text-brand-600">
          Previous
        </a>
      ) : (
        <span />
      )}
      <span class="text-ink-600">
        Page {result.page} of {result.pages}
      </span>
      {result.page < result.pages ? (
        <a href={pageHref(result.page + 1)} rel="next" class="text-brand-600">
          Next
        </a>
      ) : (
        <span />
      )}
    </nav>
  ) : null}
</AdminLayout>
