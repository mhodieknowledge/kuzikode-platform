---
/** Notifications (R6.2 group 3): all / unread view switch, rows with a gold unread mark and mono times, mark-as-read actions. */
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHead from '../../ui/admin/PageHead.astro';
import Pane from '../../ui/admin/Pane.astro';
import Views from '../../ui/admin/Views.astro';
import { MarkAllReadButton, MarkReadButton } from '../../ui/admin/account/AccountActions';
import { loadAdminPage } from '../../server/lib/admin-page';
import { listNotifications } from '../../server/modules/notifications';
import { notificationLabel } from '../../shared/notifications';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request);
if (page instanceof Response) return page;
const unreadOnly = Astro.url.searchParams.get('filter') === 'unread';
const { items, unread } = await listNotifications(ctx, page.auth.user.id, { limit: 100, unreadOnly });
const fmt = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Africa/Harare' }).format(
    new Date(iso),
  );
---

<AdminLayout title="Notifications" page={page}>
  <PageHead title="Notifications">
    <Fragment slot="meta">
      {unread} unread · showing the latest {items.length} · <a href="/admin/account/notifications">Preferences</a>
    </Fragment>
    <Fragment slot="actions">{unread > 0 ? <MarkAllReadButton client:load /> : null}</Fragment>
  </PageHead>
  <div class="kz-atools">
    <Views
      label="Filter notifications"
      current={unreadOnly ? 'unread' : 'all'}
      items={[
        { key: 'all', label: 'All', href: '/admin/notifications' },
        { key: 'unread', label: `Unread (${unread})`, href: '/admin/notifications?filter=unread' },
      ]}
    />
  </div>
  <Pane title={unreadOnly ? 'Unread' : 'Latest'} id="notes-h" flush meta={String(items.length)}>
    {items.length === 0 ? (
      <p class="kz-anone">
        <span class="kz-anone__code">0 notifications</span>
        {unreadOnly ? 'You have read everything.' : 'You have no notifications yet.'}
      </p>
    ) : (
      <ul class="kz-anrows" role="list">
        {items.map((n) => (
          <li class:list={['kz-anrow', !n.readAt && 'is-unread']} data-notification={n.id}>
            <span class="kz-anrow__dot" aria-hidden="true" />
            <div class="kz-anrow__main">
              <span class="kz-anrow__k">{notificationLabel(n.type)}</span>
              {n.link ? (
                <a href={n.link} class="kz-anrow__t">
                  {n.title}
                </a>
              ) : (
                <span class="kz-anrow__t">{n.title}</span>
              )}
              {n.readAt ? null : <span class="sr-only"> (unread)</span>}
              {n.body ? <span class="kz-anrow__b">{n.body}</span> : null}
              <span class="kz-anrow__w">{fmt(n.createdAt)}</span>
            </div>
            {n.readAt ? null : (
              <div class="kz-anrow__act">
                <MarkReadButton client:visible id={n.id} title={n.title} />
              </div>
            )}
          </li>
        ))}
      </ul>
    )}
  </Pane>
</AdminLayout>
