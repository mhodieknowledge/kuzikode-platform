---
import AuthLayout from '../../layouts/AuthLayout.astro';
import { SetPasswordForm } from '../../components/auth/AuthForms';

const token = (Astro.url.searchParams.get('token') ?? '').slice(0, 200);
Astro.response.headers.set('referrer-policy', 'no-referrer');
---

<AuthLayout title="Choose a new password" heading="Choose a new password" area="Client portal">
  {token ? (
    <SetPasswordForm client:load audience="portal" token={token} mode="reset" />
  ) : (
    <p class="text-ink-600">
      This link is incomplete.{' '}
      <a href="/portal/forgot-password" class="font-semibold text-brand-600 underline underline-offset-2">
        Request a new one
      </a>
      .
    </p>
  )}
</AuthLayout>
