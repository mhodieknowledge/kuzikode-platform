---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import {
  ClientStatusActions,
  ContactsPanel,
  NoteForm,
  PortalAccessPanel,
} from '../../../../components/admin/ClientsAdmin';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { AppError } from '../../../../server/lib/errors';
import { getClient } from '../../../../server/modules/clients';
import { formatMoney } from '../../../../shared/money';
import { ASSET_TYPE_LABELS, clientServices } from '../../../../server/modules/subscriptions';
import { formatLongDate } from '../../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'clients.view' });
if (page instanceof Response) return page;
let data;
try {
  data = await getClient(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const { client: c, contacts, notes, credits, access, related } = data;
const tabs = [
  ['overview', 'Overview'],
  ['contacts', `Contacts (${contacts.length})`],
  ['notes', `Notes (${notes.length})`],
  ['services', 'Services'],
  ['portal', 'Portal access'],
] as const;
const tab = tabs.some(([k]) => k === Astro.url.searchParams.get('tab'))
  ? Astro.url.searchParams.get('tab')!
  : 'overview';
const canEdit = page.auth.permissions.has('clients.update') && c.status === 'active';
const canSubs = page.auth.permissions.has('subscriptions.view');
const canAssets = page.auth.permissions.has('client_assets.manage');
const services = tab === 'services' ? await clientServices(ctx, c.id) : null;
const canArchive = page.auth.permissions.has('clients.archive');
const unused = !(
  related.quotations ||
  related.invoices ||
  related.projects ||
  related.credits ||
  related.access ||
  related.subscriptions
);
const fmt = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Africa/Harare' }).format(
    new Date(iso),
  );
const address = c.billingAddress
  ? [
      c.billingAddress.line1,
      c.billingAddress.line2,
      c.billingAddress.city,
      c.billingAddress.region,
      c.billingAddress.postalCode,
      c.billingAddress.country,
    ]
      .filter(Boolean)
      .join(', ')
  : null;
---

<AdminLayout title={c.displayName} page={page}>
  <nav aria-label="Breadcrumb" class="text-[13px] text-ink-600">
    <a href="/admin/clients" class="hover:text-ink-950 hover:underline">
      Clients
    </a>{' '}
    / <span class="text-ink-950">{c.displayName}</span>
  </nav>
  <div class="mt-2 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-display">{c.displayName}</h1>
      <p class="mt-1 text-sm text-ink-600">
        <span class="font-mono">{c.number}</span> · {c.type === 'business' ? 'Business' : 'Individual'}
        {c.status === 'archived' ? ' · Archived' : ''}
      </p>
      {c.tags.length ? (
        <p class="mt-2">
          {c.tags.map((t) => (
            <span class="mr-1 inline-flex rounded-full bg-ink-950/5 px-2 py-0.5 text-[12px] text-ink-800">{t}</span>
          ))}
        </p>
      ) : null}
    </div>
    <div class="flex flex-wrap gap-2">
      {page.auth.permissions.has('quotations.create') && c.status === 'active' ? (
        <a
          href={`/admin/quotations/new?clientId=${c.id}`}
          class="inline-flex h-10 items-center rounded-sm border border-line bg-surface px-4 text-sm font-semibold text-ink-950 hover:border-ink-400"
        >
          New quotation
        </a>
      ) : null}
      {page.auth.permissions.has('invoices.create') && c.status === 'active' ? (
        <a
          href={`/admin/invoices/new?clientId=${c.id}`}
          class="inline-flex h-10 items-center rounded-sm border border-line bg-surface px-4 text-sm font-semibold text-ink-950 hover:border-ink-400"
        >
          New invoice
        </a>
      ) : null}
      {canEdit ? (
        <a
          href={`/admin/clients/${c.id}/edit`}
          class="inline-flex h-10 items-center rounded-sm border border-line bg-surface px-4 text-sm font-semibold text-ink-950 hover:border-ink-400"
        >
          Edit
        </a>
      ) : null}
      {canArchive ? <ClientStatusActions client:visible clientId={c.id} status={c.status} canDelete={unused} /> : null}
    </div>
  </div>
  <nav aria-label="Client sections" class="mt-6 overflow-x-auto border-b border-line">
    <ul class="flex gap-1">
      {tabs.map(([k, label]) => (
        <li class="shrink-0">
          <a
            href={`/admin/clients/${c.id}${k === 'overview' ? '' : `?tab=${k}`}`}
            aria-current={tab === k ? 'page' : undefined}
            class:list={[
              'inline-flex h-10 items-center border-b-2 px-3 text-sm font-semibold',
              tab === k ? 'border-brand-600 text-brand-600' : 'border-transparent text-ink-600 hover:text-ink-950',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="mt-6 max-w-5xl">
    {tab === 'overview' ? (
      <div class="grid gap-6 lg:grid-cols-[1fr_320px]">
        <section class="rounded-lg border border-line bg-surface p-6" aria-labelledby="d-title">
          <h2 id="d-title" class="font-sans text-base font-semibold">
            Details
          </h2>
          <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-2">
            <div>
              <dt class="text-ink-600">Registered name</dt>
              <dd class="font-medium text-ink-950">{c.legalName ?? '—'}</dd>
            </div>
            <div>
              <dt class="text-ink-600">Email</dt>
              <dd class="font-medium text-ink-950">{c.email ?? '—'}</dd>
            </div>
            <div>
              <dt class="text-ink-600">Phone</dt>
              <dd class="font-medium text-ink-950">{c.phone ?? '—'}</dd>
            </div>
            <div>
              <dt class="text-ink-600">Website</dt>
              <dd class="font-medium text-ink-950 break-all">{c.website ?? '—'}</dd>
            </div>
            <div>
              <dt class="text-ink-600">Tax / VAT number</dt>
              <dd class="font-medium text-ink-950">{c.taxNumber ?? '—'}</dd>
            </div>
            <div>
              <dt class="text-ink-600">Billing address</dt>
              <dd class="font-medium text-ink-950">{address ?? '—'}</dd>
            </div>
            <div>
              <dt class="text-ink-600">Default currency</dt>
              <dd class="font-medium text-ink-950">{c.defaultCurrency}</dd>
            </div>
            <div>
              <dt class="text-ink-600">Payment terms</dt>
              <dd class="font-medium text-ink-950">{c.paymentTermsDays} days</dd>
            </div>
          </dl>
          {c.notes ? (
            <div class="mt-6">
              <h3 class="text-sm font-semibold text-ink-950">Internal notes</h3>
              <p class="mt-1 text-sm whitespace-pre-line text-ink-800">{c.notes}</p>
            </div>
          ) : null}
        </section>
        <aside class="flex flex-col gap-6">
          <section class="rounded-lg border border-line bg-surface p-6" aria-labelledby="cr-title">
            <h2 id="cr-title" class="font-sans text-base font-semibold">
              Credit balance
            </h2>
            {credits.length === 0 ? (
              <p class="mt-2 text-sm text-ink-600">No credit.</p>
            ) : (
              <ul class="mt-2 flex flex-col gap-1">
                {credits.map((x) => (
                  <li class="tnum text-lg font-semibold text-ink-950">{formatMoney(x.balance, x.currency)}</li>
                ))}
              </ul>
            )}
          </section>
          <section class="rounded-lg border border-line bg-surface p-6" aria-labelledby="rel-title">
            <h2 id="rel-title" class="font-sans text-base font-semibold">
              Activity
            </h2>
            <dl class="mt-3 grid gap-2 text-sm">
              <div class="flex justify-between">
                <dt class="text-ink-600">Quotations</dt>
                <dd class="font-medium">{related.quotations}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-ink-600">Invoices</dt>
                <dd class="font-medium">{related.invoices}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-ink-600">Projects</dt>
                <dd class="font-medium">{related.projects}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-ink-600">Subscriptions</dt>
                <dd class="font-medium">{related.subscriptions}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-ink-600">Created</dt>
                <dd class="font-medium">{fmt(c.createdAt)}</dd>
              </div>
            </dl>
          </section>
        </aside>
      </div>
    ) : tab === 'contacts' ? (
      <ContactsPanel client:load clientId={c.id} contacts={contacts} canEdit={canEdit} />
    ) : tab === 'notes' ? (
      <div class="flex flex-col gap-6">
        {canEdit ? (
          <div class="rounded-lg border border-line bg-surface p-6">
            <NoteForm client:load clientId={c.id} />
          </div>
        ) : null}
        {notes.length === 0 ? (
          <p class="text-sm text-ink-600">No notes yet.</p>
        ) : (
          <ol class="flex flex-col gap-3">
            {notes.map((n) => (
              <li class="rounded-lg border border-line bg-surface p-5">
                <p class="text-sm whitespace-pre-line text-ink-950">{n.body}</p>
                <p class="mt-2 text-[12px] text-ink-600">
                  {n.author} · {fmt(n.created_at)}
                </p>
              </li>
            ))}
          </ol>
        )}
      </div>
    ) : tab === 'services' && services ? (
      <div class="grid items-start gap-6 lg:grid-cols-2">
        <section class="rounded-lg border border-line bg-surface p-6" aria-labelledby="subs-title">
          <div class="flex items-center justify-between gap-3">
            <h2 id="subs-title" class="font-sans text-base font-semibold">
              Subscriptions
            </h2>
            {page.auth.permissions.has('subscriptions.manage') && c.status === 'active' ? (
              <a href={`/admin/subscriptions/new?client=${c.id}`} class="text-sm font-semibold text-brand-600">
                New subscription
              </a>
            ) : null}
          </div>
          {services.subscriptions.length === 0 ? (
            <p class="mt-3 text-sm text-ink-600">No active subscriptions.</p>
          ) : (
            <ul class="mt-3 divide-y divide-line">
              {services.subscriptions.map((s) => (
                <li class="flex flex-wrap items-start justify-between gap-3 py-3 text-sm">
                  <div>
                    {canSubs ? (
                      <a href={`/admin/subscriptions/${s.id}`} class="font-semibold text-ink-950 hover:underline">
                        {s.description}
                      </a>
                    ) : (
                      <span class="font-semibold text-ink-950">{s.description}</span>
                    )}
                    <span class="block text-[12px] text-ink-600">
                      {s.paused ? 'Paused' : `Next invoice ${formatLongDate(s.nextBillingDate!)}`}
                    </span>
                  </div>
                  <span class="tnum text-ink-950">
                    {formatMoney(s.amountMinor, s.currency)} / {s.interval === 'month' ? 'month' : 'year'}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </section>
        <section class="rounded-lg border border-line bg-surface p-6" aria-labelledby="assets-title">
          <div class="flex items-center justify-between gap-3">
            <h2 id="assets-title" class="font-sans text-base font-semibold">
              Managed services
            </h2>
            {canAssets ? (
              <a href={`/admin/assets/new?client=${c.id}`} class="text-sm font-semibold text-brand-600">
                Add to register
              </a>
            ) : null}
          </div>
          {services.assets.length === 0 ? (
            <p class="mt-3 text-sm text-ink-600">Nothing in the register for this client.</p>
          ) : (
            <ul class="mt-3 divide-y divide-line">
              {services.assets.map((a) => (
                <li class="flex flex-wrap items-start justify-between gap-3 py-3 text-sm">
                  <div>
                    {canAssets ? (
                      <a href={`/admin/assets/${a.id}`} class="font-semibold text-ink-950 hover:underline">
                        {a.name}
                      </a>
                    ) : (
                      <span class="font-semibold text-ink-950">{a.name}</span>
                    )}
                    <span class="block text-[12px] text-ink-600">
                      {ASSET_TYPE_LABELS[a.type] ?? a.type}
                      {a.provider ? ` · ${a.provider}` : ''}
                    </span>
                  </div>
                  <span class="text-ink-800">
                    {a.renewalDate ? `Renews ${formatLongDate(a.renewalDate)}` : 'No renewal date'}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </section>
      </div>
    ) : (
      <PortalAccessPanel
        client:load
        clientId={c.id}
        access={access.map((x) => ({
          id: x.id,
          role: x.role,
          status: x.status,
          name: x.name,
          email: x.email,
          userStatus: x.user_status,
        }))}
        contacts={contacts.map((x) => ({ id: x.id, name: x.name, email: x.email }))}
        canEdit={canEdit}
      />
    )}
  </div>
</AdminLayout>
