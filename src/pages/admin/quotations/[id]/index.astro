---
/**
 * One quotation (R6.2): the head carries the number (the sheet below holds the H1 title), status, version and client, and
 * every action; banners for replaced / converted / project; the paper sheet beside the history and versions panes.
 */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import QuotationDocument from '../../../../ui/documents/QuotationSheet.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import Pane from '../../../../ui/admin/Pane.astro';
import StatusPill from '../../../../ui/primitives/StatusPill.astro';
import { QuotationActions } from '../../../../ui/admin/quotations/QuotationActions';
import { QUOTATION_STATUS_TONE } from '../../../../ui/admin/quotations/labels';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { businessDate } from '../../../../server/lib/dates';
import { AppError } from '../../../../server/lib/errors';
import { getSettings, settingText } from '../../../../server/modules/cms';
import {
  getQuotation,
  publicLink,
  type BusinessSnapshot,
  type ClientSnapshot,
} from '../../../../server/modules/quotations';
import { OPEN_FOR_RESPONSE, QUOTATION_STATUS_LABEL, REVISABLE } from '../../../../shared/quotations';
import { formatLongDate } from '../../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'quotations.view' });
if (page instanceof Response) return page;
let data;
try {
  data = await getQuotation(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const { quotation: q, items, client, contact, versions, invoice, createdBy } = data;
const project = await ctx.db
  .prepare('SELECT id, reference FROM projects WHERE source_quotation_id = ?')
  .bind(q.id)
  .first<{ id: string; reference: string }>();
const perms = page.auth.permissions;
const settings = await getSettings(ctx);
const link = q.status === 'draft' ? null : await publicLink(ctx, q.id);
const today = businessDate(ctx.now());
const current = !q.superseded_by_id;
const open = OPEN_FOR_RESPONSE.includes(q.status) && current && (!q.valid_until || q.valid_until >= today);
const can = {
  edit: q.status === 'draft' && perms.has('quotations.update'),
  send: q.status === 'draft' && perms.has('quotations.send'),
  resend: OPEN_FOR_RESPONSE.includes(q.status) && current && perms.has('quotations.send'),
  revise: REVISABLE.includes(q.status) && current && perms.has('quotations.update'),
  duplicate: perms.has('quotations.create'),
  respond: open && perms.has('quotations.update'),
  void: q.status !== 'draft' && q.status !== 'void' && !invoice && perms.has('quotations.void'),
  convert: q.status === 'accepted' && !invoice && perms.has('invoices.create'),
  delete: q.status === 'draft' && perms.has('quotations.update'),
  project: q.status === 'accepted' && !project && perms.has('projects.manage'),
};
// Drafts show live client/business details; sent quotations show the frozen snapshots.
const clientParty: ClientSnapshot = q.client_snapshot
  ? (JSON.parse(q.client_snapshot) as ClientSnapshot)
  : {
      name: client?.display_name ?? '—',
      legalName: null,
      number: client?.client_number ?? '',
      email: client?.email ?? null,
      phone: null,
      taxNumber: null,
      address: null,
      contact: contact ? { name: contact.name, email: contact.email } : null,
    };
const business: BusinessSnapshot = q.business_snapshot
  ? (JSON.parse(q.business_snapshot) as BusinessSnapshot)
  : {
      name: settingText(settings, 'company.name') ?? 'Kuzikode Intelligent Technologies',
      legalName: settingText(settings, 'company.legal_name') ?? null,
      registrationNumber: null,
      taxNumber: settingText(settings, 'company.tax_number') ?? null,
      address: settingText(settings, 'contact.address') ?? null,
      email: settingText(settings, 'contact.billing_email') ?? settingText(settings, 'contact.email') ?? null,
      phone: settingText(settings, 'contact.phone') ?? null,
    };
const when = (iso: string | null) =>
  iso
    ? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Africa/Harare' }).format(
        new Date(iso),
      )
    : null;
const timeline = [
  ['Created', when(q.created_at), createdBy],
  ['Sent', when(q.sent_at), null],
  ['Opened by the client', when(q.viewed_at), null],
  ['Accepted', when(q.accepted_at), q.accepted_by_name],
  ['Rejected', when(q.rejected_at), q.rejection_reason],
  ['Voided', when(q.voided_at), q.void_reason],
].filter(([, at]) => at) as [string, string, string | null][];
const title = q.number ?? `Draft: ${q.title}`;
---

<AdminLayout title={title} page={page}>
  <PageHead
    as="p"
    title={q.number ?? 'Draft quotation'}
    crumbs={[{ label: 'Quotations', href: '/admin/quotations' }, { label: q.number ?? 'Draft' }]}
  >
    <Fragment slot="meta">
      <StatusPill tone={QUOTATION_STATUS_TONE[q.status]}>{QUOTATION_STATUS_LABEL[q.status]}</StatusPill>
      {q.version > 1 ? ` · version ${q.version}` : ''} ·{' '}
      <a href={`/admin/clients/${q.client_id}`}>{client?.display_name}</a>
    </Fragment>
    <QuotationActions
      slot="actions"
      client:load
      id={q.id}
      number={q.number}
      status={q.status}
      publicLink={link}
      can={can}
    />
  </PageHead>
  {q.superseded_by_id || invoice || project ? (
    <div class="kz-anotices">
      {q.superseded_by_id ? (
        <p role="status" class="kz-anotice kz-anotice--info">
          <span>A newer version replaces this quotation.</span>
          <a href={`/admin/quotations/${q.superseded_by_id}`}>Open the newer version</a>
        </p>
      ) : null}
      {invoice ? (
        <p role="status" class="kz-anotice kz-anotice--ok">
          <span>Converted to {invoice.number ? `invoice ${invoice.number}` : 'a draft invoice'}.</span>
          <a href={`/admin/invoices/${invoice.id}`}>Open the invoice</a>
        </p>
      ) : null}
      {project ? (
        <p role="status" class="kz-anotice kz-anotice--info">
          <span>Project {project.reference} was created from this quotation.</span>
          <a href={`/admin/projects/${project.id}`}>Open the project</a>
        </p>
      ) : null}
    </div>
  ) : null}
  <div class="kz-agrid kz-agrid--doc">
    <QuotationDocument
      number={q.number}
      title={q.title}
      status={q.status}
      introHtml={q.intro_html}
      currency={q.currency}
      issueDate={q.issue_date}
      validUntil={q.valid_until}
      paymentTerms={q.payment_terms}
      notes={q.notes}
      terms={q.terms}
      totals={{ subtotal: q.subtotal_minor, discount: q.discount_minor, tax: q.tax_minor, total: q.total_minor }}
      items={items}
      client={clientParty}
      business={business}
    />
    <aside class="kz-astack" aria-label="Quotation history">
      <Pane title="History" id="tl-title" flush>
        <ol class="kz-afeed">
          {timeline.map(([what, at, extra]) => (
            <li data-kind={what === 'Accepted' ? 'lit' : undefined}>
              <p class="kz-afeed__k">{what}</p>
              <p class="kz-afeed__t">
                {at}
                {extra ? ` · ${extra}` : ''}
              </p>
            </li>
          ))}
        </ol>
        {q.valid_until && q.status !== 'draft' ? (
          <p class="kz-apad kz-afeed__t kz-apad--b">Valid until {formatLongDate(q.valid_until)}</p>
        ) : null}
      </Pane>
      {versions.length > 1 ? (
        <Pane title="Versions" id="v-title" flush>
          <ol class="kz-alist">
            {versions.map((v) => (
              <li>
                <div class="kz-alist__main">
                  {v.id === q.id ? (
                    <span class="kz-alist__t">Version {v.version} (this one)</span>
                  ) : (
                    <a href={`/admin/quotations/${v.id}`} class="kz-alist__t">
                      Version {v.version}
                    </a>
                  )}
                  <span class="kz-alist__m">{QUOTATION_STATUS_LABEL[v.status]}</span>
                </div>
              </li>
            ))}
          </ol>
        </Pane>
      ) : null}
    </aside>
  </div>
</AdminLayout>
