---
/**
 * Our Work (R4.4, rebuilt from scratch). Light header (title, intro, category filter when there is more than one category), then
 * the editorial grid of published case studies, or the designed empty state while none are published (ships empty).
 */
import PublicLayout from '../../layouts/PublicLayout.astro';
import SegmentedControl from '../../ui/primitives/SegmentedControl.astro';
import WorkEmpty from '../../ui/public/work/WorkEmpty.astro';
import WorkGrid from '../../ui/public/work/WorkGrid.astro';
import { getPage, listPortfolio } from '../../server/modules/cms';
import type { Section } from '../../shared/schemas/cms';

const { ctx } = Astro.locals;
const [page, items] = await Promise.all([getPage(ctx, 'work'), listPortfolio(ctx)]);
const intro = page?.sections.find((s) => s.key === 'intro' && s.type === 'rich_text') as
  Section<'rich_text'> | undefined;
const empty = page?.sections.find((s) => s.key === 'empty' && s.type === 'cta') as Section<'cta'> | undefined;
const categories = [...new Set(items.map((i) => i.category))].sort();
const active = Astro.url.searchParams.get('category');
const current = active && categories.includes(active) ? active : null;
const filtered = current ? items.filter((i) => i.category === current) : items;
const label = (c: string) => c.replace(/[-_]/g, ' ').replace(/^\w/, (m) => m.toUpperCase());
const filters = [
  { label: 'All', href: '/work', value: '' },
  ...categories.map((c) => ({ label: label(c), href: `/work?category=${encodeURIComponent(c)}`, value: c })),
];
---

<PublicLayout
  title={page?.seoTitle ?? 'Our Work · Kuzikode Technologies'}
  description={page?.seoDescription ?? undefined}
  canonicalPath="/work"
  headerTone="bone"
  footerLead={items.length > 0 ? { title: 'Have a project like these?' } : undefined}
  footerCta={items.length > 0}
>
  <section class="kz-whead" aria-labelledby="work-title">
    <div class="container-wide kz-whead__grid">
      <h1 id="work-title" class="kz-whead__title" data-reveal>
        {intro?.content.title ?? 'Our work'}
      </h1>
      <div>
        {intro ? <div class="kz-whead__intro prose-kz" set:html={intro.content.html} /> : null}
        {items.length > 0 ? (
          <p class="kz-whead__count">
            {items.length} {items.length === 1 ? 'case study' : 'case studies'}
          </p>
        ) : null}
      </div>
    </div>
  </section>

  <section class="kz-sec kz-wbody" aria-label="Case studies">
    <div class="container-wide">
      {items.length === 0 ? (
        <WorkEmpty
          title={empty?.content.title ?? 'Case studies are being prepared.'}
          body={empty?.content.body ?? 'Talk to us about what we can build for you.'}
          cta={empty?.content.primaryCta ?? { label: 'Contact us', href: '/contact' }}
        />
      ) : (
        <Fragment>
          {categories.length > 1 ? (
            <nav class="kz-wfilter" aria-label="Filter by category">
              <SegmentedControl
                mode="links"
                scroll
                label="Filter by category"
                selected={current ? categories.indexOf(current) + 1 : 0}
                items={filters}
              />
            </nav>
          ) : null}
          <WorkGrid items={filtered} label={label} />
        </Fragment>
      )}
    </div>
  </section>
</PublicLayout>
