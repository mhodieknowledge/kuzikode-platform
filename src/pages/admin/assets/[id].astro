---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import { AssetForm } from '../../../ui/admin/subscriptions/AssetForm';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { AppError } from '../../../server/lib/errors';
import { formOptions, getAsset } from '../../../server/modules/subscriptions';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'client_assets.manage' });
if (page instanceof Response) return page;
let data;
try {
  data = await getAsset(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const a = data.asset;
const opts = await formOptions(ctx);
if (!opts.clients.some((c) => c.id === a.client_id))
  opts.clients.unshift({ id: a.client_id, name: a.client_name, currency: 'USD' });
const initial = {
  id: a.id,
  clientId: a.client_id,
  type: a.type,
  name: a.name,
  provider: a.provider,
  subscriptionId: a.subscription_id,
  renewalDate: a.renewal_date,
  autoRenew: a.auto_renew === 1,
  billableToClient: a.billable_to_client === 1,
  costNote: a.cost_note,
  credentialsNote: a.credentials_note,
  status: a.status,
};
const KIND: Record<string, string> = { '30d': '30 days before', '14d': '14 days before', '7d': '7 days before' };
---

<AdminLayout title={a.name} page={page}>
  <PageHead title={a.name} crumbs={[{ label: 'Managed services', href: '/admin/assets' }, { label: a.name }]}>
    <Fragment slot="meta">
      <a href={`/admin/clients/${a.client_id}`}>{a.client_name}</a>
    </Fragment>
  </PageHead>
  <AssetForm client:load initial={initial} clients={opts.clients} subscriptions={opts.subscriptions} />
  <Pane title="Reminders sent" id="rem-title" flush class="kz-agap">
    {data.reminders.length === 0 ? (
      <p class="kz-anone">
        <span class="kz-anone__code">0 reminders</span>None yet.
      </p>
    ) : (
      <ol class="kz-afeed">
        {data.reminders.map((r) => (
          <li>
            <p class="kz-afeed__k">{KIND[r.kind] ?? r.kind}</p>
            <p class="kz-afeed__t">for the {formatLongDate(r.renewal_date)} renewal</p>
          </li>
        ))}
      </ol>
    )}
  </Pane>
</AdminLayout>
