---
/** Settings, general (R6.2 group 3): section nav beside the settings sections. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import SettingsNav from '../../../ui/admin/settings/SettingsNav.astro';
import SettingsSections from '../../../ui/admin/settings/SettingsSections.astro';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { settingsPage } from '../../../server/modules/settings';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'settings.view' });
if (page instanceof Response) return page;
const sections = await settingsPage(ctx, 'general');
const canEdit = page.auth.permissions.has('settings.manage');
---

<AdminLayout title="Settings" page={page}>
  <PageHead title="Settings" meta="General" />
  <div class="kz-aset">
    <SettingsNav current="general" canExport={page.auth.permissions.has('data.export')} />
    <div class="kz-aset__main">
      {canEdit ? null : (
        <p class="kz-anotice kz-anotice--info">You can view settings. Ask an administrator to change them.</p>
      )}
      <SettingsSections sections={sections} canEdit={canEdit} />
    </div>
  </div>
</AdminLayout>
