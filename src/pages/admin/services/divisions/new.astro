---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import { DivisionForm } from '../../../../ui/admin/services/DivisionForm';
import { loadAdminPage } from '../../../../server/lib/admin-page';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'services.manage' });
if (page instanceof Response) return page;
const initial = {
  slug: '',
  name: '',
  summary: '',
  description: '',
  benefits: [],
  deliverables: [],
  faq: [],
  icon: null,
  status: 'coming_soon' as const,
  featured: false,
  seoTitle: null,
  seoDescription: null,
};
---

<AdminLayout title="New division" page={page}>
  <PageHead title="New division" crumbs={[{ label: 'Services', href: '/admin/services' }, { label: 'New division' }]} />
  <DivisionForm client:load initial={initial} />
</AdminLayout>
