---
import PublicLayout from '../layouts/PublicLayout.astro';
Astro.response.status = 404;
---

<PublicLayout title="Page not found · Kuzikode Technologies" noindex>
  <section class="bg-canvas py-24 md:py-32">
    <div class="container-content max-w-2xl">
      <p class="font-mono text-sm text-brand-600">404</p>
      <h1 class="mt-3 text-4xl font-bold tracking-display md:text-5xl">We couldn't find that page.</h1>
      <p class="mt-4 text-lg text-ink-600">It may have moved, or the link may be mistyped. These pages might help:</p>
      <ul class="mt-8 flex flex-wrap gap-3">
        <li>
          <a
            href="/"
            class="inline-flex h-11 items-center rounded-sm bg-brand-600 px-5 text-sm font-semibold text-white hover:bg-brand-500"
          >
            Home
          </a>
        </li>
        <li>
          <a
            href="/services"
            class="inline-flex h-11 items-center rounded-sm border border-line bg-surface px-5 text-sm font-semibold text-ink-950"
          >
            Services
          </a>
        </li>
        <li>
          <a
            href="/contact"
            class="inline-flex h-11 items-center rounded-sm border border-line bg-surface px-5 text-sm font-semibold text-ink-950"
          >
            Contact
          </a>
        </li>
      </ul>
    </div>
  </section>
</PublicLayout>
