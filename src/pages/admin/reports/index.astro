---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BarChart from '../../../ui/admin/BarChart.astro';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { addMonths } from '../../../server/lib/dates';
import { reports, resolveRange } from '../../../server/modules/reports';
import { formatMoney } from '../../../shared/money';
import { AGEING_BUCKETS, AGEING_LABEL, reportRangeQuery, type ReportKey } from '../../../shared/schemas/reports';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'reports.view' });
if (page instanceof Response) return page;
const params = Astro.url.searchParams;
const range = resolveRange(
  ctx,
  reportRangeQuery.parse({ from: params.get('from') ?? undefined, to: params.get('to') ?? undefined }),
);
const d = await reports(ctx, range);
const canExport = page.auth.permissions.has('reports.export');
const csv = (report: ReportKey) =>
  `/api/v1/admin/reports/export.csv?report=${report}&from=${range.from}&to=${range.to}`;

// Months in the range for the charts (YYYY-MM).
const months: string[] = [];
for (let m = `${range.from.slice(0, 7)}-01`; m.slice(0, 7) <= range.to.slice(0, 7); m = addMonths(m, 1))
  months.push(m.slice(0, 7));
const currencies = [...new Set(d.byMonth.map((x) => x.currency))];
const compact = (currency: string) => (minor: number) =>
  `${currency} ${new Intl.NumberFormat('en-GB', { notation: 'compact', maximumFractionDigits: 1 }).format(minor / 100)}`;
const card = 'rounded-lg border border-line bg-surface p-5';
const th = 'px-4 py-2.5 font-semibold';
const num = 'tnum px-4 py-2.5 text-right';
const exportLink = 'text-sm font-semibold text-brand-600 hover:underline';
const field = 'h-10 rounded-sm border border-line bg-surface px-3 text-sm';
---

<AdminLayout title="Reports" page={page}>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-display">Reports</h1>
      <p class="mt-1 text-sm text-ink-600">
        {range.from} to {range.to} (Africa/Harare). Every amount stays in its own currency; nothing is converted or
        added across currencies.
      </p>
    </div>
    <form method="get" class="flex flex-wrap items-end gap-3" aria-label="Report period">
      <label class="flex flex-col gap-1 text-sm font-medium">
        From
        <input type="date" name="from" value={range.from} class={field} />
      </label>
      <label class="flex flex-col gap-1 text-sm font-medium">
        To
        <input type="date" name="to" value={range.to} class={field} />
      </label>
      <button class="h-10 rounded-sm bg-brand-600 px-4 text-sm font-semibold text-white hover:bg-brand-500">
        Show
      </button>
    </form>
  </div>

  <div class="mt-6 grid gap-6 [&>*]:min-w-0">
    <section class={card} aria-labelledby="rev-h">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
        <h2 id="rev-h" class="text-lg font-semibold">
          Revenue received by month
        </h2>
        {canExport ? (
          <a class={exportLink} href={csv('revenue_month')}>
            Export CSV
          </a>
        ) : null}
      </div>
      <p class="mb-4 text-sm text-ink-600">
        Payments received, minus refunds in the month they were made. Reversed payments are excluded.
      </p>
      {currencies.length === 0 ? <p class="text-sm text-ink-600">No payments in this period.</p> : null}
      <div class="grid gap-8 lg:grid-cols-2 [&>*]:min-w-0">
        {currencies.map((cur) => (
          <BarChart
            id={`rev-${cur}`}
            title={`Net revenue (${cur})`}
            months={months}
            series={[
              {
                label: cur,
                values: months.map((m) => d.byMonth.find((x) => x.month === m && x.currency === cur)?.netMinor ?? 0),
              },
            ]}
            format={(v) => formatMoney(v, cur)}
            tick={compact(cur)}
          />
        ))}
      </div>
    </section>

    <section class={card} aria-labelledby="profit-h">
      <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
        <h2 id="profit-h" class="text-lg font-semibold">
          Indicative profit
        </h2>
        {canExport ? (
          <a class={exportLink} href={csv('profit')}>
            Export CSV
          </a>
        ) : null}
      </div>
      <p class="mb-4 text-sm text-ink-600">
        Indicative only: revenue received minus recorded expenses. These are not accounting figures.
      </p>
      <div class="relative overflow-x-auto">
        <table class="w-full min-w-[480px] text-sm">
          <thead class="border-b border-line text-left text-[12px] text-ink-600">
            <tr>
              <th scope="col" class={th}>
                Currency
              </th>
              <th scope="col" class={`${th} text-right`}>
                Revenue received
              </th>
              <th scope="col" class={`${th} text-right`}>
                Expenses
              </th>
              <th scope="col" class={`${th} text-right`}>
                Indicative profit
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {d.profit.length === 0 ? (
              <tr>
                <td colspan="4" class="px-4 py-6 text-center text-ink-600">
                  Nothing in this period.
                </td>
              </tr>
            ) : null}
            {d.profit.map((p) => (
              <tr>
                <th scope="row" class="px-4 py-2.5 text-left font-medium">
                  {p.currency}
                </th>
                <td class={num}>{formatMoney(p.revenueMinor, p.currency)}</td>
                <td class={num}>{formatMoney(p.expensesMinor, p.currency)}</td>
                <td class={`${num} font-semibold`}>{formatMoney(p.profitMinor, p.currency)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <div class="grid gap-6 xl:grid-cols-2 [&>*]:min-w-0">
      <section class={card} aria-labelledby="client-h">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
          <h2 id="client-h" class="text-lg font-semibold">
            Revenue by client
          </h2>
          {canExport ? (
            <a class={exportLink} href={csv('revenue_client')}>
              Export CSV
            </a>
          ) : null}
        </div>
        <div class="relative max-h-96 overflow-auto">
          <table class="w-full min-w-[420px] text-sm">
            <thead class="border-b border-line text-left text-[12px] text-ink-600">
              <tr>
                <th scope="col" class={th}>
                  Client
                </th>
                <th scope="col" class={`${th} text-right`}>
                  Net received
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {d.byClient.length === 0 ? (
                <tr>
                  <td colspan="2" class="px-4 py-6 text-center text-ink-600">
                    No payments in this period.
                  </td>
                </tr>
              ) : null}
              {d.byClient.map((c) => (
                <tr>
                  <td class="px-4 py-2.5">
                    <a class="hover:underline" href={`/admin/clients/${c.client_id}`}>
                      {c.client}
                    </a>
                  </td>
                  <td class={num}>{formatMoney(c.net, c.currency)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class={card} aria-labelledby="svc-h">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
          <h2 id="svc-h" class="text-lg font-semibold">
            Invoiced by service
          </h2>
          {canExport ? (
            <a class={exportLink} href={csv('revenue_service')}>
              Export CSV
            </a>
          ) : null}
        </div>
        <p class="mb-4 text-sm text-ink-600">
          Line totals on invoices issued in this period (void and draft invoices excluded).
        </p>
        <div class="relative max-h-96 overflow-auto">
          <table class="w-full min-w-[420px] text-sm">
            <thead class="border-b border-line text-left text-[12px] text-ink-600">
              <tr>
                <th scope="col" class={th}>
                  Service
                </th>
                <th scope="col" class={`${th} text-right`}>
                  Invoiced
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {d.byService.length === 0 ? (
                <tr>
                  <td colspan="2" class="px-4 py-6 text-center text-ink-600">
                    No invoices issued in this period.
                  </td>
                </tr>
              ) : null}
              {d.byService.map((s) => (
                <tr>
                  <td class="px-4 py-2.5">{s.service}</td>
                  <td class={num}>{formatMoney(s.amount, s.currency)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <section class={card} aria-labelledby="age-h">
      <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
        <h2 id="age-h" class="text-lg font-semibold">
          Outstanding and ageing
        </h2>
        {canExport ? (
          <a class={exportLink} href={csv('ageing')}>
            Export CSV
          </a>
        ) : null}
      </div>
      <p class="mb-4 text-sm text-ink-600">Open invoice balances today ({d.ageing.asOf}), by days past the due date.</p>
      <div class="relative overflow-x-auto">
        <table class="w-full min-w-[720px] text-sm">
          <thead class="border-b border-line text-left text-[12px] text-ink-600">
            <tr>
              <th scope="col" class={th}>
                Currency
              </th>
              {AGEING_BUCKETS.map((b) => (
                <th scope="col" class={`${th} text-right`}>
                  {AGEING_LABEL[b]}
                </th>
              ))}
              <th scope="col" class={`${th} text-right`}>
                Total
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {d.ageing.summary.length === 0 ? (
              <tr>
                <td colspan="7" class="px-4 py-6 text-center text-ink-600">
                  Nothing outstanding.
                </td>
              </tr>
            ) : null}
            {d.ageing.summary.map((s) => (
              <tr>
                <th scope="row" class="px-4 py-2.5 text-left font-medium">
                  {s.currency}
                </th>
                {AGEING_BUCKETS.map((b) => (
                  <td class={num}>
                    {formatMoney(s[b].amountMinor, s.currency)}
                    <span class="block text-[12px] text-ink-600">{s[b].count} inv.</span>
                  </td>
                ))}
                <td class={`${num} font-semibold`}>{formatMoney(s.totalMinor, s.currency)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <div class="grid gap-6 xl:grid-cols-2 [&>*]:min-w-0">
      <section class={card} aria-labelledby="conv-h">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
          <h2 id="conv-h" class="text-lg font-semibold">
            Quotation conversion
          </h2>
          {canExport ? (
            <a class={exportLink} href={csv('conversion')}>
              Export CSV
            </a>
          ) : null}
        </div>
        <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {[
            ['Sent', String(d.conversion.sent)],
            ['Accepted', String(d.conversion.accepted)],
            ['Conversion rate', d.conversion.rateBp === null ? '–' : `${(d.conversion.rateBp / 100).toFixed(1)}%`],
            ['Rejected', String(d.conversion.rejected)],
            ['Expired', String(d.conversion.expired)],
            ['Still open', String(d.conversion.open)],
          ].map(([k, v]) => (
            <div class="rounded-md bg-canvas p-3">
              <dt class="text-[12px] text-ink-600">{k}</dt>
              <dd class="tnum text-xl font-bold">{v}</dd>
            </div>
          ))}
        </dl>
        {d.conversion.acceptedValue.length ? (
          <p class="mt-3 text-sm text-ink-600">
            Accepted value: {d.conversion.acceptedValue.map((v) => formatMoney(v.amountMinor, v.currency)).join(' · ')}
          </p>
        ) : null}
        <p class="mt-2 text-[13px] text-ink-600">Quotations first sent in this period; the rate is accepted ÷ sent.</p>
      </section>

      <section class={card} aria-labelledby="exp-h">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
          <h2 id="exp-h" class="text-lg font-semibold">
            Expenses by category
          </h2>
          {canExport ? (
            <a class={exportLink} href={csv('expenses')}>
              Export CSV
            </a>
          ) : null}
        </div>
        <p class="mb-4 text-sm text-ink-600">Expense records. This is not a statutory accounting system.</p>
        <div class="relative max-h-96 overflow-auto">
          <table class="w-full min-w-[420px] text-sm">
            <thead class="border-b border-line text-left text-[12px] text-ink-600">
              <tr>
                <th scope="col" class={th}>
                  Category
                </th>
                <th scope="col" class={`${th} text-right`}>
                  Amount
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {d.expenses.length === 0 ? (
                <tr>
                  <td colspan="2" class="px-4 py-6 text-center text-ink-600">
                    No expenses in this period.
                  </td>
                </tr>
              ) : null}
              {d.expenses.map((e) => (
                <tr>
                  <td class="px-4 py-2.5">{e.category}</td>
                  <td class={num}>{formatMoney(e.amount, e.currency)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</AdminLayout>
