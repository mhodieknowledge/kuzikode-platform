---
import PublicLayout from '../layouts/PublicLayout.astro';
import StartProjectWizard from '../components/forms/StartProjectWizard';
import { getPage, getPricingCatalogue, getServiceCatalogue, sectionOf } from '../server/modules/cms';

const { ctx } = Astro.locals;
const [page, catalogue, pricing] = await Promise.all([
  getPage(ctx, 'start-a-project'),
  getServiceCatalogue(ctx),
  getPricingCatalogue(ctx),
]);
const intro = sectionOf(page, 'intro', 'rich_text');
const divisions = catalogue
  .filter((c) => c.status === 'active')
  .map((c) => ({
    slug: c.slug,
    name: c.name,
    summary: c.summary,
    services: c.services.filter((s) => s.status === 'active').map((s) => ({ slug: s.slug, name: s.name })),
  }));
// Only what the island needs; prices are already redacted when public prices are off.
const packages = pricing.packages
  .filter((p) => p.status === 'active' && divisions.some((d) => d.slug === p.categorySlug))
  .map((p) => ({
    slug: p.slug,
    name: p.name,
    tagline: p.tagline,
    categorySlug: p.categorySlug,
    serviceSlug: p.serviceSlug,
    priceType: p.priceType,
    priceMinor: p.priceMinor,
    annualPriceMinor: p.annualPriceMinor,
    currency: p.currency,
    billingType: p.billingType,
    interval: p.interval,
    priceUnit: p.priceUnit,
    minQuantity: p.minQuantity,
    mostPopular: p.mostPopular,
  }));
const url = Astro.url;
const initialPackage = url.searchParams.get('package')?.slice(0, 80) ?? undefined;
const initialCategory = url.searchParams.get('category')?.slice(0, 80) ?? undefined;
---

<PublicLayout
  title={page?.seoTitle ?? 'Start a project · Kuzikode Technologies'}
  description={page?.seoDescription ?? undefined}
>
  <section class="bg-canvas py-12 md:py-16" aria-labelledby="start-title">
    <div class="container-content">
      <h1 id="start-title" class="text-4xl font-bold tracking-display md:text-5xl">
        {intro?.content.title ?? 'Start a project'}
      </h1>
      {intro ? <div class="prose-kz mt-4 max-w-2xl text-lg" set:html={intro.content.html} /> : null}
      <div class="mt-10">
        <StartProjectWizard
          client:load
          divisions={divisions}
          packages={packages}
          addons={pricing.addons}
          showPrices={pricing.showPrices}
          siteKey={ctx.config.turnstileSiteKey}
          initialPackage={initialPackage}
          initialCategory={initialCategory}
        />
      </div>
      <noscript>
        <p class="mt-6 text-ink-600">
          This form needs JavaScript. You can also reach us on the{' '}
          <a href="/contact" class="font-semibold text-brand-600 underline">
            contact page
          </a>
          .
        </p>
      </noscript>
    </div>
  </section>
</PublicLayout>
