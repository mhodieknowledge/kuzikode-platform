---
/**
 * Pricing (R4.3, rebuilt from scratch). Order: rate-card hero → sticky category control → one section per pricing category
 * (tiers: plan deck + comparison table on desktop; separate products: flat ledger; "Other services": division ledger, which
 * includes the Add-ons division since R9.1) → VAT note → questions →
 * footer lead. Every figure comes from `getPricingCatalogue` (BRIEF B.6; the price-accuracy e2e test checks it against D1).
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import PricingHero, { type RateRow } from '../ui/public/pricing/PricingHero.astro';
import PlanDeck from '../ui/public/pricing/PlanDeck.astro';
import ServiceRates from '../ui/public/pricing/ServiceRates.astro';
import PackageCompare from '../ui/public/services/PackageCompare.astro';
import SegmentedControl from '../ui/primitives/SegmentedControl.astro';
import Accordion from '../ui/primitives/Accordion.astro';
import AccordionItem from '../ui/primitives/AccordionItem.astro';
import {
  PRICING_TABS,
  breadcrumbLd,
  faqLd,
  getPage,
  getPricingCatalogue,
  getServiceCatalogue,
  listFaqs,
  sectionOf,
  type PublicPackage,
} from '../server/modules/cms';
import { packagePrice } from '../shared/service-display';

const { ctx } = Astro.locals;
const [page, catalogue, services, faqs] = await Promise.all([
  getPage(ctx, 'pricing'),
  getPricingCatalogue(ctx),
  getServiceCatalogue(ctx),
  listFaqs(ctx, 'pricing'),
]);
const intro = sectionOf(page, 'intro', 'rich_text');
const cta = sectionOf(page, 'cta', 'cta');
const divisions = services.map((c, i) => ({ slug: c.slug, name: c.name, n: i + 1 }));

/** Short labels for the phone category control. */
const SHORT: Record<string, string> = { websites: 'Websites', care: 'Care', email: 'Email', other: 'Other' };
/** Packages without feature lists are single priced services: a ledger grouped by division (night band). */
const isLedger = (pkgs: PublicPackage[]) => pkgs.every((p) => p.features.length === 0);
/** The comparison table only helps when every package lists features and they share at least one row. */
const comparable = (pkgs: PublicPackage[]) => {
  if (pkgs.length < 2 || pkgs.some((p) => p.features.length === 0)) return false;
  const [head, ...others] = pkgs;
  return (head?.features ?? []).some((f) => others.every((o) => o.features.some((g) => g.label === f.label)));
};
/** Lowest published price in a category (same currency as the first priced package), shown with its own unit. */
const lowest = (pkgs: PublicPackage[]): RateRow['from'] => {
  if (!catalogue.showPrices) return null;
  const priced = pkgs.filter((p) => p.priceType !== 'custom_quote' && p.priceMinor !== null && p.currency);
  const currency = priced[0]?.currency;
  const min = priced
    .filter((p) => p.currency === currency)
    .reduce<PublicPackage | null>((a, p) => (a === null || (p.priceMinor ?? 0) < (a.priceMinor ?? 0) ? p : a), null);
  if (!min) return null;
  const d = packagePrice(min);
  return { amount: d.amount, suffix: d.suffix };
};

const tabs = PRICING_TABS.map((t) => ({ ...t, packages: catalogue.packages.filter((p) => p.tab === t.key) })).filter(
  (t) => t.packages.length > 0,
);
const rows: RateRow[] = tabs.map((t) => ({
  key: t.key,
  label: t.label,
  count: t.packages.length,
  from: lowest(t.packages),
}));
const ld = [breadcrumbLd(ctx, [{ name: 'Pricing', path: '/pricing' }]), ...(faqs.length ? [faqLd(faqs)] : [])];
---

<PublicLayout
  structuredData={ld}
  title={page?.seoTitle ?? 'Pricing · Kuzikode Technologies'}
  description={page?.seoDescription ?? undefined}
  whatsappMessage="Hi Kuzikode, I have a question about your packages and pricing."
  headerTone="bone"
  footerLead={
    cta ? { title: cta.content.title, body: cta.content.body ?? undefined } : { title: 'Not sure which package fits?' }
  }
>
  <PricingHero
    title={intro?.content.title ?? 'Pricing'}
    introHtml={intro?.content.html ?? null}
    rows={rows}
    showPrices={catalogue.showPrices}
  />

  {tabs.length > 0 ? (
    <nav class="kz-pnav" aria-label="Pricing categories">
      <div class="container-wide">
        <SegmentedControl
          mode="links"
          scroll
          block
          label="Pricing categories"
          items={tabs.map((t) => ({ label: t.label, short: SHORT[t.key], href: `#${t.key}`, value: t.key }))}
        />
      </div>
    </nav>
  ) : null}

  {tabs.length === 0 ? (
    <section class="kz-sec">
      <div class="container-wide">
        <p class="kz-lede">
          Our packages are being updated.{' '}
          <a class="kz-link" href="/contact">
            Contact us
          </a>{' '}
          for a quotation.
        </p>
      </div>
    </section>
  ) : (
    tabs.map((t, i) => {
      const ledger = isLedger(t.packages);
      // Tiers of one product (comparable) are plates + table; separate products (email, domains) are a flat ledger.
      const compare = !ledger && comparable(t.packages);
      const flat = !ledger && !compare;
      return (
        <section
          id={t.key}
          class:list={[
            'kz-ptab',
            flat && 'kz-ptab--flat',
            ledger ? 'kz-band on-night' : 'kz-sec',
            !ledger && i % 2 === 1 && 'kz-sec--inset',
          ]}
          aria-labelledby={`tab-${t.key}`}
        >
          <div class="container-wide">
            <header class="kz-ptab__head">
              <span class="kz-ptab__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h2 id={`tab-${t.key}`} class="kz-h2">
                {t.label}
              </h2>
              <p class="kz-ptab__count">
                {t.packages.length} {t.packages.length === 1 ? 'package' : 'packages'}
              </p>
            </header>
            {ledger ? (
              <ServiceRates packages={t.packages} divisions={divisions} />
            ) : flat ? (
              <ServiceRates packages={t.packages} />
            ) : (
              <PlanDeck packages={t.packages} label={t.label} id={`plans-${t.key}`} />
            )}
            {compare ? (
              <div class="kz-ptab__compare">
                <h3 class="kz-ptab__sub">Compare {t.label.toLowerCase()} side by side</h3>
                <PackageCompare packages={t.packages} caption={`${t.label}: package comparison`} id={`cmp-${t.key}`} />
              </div>
            ) : null}
          </div>
        </section>
      );
    })
  )}

  <section
    class="kz-sec kz-sec--inset kz-faq kz-pfaq"
    aria-labelledby={faqs.length > 0 ? 'faq-title' : undefined}
    aria-label={faqs.length > 0 ? undefined : 'Pricing note'}
  >
    <div class="container-wide kz-faq__grid">
      <div>
        {faqs.length > 0 ? (
          <h2 id="faq-title" class="kz-h2">
            Pricing questions
          </h2>
        ) : null}
        <p class="kz-pnote" data-vat-note>
          {catalogue.vatNote}
        </p>
      </div>
      {faqs.length > 0 ? (
        <Accordion>
          {faqs.map((f, i) => (
            <AccordionItem title={f.question} open={i === 0}>
              <p>{f.answer}</p>
            </AccordionItem>
          ))}
        </Accordion>
      ) : null}
    </div>
  </section>
</PublicLayout>
