---
/**
 * "How we work" as the road strip (R4.1, DESIGN_DIRECTION §3): the CMS process steps are stops S1…Sn on one road. The road is a
 * night band with a dashed centre line that runs through every stop marker (IMG_5066 numbered route of cards along a dashed path,
 * IMG_5067 stepper with connecting lines; the tilted cards and doodles are not used). Header: title left, link right.
 * Phones: the strip is a swipe track (one stop and the next peeking), the road continuing across items.
 */
import Icon from '../../icons/Icon.astro';
import type { SectionContent } from '../../../shared/schemas/cms';

interface Props {
  content: SectionContent<'process'>;
  anchor: string;
}
const { content: c, anchor } = Astro.props;
---

<section class="kz-sec kz-sec--inset kz-road" id={anchor} aria-labelledby={`${anchor}-title`}>
  <div class="container-wide">
    <header class="kz-sec__head">
      <h2 id={`${anchor}-title`} class="kz-h2">{c.title}</h2>
      {
        c.link ? (
          <a class="kz-link" href={c.link.href}>
            {c.link.label}
            <Icon name="arrow-right" size={16} />
          </a>
        ) : null
      }
    </header>
    <ol class="kz-track kz-road__track" role="list" data-kz-track data-reveal-group style={`--stops:${c.steps.length}`}>
      {
        c.steps.map((s, i) => (
          <li class="kz-stop">
            <span class="kz-stop__road" aria-hidden="true">
              <span class="kz-stop__mark">S{i + 1}</span>
            </span>
            <h3 class="kz-stop__title">
              <span class="sr-only">Stop {i + 1}: </span>
              {s.title}
            </h3>
            <p class="kz-stop__body">{s.body}</p>
          </li>
        ))
      }
    </ol>
    <div class="kz-track__dots kz-road__dots" aria-hidden="true" data-kz-track-dots>
      {c.steps.map((_, i) => <i class:list={[i === 0 && 'is-on']} />)}
    </div>
  </div>
</section>
