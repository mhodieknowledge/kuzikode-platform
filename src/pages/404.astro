---
/**
 * Not found (R4.7, rebuilt from scratch). Spec: a plain sentence, a search field and the main destinations as a short route
 * ledger, beside the "road runs out" drawing (desktop) or under a compact one (phones). noindex, status 404.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from '../ui/icons/Icon.astro';
import CoverArt from '../ui/illustrations/CoverArt.astro';

Astro.response.status = 404;
const routes = [
  ['Home', '/', 'Where everything starts.'],
  ['Services', '/services', 'What we build and run.'],
  ['Pricing', '/pricing', 'Every published package.'],
  ['Contact', '/contact', 'Tell us what you were looking for.'],
] as const;
---

<PublicLayout title="Page not found · Kuzikode Technologies" noindex headerTone="bone" footerCta={false}>
  <section class="kz-lost" aria-labelledby="lost-title">
    <div class="container-wide kz-lost__grid">
      <div class="kz-lost__text">
        <p class="kz-lost__code">404 · Not found</p>
        <h1 id="lost-title" class="kz-xhead__title" data-enter>
          We couldn't find that page.
        </h1>
        <p class="kz-lost__body">It may have moved, or the link may be mistyped. Search, or take one of these roads.</p>
        <form action="/search" method="get" role="search" class="kz-lost__search">
          <label for="lost-search" class="sr-only">
            Search the site
          </label>
          <Icon name="search" size={20} />
          <input
            id="lost-search"
            name="q"
            type="search"
            maxlength="100"
            placeholder="Search the site"
            enterkeyhint="search"
          />
          <button type="submit" class="kz-btn kz-btn--secondary kz-btn--sm">
            <span>Search</span>
          </button>
        </form>
        <ol class="kz-lost__routes" role="list">
          {routes.map(([label, href, note], i) => (
            <li>
              <a href={href}>
                <span class="kz-lost__no" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="kz-lost__label">{label}</span>
                <span class="kz-lost__note">{note}</span>
                <Icon name="arrow-right" size={16} />
              </a>
            </li>
          ))}
        </ol>
      </div>
      <div class="kz-lost__art" aria-hidden="true">
        <CoverArt motif="end" />
      </div>
    </div>
  </section>
</PublicLayout>
