---
/**
 * Home (R4.1, clean slate). Section order from the Route direction, content from the CMS `home` page:
 * hero (workspace window + route index) → services night band (route tabs) → road strip (how we work) → why (ledger + payment
 * slip) → selected work (only when published) → client words (only real, consented) → company band (values);
 * the CMS closing call to action titles the footer's "Where next" routes.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import Hero from '../ui/public/home/Hero.astro';
import ServicesBand from '../ui/public/home/ServicesBand.astro';
import PhotoStrip from '../ui/public/shared/PhotoStrip.astro';
import Approach from '../ui/public/home/Approach.astro';
import WorkRail from '../ui/public/home/WorkRail.astro';
import RoadStrip from '../ui/public/home/RoadStrip.astro';
import Voices from '../ui/public/home/Voices.astro';
import CompanyBand from '../ui/public/home/CompanyBand.astro';
import { divisionFromPrice } from '../shared/directory';
import {
  getPage,
  getPricingCatalogue,
  getServiceCatalogue,
  listPortfolio,
  listTestimonials,
} from '../server/modules/cms';
import type { Section } from '../shared/schemas/cms';

const { ctx } = Astro.locals;
const [page, catalogue, pricing, portfolio, testimonials] = await Promise.all([
  getPage(ctx, 'home'),
  getServiceCatalogue(ctx),
  getPricingCatalogue(ctx),
  listPortfolio(ctx),
  listTestimonials(ctx),
]);
if (!page) return new Response('Not found', { status: 404 });
// Home shows the featured divisions only (the Add-ons division is priced but is not a home widget, REFINEMENTS §1).
const categories = catalogue.filter((c) => c.featured);
const featured = portfolio.filter((p) => p.featured).length ? portfolio.filter((p) => p.featured) : portfolio;
const sections = page.sections as Section[];
const divisions = categories.map((c) => ({
  slug: c.slug,
  name: c.name,
  href: `/services/${c.slug}`,
  from: pricing.showPrices ? divisionFromPrice(pricing.packages, c.slug) : null,
}));
// Section order is the design's (RESPONSIVE_DESIGN_SPEC, B.0 clean slate), not the CMS list order; content stays the CMS's.
const byType = (t: Section['type']) => sections.find((s) => s.type === t);
const hero = byType('hero');
const services = byType('services_grid');
const process = byType('process');
const why = byType('features');
const work = byType('work_grid');
const values = byType('values');
const closing = byType('cta')?.content as Section<'cta'>['content'] | undefined;
---

<PublicLayout
  title={page.seoTitle ?? 'Kuzikode Intelligent Technologies'}
  description={page.seoDescription ?? undefined}
  canonicalPath="/"
  headerTone="bone"
  footerLead={closing ? { title: closing.title } : undefined}
>
  {hero ? <Hero content={hero.content as Section<'hero'>['content']} divisions={divisions} /> : null}
  {services ? (
    <ServicesBand
      content={services.content as Section<'services_grid'>['content']}
      categories={categories}
      packages={pricing.packages}
      showPrices={pricing.showPrices}
    />
  ) : null}
  {process ? <RoadStrip content={process.content as Section<'process'>['content']} anchor={process.key} /> : null}
  {why ? <Approach content={why.content as Section<'features'>['content']} anchor={why.key} /> : null}
  <PhotoStrip image="home-band" />
  {work ? <WorkRail content={work.content as Section<'work_grid'>['content']} items={featured} /> : null}
  <Voices testimonials={testimonials} />
  <CompanyBand values={values?.content as Section<'values'>['content'] | undefined} anchor={values?.key ?? 'values'} />
</PublicLayout>
