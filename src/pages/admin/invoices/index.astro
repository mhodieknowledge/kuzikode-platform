---
/** Invoices (R6.2): outstanding strip, filters (sheet on phones), dense table → list rows (number, client + balance, total, status). */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Pager from '../../../ui/admin/Pager.astro';
import KpiStrip, { type Kpi } from '../../../ui/admin/KpiStrip.astro';
import Button from '../../../ui/primitives/Button.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import { FilterBar } from '../../../ui/admin/FilterBar';
import { INVOICE_STATUS_TONE, OPEN_BALANCE_STATUSES } from '../../../ui/admin/finance/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listInvoices } from '../../../server/modules/invoices';
import { invoiceListQuery } from '../../../shared/schemas/invoices';
import { INVOICE_STATUS_LABEL } from '../../../shared/invoices';
import { formatMoney } from '../../../shared/money';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'invoices.view' });
if (page instanceof Response) return page;
const parsed = invoiceListQuery.safeParse(Object.fromEntries(Astro.url.searchParams));
const filter = parsed.success ? parsed.data : invoiceListQuery.parse({});
const result = await listInvoices(ctx, filter);
const canCreate = page.auth.permissions.has('invoices.create');
const pageHref = (n: number) => {
  const q = new URLSearchParams(Astro.url.searchParams);
  q.set('page', String(n));
  return `/admin/invoices?${q.toString()}`;
};
const filtered = !!(filter.q || filter.status);
const tiles: Kpi[] = result.outstanding.length
  ? [
      {
        label: 'Outstanding',
        values: result.outstanding.map((o) => formatMoney(o.balance, o.currency)),
      },
      ...(result.outstanding.some((o) => o.overdue > 0)
        ? [
            {
              label: 'Overdue',
              values: result.outstanding.filter((o) => o.overdue > 0).map((o) => formatMoney(o.overdue, o.currency)),
            },
          ]
        : []),
    ]
  : [];
---

<AdminLayout title="Invoices" page={page}>
  <PageHead title="Invoices" meta={`${result.total} ${result.total === 1 ? 'invoice' : 'invoices'}`}>
    {canCreate ? (
      <Button slot="actions" href="/admin/invoices/new" lead="add">
        New invoice
      </Button>
    ) : null}
  </PageHead>
  {tiles.length ? <KpiStrip items={tiles} testId="invoice-kpis" /> : null}
  <div class="kz-atools kz-agap">
    <FilterBar
      client:load
      label="Filter invoices"
      hidden={filter.clientId ? { clientId: filter.clientId } : {}}
      clearHref="/admin/invoices"
      fields={[
        { kind: 'search', name: 'q', label: 'Search', value: filter.q ?? '', placeholder: 'Number or client' },
        {
          kind: 'select',
          name: 'status',
          label: 'Status',
          value: filter.status ?? 'open',
          options: [
            { value: 'open', label: 'Open (draft, issued, part paid, overdue)' },
            ...Object.entries(INVOICE_STATUS_LABEL).map(([value, label]) => ({ value, label })),
            { value: 'all', label: 'All' },
          ],
        },
      ]}
    />
  </div>
  <DataTable
    caption="Invoices"
    count={result.items.length}
    columns={[
      { label: 'Invoice' },
      { label: 'Client' },
      { label: 'Status' },
      { label: 'Due' },
      { label: 'Total', num: true },
      { label: 'Balance', num: true },
    ]}
  >
    <EmptyState
      slot="empty"
      code={filtered ? 'no matches' : '0 open'}
      title={filtered ? 'No invoices match these filters.' : 'No open invoices.'}
    >
      Drafts and unpaid invoices appear here. Change the status filter to see the rest.
    </EmptyState>
    {result.items.map((q) => (
      <tr>
        <Cell
          m="main"
          class="kz-dt__nowrap"
          href={`/admin/invoices/${q.id}`}
          title={q.number ?? 'Draft invoice'}
          sub={q.issue_date ? `Issued ${formatLongDate(q.issue_date)}` : 'Not issued'}
        />
        <Cell m="meta" tone="mute">
          <span>{q.client_name}</span>
          {OPEN_BALANCE_STATUSES.includes(q.status) && q.balance_minor > 0 ? (
            <span class="kz-dt__ph"> · {formatMoney(q.balance_minor, q.currency)} due</span>
          ) : null}
        </Cell>
        <Cell m="status">
          <StatusPill tone={INVOICE_STATUS_TONE[q.status]} class={q.status === 'void' ? 'kz-pill--void' : undefined}>
            {INVOICE_STATUS_LABEL[q.status]}
          </StatusPill>
        </Cell>
        <Cell tone="mute">{q.due_date ? formatLongDate(q.due_date) : '—'}</Cell>
        <Cell m="amount" num>
          {formatMoney(q.total_minor, q.currency)}
        </Cell>
        <Cell num>
          {q.status === 'draft' || q.status === 'void' ? (
            <span class="kz-dt__dash">—</span>
          ) : (
            formatMoney(q.balance_minor, q.currency)
          )}
        </Cell>
      </tr>
    ))}
  </DataTable>
  <Pager page={result.page} pages={result.pages} href={pageHref} />
</AdminLayout>
