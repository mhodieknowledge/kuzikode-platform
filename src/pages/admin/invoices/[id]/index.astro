---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import InvoiceDocument from '../../../../ui/documents/InvoiceSheet.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import Pane from '../../../../ui/admin/Pane.astro';
import StatusPill from '../../../../ui/primitives/StatusPill.astro';
import { InvoiceActions } from '../../../../ui/admin/invoices/InvoiceActions';
import { PaymentAttempts } from '../../../../ui/admin/payments/PaymentAttempts';
import { INVOICE_STATUS_TONE, PAYMENT_METHOD, formatWhen, reminderLabel } from '../../../../ui/admin/finance/labels';
import { listInvoiceAttempts } from '../../../../server/modules/payments';
import { paymentMethodLabel } from '../../../../shared/payment-methods';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { businessDate } from '../../../../server/lib/dates';
import { AppError } from '../../../../server/lib/errors';
import { getSettings, settingText } from '../../../../server/modules/cms';
import { getInvoice, publicLink } from '../../../../server/modules/invoices';
import type { BusinessSnapshot, ClientSnapshot } from '../../../../server/modules/quotations';
import { canVoid, INVOICE_STATUS_LABEL, OPEN_INVOICE_STATUSES } from '../../../../shared/invoices';
import { formatMoney } from '../../../../shared/money';
import { formatLongDate } from '../../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'invoices.view' });
if (page instanceof Response) return page;
let data;
try {
  data = await getInvoice(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const { invoice: inv, items, client, contact, history, payments, creditsApplied, reminders, quotation } = data;
const perms = page.auth.permissions;
const attempts =
  inv.status !== 'draft' && perms.has('payments.view')
    ? (await listInvoiceAttempts(ctx, inv.id)).map((a) => ({
        ...a,
        methodLabel: paymentMethodLabel(a.methodCode ?? a.providerKey),
      }))
    : [];
const settings = await getSettings(ctx);
const link = inv.status === 'draft' ? null : await publicLink(ctx, inv.id);
const open = OPEN_INVOICE_STATUSES.includes(inv.status) && inv.balance_minor > 0;
const clientParty: ClientSnapshot = inv.client_snapshot
  ? (JSON.parse(inv.client_snapshot) as ClientSnapshot)
  : {
      name: client?.display_name ?? '—',
      legalName: null,
      number: client?.client_number ?? '',
      email: client?.email ?? null,
      phone: null,
      taxNumber: null,
      address: null,
      contact: contact ? { name: contact.name, email: contact.email } : null,
    };
const business: BusinessSnapshot = inv.business_snapshot
  ? (JSON.parse(inv.business_snapshot) as BusinessSnapshot)
  : {
      name: settingText(settings, 'company.name') ?? 'Kuzikode Intelligent Technologies',
      legalName: settingText(settings, 'company.legal_name') ?? null,
      registrationNumber: null,
      taxNumber: settingText(settings, 'company.tax_number') ?? null,
      address: settingText(settings, 'contact.address') ?? null,
      email: settingText(settings, 'contact.billing_email') ?? settingText(settings, 'contact.email') ?? null,
      phone: settingText(settings, 'contact.phone') ?? null,
    };
const hasEmail = !!(clientParty.contact?.email ?? clientParty.email ?? contact?.email ?? client?.email);
const can = {
  edit: inv.status === 'draft' && perms.has('invoices.update'),
  issue: inv.status === 'draft' && perms.has('invoices.issue'),
  send: inv.status !== 'draft' && inv.status !== 'void' && hasEmail && perms.has('invoices.send'),
  pay: open && perms.has('payments.record_manual'),
  credit: open && data.creditAvailable > 0 && perms.has('payments.record_manual'),
  void: canVoid(inv.status, inv.amount_paid_minor, inv.amount_credited_minor) && perms.has('invoices.void'),
  delete: inv.status === 'draft' && !inv.number && perms.has('invoices.update'),
  creditNote: !!data.creditOptions && perms.has('credit_notes.issue'),
};
const APPLIED: Record<string, string> = {
  invoice: 'Reduced the balance',
  client_credit: 'Added to account credit',
  refund: 'To be refunded',
};
const money = (m: number) => formatMoney(m, inv.currency, data.minorDigits);
const when = formatWhen;
const label = (s: string | null) => (s ? (INVOICE_STATUS_LABEL[s as keyof typeof INVOICE_STATUS_LABEL] ?? s) : '');
---

<AdminLayout title={inv.number ?? 'Draft invoice'} page={page}>
  <PageHead
    as="p"
    title={inv.number ?? 'Draft invoice'}
    crumbs={[{ label: 'Invoices', href: '/admin/invoices' }, { label: inv.number ?? 'Draft' }]}
  >
    <Fragment slot="meta">
      <StatusPill tone={INVOICE_STATUS_TONE[inv.status]}>{INVOICE_STATUS_LABEL[inv.status]}</StatusPill> ·{' '}
      <a href={`/admin/clients/${inv.client_id}`}>{client?.display_name}</a>
      {quotation ? (
        <>
          {' '}
          · from <a href={`/admin/quotations/${quotation.id}`}>{quotation.number}</a>
        </>
      ) : null}
    </Fragment>
    <InvoiceActions
      slot="actions"
      client:load
      id={inv.id}
      number={inv.number}
      status={inv.status}
      currency={inv.currency}
      minorDigits={data.minorDigits}
      balanceMinor={inv.balance_minor}
      creditAvailableMinor={data.creditAvailable}
      hasEmail={hasEmail}
      publicLink={link}
      today={businessDate(ctx.now())}
      creditOptions={data.creditOptions}
      can={can}
    />
  </PageHead>
  {inv.status === 'void' ? (
    <div class="kz-anotices">
      <p role="status" class="kz-anotice">
        Voided{inv.voided_at ? ` on ${formatLongDate(inv.voided_at)}` : ''}: {inv.void_reason}
      </p>
    </div>
  ) : null}
  <div class="kz-agrid kz-agrid--doc">
    <InvoiceDocument
      number={inv.number}
      currency={inv.currency}
      minorDigits={data.minorDigits}
      issueDate={inv.issue_date}
      dueDate={inv.due_date}
      notes={inv.notes}
      terms={inv.terms}
      issued={inv.status !== 'draft'}
      totals={{
        subtotal: inv.subtotal_minor,
        discount: inv.discount_minor,
        tax: inv.tax_minor,
        total: inv.total_minor,
        paid: inv.amount_paid_minor,
        credited: inv.amount_credited_minor,
        balance: inv.balance_minor,
      }}
      items={items}
      client={clientParty}
      business={business}
    />
    <aside class="kz-astack" aria-label="Invoice activity">
      {inv.status !== 'draft' ? (
        <Pane title="Payments and credits" id="pay-title" flush>
          {payments.length === 0 && creditsApplied.length === 0 ? (
            <p class="kz-anone">
              <span class="kz-anone__code">0 payments</span>Nothing received yet.
            </p>
          ) : (
            <ul class="kz-alist" role="list">
              {payments.map((p) => (
                <li>
                  <div class="kz-alist__main">
                    <a href={`/admin/payments/${p.id}`} class="kz-alist__t">
                      {PAYMENT_METHOD[p.method] ?? p.method}
                    </a>
                    <span class="kz-alist__m">
                      {formatLongDate(p.received_at)} ·{' '}
                      <a href={`/api/v1/admin/documents/receipts/${p.id}/pdf`} download class="kz-amono">
                        {p.receipt_number}
                      </a>
                      {p.reference ? ` · ${p.reference}` : ''}
                      {p.payment_minor > p.applied_minor
                        ? ` · ${money(p.payment_minor - p.applied_minor)} to credit`
                        : ''}
                    </span>
                  </div>
                  <span class="kz-alist__r">{money(p.applied_minor)}</span>
                </li>
              ))}
              {creditsApplied.map((c) => (
                <li>
                  <div class="kz-alist__main">
                    <span class="kz-alist__t">Account credit</span>
                    <span class="kz-alist__m">{formatLongDate(c.created_at)}</span>
                  </div>
                  <span class="kz-alist__r">{money(-c.amount_minor)}</span>
                </li>
              ))}
            </ul>
          )}
          {data.creditAvailable > 0 && open ? (
            <p class="kz-apad kz-apad--b kz-afeed__t">The client has {money(data.creditAvailable)} credit available.</p>
          ) : null}
        </Pane>
      ) : null}
      {attempts.length ? (
        <Pane title="Online payment attempts" id="att-title" flush>
          <p class="kz-apad kz-afeed__t">
            Checked with the gateway automatically. Use Check now when a client says they paid.
          </p>
          <PaymentAttempts client:visible initial={attempts} />
        </Pane>
      ) : null}
      {data.creditNotes.length ? (
        <Pane title="Credit notes" id="cn-title" flush>
          <ul class="kz-alist" role="list">
            {data.creditNotes.map((cn) => (
              <li>
                <div class="kz-alist__main">
                  <a href={`/api/v1/admin/documents/credit-notes/${cn.id}/pdf`} download class="kz-alist__t kz-amono">
                    {cn.number}
                  </a>
                  <span class="kz-alist__m">
                    {formatLongDate(cn.issued_at)} · {APPLIED[cn.applied_to]} · {cn.reason}
                  </span>
                </div>
                <span class="kz-alist__r">{money(cn.total_minor)}</span>
              </li>
            ))}
          </ul>
        </Pane>
      ) : null}
      <Pane title="History" id="hist-title" flush>
        {history.length === 0 ? (
          <p class="kz-anone">
            <span class="kz-anone__code">0 changes</span>No status changes recorded.
          </p>
        ) : (
          <ol class="kz-afeed">
            {history.map((h) => (
              <li>
                <p class="kz-afeed__k">
                  {h.from_status ? `${label(h.from_status)} → ${label(h.to_status)}` : label(h.to_status)}
                </p>
                <p class="kz-afeed__t">
                  {when(h.created_at)}
                  {h.actor ? ` · ${h.actor}` : ''}
                  {h.reason ? ` · ${h.reason}` : ''}
                </p>
              </li>
            ))}
          </ol>
        )}
      </Pane>
      {reminders.length ? (
        <Pane title="Reminders sent" id="rem-title" flush>
          <ol class="kz-afeed">
            {reminders.map((r) => (
              <li>
                <p class="kz-afeed__k">{reminderLabel(r.kind)}</p>
                <p class="kz-afeed__t">{when(r.sent_at)}</p>
              </li>
            ))}
          </ol>
        </Pane>
      ) : null}
    </aside>
  </div>
</AdminLayout>
