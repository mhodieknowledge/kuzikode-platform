---
/** Two illustrative photos side by side (wide + narrow), used between text sections. */
import ResponsiveImage from '../../ResponsiveImage.astro';

interface Props {
  wide: string;
  narrow: string;
  tone?: 'surface' | 'canvas';
}
const { wide, narrow, tone = 'canvas' } = Astro.props;
---

<section class:list={['pb-14 md:pb-20', tone === 'canvas' ? 'bg-canvas' : 'bg-surface']}>
  <div class="container-content grid gap-4 md:grid-cols-[2fr_1fr] md:gap-6">
    <div class="overflow-hidden rounded-lg">
      <ResponsiveImage id={wide} sizes="(min-width: 768px) 66vw, 100vw" class="aspect-[3/2] h-full w-full object-cover" />
    </div>
    <div class="hidden overflow-hidden rounded-lg md:block [&_picture]:block [&_picture]:h-full">
      <ResponsiveImage id={narrow} sizes="33vw" class="h-full w-full object-cover object-[20%_50%]" />
    </div>
  </div>
</section>
