---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import { CategoriesManager } from '../../../ui/admin/expenses/CategoriesManager';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listCategories } from '../../../server/modules/expenses';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'expenses.view' });
if (page instanceof Response) return page;
const categories = await listCategories(ctx);
---

<AdminLayout title="Expense categories" page={page}>
  <PageHead
    title="Expense categories"
    meta="Categories in use can be deactivated but not deleted, so past records keep them."
    crumbs={[{ label: 'Expenses', href: '/admin/expenses' }, { label: 'Categories' }]}
  />
  <div class="kz-anarrow">
    <CategoriesManager client:load categories={categories} canManage={page.auth.permissions.has('expenses.manage')} />
  </div>
</AdminLayout>
