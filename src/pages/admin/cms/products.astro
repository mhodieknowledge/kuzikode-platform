---
/** Website products (R6.2): described honestly; nothing is sold or subscribed to from these pages. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import CmsTabs from '../../../ui/admin/website/CmsTabs.astro';
import { ProductsManager } from '../../../ui/admin/cms/ProductsManager';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listProductsAdmin } from '../../../server/modules/cms/admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'cms.manage' });
if (page instanceof Response) return page;
const products = (await listProductsAdmin(ctx)) as never[];
---

<AdminLayout title="Products" page={page}>
  <PageHead
    title="Website"
    meta="Products are described honestly: nothing is sold or subscribed to from these pages."
  />
  <div class="kz-atools">
    <CmsTabs current="products" />
  </div>
  <ProductsManager client:load products={products} />
</AdminLayout>
