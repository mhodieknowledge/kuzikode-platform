---
/**
 * Contact (R4.6, rebuilt from scratch). Desktop: the heading, intro, channel ledger and the consultation plate on the left; the
 * enquiry form on a paper sheet on the right (three numbered parts and a "you are sending" preview). Phones: heading, intro, a
 * quick row of the tappable channels, the form, then the channel ledger and the consultation plate. No photograph (B.4a).
 * `?category=`, `?service=` and `?package=` preselect the form (BRIEF B.0c); the package decides its division and service.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import ContactForm from '../ui/public/forms/ContactForm';
import Channels from '../ui/public/forms/Channels.astro';
import Icon from '../ui/icons/Icon.astro';
import { getPage, getPricingCatalogue, getServiceCatalogue, getSettings, settingText } from '../server/modules/cms';
import type { Section } from '../shared/schemas/cms';

const { ctx } = Astro.locals;
const [page, catalogue, settings, pricing] = await Promise.all([
  getPage(ctx, 'contact'),
  getServiceCatalogue(ctx),
  getSettings(ctx),
  getPricingCatalogue(ctx),
]);
const intro = page?.sections.find((s) => s.type === 'rich_text') as Section<'rich_text'> | undefined;
const divisions = catalogue
  .filter((c) => c.status === 'active')
  .map((c) => ({
    slug: c.slug,
    name: c.name,
    services: c.services.filter((s) => s.status === 'active').map((s) => ({ slug: s.slug, name: s.name })),
  }));
const channels = {
  email: settingText(settings, 'contact.email') ?? null,
  phone: settingText(settings, 'contact.phone') ?? null,
  whatsapp: settingText(settings, 'contact.whatsapp_number') ?? null,
  whatsappMsg: settingText(settings, 'contact.whatsapp_message') ?? '',
  location: settingText(settings, 'contact.address') ?? settingText(settings, 'contact.location') ?? null,
  hours: settingText(settings, 'contact.hours') ?? null,
};
const packageSlug = Astro.url.searchParams.get('package')?.slice(0, 80);
const chosen = packageSlug ? pricing.packages.find((p) => p.slug === packageSlug && p.status === 'active') : undefined;
const category = chosen?.categorySlug ?? Astro.url.searchParams.get('category') ?? undefined;
const service = (chosen ? chosen.serviceSlug : Astro.url.searchParams.get('service')) ?? undefined;
const initialPackage = chosen ? { slug: chosen.slug, name: chosen.name } : undefined;
const next = [
  'We read your message and reply, usually within one business day.',
  'We come back with questions or a written quotation.',
  'Work starts only once you approve the scope in writing.',
];
---

<PublicLayout
  ogImage="/brand/og/contact.png"
  title={page?.seoTitle ?? 'Contact Kuzikode Technologies'}
  description={page?.seoDescription ?? undefined}
  canonicalPath="/contact"
  headerTone="bone"
  footerCta={false}
>
  <section class="kz-contact" aria-labelledby="contact-title">
    <div class="container-wide kz-contact__grid">
      <div class="kz-contact__head">
        <h1 id="contact-title" class="kz-contact__title" data-enter>
          {intro?.content.title ?? 'Contact us'}
        </h1>
        {intro ? <div class="kz-contact__intro" data-enter="2" set:html={intro.content.html} /> : null}
        <div class="kz-contact__quick" data-enter="2">
          <Channels {...channels} compact />
        </div>
      </div>
      <div class="kz-contact__sheet" data-enter="3">
        <h2 class="kz-contact__sheet-h">Send us a message</h2>
        <ContactForm
          client:load
          divisions={divisions}
          siteKey={ctx.config.turnstileSiteKey}
          initialCategory={category}
          initialService={service}
          initialPackage={initialPackage}
        />
      </div>
      <aside class="kz-contact__side" aria-label="Other ways to reach us">
        <div>
          <h2 class="kz-contact__h">After you send</h2>
          <ol class="kz-next" role="list">
            {next.map((t, i) => (
              <li>
                <span class="kz-next__mark" aria-hidden="true">
                  S{i + 1}
                </span>
                <span>{t}</span>
              </li>
            ))}
          </ol>
        </div>
        <Channels {...channels} />
        <div class="kz-consult-plate on-night">
          <p class="kz-consult-plate__h">
            <Icon name="calendar" size={20} />
            Prefer to talk it through?
          </p>
          <p>Book a free 30-minute call by video or phone.</p>
          <a class="kz-link" href="/consultation">
            Book a free consultation
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </aside>
    </div>
  </section>
</PublicLayout>
