---
/** The invoice as the client sees it (admin preview and the public /i/[token] page). Amounts come from stored lines. */
import { formatMoney, formatQuantity, formatBpAsPercent } from '../../shared/money';
import { formatLongDate } from '../../shared/service-display';

interface Party {
  name: string;
  legalName?: string | null;
  number?: string | null;
  email?: string | null;
  phone?: string | null;
  taxNumber?: string | null;
  registrationNumber?: string | null;
  address?: string | null;
  contact?: { name: string; email: string | null } | null;
}
interface Item {
  description: string;
  quantity_milli: number;
  unit_price_minor: number;
  discount_type: string;
  discount_value: number;
  tax_rate_bp: number;
  tax_inclusive: number;
  line_discount_minor: number;
  line_tax_minor: number;
  line_total_minor: number;
}
interface Props {
  number: string | null;
  currency: string;
  minorDigits?: number;
  issueDate: string | null;
  dueDate: string | null;
  notes: string | null;
  terms: string | null;
  totals: {
    subtotal: number;
    discount: number;
    tax: number;
    total: number;
    paid: number;
    credited: number;
    balance: number;
  };
  /** Payments and credits are shown once the invoice is issued. */
  issued: boolean;
  items: Item[];
  client: Party;
  business: Party;
}
const p = Astro.props;
const money = (m: number) => formatMoney(m, p.currency, p.minorDigits ?? 2);
const hasDiscount = p.items.some((i) => i.line_discount_minor > 0);
const hasTax = p.items.some((i) => i.line_tax_minor > 0);
---

<article class="min-w-0 rounded-lg border border-line bg-surface p-6 shadow-sm md:p-10" aria-labelledby="doc-title">
  <header class="flex flex-wrap items-start justify-between gap-6">
    <div>
      <p class="text-[13px] font-semibold tracking-wide text-ink-600 uppercase">Invoice</p>
      <h1 id="doc-title" class="mt-1 font-mono text-2xl font-bold tracking-display md:text-3xl">
        {p.number ?? 'Draft invoice'}
      </h1>
      {p.number ? null : <p class="mt-1 text-sm text-ink-800">Not yet issued</p>}
    </div>
    <dl class="grid grid-cols-[auto_auto] gap-x-4 gap-y-1 text-sm">
      <dt class="text-ink-600">Date</dt>
      <dd class="text-right font-medium">{p.issueDate ? formatLongDate(p.issueDate) : '—'}</dd>
      <dt class="text-ink-600">Due date</dt>
      <dd class="text-right font-medium">{p.dueDate ? formatLongDate(p.dueDate) : 'Set when issued'}</dd>
    </dl>
  </header>

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    <section aria-labelledby="from-h">
      <h2 id="from-h" class="text-[13px] font-semibold text-ink-600">
        From
      </h2>
      <p class="mt-1 font-semibold text-ink-950">{p.business.name}</p>
      {p.business.legalName && p.business.legalName !== p.business.name ? (
        <p class="text-sm">{p.business.legalName}</p>
      ) : null}
      {p.business.address ? <p class="text-sm whitespace-pre-line text-ink-800">{p.business.address}</p> : null}
      {p.business.email ? <p class="text-sm text-ink-800">{p.business.email}</p> : null}
      {p.business.phone ? <p class="text-sm text-ink-800">{p.business.phone}</p> : null}
      {p.business.taxNumber ? <p class="text-sm text-ink-800">Tax number: {p.business.taxNumber}</p> : null}
    </section>
    <section aria-labelledby="to-h">
      <h2 id="to-h" class="text-[13px] font-semibold text-ink-600">
        Bill to
      </h2>
      <p class="mt-1 font-semibold text-ink-950">{p.client.name}</p>
      {p.client.legalName && p.client.legalName !== p.client.name ? <p class="text-sm">{p.client.legalName}</p> : null}
      {p.client.contact ? <p class="text-sm text-ink-800">Attn: {p.client.contact.name}</p> : null}
      {p.client.address ? <p class="text-sm text-ink-800">{p.client.address}</p> : null}
      {p.client.email ? <p class="text-sm text-ink-800">{p.client.email}</p> : null}
      {p.client.taxNumber ? <p class="text-sm text-ink-800">Tax number: {p.client.taxNumber}</p> : null}
    </section>
  </div>

  <ul class="mt-8 divide-y divide-line border-y border-line sm:hidden" aria-label="Invoice lines">
    {p.items.map((i) => (
      <li class="tnum py-3 text-sm">
        <p class="whitespace-pre-line text-ink-950">{i.description}</p>
        <p class="mt-1 flex justify-between gap-3 text-ink-600">
          <span>
            {formatQuantity(i.quantity_milli)} × {money(i.unit_price_minor)}
            {i.line_discount_minor ? ` · −${money(i.line_discount_minor)}` : ''}
            {i.tax_rate_bp ? ` · ${formatBpAsPercent(i.tax_rate_bp)} tax${i.tax_inclusive ? ' incl.' : ''}` : ''}
          </span>
          <span class="font-medium text-ink-950">{money(i.line_total_minor)}</span>
        </p>
      </li>
    ))}
  </ul>
  <div class="mt-8 hidden overflow-x-auto sm:block">
    <table class="w-full min-w-[560px] text-left text-sm">
      <caption class="sr-only">Invoice lines</caption>
      <thead class="border-b border-line text-[13px] text-ink-600">
        <tr>
          <th scope="col" class="py-2 pr-3 font-semibold">
            Description
          </th>
          <th scope="col" class="py-2 pr-3 text-right font-semibold">
            Qty
          </th>
          <th scope="col" class="py-2 pr-3 text-right font-semibold">
            Unit price
          </th>
          {hasDiscount ? (
            <th scope="col" class="py-2 pr-3 text-right font-semibold">
              Discount
            </th>
          ) : null}
          {hasTax ? (
            <th scope="col" class="py-2 pr-3 text-right font-semibold">
              Tax
            </th>
          ) : null}
          <th scope="col" class="py-2 text-right font-semibold">
            Amount
          </th>
        </tr>
      </thead>
      <tbody class="tnum">
        {p.items.map((i) => (
          <tr class="border-b border-line align-top">
            <td class="py-3 pr-3 whitespace-pre-line text-ink-950">{i.description}</td>
            <td class="py-3 pr-3 text-right">{formatQuantity(i.quantity_milli)}</td>
            <td class="py-3 pr-3 text-right">{money(i.unit_price_minor)}</td>
            {hasDiscount ? (
              <td class="py-3 pr-3 text-right">{i.line_discount_minor ? `−${money(i.line_discount_minor)}` : '—'}</td>
            ) : null}
            {hasTax ? (
              <td class="py-3 pr-3 text-right">
                {i.tax_rate_bp ? `${formatBpAsPercent(i.tax_rate_bp)}${i.tax_inclusive ? ' incl.' : ''}` : '—'}
              </td>
            ) : null}
            <td class="py-3 text-right font-medium text-ink-950">{money(i.line_total_minor)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <dl class="tnum mt-6 ml-auto grid max-w-xs grid-cols-2 gap-y-1 text-sm">
    <dt class="text-ink-600">Subtotal</dt>
    <dd class="text-right">{money(p.totals.subtotal)}</dd>
    {p.totals.discount ? (
      <>
        <dt class="text-ink-600">Discounts</dt>
        <dd class="text-right">−{money(p.totals.discount)}</dd>
      </>
    ) : null}
    {p.totals.tax ? (
      <>
        <dt class="text-ink-600">Tax</dt>
        <dd class="text-right">{money(p.totals.tax)}</dd>
      </>
    ) : null}
    <dt class="border-t border-line pt-2 text-base font-bold text-ink-950">Total</dt>
    <dd class="border-t border-line pt-2 text-right text-base font-bold text-ink-950">{money(p.totals.total)}</dd>
    {p.issued && p.totals.paid ? (
      <>
        <dt class="text-ink-600">Paid</dt>
        <dd class="text-right">−{money(p.totals.paid)}</dd>
      </>
    ) : null}
    {p.issued && p.totals.credited ? (
      <>
        <dt class="text-ink-600">Credits</dt>
        <dd class="text-right">−{money(p.totals.credited)}</dd>
      </>
    ) : null}
    {p.issued ? (
      <>
        <dt class="border-t border-line pt-2 font-semibold text-ink-950">Balance due</dt>
        <dd class="border-t border-line pt-2 text-right font-semibold text-ink-950">{money(p.totals.balance)}</dd>
      </>
    ) : null}
  </dl>

  {p.notes || p.terms ? (
    <div class="mt-8 grid gap-6 border-t border-line pt-6 text-sm sm:grid-cols-2">
      {p.notes ? (
        <section>
          <h2 class="text-[13px] font-semibold text-ink-600">Notes</h2>
          <p class="mt-1 whitespace-pre-line text-ink-800">{p.notes}</p>
        </section>
      ) : null}
      {p.terms ? (
        <section class="sm:col-span-2">
          <h2 class="text-[13px] font-semibold text-ink-600">Terms</h2>
          <p class="mt-1 whitespace-pre-line text-ink-800">{p.terms}</p>
        </section>
      ) : null}
    </div>
  ) : null}
</article>
