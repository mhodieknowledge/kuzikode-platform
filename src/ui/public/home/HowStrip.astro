---
/**
 * "How we work" as one short strip (R9.6, REFINEMENTS §7 "only if short"): the CMS process step titles as numbered stops on one
 * line, the link to the full page. No step bodies here; /how-we-work carries the detail.
 */
import Icon from '../../icons/Icon.astro';
import type { SectionContent } from '../../../shared/schemas/cms';

interface Props {
  content: SectionContent<'process'>;
  anchor: string;
}
const { content: c, anchor } = Astro.props;
---

<section class="kz-how" id={anchor} aria-labelledby={`${anchor}-title`}>
  <div class="container-wide kz-how__grid">
    <h2 id={`${anchor}-title`} class="kz-how__title">{c.title}</h2>
    <ol class="kz-how__steps" role="list" style={`--steps:${c.steps.length}`}>
      {
        c.steps.map((s, i) => (
          <li>
            <span class="kz-how__n" aria-hidden="true">
              {i + 1}
            </span>
            <span class="kz-how__name">{s.title}</span>
          </li>
        ))
      }
    </ol>
    {
      c.link ? (
        <a class="kz-link kz-how__more" href={c.link.href}>
          {c.link.label}
          <Icon name="arrow-right" size={16} />
        </a>
      ) : null
    }
  </div>
</section>
