---
/** Order summary of the checkout (docs/06 §3b), server-rendered so it works without JavaScript. */
import type { CheckoutView } from '../../server/modules/payments';
import { formatMoney } from '../../shared/money';

interface Props {
  view: CheckoutView;
}
const { view } = Astro.props;
const inv = view.invoice;
const money = (m: number) => formatMoney(m, inv.currency, inv.minorDigits);
---

<section class="rounded-lg border border-line bg-surface p-5 md:p-6" aria-labelledby="summary-h">
  <p class="text-[13px] font-semibold tracking-wide text-ink-600 uppercase">Paying invoice</p>
  <h1 id="summary-h" class="mt-1 font-mono text-2xl font-bold tracking-display">
    {inv.number}
  </h1>
  {inv.clientName ? <p class="mt-1 text-sm text-ink-800">{inv.clientName}</p> : null}
  <ul class="mt-4 divide-y divide-line border-y border-line text-sm">
    {inv.lines.map((l) => (
      <li class="flex justify-between gap-4 py-2">
        <span class="min-w-0 text-ink-800">{l.description}</span>
        <span class="shrink-0 tabular-nums text-ink-950">{money(l.totalMinor)}</span>
      </li>
    ))}
    {inv.moreLines ? (
      <li class="py-2 text-ink-600">
        and {inv.moreLines} more {inv.moreLines === 1 ? 'item' : 'items'}
      </li>
    ) : null}
  </ul>
  <dl class="mt-3 grid grid-cols-[1fr_auto] gap-y-1 text-sm">
    <dt class="text-ink-600">Invoice total</dt>
    <dd class="text-right tabular-nums">{money(inv.totalMinor)}</dd>
    {inv.paidMinor > 0 ? (
      <>
        <dt class="text-ink-600">Already paid</dt>
        <dd class="text-right tabular-nums">−{money(inv.paidMinor)}</dd>
      </>
    ) : null}
    <dt class="mt-2 font-semibold text-ink-950">Amount due now</dt>
    <dd class="mt-2 text-right text-xl font-bold tabular-nums text-ink-950" data-testid="amount-due">
      {money(inv.amountDueMinor)}
    </dd>
  </dl>
  <p class="mt-1 text-right text-[12px] text-ink-600">All amounts in {inv.currency}</p>
</section>
<noscript>
  {view.bankTransfer ? (
    <section class="rounded-lg border border-line bg-surface p-5">
      <h2 class="text-base font-semibold">Pay by bank transfer</h2>
      <p class="mt-2 text-sm text-ink-800">
        Use <strong class="font-mono">{view.bankTransfer.reference}</strong> as the reference:
      </p>
      <p class="mt-2 whitespace-pre-line rounded-sm bg-canvas px-4 py-3 font-mono text-sm">
        {view.bankTransfer.details}
      </p>
      <p class="mt-2 text-[13px] text-ink-600">Mobile money and card payments need JavaScript turned on.</p>
    </section>
  ) : (
    <p class="text-sm text-ink-800">Turn on JavaScript to pay online.</p>
  )}
</noscript>
