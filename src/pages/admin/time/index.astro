---
/**
 * Time (R6.2 group 3): my time (timer + the last 30 days), the weekly timesheet and unbilled time per project, as views over
 * one page. Tables become list rows on phones; the timesheet grid scrolls inside its own box.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Views from '../../../ui/admin/Views.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Button from '../../../ui/primitives/Button.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import { EntryDialogButton } from '../../../ui/admin/time/EntryDialog';
import { TimerWidget } from '../../../ui/admin/time/TimerWidget';
import { billingLabel, workLabel } from '../../../ui/admin/time/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { businessDate } from '../../../server/lib/dates';
import {
  listEntries,
  runningTimer,
  timeStaff,
  timesheet,
  trackingOptions,
  unbilledByProject,
} from '../../../server/modules/timetracking';
import { addDays, formatMinutes, weekStart } from '../../../shared/schemas/time';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { anyOf: ['time.track', 'time.view_all', 'time.bill'] });
if (page instanceof Response) return page;
const perms = page.auth.permissions;
const canTrack = perms.has('time.track');
const canViewAll = perms.has('time.view_all');
const canBill = perms.has('time.bill');
const tabs = [
  ...(canTrack ? ([['mine', 'My time']] as const) : []),
  ...(canTrack || canViewAll ? ([['timesheet', 'Timesheet']] as const) : []),
  ...(canBill ? ([['billing', 'Unbilled time']] as const) : []),
];
const q = Astro.url.searchParams;
const tab = tabs.find(([k]) => k === q.get('tab'))?.[0] ?? tabs[0]![0];
const today = businessDate(ctx.now());
const date = /^\d{4}-\d{2}-\d{2}$/.test(q.get('date') ?? '') ? q.get('date')! : today;
const userParam = q.get('user') ?? undefined;

const projects = canTrack ? await trackingOptions(ctx) : [];
const running = tab === 'mine' ? await runningTimer(ctx) : null;
const mine = tab === 'mine' ? await listEntries(ctx, { from: addDays(today, -30) }) : [];
const myEntries = mine.filter((e) => e.user_id === page.auth.user.id);
const sheet = tab === 'timesheet' ? await timesheet(ctx, userParam ?? null, date) : null;
const staff = tab === 'timesheet' && canViewAll ? await timeStaff(ctx) : [];
const unbilled = tab === 'billing' ? await unbilledByProject(ctx) : [];
const dayLabel = (d: string) =>
  new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }).format(
    new Date(`${d}T00:00:00Z`),
  );
const sheetHref = (d: string) => `/admin/time?tab=timesheet&date=${d}${sheet && userParam ? `&user=${userParam}` : ''}`;
---

<AdminLayout title="Time" page={page}>
  <PageHead title="Time">
    <Fragment slot="actions">
      {canTrack && projects.length > 0 ? <EntryDialogButton client:load projects={projects} today={today} /> : null}
    </Fragment>
  </PageHead>
  <div class="kz-atools">
    <Views
      label="Time"
      current={tab}
      items={tabs.map(([key, label]) => ({ key, label, href: `/admin/time?tab=${key}` }))}
    />
  </div>

  {tab === 'mine' ? (
    <div class="kz-asect">
      {projects.length === 0 && !running ? (
        <p class="kz-anotice kz-anotice--info">
          You aren&apos;t on any open projects yet. Ask a project lead to add you to the team.
        </p>
      ) : (
        <TimerWidget
          client:load
          projects={projects}
          running={
            running
              ? {
                  projectLabel: `${running.project_reference} · ${running.project_name}`,
                  description: running.description,
                  startedAt: running.timer_started_at!,
                }
              : null
          }
        />
      )}
      <section aria-labelledby="recent-h">
        <h2 id="recent-h" class="kz-ashead">
          Last 30 days
        </h2>
        <DataTable
          caption="Time logged in the last 30 days"
          count={myEntries.length}
          columns={[
            { label: 'Date' },
            { label: 'Project' },
            { label: 'Work' },
            { label: 'Time', num: true },
            { label: 'Billing' },
            { label: 'Actions' },
          ]}
        >
          <EmptyState slot="empty" code="0 entries" title="No time logged in the last 30 days.">
            Start the timer or log time by hand.
          </EmptyState>
          {myEntries.map((e) => (
            <tr>
              <Cell m="meta" class="kz-dt__nw">
                <span class="kz-amono">{e.entry_date}</span>
                <span class="kz-dt__ph"> · {e.project_reference}</span>
              </Cell>
              <Cell tone="mute">{e.project_reference}</Cell>
              <Cell m="main">{workLabel(e)}</Cell>
              <Cell m="amount" num>
                {formatMinutes(e.minutes ?? 0)}
              </Cell>
              <Cell m="status" tone="mute">
                {billingLabel(e)}
              </Cell>
              <Cell m="acts" class="kz-dt__acts">
                {!e.invoice_id ? (
                  <EntryDialogButton
                    client:visible
                    projects={projects}
                    today={today}
                    label="Edit"
                    entry={{
                      id: e.id,
                      projectId: e.project_id,
                      taskId: e.task_id,
                      entryDate: e.entry_date,
                      minutes: e.minutes ?? 0,
                      description: e.description,
                      billable: e.billable === 1,
                    }}
                  />
                ) : null}
              </Cell>
            </tr>
          ))}
        </DataTable>
      </section>
    </div>
  ) : null}

  {tab === 'timesheet' && sheet ? (
    <section aria-labelledby="sheet-h" class="kz-asect">
      <div>
        <h2 id="sheet-h" class="kz-ashead">
          Week of {dayLabel(sheet.week)}
          <span class="kz-ashead__m">
            {formatMinutes(sheet.total)} total · {formatMinutes(sheet.billableTotal)} billable
          </span>
        </h2>
        <div class="kz-atools">
          {canViewAll ? (
            <form method="get" class="kz-aperiod" aria-label="Choose person">
              <input type="hidden" name="tab" value="timesheet" />
              <input type="hidden" name="date" value={sheet.week} />
              <div class="kz-field">
                <label class="kz-label" for="ts-person">
                  Person
                </label>
                <select id="ts-person" name="user" class="kz-input">
                  {staff.map((s) => (
                    <option value={s.id} selected={s.id === sheet.userId}>
                      {s.name}
                    </option>
                  ))}
                </select>
              </div>
              <button type="submit" class="kz-btn kz-btn--secondary">
                <span>Show</span>
              </button>
            </form>
          ) : null}
          <div class="kz-aacts-row">
            <Button href={sheetHref(addDays(sheet.week, -7))} variant="secondary" size="sm" lead="chevron-left">
              Previous week
            </Button>
            <Button href={sheetHref(weekStart(today))} variant="secondary" size="sm">
              This week
            </Button>
            <Button href={sheetHref(addDays(sheet.week, 7))} variant="secondary" size="sm" icon="chevron-right">
              Next week
            </Button>
          </div>
        </div>
      </div>
      <section class="kz-apane" aria-label="Timesheet">
        <div class="kz-apane__body is-flush">
          <div class="kz-rscroll" tabindex="0" role="region" aria-label="Scrollable table">
            <table class="kz-rt kz-rt--week">
              <caption class="sr-only">Hours per project and day</caption>
              <thead>
                <tr>
                  <th scope="col">Project</th>
                  {sheet.days.map((d) => (
                    <th scope="col" class="is-num">
                      {dayLabel(d)}
                    </th>
                  ))}
                  <th scope="col" class="is-num">
                    Total
                  </th>
                </tr>
              </thead>
              <tbody>
                {sheet.rows.length === 0 ? (
                  <tr>
                    <td colspan="9" class="is-none">
                      No time logged this week.
                    </td>
                  </tr>
                ) : null}
                {sheet.rows.map((r) => (
                  <tr>
                    <th scope="row">{r.label}</th>
                    {r.minutes.map((m) => (
                      <td class="is-num">{m ? formatMinutes(m) : '–'}</td>
                    ))}
                    <td class="is-num is-strong">{formatMinutes(r.total)}</td>
                  </tr>
                ))}
              </tbody>
              {sheet.rows.length > 0 ? (
                <tfoot>
                  <tr>
                    <th scope="row">Total</th>
                    {sheet.dayTotals.map((m) => (
                      <td class="is-num">{m ? formatMinutes(m) : '–'}</td>
                    ))}
                    <td class="is-num">{formatMinutes(sheet.total)}</td>
                  </tr>
                </tfoot>
              ) : null}
            </table>
          </div>
        </div>
      </section>
    </section>
  ) : null}

  {tab === 'billing' ? (
    <section aria-labelledby="unbilled-h">
      <h2 id="unbilled-h" class="kz-ashead">
        Projects with unbilled time
      </h2>
      <section class="kz-apane" aria-label="Unbilled time by project">
        <div class="kz-apane__body is-flush">
          {unbilled.length === 0 ? (
            <p class="kz-anone">
              <span class="kz-anone__code">0 unbilled</span>All billable time has been billed.
            </p>
          ) : (
            <ul class="kz-alist">
              {unbilled.map((u) => (
                <li>
                  <div class="kz-alist__main">
                    <span class="kz-alist__t">
                      {u.reference} · {u.name}
                    </span>
                    <span class="kz-alist__m">
                      {u.client_name} · {u.entries} {u.entries === 1 ? 'entry' : 'entries'} · {formatMinutes(u.minutes)}{' '}
                      · {u.currency ?? 'USD'} · since {u.oldest}
                    </span>
                  </div>
                  <Button href={`/admin/time/bill/${u.id}`} variant="secondary" size="sm">
                    Review and bill
                  </Button>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    </section>
  ) : null}
</AdminLayout>
