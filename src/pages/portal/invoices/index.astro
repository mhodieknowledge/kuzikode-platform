---
/**
 * Workspace invoices (R5.3, PANEL_DESIGN_SPEC §2): the filter (to pay / all / credit notes), then the list window (8) of invoice
 * rows (mono number, dates, balance in mono with "of total" when part paid, state; overdue in clay) and an "Outstanding" window (4)
 * with the open balance per currency. Credit notes: one full-width list with a PDF link per note.
 */
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PageHead from '../../../ui/workspace/PageHead.astro';
import Window from '../../../ui/workspace/Window.astro';
import FilterNav from '../../../ui/workspace/finance/FilterNav.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import Icon from '../../../ui/icons/Icon.astro';
import { pillTone } from '../../../ui/workspace/finance/tone';
import { loadPortalPage } from '../../../server/lib/portal-page';
import { listPortalCreditNotes, listPortalInvoices } from '../../../server/modules/invoices';
import { formatMoney } from '../../../shared/money';
import { CREDIT_APPLIED_LABEL, portalInvoiceStatus } from '../../../shared/portal';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request, { area: 'finance' });
if (page instanceof Response) return page;
const param = Astro.url.searchParams.get('show');
const show: 'open' | 'all' | 'credit-notes' = param === 'all' || param === 'credit-notes' ? param : 'open';
const invoices = show === 'credit-notes' ? [] : await listPortalInvoices(ctx, { show });
const credits = show === 'credit-notes' ? await listPortalCreditNotes(ctx) : [];
const multiClient = page.clients.length > 1;
const tabs = [
  { key: 'open', label: 'To pay', href: '/portal/invoices' },
  { key: 'all', label: 'All invoices', href: '/portal/invoices?show=all' },
  { key: 'credit-notes', label: 'Credit notes', href: '/portal/invoices?show=credit-notes' },
];
const isOpen = (i: (typeof invoices)[number]) => i.balanceMinor > 0 && i.status !== 'void';
/** Open balance per currency, summed from the listed rows (integer minor units). */
const outstanding = [
  ...invoices
    .filter(isOpen)
    .reduce((m, i) => {
      const t = m.get(i.currency) ?? { currency: i.currency, open: 0, overdue: 0, count: 0, overdueCount: 0 };
      t.open += i.balanceMinor;
      t.count += 1;
      if (i.overdue) {
        t.overdue += i.balanceMinor;
        t.overdueCount += 1;
      }
      return m.set(i.currency, t);
    }, new Map<string, { currency: string; open: number; overdue: number; count: number; overdueCount: number }>())
    .values(),
];
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
---

<PortalLayout title="Invoices" page={page} active="invoices">
  <PageHead title="Invoices" sub="What you owe, what you have paid, and any credit notes." />
  <FilterNav label="Filter invoices" items={tabs} current={show} />

  {show === 'credit-notes' ? (
    <div class="kz-wgrid">
      <Window
        title="Credit notes"
        icon="receipt"
        id="list"
        meta={credits.length ? String(credits.length) : undefined}
        flush={credits.length > 0}
      >
        {credits.length === 0 ? (
          <div class="kz-wnote">
            <p class="kz-wnote__code">no credit notes</p>
            <p>There are no credit notes.</p>
          </div>
        ) : (
          <ul class="kz-wlist" aria-label="Credit notes">
            {credits.map((c) => (
              <li class="kz-frow">
                <div class="kz-frow__main">
                  <p class="kz-frow__title">
                    <span class="kz-wmono">{c.number}</span>
                    {c.status === 'void' ? <StatusPill>Cancelled</StatusPill> : null}
                  </p>
                  <p class="kz-wrow__meta">
                    {formatLongDate(c.issuedAt)} · for{' '}
                    <a class="kz-frow__ref" href={`/portal/invoices/${c.invoiceId}`}>
                      {c.invoiceNumber}
                    </a>{' '}
                    · {CREDIT_APPLIED_LABEL[c.appliedTo]}
                  </p>
                  <p class="kz-frow__note">{c.reason}</p>
                </div>
                <div class="kz-frow__side">
                  <p class="kz-wrow__fig">{formatMoney(c.totalMinor, c.currency)}</p>
                  <a class="kz-frow__dl" href={`/api/v1/portal/credit-notes/${c.id}/pdf`} download>
                    <Icon name="download" size={16} />
                    PDF<span class="sr-only"> of credit note {c.number}</span>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        )}
      </Window>
    </div>
  ) : (
    <div class="kz-wgrid">
      <Window
        title={show === 'open' ? 'To pay' : 'All invoices'}
        icon="invoices"
        span={outstanding.length ? 8 : 12}
        id="list"
        meta={invoices.length ? String(invoices.length) : undefined}
        flush={invoices.length > 0}
      >
        {invoices.length === 0 ? (
          <div class="kz-wnote" data-testid="portal-no-invoices">
            <p class="kz-wnote__code">{show === 'open' ? 'nothing to pay' : 'no invoices yet'}</p>
            <p>{show === 'open' ? 'You have nothing to pay right now.' : 'There are no invoices yet.'}</p>
          </div>
        ) : (
          <ul class="kz-wlist" aria-label="Invoices">
            {invoices.map((i) => {
              const st = portalInvoiceStatus(i.status, i.overdue);
              const open = isOpen(i);
              return (
                <li class:list={['kz-wrow kz-wrow--fin', i.overdue && open && 'is-over']}>
                  <div class="kz-wrow__main">
                    <a class="kz-wrow__title kz-wrow__link kz-wmono" href={`/portal/invoices/${i.id}`}>
                      {i.number}
                    </a>
                    <p class="kz-wrow__meta">
                      {i.issueDate ? formatLongDate(i.issueDate) : ''}
                      {open && i.dueDate ? ` · due ${formatLongDate(i.dueDate)}` : ''}
                      {multiClient ? ` · ${i.clientName}` : ''}
                    </p>
                  </div>
                  <div class="kz-fend">
                    <p class="kz-wrow__fig">{formatMoney(open ? i.balanceMinor : i.totalMinor, i.currency)}</p>
                    {open && i.balanceMinor !== i.totalMinor ? (
                      <p class="kz-fend__of">of {formatMoney(i.totalMinor, i.currency)}</p>
                    ) : null}
                    <StatusPill tone={pillTone(st.tone)}>{st.label}</StatusPill>
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </Window>

      {outstanding.length ? (
        <Window title="Outstanding" icon="wallet" span={4} id="outstanding">
          <ul class="kz-bal" aria-label="Outstanding by currency">
            {outstanding.map((b) => (
              <li>
                <p class="kz-bal__label">Open · {b.currency}</p>
                <p class="kz-bal__fig">{formatMoney(b.open, b.currency)}</p>
                <p class="kz-bal__meta">
                  <span>{plural(b.count, 'open invoice', 'open invoices')}</span>
                  {b.overdue > 0 ? (
                    <span class="kz-bal__over">
                      <Icon name="status-warn" size={16} />
                      {`${formatMoney(b.overdue, b.currency)} overdue`}
                    </span>
                  ) : null}
                </p>
              </li>
            ))}
          </ul>
          <p class="kz-fglance__hint">Open an invoice to pay it online or to see the bank transfer details.</p>
        </Window>
      ) : null}
    </div>
  )}
</PortalLayout>
