---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import { ProjectForm } from '../../../../ui/admin/projects/ProjectForm';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { AppError } from '../../../../server/lib/errors';
import { formOptions, getProject } from '../../../../server/modules/projects';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'projects.manage' });
if (page instanceof Response) return page;
let data;
try {
  data = await getProject(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const p = data.project;
const opts = await formOptions(ctx);
if (data.client && !opts.clients.some((c) => c.id === data.client!.id))
  opts.clients.push({
    id: data.client.id,
    name: `${data.client.display_name} (archived)`,
    number: data.client.client_number,
    currency: p.currency ?? 'USD',
  });
const lead = data.members.find((m) => m.role === 'lead');
const initial = {
  clientId: p.client_id,
  name: p.name,
  description: p.description,
  status: p.status,
  startDate: p.start_date,
  targetDate: p.target_date,
  budgetMinor: p.budget_minor,
  currency: p.currency,
  leadId: lead?.user_id ?? null,
  memberIds: data.members.filter((m) => m.role !== 'lead').map((m) => m.user_id),
};
---

<AdminLayout title={`Edit ${p.name}`} page={page}>
  <PageHead
    title="Edit project"
    crumbs={[
      { label: 'Projects', href: '/admin/projects' },
      { label: p.reference, href: `/admin/projects/${p.id}` },
      { label: 'Edit' },
    ]}
  />
  <ProjectForm client:load id={p.id} initial={initial} {...opts} />
</AdminLayout>
