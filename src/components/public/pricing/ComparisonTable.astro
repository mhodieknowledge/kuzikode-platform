---
import { Check, Minus } from 'lucide-react';
import { comparisonRows, type PublicPackage } from '../../../server/modules/cms';
import { packagePrice } from '../../../shared/service-display';

interface Props {
  packages: PublicPackage[];
  caption: string;
}
const { packages, caption } = Astro.props;
const rows = comparisonRows(packages);
const cell = (p: PublicPackage, key: string) => p.features.find((f) => f.key === key);
---

{
  rows.length > 0 && packages.length > 1 ? (
    <div class="mt-10 hidden relative overflow-x-auto rounded-lg border border-line lg:block">
      <table class="w-full border-collapse text-left text-[15px]">
        <caption class="sr-only">{caption}</caption>
        <thead class="bg-canvas">
          <tr>
            <th scope="col" class="w-1/4 px-5 py-4 text-[13px] font-semibold text-ink-600">
              Feature
            </th>
            {packages.map((p) => {
              const price = packagePrice(p);
              return (
                <th scope="col" class="px-5 py-4 align-bottom">
                  <span class="block font-semibold text-ink-950">{p.name}</span>
                  <span class="tnum block text-[13px] font-medium text-ink-600">
                    {price.prefix ? `${price.prefix} ` : ''}
                    {price.amount}
                    {price.suffix ? ` ${price.suffix}` : ''}
                  </span>
                </th>
              );
            })}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-t border-line">
              <th scope="row" class="px-5 py-3.5 font-medium text-ink-800">
                {r.label}
              </th>
              {packages.map((p) => {
                const f = cell(p, r.key);
                return (
                  <td class="px-5 py-3.5 text-ink-950">
                    {!f || f.value === 'not_included' ? (
                      <>
                        <Minus size={18} className="text-ink-400" aria-hidden="true" />
                        <span class="sr-only">Not included</span>
                      </>
                    ) : f.value === 'included' ? (
                      <>
                        <Check size={18} className="text-brand-600" aria-hidden="true" />
                        <span class="sr-only">Included</span>
                      </>
                    ) : (
                      <span class="font-medium">{f.text}</span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : null
}
