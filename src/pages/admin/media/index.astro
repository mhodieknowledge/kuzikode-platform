---
/** Media library (R6.2): images for the website; every image needs alt text. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import { MediaLibrary } from '../../../ui/admin/cms/MediaLibrary';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { listMedia } from '../../../server/modules/cms/admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'media.manage' });
if (page instanceof Response) return page;
const media = await listMedia(ctx);
---

<AdminLayout title="Media library" page={page}>
  <PageHead
    title="Media library"
    meta="Images for the website. Every image needs alt text. Images used on the website can't be deleted until they are replaced."
  />
  <MediaLibrary client:load media={media} canManage={true} />
</AdminLayout>
