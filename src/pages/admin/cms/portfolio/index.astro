---
/** Our work (R6.2): case studies with their status; only real, completed work. */
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageHead from '../../../../ui/admin/PageHead.astro';
import CmsTabs from '../../../../ui/admin/website/CmsTabs.astro';
import DataTable from '../../../../ui/admin/DataTable.astro';
import Cell from '../../../../ui/admin/Cell.astro';
import Button from '../../../../ui/primitives/Button.astro';
import StatusPill from '../../../../ui/primitives/StatusPill.astro';
import EmptyState from '../../../../ui/primitives/EmptyState.astro';
import { loadAdminPage } from '../../../../server/lib/admin-page';
import { listPortfolioAdmin } from '../../../../server/modules/cms/admin';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'cms.manage' });
if (page instanceof Response) return page;
const items = await listPortfolioAdmin(ctx);
---

<AdminLayout title="Our work" page={page}>
  <PageHead title="Website" meta="Only real, completed work. Name a client only with their permission.">
    <Button slot="actions" href="/admin/cms/portfolio/new" lead="add">
      New case study
    </Button>
  </PageHead>
  <div class="kz-atools">
    <CmsTabs current="portfolio" />
  </div>
  <DataTable
    caption="Case studies"
    count={items.length}
    columns={[{ label: 'Case study' }, { label: 'Category' }, { label: 'Status' }]}
  >
    <EmptyState slot="empty" code="0 case studies" title="No case studies yet.">
      The public page shows a tasteful empty state until you add one.
    </EmptyState>
    {items.map((p) => (
      <tr>
        <Cell
          m="main"
          href={`/admin/cms/portfolio/${p.id}`}
          title={p.name}
          sub={`/work/${p.slug}${p.featured ? ' · featured' : ''}`}
        />
        <Cell m="meta" tone="mute">
          {p.category}
        </Cell>
        <Cell m="status">
          <StatusPill tone={p.status === 'published' ? 'ok' : 'neutral'}>
            {p.status === 'published' ? 'Published' : 'Draft'}
          </StatusPill>
        </Cell>
      </tr>
    ))}
  </DataTable>
</AdminLayout>
