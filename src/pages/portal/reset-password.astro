---
import AuthLayout from '../../layouts/AuthLayout.astro';
import { SetPasswordForm } from '../../ui/auth/AuthForms';

const token = (Astro.url.searchParams.get('token') ?? '').slice(0, 200);
Astro.response.headers.set('referrer-policy', 'no-referrer');
---

<AuthLayout title="Choose a new password" heading="Choose a new password" area="portal" step={2}>
  {token ? (
    <SetPasswordForm client:load audience="portal" token={token} mode="reset" />
  ) : (
    <p class="kz-auth__note">
      This link is incomplete. <a href="/portal/forgot-password">Request a new one</a>.
    </p>
  )}
</AuthLayout>
