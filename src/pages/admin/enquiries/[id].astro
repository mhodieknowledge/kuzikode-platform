---
/** One enquiry (R6.2): message and brief panes beside the contact, attachment and lead panes; triage actions in the head. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import DetailList from '../../../ui/admin/DetailList.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import Button from '../../../ui/primitives/Button.astro';
import { EnquiryActions } from '../../../ui/admin/enquiries/EnquiryActions';
import { ENQUIRY_STATUS_LABEL, ENQUIRY_STATUS_TONE } from '../../../ui/admin/enquiries/labels';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { AppError } from '../../../server/lib/errors';
import { getEnquiry, leadFormOptions, LEAD_STATUS_LABEL } from '../../../server/modules/leads';
import { formatMoney } from '../../../shared/money';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'enquiries.view' });
if (page instanceof Response) return page;
let e;
try {
  e = await getEnquiry(ctx, Astro.params.id ?? '');
} catch (err) {
  if (err instanceof AppError && err.code === 'NOT_FOUND')
    return new Response(null, { status: 404, statusText: 'Not found' });
  throw err;
}
const perms = page.auth.permissions;
const canManage = perms.has('enquiries.manage');
const canTriage = canManage && perms.has('leads.manage');
const staff = canTriage ? (await leadFormOptions(ctx)).staff : [];
const KIND_LABEL = {
  contact: 'Contact form',
  wizard: 'Project request',
  consultation: 'Consultation request',
  product_interest: 'Product interest',
} as const;
const fmt = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Africa/Harare' }).format(
    new Date(iso),
  );
const kb = (n: number) => (n >= 1024 * 1024 ? `${(n / 1024 / 1024).toFixed(1)} MB` : `${Math.ceil(n / 1024)} KB`);
const brief = e.brief && 'version' in e.brief ? e.brief : null;
const preferredTimes = e.brief && 'preferredTimes' in e.brief ? (e.brief.preferredTimes ?? []) : [];
const requested = e.package_name ?? e.service_name ?? e.product_name ?? e.category_name ?? null;
const estimate = brief?.estimate ?? null;
const estimateText =
  estimate && estimate.oneOffLowMinor > 0
    ? `${
        estimate.oneOffLowMinor === estimate.oneOffHighMinor
          ? formatMoney(estimate.oneOffLowMinor, estimate.currency)
          : `${formatMoney(estimate.oneOffLowMinor, estimate.currency)} – ${formatMoney(estimate.oneOffHighMinor, estimate.currency)}`
      }${estimate.recurring.map((r) => ` + ${formatMoney(r.amountMinor, estimate.currency)} / ${r.interval}`).join('')}`
    : null;
---

<AdminLayout title={`Enquiry ${e.reference}`} page={page}>
  <PageHead title={e.name} crumbs={[{ label: 'Enquiries', href: '/admin/enquiries' }, { label: e.reference }]}>
    <Fragment slot="meta">
      {KIND_LABEL[e.kind]} · <span class="kz-amono">{e.reference}</span> · {fmt(e.created_at)} ·{' '}
      {ENQUIRY_STATUS_LABEL[e.status]}
    </Fragment>
    <Fragment slot="actions">
      {canManage ? (
        <EnquiryActions
          client:load
          enquiryId={e.id}
          status={e.status}
          leadId={e.lead_id}
          canTriage={canTriage}
          staff={staff}
          meId={page.auth.user.id}
        />
      ) : e.lead_id && perms.has('leads.view') ? (
        <Button href={`/admin/leads/${e.lead_id}`} variant="secondary" arrow>
          Open lead
        </Button>
      ) : null}
    </Fragment>
  </PageHead>
  <div class="kz-agrid kz-agrid--detail">
    <div class="kz-astack">
      <Pane title="Message" id="m-title">
        <StatusPill slot="actions" tone={ENQUIRY_STATUS_TONE[e.status]}>
          {ENQUIRY_STATUS_LABEL[e.status]}
        </StatusPill>
        <p class="kz-aprose">{e.message}</p>
      </Pane>
      {brief ? (
        <Pane title="Project brief" id="b-title">
          <DetailList
            cols={2}
            items={[
              { label: 'Division', value: brief.division.name },
              { label: 'Service', value: brief.service?.name ?? 'Not sure yet' },
              { label: 'Package', value: brief.package?.name ?? 'None chosen' },
              { label: 'Timeline', value: brief.timeline },
              { label: 'Budget', value: brief.budgetRange },
              { label: 'Current website', value: brief.websiteUrl },
              ...(brief.addons.length
                ? [{ label: 'Add-ons', value: brief.addons.map((x) => x.name).join(', '), wide: true }]
                : []),
              ...(brief.features.length
                ? [{ label: 'Features', value: brief.features.map((x) => x.label).join(', '), wide: true }]
                : []),
              ...(estimateText
                ? [{ label: 'Indicative estimate shown to the visitor', value: estimateText, mono: true, wide: true }]
                : []),
            ]}
          />
        </Pane>
      ) : null}
      {preferredTimes.length ? (
        <Pane title="Preferred times" id="t-title" flush>
          <ul class="kz-alist" role="list">
            {preferredTimes.map((t) => (
              <li>
                <span class="kz-alist__main">{t}</span>
              </li>
            ))}
          </ul>
        </Pane>
      ) : null}
    </div>
    <aside class="kz-astack" aria-label="Enquiry details">
      <Pane title="Contact" id="c-title">
        <DetailList
          items={[
            { label: 'Email', value: e.email, href: `mailto:${e.email}` },
            { label: 'Phone', value: e.phone, href: e.phone ? `tel:${e.phone.replace(/[^\d+]/g, '')}` : undefined },
            { label: 'Organisation', value: e.organisation },
            ...(requested ? [{ label: 'Interested in', value: requested }] : []),
            ...(e.budget_range && !brief ? [{ label: 'Budget', value: e.budget_range }] : []),
          ]}
        />
      </Pane>
      {e.attachment_file_id ? (
        <Pane title="Attachment" id="a-title">
          <a href={`/api/v1/admin/files/${e.attachment_file_id}`} class="kz-afile">
            {e.attachment_name ?? 'Download file'}
          </a>
          {e.attachment_size ? <p class="kz-afeed__t">{kb(e.attachment_size)}</p> : null}
        </Pane>
      ) : null}
      {e.lead_id && e.lead_title ? (
        <Pane title="Lead" id="l-title">
          <a href={`/admin/leads/${e.lead_id}`} class="kz-afile">
            {e.lead_title}
          </a>
          {e.lead_status ? <p class="kz-afeed__t">{LEAD_STATUS_LABEL[e.lead_status]}</p> : null}
        </Pane>
      ) : null}
    </aside>
  </div>
</AdminLayout>
