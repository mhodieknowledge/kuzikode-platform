---
/** Expenses (R6.2): totals strip, filters (sheet on phones), dense table → list rows (description, vendor, amount, category). */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import DataTable from '../../../ui/admin/DataTable.astro';
import Cell from '../../../ui/admin/Cell.astro';
import Pager from '../../../ui/admin/Pager.astro';
import KpiStrip, { type Kpi } from '../../../ui/admin/KpiStrip.astro';
import Button from '../../../ui/primitives/Button.astro';
import EmptyState from '../../../ui/primitives/EmptyState.astro';
import { FilterBar } from '../../../ui/admin/FilterBar';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { EXPENSE_DISCLAIMER, listCategories, listExpenses } from '../../../server/modules/expenses';
import { expenseListQuery } from '../../../shared/schemas/expenses';
import { formatMoney } from '../../../shared/money';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'expenses.view' });
if (page instanceof Response) return page;
const parsed = expenseListQuery.safeParse(Object.fromEntries(Astro.url.searchParams));
const filter = parsed.success ? parsed.data : expenseListQuery.parse({});
const [result, categories] = await Promise.all([listExpenses(ctx, filter), listCategories(ctx)]);
const currencies = (
  await ctx.db
    .prepare('SELECT code FROM currencies WHERE active = 1 ORDER BY is_default DESC, code')
    .all<{ code: string }>()
).results;
const canManage = page.auth.permissions.has('expenses.manage');
const exportQuery = new URLSearchParams(Astro.url.searchParams);
exportQuery.delete('page');
const pageHref = (n: number) => {
  const q = new URLSearchParams(Astro.url.searchParams);
  q.set('page', String(n));
  return `/admin/expenses?${q.toString()}`;
};
const filtered = [...new URLSearchParams(Astro.url.searchParams).keys()].some((k) => k !== 'page');
const tiles: Kpi[] = result.totals.length
  ? [
      {
        label: 'Total',
        values: result.totals.map((t) => formatMoney(t.total, t.currency)),
        note: `${result.totals.reduce((n, t) => n + t.n, 0)} expenses`,
      },
    ]
  : [];
---

<AdminLayout title="Expenses" page={page}>
  <PageHead title="Expenses" meta={EXPENSE_DISCLAIMER}>
    <Fragment slot="actions">
      <Button variant="secondary" href="/admin/expenses/report">
        Report
      </Button>
      <Button variant="secondary" href="/admin/expenses/categories">
        Categories
      </Button>
      <Button
        variant="secondary"
        lead="download"
        href={`/api/v1/admin/expenses/export.csv?${exportQuery.toString()}`}
        download
      >
        Export CSV
      </Button>
      {canManage ? (
        <Button href="/admin/expenses/new" lead="add">
          Record expense
        </Button>
      ) : null}
    </Fragment>
  </PageHead>
  {tiles.length ? <KpiStrip items={tiles} testId="expense-kpis" /> : null}
  <div class="kz-atools kz-agap">
    <FilterBar
      client:load
      label="Filter expenses"
      clearHref="/admin/expenses"
      fields={[
        {
          kind: 'search',
          name: 'q',
          label: 'Search',
          value: filter.q ?? '',
          placeholder: 'Description, vendor or reference',
        },
        {
          kind: 'select',
          name: 'categoryId',
          label: 'Category',
          value: filter.categoryId ?? '',
          options: [{ value: '', label: 'Any' }, ...categories.map((c) => ({ value: c.id, label: c.name }))],
        },
        {
          kind: 'select',
          name: 'currency',
          label: 'Currency',
          value: filter.currency ?? '',
          options: [{ value: '', label: 'Any' }, ...currencies.map((c) => ({ value: c.code, label: c.code }))],
        },
        {
          kind: 'select',
          name: 'status',
          label: 'Status',
          value: filter.status ?? 'recorded',
          options: [
            { value: 'recorded', label: 'Recorded' },
            { value: 'void', label: 'Void' },
            { value: 'all', label: 'All' },
          ],
        },
        { kind: 'date', name: 'from', label: 'From', value: filter.from ?? '' },
        { kind: 'date', name: 'to', label: 'To', value: filter.to ?? '' },
      ]}
    />
  </div>
  <DataTable
    caption="Expenses"
    count={result.items.length}
    columns={[
      { label: 'Date' },
      { label: 'Description' },
      { label: 'Category' },
      { label: 'Project / client' },
      { label: 'Amount', num: true },
    ]}
  >
    <EmptyState
      slot="empty"
      code={filtered ? 'no matches' : '0 expenses'}
      title={filtered ? 'No expenses match these filters.' : 'No expenses recorded yet.'}
    >
      Costs of running the business appear here once recorded.
    </EmptyState>
    {result.items.map((e) => (
      <tr>
        <Cell tone="mute" class="kz-dt__nowrap">
          {formatLongDate(e.expense_date)}
        </Cell>
        <Cell
          m="main"
          href={`/admin/expenses/${e.id}`}
          title={e.description}
          sub={`${e.vendor ?? 'No vendor'}${e.receipt_file_id ? ' · receipt attached' : ''}${e.status === 'void' ? ' · void' : ''}`}
          subText
        />
        <Cell m="meta" tone="mute">
          <span class="kz-dt__ph">{formatLongDate(e.expense_date)} · </span>
          <span>{e.category}</span>
        </Cell>
        <Cell>{e.project_reference ?? e.client_name ?? '—'}</Cell>
        <Cell m="amount" num>
          {formatMoney(e.amount_minor, e.currency)}
        </Cell>
      </tr>
    ))}
  </DataTable>
  <Pager page={result.page} pages={result.pages} href={pageHref} />
</AdminLayout>
