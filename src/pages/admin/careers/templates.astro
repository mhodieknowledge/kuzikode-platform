---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import { CandidateTemplatesForm } from '../../../ui/admin/careers/CandidateTemplates';
import { loadAdminPage } from '../../../server/lib/admin-page';
import { candidateTemplates } from '../../../server/modules/careers';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request, { permission: 'careers.manage' });
if (page instanceof Response) return page;
const templates = await candidateTemplates(ctx);
---

<AdminLayout title="Candidate email templates" page={page}>
  <PageHead
    title="Candidate email templates"
    crumbs={[{ label: 'Careers', href: '/admin/careers' }, { label: 'Email templates' }]}
  />
  <CandidateTemplatesForm client:load initial={templates} />
</AdminLayout>
