---
/** Account security (R6.2 group 3): two-factor and password panes, link to signed-in devices. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHead from '../../../ui/admin/PageHead.astro';
import Pane from '../../../ui/admin/Pane.astro';
import Button from '../../../ui/primitives/Button.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import { ChangePasswordForm } from '../../../ui/auth/AuthForms';
import { MfaManage } from '../../../ui/admin/account/AccountActions';
import { loadAdminPage } from '../../../server/lib/admin-page';

const { ctx } = Astro.locals;
const page = await loadAdminPage(ctx, Astro.request);
if (page instanceof Response) return page;
const { mfa } = page.auth;
---

<AdminLayout title="Security" page={page}>
  <PageHead title="Security">
    <Fragment slot="actions">
      <Button href="/admin/account/sessions" variant="secondary" lead="lock">
        See signed-in devices
      </Button>
    </Fragment>
  </PageHead>
  <div class="kz-aset__main">
    <Pane title="Two-factor authentication" id="mfa-title">
      <div slot="actions">
        <StatusPill tone={mfa.enabled ? 'ok' : 'warn'}>{mfa.enabled ? 'On' : 'Off'}</StatusPill>
      </div>
      <p class="kz-hint">
        {mfa.enabled
          ? 'You enter a code from your authenticator app when you sign in.'
          : 'Turn it on to protect your account if your password is ever stolen.'}
        {mfa.required ? ' Your role requires it.' : ''}
      </p>
      <div class="kz-agap">
        {mfa.enabled ? (
          <MfaManage client:visible canDisable={!mfa.required} />
        ) : (
          <Button href="/admin/mfa/setup" lead="key">
            Set up two-factor authentication
          </Button>
        )}
      </div>
    </Pane>
    <Pane title="Change password" id="pw-title">
      <p class="kz-hint">Changing your password signs out your other sessions.</p>
      <div class="kz-agap" style="max-width:420px">
        <ChangePasswordForm client:visible audience="admin" forced={false} />
      </div>
    </Pane>
  </div>
</AdminLayout>
