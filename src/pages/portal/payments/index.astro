---
/**
 * Workspace payments (R5.3, PANEL_DESIGN_SPEC §1–2): the receipts window (8), a table from 1024 px (Receipt · Date · Method ·
 * For · Amount · Status, receipt download) and list rows below; beside it (4) "Received" per currency and the saved cards.
 */
import PortalLayout from '../../../layouts/PortalLayout.astro';
import PageHead from '../../../ui/workspace/PageHead.astro';
import Window from '../../../ui/workspace/Window.astro';
import StatusPill from '../../../ui/primitives/StatusPill.astro';
import Icon from '../../../ui/icons/Icon.astro';
import { SavedCards } from '../../../ui/workspace/finance/SavedCards';
import { loadPortalPage } from '../../../server/lib/portal-page';
import { listPortalPayments, listPortalSavedCards } from '../../../server/modules/payments';
import { formatMoney } from '../../../shared/money';
import { paymentMethodLabel } from '../../../shared/payment-methods';
import { formatLongDate } from '../../../shared/service-display';

const { ctx } = Astro.locals;
const page = await loadPortalPage(ctx, Astro.request, { area: 'finance' });
if (page instanceof Response) return page;
const [payments, cards] = await Promise.all([listPortalPayments(ctx), listPortalSavedCards(ctx)]);
const multiClient = new Set(cards.map((c) => c.clientId)).size > 1;
const STATUS = {
  completed: { label: 'Received', tone: 'ok' },
  partially_refunded: { label: 'Part refunded', tone: 'warn' },
  refunded: { label: 'Refunded', tone: 'neutral' },
  reversed: { label: 'Reversed', tone: 'danger' },
} as const;
const partRefunded = payments.some((p) => p.status === 'partially_refunded');
/** Received per currency, from the listed payments (integer minor units); refunded and reversed ones are left out. */
const paid = [
  ...payments
    .filter((p) => p.status === 'completed' || p.status === 'partially_refunded')
    .reduce((m, p) => {
      const t = m.get(p.currency) ?? { currency: p.currency, total: 0, count: 0, last: p.receivedAt };
      t.total += p.amountMinor;
      t.count += 1;
      if (p.receivedAt > t.last) t.last = p.receivedAt;
      return m.set(p.currency, t);
    }, new Map<string, { currency: string; total: number; count: number; last: string }>())
    .values(),
];
---

<PortalLayout title="Payments" page={page} active="payments">
  <PageHead title="Payments" sub="Every payment we have received from you, with its receipt." />

  <div class="kz-wgrid">
    <Window
      title="Receipts"
      icon="receipt"
      span={payments.length || cards.length ? 8 : 12}
      id="list"
      meta={payments.length ? String(payments.length) : undefined}
      flush={payments.length > 0}
    >
      {payments.length === 0 ? (
        <div class="kz-wnote">
          <p class="kz-wnote__code">no payments yet</p>
          <p>Receipts for what you pay appear here.</p>
        </div>
      ) : (
        <div class="kz-ftab kz-ftab--pay">
          <div class="kz-ftab__head" aria-hidden="true">
            <span>Receipt</span>
            <span>Date</span>
            <span>Method</span>
            <span>For</span>
            <span class="is-num">Amount</span>
            <span class="sr-only">Download</span>
          </div>
          <ul class="kz-wlist" aria-label="Payments">
            {payments.map((p) => (
              <li class="kz-ftr">
                <p class="kz-ftr__id kz-frow__title kz-wmono">{p.receiptNumber}</p>
                <p class="kz-ftr__date">
                  <time datetime={p.receivedAt}>{formatLongDate(p.receivedAt)}</time>
                </p>
                <p class="kz-ftr__dates">
                  <span class="kz-ftr__method">{paymentMethodLabel(p.method)}</span>
                  <span class="kz-ftr__for">
                    {p.invoices.length ? <span class="kz-ftr__lbl"> · for </span> : null}
                    {p.invoices.map((i, n) => (
                      <Fragment>
                        {n > 0 ? ', ' : ''}
                        <a class="kz-frow__ref" href={`/portal/invoices/${i.id}`}>
                          {i.number}
                        </a>
                      </Fragment>
                    ))}
                  </span>
                </p>
                <div class="kz-ftr__amt">
                  <p class="kz-wrow__fig">{formatMoney(p.amountMinor, p.currency)}</p>
                  <StatusPill tone={STATUS[p.status].tone}>{STATUS[p.status].label}</StatusPill>
                </div>
                <a class="kz-frow__dl kz-ftr__dl" href={`/api/v1/portal/payments/${p.id}/receipt`} download>
                  <Icon name="download" size={16} />
                  Receipt<span class="sr-only"> {p.receiptNumber}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </Window>

    {paid.length || cards.length ? (
      <div class="kz-fstack">
        {paid.length ? (
          <Window title="Received" icon="wallet" id="paid">
            <ul class="kz-bal" aria-label="Received by currency">
              {paid.map((t) => (
                <li>
                  <p class="kz-bal__label">Received · {t.currency}</p>
                  <p class="kz-bal__fig">{formatMoney(t.total, t.currency)}</p>
                  <p class="kz-bal__meta">
                    <span>{t.count === 1 ? '1 receipt' : `${t.count} receipts`}</span>
                    <span>
                      last <span class="kz-wmono">{formatLongDate(t.last)}</span>
                    </span>
                  </p>
                </li>
              ))}
            </ul>
            <p class="kz-fglance__hint">
              {partRefunded
                ? 'Refunded and reversed payments are not counted. Part-refunded payments count at the amount received.'
                : 'Refunded and reversed payments are not counted.'}
            </p>
          </Window>
        ) : null}
        {cards.length ? (
          <Window title="Saved cards" icon="wallet" id="cards" meta={String(cards.length)} flush>
            <p class="kz-fcards__intro">
              Cards you saved when paying. We keep only a secure token from our payment partner, never your card number.
            </p>
            <SavedCards client:load cards={cards} showClient={multiClient} />
          </Window>
        ) : null}
      </div>
    ) : null}
  </div>
</PortalLayout>
